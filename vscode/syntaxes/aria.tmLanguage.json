{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aria",
  "scopeName": "source.aria",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.aria",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.aria",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aria",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aria",
              "match": "\\\\[nrt\\\\\"{}0]"
            },
            {
              "name": "meta.interpolation.aria",
              "begin": "(?<!\\\\)\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.aria" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.aria" }
              },
              "patterns": [
                { "include": "source.aria" }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.aria",
          "match": "'(?:[^'\\\\]|\\\\[nrt\\\\'0])'",
          "captures": {
            "0": { "name": "string.quoted.single.aria" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.aria",
          "match": "\\b[0-9][0-9_]*(ns|us|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.size.aria",
          "match": "\\b[0-9][0-9_]*(gb|mb|kb|b)\\b"
        },
        {
          "name": "constant.numeric.hex.aria",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.octal.aria",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.binary.aria",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.aria",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.aria",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.aria",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|yield)\\b"
        },
        {
          "name": "keyword.declaration.aria",
          "match": "\\b(fn|type|enum|trait|impl|struct|mod|use|pub|entry|const|extern)\\b"
        },
        {
          "name": "keyword.other.aria",
          "match": "\\b(mut|defer|with|catch|test|bench|assert|derives|where|as|is|spawn|scope|select|before|after|mock|from)\\b"
        },
        {
          "name": "variable.language.self.aria",
          "match": "\\bself\\b"
        },
        {
          "name": "entity.name.type.self.aria",
          "match": "\\bSelf\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.aria",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|byte|void|dur|usize)\\b"
        },
        {
          "name": "entity.name.type.aria",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aria",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.other.caps.aria",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.aria",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.aria",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.aria",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.aria",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.pipe.aria",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.optional.aria",
          "match": "\\?\\?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.range.aria",
          "match": "\\.\\.\\.?=?"
        },
        {
          "name": "keyword.operator.arithmetic.aria",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.aria",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.error.aria",
          "match": "!"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.aria",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.definition.aria",
          "match": "(?<=\\bfn\\s+)([a-z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.annotation.aria",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
