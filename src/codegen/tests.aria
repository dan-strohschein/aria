mod codegen

// ============================================================
// Codegen Tests — IR operations and lowering
// ============================================================

use diagnostic
use lexer
use parser
use resolver
use checker

// --- IR type tests ---

test "ir op name" {
    assert ir_op_name(OpConst) == "Const"
    assert ir_op_name(OpAdd) == "Add"
    assert ir_op_name(OpRet) == "Ret"
    assert ir_op_name(OpLabel) == "Label"
}

test "ir func add inst" {
    mut f := new_ir_func("main", 0, 0)
    inst := new_inst(OpConst, 1, 42, 0, "", 0)
    f = func_add_inst(f, inst)
    assert func_inst_count(f) == 1
}

test "ir module add func" {
    mut m := new_ir_module()
    f := new_ir_func("main", 0, 0)
    m = mod_add_func(m, f)
    assert mod_func_count(m) == 1
}

test "ir module add string" {
    mut m := new_ir_module()
    m = mod_add_string(m, "hello")
    idx := mod_find_string(m, "hello")
    assert idx == 1
}

test "ir module find func" {
    mut m := new_ir_module()
    f := new_ir_func("foo", 2, 1)
    m = mod_add_func(m, f)
    found := mod_find_func(m, "foo")
    assert found.name == "foo"
    assert found.param_count == 2
}

// --- Lowering tests ---

fn _lower_source(source: str) -> IrModule {
    lex := tokenize(source, "test.aria")
    toks := get_tokens(lex)
    pr := build_decl_index(toks)
    rr := resolve(toks, pr.index, pr.pool, "test.aria")
    cr := check(toks, pr.index, pr.pool, rr.table, "test.aria")
    lower(toks, pr.index, pr.pool, cr.store, cr.registry, cr.treg, rr.table, "test.aria")
}

test "lower simple fn" {
    m := _lower_source("mod test\nfn foo() -> i64 = 42")
    f := mod_find_func(m, "foo")
    assert f.name == "foo"
    assert func_inst_count(f) > 0
}

test "lower fn with arithmetic" {
    m := _lower_source("mod test\nfn add(a: i64, b: i64) -> i64 = a + b")
    f := mod_find_func(m, "add")
    assert f.name == "add"
    assert f.param_count == 2
}

test "lower entry block" {
    lb := "\{"
    rb := "\}"
    source := "mod test\nfn foo() -> i64 = 42\nentry " + lb + "\n    foo()\n" + rb
    m := _lower_source(source)
    assert m.entry_func == "_main"
    f := mod_find_func(m, "_main")
    assert f.name == "_main"
}

test "lower string constant" {
    m := _lower_source("mod test\nfn greet() -> str = \"hello\"")
    idx := mod_find_string(m, "hello")
    assert idx > 0
}

// --- Control flow tests ---

test "lower if else" {
    lb := "\{"
    rb := "\}"
    source := "mod test\nfn pick(x: i64) -> i64 = if x > 0 " + lb + " 1 " + rb + " else " + lb + " 0 " + rb
    m := _lower_source(source)
    f := mod_find_func(m, "pick")
    assert f.name == "pick"
    assert func_inst_count(f) > 3
}

test "lower while loop" {
    lb := "\{"
    rb := "\}"
    source := "mod test\nfn count() -> i64 " + lb + "\n    mut i := 0\n    while i < 10 " + lb + "\n        i = i + 1\n    " + rb + "\n    i\n" + rb
    m := _lower_source(source)
    f := mod_find_func(m, "count")
    assert f.name == "count"
    assert func_inst_count(f) > 5
}

test "lower multiple functions" {
    source := "mod test\nfn double(x: i64) -> i64 = x * 2\nfn triple(x: i64) -> i64 = x * 3"
    m := _lower_source(source)
    f1 := mod_find_func(m, "double")
    f2 := mod_find_func(m, "triple")
    assert f1.name == "double"
    assert f2.name == "triple"
}

test "lower function call" {
    lb := "\{"
    rb := "\}"
    source := "mod test\nfn inc(x: i64) -> i64 = x + 1\nfn use_inc() -> i64 = inc(41)"
    m := _lower_source(source)
    f := mod_find_func(m, "use_inc")
    assert f.name == "use_inc"
    assert func_inst_count(f) > 1
}

// --- Type and struct tests ---

test "lower sum type match" {
    lb := "\{"
    rb := "\}"
    source := "mod test\ntype Color =\n    | Red\n    | Green\n    | Blue\nfn color_num(c: Color) -> i64 = match c " + lb + "\n    Red => 1\n    Green => 2\n    Blue => 3\n" + rb
    m := _lower_source(source)
    f := mod_find_func(m, "color_num")
    assert f.name == "color_num"
    assert func_inst_count(f) > 3
}

test "lower boolean operations" {
    source := "mod test\nfn both(a: bool, b: bool) -> bool = a && b"
    m := _lower_source(source)
    f := mod_find_func(m, "both")
    assert f.name == "both"
    assert f.param_count == 2
}

test "lower array literal" {
    lb := "\{"
    rb := "\}"
    source := "mod test\nfn nums() -> [i64] " + lb + "\n    xs := [1, 2, 3]\n    xs\n" + rb
    m := _lower_source(source)
    f := mod_find_func(m, "nums")
    assert f.name == "nums"
    assert func_inst_count(f) > 3
}

// --- IR validation tests ---

test "ir validate empty module" {
    m := new_ir_module()
    errors := validate_ir_module(m)
    assert errors.len() == 1  // only sentinel
}

test "ir validate valid function" {
    mut m := new_ir_module()
    mut f := new_ir_func("test_fn", 0, 1)
    f = func_add_inst(f, new_inst(OpConst, 0, 42, 0, "", 0))
    f = func_add_inst(f, new_inst(OpRet, 0, 0, 0, "", 0))
    f = func_set_locals(f, 1)
    m = mod_add_func(m, f)
    errors := validate_ir_module(m)
    assert errors.len() == 1  // only sentinel, no errors
}

test "ir validate bad jump target" {
    mut m := new_ir_module()
    mut f := new_ir_func("bad_fn", 0, 1)
    f = func_add_inst(f, new_inst(OpJump, 0, 999, 0, "", 0))
    f = func_add_inst(f, new_inst(OpRet, 0, 0, 0, "", 0))
    f = func_set_locals(f, 1)
    m = mod_add_func(m, f)
    errors := validate_ir_module(m)
    assert errors.len() > 1  // should have jump-to-undefined-label error
}

test "ir validate missing entry" {
    mut m := new_ir_module()
    m = mod_set_entry(m, "nonexistent")
    errors := validate_ir_module(m)
    assert errors.len() > 1  // should have missing entry error
}
