                if _lk(ll) == ")" { ll = _ladv(ll) }

                // For generic functions, infer specialization from argument types
                if fn_is_generic(sig) {
                    // Recursive TypeVar extraction handles multi-param generics
                    // like `fn wrap[T, U](f: fn() -> T!U)` where T and U come
                    // from nested Function/Result positions.
                    bindings := _resolve_generic_bindings(ll.store, ll.registry, sig, arg_types)
                    call_name = name
