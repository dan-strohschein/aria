mod codegen

// ============================================================
// Lowering — Token Stream to IR
// Multi-pass token walker (mirrors checker pattern).
// Pass 1: Collect type layouts (struct sizes, field offsets)
// Pass 2: Collect function signatures
// Pass 3: Lower function/entry/test bodies to IR
// ============================================================

use diagnostic
use lexer
use parser
use resolver
use checker

// --- Lowerer state ---

struct Lowerer {
    tokens: [Token]
    pos: i64
    store: TypeStore
    registry: TypeRegistry
    treg: TraitRegistry
    pool: NodePool
    table: SymbolTable
    file: str
    module: IrModule
    current_func: IrFunc
    temp_counter: i64
    label_counter: i64
    env_names: [str]
    env_slots: [i64]
    loop_start: i64
    loop_end: i64
    // Const pre-scan arrays
    const_names: [str]
    const_vals: [i64]
    const_str_names: [str]
    const_str_vals: [str]
    // Type tracking per temp: 0=unknown, 1=i64, 12=str, 100+=struct
    temp_types: [i64]
    // Shadow channel: 1 if temp holds a Result pointer (fallible call / Ok/Err ctor), 0 otherwise
    is_result: [i64]
    // Error type for current function (0 = not fallible)
    fn_error_type: i64
    // Defer tracking: token positions of deferred expressions (dynamic)
    defer_starts: [i64]
    defer_ends: [i64]
}

// --- Lowerer + temp result (like CE) ---

struct LT {
    l: Lowerer
    temp: i64
}

// --- Constructor ---

fn _new_lowerer(tokens: [Token], pool: NodePool, store: TypeStore, reg: TypeRegistry, treg: TraitRegistry, table: SymbolTable, file: str) -> Lowerer =
    Lowerer{
        tokens: tokens, pos: 0, store: store, registry: reg, treg: treg,
        pool: pool, table: table, file: file,
        module: new_ir_module(),
        current_func: _sentinel_func(),
        temp_counter: 0, label_counter: 0,
        env_names: [""], env_slots: [0],
        loop_start: -1, loop_end: -1,
        const_names: [""], const_vals: [0],
        const_str_names: [""], const_str_vals: [""],
        temp_types: [0],
        is_result: [0],
        fn_error_type: 0, defer_starts: [0], defer_ends: [0]
    }

// --- Helpers ---

fn _lcur(l: Lowerer) -> Token {
    if l.pos >= l.tokens.len() {
        return Token{kind: TkEof, text: "", line: 0, col: 0, offset: 0, name: "EOF", file: ""}
    }
    return l.tokens[l.pos]
}


fn _lk(l: Lowerer) -> str = _lcur(l).name

fn _ladv(l: Lowerer) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos + 1, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

// Skip pub modifier, including optional (pkg) scope qualifier
fn _lskip_pub(l: Lowerer) -> Lowerer {
    mut ll := l
    if _lk(ll) == "pub" {
        ll = _ladv(ll)
        if _lk(ll) == "(" {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" { ll = _ladv(ll) }
            if _lk(ll) == ")" { ll = _ladv(ll) }
        }
    }
    ll
}

fn _lset_reg(l: Lowerer, reg: TypeRegistry) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: reg, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lset_store(l: Lowerer, store: TypeStore) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lset_pos(l: Lowerer, pos: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lskip_nl(l: Lowerer) -> Lowerer {
    mut ll := l
    while _lk(ll) == "NEWLINE" { ll = _ladv(ll) }
    ll
}

fn _lnew_temp(l: Lowerer) -> LT {
    temp := l.temp_counter
    ll := Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
                  table: l.table, file: l.file, module: l.module,
                  current_func: l.current_func,
                  temp_counter: l.temp_counter + 1, label_counter: l.label_counter,
                  env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
    // Default new temps to type=0 (unknown/potential pointer). The lowerer
    // explicitly sets type=1 (scalar) for known integers and type=12 (str)
    // for strings. Unknown temps are conservatively treated as GC roots.
    LT{l: ll, temp: temp}
}

fn _lnew_label(l: Lowerer) -> LT {
    lbl := l.label_counter
    ll := Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
                  table: l.table, file: l.file, module: l.module,
                  current_func: l.current_func,
                  temp_counter: l.temp_counter, label_counter: l.label_counter + 1,
                  env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
    LT{l: ll, temp: lbl}
}

fn _lemit(l: Lowerer, inst: IrInst) -> Lowerer {
    new_func := func_add_inst(l.current_func, inst)
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: new_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

fn _lset_func(l: Lowerer, f: IrFunc) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: f,
            temp_counter: 0, label_counter: 0,
            env_names: [""], env_slots: [0],
            loop_start: -1, loop_end: -1,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: [0], is_result: [0],
            fn_error_type: 0, defer_starts: [0], defer_ends: [0]}

fn _lset_mod(l: Lowerer, m: IrModule) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: m,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lfinish_func(l: Lowerer) -> Lowerer {
    f0 := func_set_locals(l.current_func, l.temp_counter)
    f := func_set_temp_types(f0, l.temp_types)
    new_mod := mod_add_func(l.module, f)
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: new_mod,
            current_func: _sentinel_func(),
            temp_counter: 0, label_counter: l.label_counter,
            env_names: [""], env_slots: [0],
            loop_start: -1, loop_end: -1,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

fn _lset_loop(l: Lowerer, start: i64, end_l: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: start, loop_end: end_l,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lenv_add(l: Lowerer, name: str, slot: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names.append(name), env_slots: l.env_slots.append(slot),
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lenv_lookup(l: Lowerer, name: str) -> i64 {
    mut i := l.env_names.len() - 1
    while i > 0 {
        if l.env_names[i] == name { return l.env_slots[i] }
        i = i - 1
    }
    return -1
}

// Truncate the env back to a given size. Used by `with` blocks so the
// resource binding doesn't persist into the outer scope's drop pass.
fn _lenv_truncate(l: Lowerer, new_len: i64) -> Lowerer {
    mut names: [str] = [""]
    mut slots: [i64] = [0]
    mut i := 1
    while i < new_len && i < l.env_names.len() {
        names = names.append(l.env_names[i])
        slots = slots.append(l.env_slots[i])
        i = i + 1
    }
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: names, env_slots: slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

// Array/iterator pipeline ops whose implementations live only in the token-based
// _lower_method_call. The AST-based dispatch at method call sites seeks to `(`
// and delegates to _lower_method_call for these, so we don't have to duplicate
// 15+ method bodies in _lower_method_with_args.
fn _is_pipeline_method(method: str) -> bool {
    method == "filter" ||
    method == "map" ||
    method == "fold" ||
    method == "sort" ||
    method == "sort_by" ||
    method == "take" ||
    method == "skip" ||
    method == "count" ||
    method == "any" ||
    method == "all" ||
    method == "first" ||
    method == "last" ||
    method == "reverse" ||
    method == "collect" ||
    method == "collect_map" ||
    method == "flat_map" ||
    method == "zip" ||
    method == "unique" ||
    method == "enumerate"
}

// Shared impl for `.first()` / `.last()`. Returns an Option wrapping the head
// (want_first=true) or tail (want_first=false) of an array, or None when empty.
// Allocates a 2-slot Result/Option record: slot 0 is the tag (0=None, 1=Some),
// slot 1 is the payload. Empty check comes first to avoid OOB ArrayGet.
fn _lower_array_head(l: Lowerer, obj: i64, want_first: bool) -> LT {
    mut ll := l
    len_nt := _lnew_temp(ll)
    ll = len_nt.l
    ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
    zero := _lnew_temp(ll)
    ll = zero.l
    ll = _lemit(ll, new_inst(OpConst, zero.temp, 0, 0, "", 0))
    is_empty := _lnew_temp(ll)
    ll = is_empty.l
    ll = _lemit(ll, new_inst(OpEq, is_empty.temp, len_nt.temp, zero.temp, "", 0))
    // Allocate Option result (tag + payload). Register a canonical Optional<T>
    // type where T is the array's element type, so downstream consumers (interp,
    // match, eq) can format/compare the payload correctly instead of falling
    // back to "raw pointer" for the generic 201 sentinel.
    obj_type := _lget_type(ll, obj)
    elem_type := _array_elem_type(ll.store, obj_type)
    // Str payloads span 2 slots (ptr + len), so Option<str> wants 3 total.
    mut opt_slots := 2
    if elem_type == 12 { opt_slots = 3 }
    opt_nt := _lnew_temp(ll)
    ll = opt_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, opt_nt.temp, opt_slots, 0, "_Option", 0))
    if elem_type > 0 {
        opt_info := TypeInfo{kind: TyOptional, name: "", type_id: elem_type, type_id2: 0, param_start: 0, param_count: 0}
        sar := store_add_canonical(ll.store, opt_info)
        ll = _lset_store(ll, sar.store)
        ll = _lset_type(ll, opt_nt.temp, sar.id)
    } else {
        ll = _lset_type(ll, opt_nt.temp, 201)
    }
    none_lbl := _lnew_label(ll)
    ll = none_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_empty.temp, none_lbl.temp, "", 0))
    // Some path: compute index, read element, tag=1, payload=element.
    mut idx_temp := zero.temp
    if !want_first {
        one_c := _lnew_temp(ll)
        ll = one_c.l
        ll = _lemit(ll, new_inst(OpConst, one_c.temp, 1, 0, "", 0))
        last_idx := _lnew_temp(ll)
        ll = last_idx.l
        ll = _lemit(ll, new_inst(OpSub, last_idx.temp, len_nt.temp, one_c.temp, "", 0))
        idx_temp = last_idx.temp
    }
    elem := _lnew_temp(ll)
    ll = elem.l
    ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_temp, "", 0))
    some_tag := _lnew_temp(ll)
    ll = some_tag.l
    ll = _lemit(ll, new_inst(OpConst, some_tag.temp, 1, 0, "", 0))
    ll = _lemit(ll, new_inst(OpFieldSet, opt_nt.temp, some_tag.temp, 0, "_tag", 0))
    ll = _lemit(ll, new_inst(OpFieldSet, opt_nt.temp, elem.temp, 1, "_val", 0))
    ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
    // None path: tag=0, leave payload 0.
    ll = _lemit(ll, new_inst(OpLabel, 0, none_lbl.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpFieldSet, opt_nt.temp, zero.temp, 0, "_tag", 0))
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    LT{l: ll, temp: opt_nt.temp}
}

// Emit a warning for unresolved lookups during lowering (DRY: single warning format)
// Suppresses false positives for diagnostic codes (E0100, W0009)
fn _warn_unresolved(l: Lowerer, kind: str, name: str) {
    mut suppress := false
    if name.len() > 0 {
        ch := name.charAt(0)
        if ch == "E" || ch == "W" { suppress = true }
    }
    if suppress == false {
        println(l.file + ":" + i2s(_lcur(l).line) + ": warning: unresolved " + kind + " '" + name + "'")
    }
}

// --- Additional DRY helpers (SRP: each changes exactly one field group) ---

fn _lset_error_type(l: Lowerer, et: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: et, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _ladd_const(l: Lowerer, name: str, val: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names.append(name), const_vals: l.const_vals.append(val),
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

