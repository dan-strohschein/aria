        ll = cm_cmp.l
        ll = _lemit(ll, new_inst(OpLt, cm_cmp.temp, cm_idx.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cm_cmp.temp, cm_end.temp, "", 0))
        // pair = arr[i]
        pair_nt := _lnew_temp(ll)
        ll = pair_nt.l
        ll = _lemit(ll, new_inst(OpArrayGet, pair_nt.temp, obj, cm_idx.temp, "", 0))
        // Extract key + value. Fall back to slot 2 when key is str (the
        // common case) since _tuple_slot returns elem_idx for unknown
        // tuple types, which would collide with the str len slot.
        mut val_slot := _tuple_slot(ll.store, elem_type, 1)
        key_nt := _lnew_temp(ll)
        ll = key_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, key_nt.temp, pair_nt.temp, 0, "_0", 0))
        if key_is_str {
            ll = _lset_type(ll, key_nt.temp, 12)
            klen_nt := _lnew_temp(ll)
            ll = klen_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, klen_nt.temp, pair_nt.temp, 1, "_0_len", 0))
            if val_slot < 2 { val_slot = 2 }
        }
        val_nt := _lnew_temp(ll)
        ll = val_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp, pair_nt.temp, val_slot, "_1", 0))
        ll = _lemit(ll, new_inst(OpMapSet, 0, map_nt.temp, key_nt.temp, "", val_nt.temp))
        // i = i + 1
        cm_one := _lnew_temp(ll)
        ll = cm_one.l
        ll = _lemit(ll, new_inst(OpConst, cm_one.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, cm_idx.temp, cm_idx.temp, cm_one.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, cm_loop.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, cm_end.temp, 0, "", 0))
        return LT{l: ll, temp: map_nt.temp}
    }

    // count() — return array length
    if method == "count" {
        if _lk(ll) == ")" { ll = _ladv(ll) }
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        ll = _lset_type(ll, len_nt.temp, 1)
        return LT{l: ll, temp: len_nt.temp}
    }

    // reverse() — new array with elements in reverse order
    // Uses forward loop i=0..len computing rev_idx = len-1-i
    if method == "reverse" {
        if _lk(ll) == ")" { ll = _ladv(ll) }
        obj_type := _lget_type(ll, obj)
        new_arr := _lnew_temp(ll)
        ll = new_arr.l
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 8, 0, "", 0))
        ll = _lemit(ll, new_inst(OpArrayNew, new_arr.temp, cap_nt.temp, 0, "", 0))
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp_nt := _lnew_temp(ll)
        ll = cmp_nt.l
        ll = _lemit(ll, new_inst(OpLt, cmp_nt.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, end_lbl.temp, "", 0))
        // rev_idx = len - 1 - i
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        rev_idx := _lnew_temp(ll)
        ll = rev_idx.l
        ll = _lemit(ll, new_inst(OpSub, rev_idx.temp, len_nt.temp, one_nt.temp, "", 0))
        rev_idx2 := _lnew_temp(ll)
        ll = rev_idx2.l
        ll = _lemit(ll, new_inst(OpSub, rev_idx2.temp, rev_idx.temp, idx_nt.temp, "", 0))
        elem_nt := _lnew_temp(ll)
        ll = elem_nt.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, obj, rev_idx2.temp, "", 0))
        ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, new_arr.temp, elem_nt.temp, "", 0))
        inc_nt := _lnew_temp(ll)
        ll = inc_nt.l
        ll = _lemit(ll, new_inst(OpConst, inc_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        if obj_type > 0 { ll = _lset_type(ll, new_arr.temp, obj_type) }
        return LT{l: ll, temp: new_arr.temp}
    }

    // take(n) — first n elements
    if method == "take" {
        obj_type := _lget_type(ll, obj)
        n_expr := _lower_expr(ll)
        ll = n_expr.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        new_arr := _lnew_temp(ll)
        ll = new_arr.l
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 8, 0, "", 0))
        ll = _lemit(ll, new_inst(OpArrayNew, new_arr.temp, cap_nt.temp, 0, "", 0))
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp1 := _lnew_temp(ll)
        ll = cmp1.l
        ll = _lemit(ll, new_inst(OpLt, cmp1.temp, idx_nt.temp, n_expr.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp1.temp, end_lbl.temp, "", 0))
        cmp2 := _lnew_temp(ll)
        ll = cmp2.l
        ll = _lemit(ll, new_inst(OpLt, cmp2.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp2.temp, end_lbl.temp, "", 0))
        elem := _lnew_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, new_arr.temp, elem.temp, "", 0))
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        if obj_type > 0 { ll = _lset_type(ll, new_arr.temp, obj_type) }
        return LT{l: ll, temp: new_arr.temp}
    }

    // skip(n) — skip first n elements
    if method == "skip" {
        obj_type := _lget_type(ll, obj)
        n_expr := _lower_expr(ll)
        ll = n_expr.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        new_arr := _lnew_temp(ll)
        ll = new_arr.l
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 8, 0, "", 0))
        ll = _lemit(ll, new_inst(OpArrayNew, new_arr.temp, cap_nt.temp, 0, "", 0))
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, n_expr.temp, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        elem := _lnew_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, new_arr.temp, elem.temp, "", 0))
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        if obj_type > 0 { ll = _lset_type(ll, new_arr.temp, obj_type) }
        return LT{l: ll, temp: new_arr.temp}
    }

    // first() — return first element (index 1 due to sentinel at 0)
    // first() — return Some(arr[0]) or None for empty array.
    // Previously wrote arr[1] and returned a raw scalar — crashed on empty and
    // passed the wrong index on non-empty. `.ok_or(...)` / `.unwrap_or(...)` /
    // match callers all expect an Option.
    if method == "first" {
        if _lk(ll) == ")" { ll = _ladv(ll) }
        return _lower_array_head(ll, obj, true)
    }

    // last() — return Some(arr[len-1]) or None. Same shape as first().
    if method == "last" {
        if _lk(ll) == ")" { ll = _ladv(ll) }
        return _lower_array_head(ll, obj, false)
    }

    // fold(init, fn) — accumulator loop: acc = fn(acc, elem) for each element
    if method == "fold" {
        init := _lower_expr(ll)
        ll = init.l
        if _lk(ll) == "," { ll = _ladv(ll) }
        ll = _lskip_nl(ll)
        reducer := _lower_expr(ll)
        ll = reducer.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // acc = init
        acc_nt := _lnew_temp(ll)
        ll = acc_nt.l
        ll = _lemit(ll, new_inst(OpStore, acc_nt.temp, init.temp, 0, "", 0))
        init_type := _lget_type(ll, init.temp)
        if init_type > 0 { ll = _lset_type(ll, acc_nt.temp, init_type) }
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        elem := _lnew_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 0))
        if _is_float_type(init_type) {
            // f64 fast path: inline float add instead of closure call
            ll = _lset_type(ll, elem.temp, 9)
            ll = _lemit(ll, new_inst(OpAdd, acc_nt.temp, acc_nt.temp, elem.temp, "f64", 0))
        } else {
            // General path: call reducer closure
            fn_ptr := _lnew_temp(ll)
            ll = fn_ptr.l
            ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr.temp, reducer.temp, 0, "", 0))
            arg_s := _lnew_temp(ll)
            ll = arg_s.l
            arg_a := _lnew_temp(ll)
            ll = arg_a.l
            arg_e := _lnew_temp(ll)
            ll = arg_e.l
            env_p := _lnew_temp(ll)
            ll = env_p.l
            ll = _lemit(ll, new_inst(OpFieldGet, env_p.temp, reducer.temp, 1, "", 0))
            ll = _lemit(ll, new_inst(OpStore, arg_s.temp, env_p.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, arg_a.temp, acc_nt.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, arg_e.temp, elem.temp, 0, "", 0))
            result_nt := _lnew_temp(ll)
            ll = result_nt.l
            ll = _lemit(ll, new_inst(OpCallIndirect, result_nt.temp, fn_ptr.temp, 3, "", arg_s.temp))
            ll = _lemit(ll, new_inst(OpStore, acc_nt.temp, result_nt.temp, 0, "", 0))
        }
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: acc_nt.temp}
    }

    // any(fn) — true if predicate is true for any element
    if method == "any" {
        pred := _lower_expr(ll)
        ll = pred.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        result_nt := _lnew_temp(ll)
        ll = result_nt.l
        ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        elem := _lnew_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 0))
        fn_ptr := _lnew_temp(ll)
        ll = fn_ptr.l
        ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr.temp, pred.temp, 0, "", 0))
        arg_s := _lnew_temp(ll)
        ll = arg_s.l
        arg_e := _lnew_temp(ll)
        ll = arg_e.l
        env_p := _lnew_temp(ll)
        ll = env_p.l
        ll = _lemit(ll, new_inst(OpFieldGet, env_p.temp, pred.temp, 1, "", 0))
        ll = _lemit(ll, new_inst(OpStore, arg_s.temp, env_p.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, arg_e.temp, elem.temp, 0, "", 0))
        call_nt := _lnew_temp(ll)
        ll = call_nt.l
        ll = _lemit(ll, new_inst(OpCallIndirect, call_nt.temp, fn_ptr.temp, 2, "", arg_s.temp))
        skip_lbl := _lnew_label(ll)
        ll = skip_lbl.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, call_nt.temp, skip_lbl.temp, "", 0))
        ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 11)
        return LT{l: ll, temp: result_nt.temp}
    }

    // all(fn) — true if predicate is true for all elements
    if method == "all" {
        pred := _lower_expr(ll)
        ll = pred.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        result_nt := _lnew_temp(ll)
        ll = result_nt.l
        ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 1, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        elem := _lnew_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 0))
        fn_ptr := _lnew_temp(ll)
        ll = fn_ptr.l
        ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr.temp, pred.temp, 0, "", 0))
        arg_s := _lnew_temp(ll)
        ll = arg_s.l
        arg_e := _lnew_temp(ll)
        ll = arg_e.l
        env_p := _lnew_temp(ll)
        ll = env_p.l
        ll = _lemit(ll, new_inst(OpFieldGet, env_p.temp, pred.temp, 1, "", 0))
        ll = _lemit(ll, new_inst(OpStore, arg_s.temp, env_p.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, arg_e.temp, elem.temp, 0, "", 0))
        call_nt := _lnew_temp(ll)
        ll = call_nt.l
        ll = _lemit(ll, new_inst(OpCallIndirect, call_nt.temp, fn_ptr.temp, 2, "", arg_s.temp))
        cont_lbl := _lnew_label(ll)
        ll = cont_lbl.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, call_nt.temp, cont_lbl.temp, "", 0))
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, cont_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 11)
        return LT{l: ll, temp: result_nt.temp}
    }

    // join(sep) — concatenate array of strings with separator
    if method == "join" {
        sep := _lower_expr(ll)
        ll = sep.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Start with empty string
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        empty_idx := mod_find_string(ll.module, "")
        mut em_idx := empty_idx
        if em_idx == 0 {
            new_mod := mod_add_string(ll.module, "")
            em_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        ll = _lemit(ll, new_inst(OpConstStr, result_nt.temp, em_idx, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 12)
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        first_nt := _lnew_temp(ll)
        ll = first_nt.l
        ll = _lemit(ll, new_inst(OpConst, first_nt.temp, 1, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        // If not first, append separator
        is_first := _lnew_temp(ll)
        ll = is_first.l
        ll = _lemit(ll, new_inst(OpEq, is_first.temp, idx_nt.temp, first_nt.temp, "", 0))
        skip_sep := _lnew_label(ll)
        ll = skip_sep.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_first.temp, skip_sep.temp, "", 0))
        // Not first: concat separator
        sep_cat := _lnew_str_temp(ll)
        ll = sep_cat.l
        ll = _lemit(ll, new_inst(OpStrConcat, sep_cat.temp, result_nt.temp, sep.temp, "", 0))
        ll = _lset_type(ll, sep_cat.temp, 12)
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, sep_cat.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, sep_cat.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, skip_sep.temp, 0, "", 0))
        // Get element (string from array)
        elem := _lnew_str_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 12))
        ll = _lset_type(ll, elem.temp, 12)
        // Concat element
        cat := _lnew_str_temp(ll)
        ll = cat.l
        ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, result_nt.temp, elem.temp, "", 0))
        ll = _lset_type(ll, cat.temp, 12)
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, cat.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, cat.temp + 1, 0, "", 0))
        // Increment
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 12)
        return LT{l: ll, temp: result_nt.temp}
    }

    // sort_by(fn, ...) / sort() — consume args and return array unchanged (stub)
    if method == "sort" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_array_sort", 0))
        obj_type := _lget_type(ll, obj)
        if obj_type > 0 { ll = _lset_type(ll, nt.temp, obj_type) }
        return LT{l: ll, temp: nt.temp}
    }
    if method == "sort_by" {
        // Lower the key extractor closure
        key_fn := _lower_expr(ll)
        ll = key_fn.l
        // Check for `descending: true` named arg
        mut desc_val := 0
        if _lk(ll) == "," {
            ll = _ladv(ll)
            ll = _lskip_nl(ll)
            if _lk(ll) == "IDENT" && _lcur(ll).text == "descending" {
                ll = _ladv(ll)  // skip "descending"
                if _lk(ll) == ":" { ll = _ladv(ll) }  // skip ":"
                if _lk(ll) == "true" { desc_val = 1 }
                if _lk(ll) == "true" || _lk(ll) == "false" { ll = _ladv(ll) }
            }
        }
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Extract fn_ptr and env from closure struct
        fn_ptr := _lnew_temp(ll)
        ll = fn_ptr.l
        ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr.temp, key_fn.temp, 0, "", 0))
        env_ptr := _lnew_temp(ll)
        ll = env_ptr.l
        ll = _lemit(ll, new_inst(OpFieldGet, env_ptr.temp, key_fn.temp, 1, "", 0))
        desc_nt := _lnew_temp(ll)
        ll = desc_nt.l
        ll = _lemit(ll, new_inst(OpConst, desc_nt.temp, desc_val, 0, "", 0))
        // Pack args: arr, fn_ptr, env_ptr, descending in consecutive temps
        arg0 := _lnew_temp(ll)
        ll = arg0.l
        ll = _lemit(ll, new_inst(OpStore, arg0.temp, obj, 0, "", 0))
        arg1 := _lnew_temp(ll)
        ll = arg1.l
        ll = _lemit(ll, new_inst(OpStore, arg1.temp, fn_ptr.temp, 0, "", 0))
        arg2 := _lnew_temp(ll)
        ll = arg2.l
        ll = _lemit(ll, new_inst(OpStore, arg2.temp, env_ptr.temp, 0, "", 0))
        arg3 := _lnew_temp(ll)
        ll = arg3.l
        ll = _lemit(ll, new_inst(OpStore, arg3.temp, desc_nt.temp, 0, "", 0))
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, arg0.temp, 4, "_aria_array_sort_by_key", 0))
        obj_type := _lget_type(ll, obj)
        if obj_type > 0 { ll = _lset_type(ll, nt.temp, obj_type) }
        return LT{l: ll, temp: nt.temp}
    }

    if method == "append" {
        elem := _lower_expr(ll)
        ll = elem.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        // Pack string elements when element type is str
        obj_type := _lget_type(ll, obj)
        elem_type := _lget_type(ll, elem.temp)
        if elem_type == 12 || obj_type == 13 {
            ll = _lemit(ll, new_inst(OpArrayAppend, nt.temp, obj, elem.temp, "", 12))
            ll = _lset_type(ll, nt.temp, 13)
        } else {
            ll = _lemit(ll, new_inst(OpArrayAppend, nt.temp, obj, elem.temp, "", 0))
            if obj_type > 0 {
                ll = _lset_type(ll, nt.temp, obj_type)
            }
        }
        return LT{l: ll, temp: nt.temp}
    }

    if method == "contains" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        mc_obj_type := _lget_type(ll, obj)
        if mc_obj_type == 12 {
            ll = _lemit(ll, new_inst(OpStrContains, nt.temp, obj, arg.temp, "", 0))
        } else {
            ll = _lemit(ll, new_inst(OpArrayContains, nt.temp, obj, arg.temp, "", 0))
        }
        ll = _lset_type(ll, nt.temp, 11)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "charAt" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrCharAt, nt.temp, obj, arg.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "startsWith" || method == "starts_with" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrStartsWith, nt.temp, obj, arg.temp, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if method == "endsWith" || method == "ends_with" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrEndsWith, nt.temp, obj, arg.temp, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if method == "indexOf" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrIndexOf, nt.temp, obj, arg.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "trim" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrTrim, nt.temp, obj, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    // `is_alphanum()` — true iff every char is [A-Za-z0-9_]; empty str → false.
    if method == "is_alphanum" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrIsAlphanum, nt.temp, obj, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    // Option.ok_or(err) — convert Option<T> to Result<T, E>.
    // Some(v) -> Ok(v); None -> Err(err_arg).
    if method == "ok_or" {
        err_arg := _lower_expr(ll)
        ll = err_arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Determine if err and/or ok payloads are str — Result uses 3 slots
        // whenever either side carries a fat-pointer str.
        err_is_str := _lget_type(ll, err_arg.temp) == 12
        obj_type := _lget_type(ll, obj)
        mut ok_is_str := false
        if obj_type > 16 && obj_type < ll.store.types.len() {
            oi := store_get(ll.store, obj_type)
            if type_kind_name(oi.kind) == "Optional" && oi.type_id == 12 { ok_is_str = true }
        }
        mut slots := 2
        if err_is_str || ok_is_str { slots = 3 }
        // Read tag of the Option (slot 0)
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, obj, 0, "_tag", 0))
        zero_nt := _lnew_temp(ll)
        ll = zero_nt.l
        ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        is_some := _lnew_temp(ll)
        ll = is_some.l
        ll = _lemit(ll, new_inst(OpEq, is_some.temp, tag_nt.temp, one_nt.temp, "", 0))
        result := _lnew_temp(ll)
        ll = result.l
        ll = _lemit(ll, new_inst(OpAlloc, result.temp, slots, 0, "_Result", 0))
        some_lbl := _lnew_label(ll)
        ll = some_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_some.temp, some_lbl.temp, "", 0))
        // None path: Err(err_arg)
        ll = _lemit(ll, new_inst(OpFieldSet, result.temp, one_nt.temp, 0, "_tag", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, result.temp, err_arg.temp, 1, "_val", 0))
        if err_is_str {
            err_len := err_arg.temp + 1
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, err_len, 2, "_val_len", 0))
        } else if slots == 3 {
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 2, "_val_len", 0))
        }
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        // Some path: Ok(obj.val)
        ll = _lemit(ll, new_inst(OpLabel, 0, some_lbl.temp, 0, "", 0))
        if ok_is_str {
            val_nt := _lnew_str_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp, obj, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp + 1, obj, 2, "_val_len", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_nt.temp, 1, "_val", 0))
            val_len := val_nt.temp + 1
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_len, 2, "_val_len", 0))
        } else {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp, obj, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_nt.temp, 1, "_val", 0))
            if slots == 3 {
                ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 2, "_val_len", 0))
            }
        }
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_is_result(ll, result.temp)
        return LT{l: ll, temp: result.temp}
    }

    if method == "replace" {
        old_arg := _lower_expr(ll)
        ll = old_arg.l
        if _lk(ll) == "," { ll = _ladv(ll) }
        new_arg := _lower_expr(ll)
        ll = new_arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrReplace, nt.temp, obj, old_arg.temp, "", new_arg.temp))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "toLower" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrToLower, nt.temp, obj, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "toUpper" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrToUpper, nt.temp, obj, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "split" {
        arg := _lower_expr(ll)
        ll = arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrSplit, nt.temp, obj, arg.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 13)
        return LT{l: ll, temp: nt.temp}
    }

    // `lines()` — split on newline. Equivalent to `split("\n")`.
    if method == "lines" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        sep := _lower_string_const(ll, "\n")
        ll = sep.l
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrSplit, nt.temp, obj, sep.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 13)
        return LT{l: ll, temp: nt.temp}
    }

    // `split_whitespace()` — split on single space (simple approximation).
    // Good enough for word-count style usage in examples.
    if method == "split_whitespace" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        sep := _lower_string_const(ll, " ")
        ll = sep.l
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrSplit, nt.temp, obj, sep.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 13)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "substring" {
        start := _lower_expr(ll)
        ll = start.l
        if _lk(ll) == "," { ll = _ladv(ll) }
        end := _lower_expr(ll)
        ll = end.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        // Pass end temp via type_id field
        ll = _lemit(ll, new_inst(OpStrSubstring, nt.temp, obj, start.temp, "", end.temp))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "repeat" {
        n_arg := _lower_expr(ll)
        ll = n_arg.l
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrRepeat, nt.temp, obj, n_arg.temp, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    // `.to_json()` on a struct tagged `@[derive(Json)]` — the derive
    // emits `<T>_to_json(self)` in `_lower_derives`, so we dispatch via
    // a direct OpCall. The user fn registry doesn't have it yet (derives
    // run after body lowering), which is why the generic method-dispatch
    // path below wouldn't find it.
    if method == "to_json" {
        obj_type_jt := _lget_type(ll, obj)
        sname_jt := _struct_name_for_type(ll.store, ll.registry, obj_type_jt)
        if sname_jt != "" && treg_has_impl(ll.treg, sname_jt, "Json") {
            while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
            if _lk(ll) == ")" { ll = _ladv(ll) }
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, sname_jt + "_to_json", 12))
            ll = _lset_type(ll, nt.temp, 12)
            return LT{l: ll, temp: nt.temp}
        }
    }

    if method == "debug_str" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Generate debug string: "TypeName{field1: val1, field2: val2}"
        obj_type := _lget_type(ll, obj)
        sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
        if sname != "" {
            def := reg_find_struct(ll.registry, sname)
            // Start with struct name + "{"
            mut hdr_idx := mod_find_string(ll.module, sname + "\{")
            if hdr_idx == 0 {
                new_mod := mod_add_string(ll.module, sname + "\{")
                hdr_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            hdr_len := sname.len() + 1
            result_nt := _lnew_str_temp(ll)
            ll = result_nt.l
            ll = _lemit(ll, new_inst(OpConstStr, result_nt.temp, hdr_idx, hdr_len, "", 0))
            ll = _lset_type(ll, result_nt.temp, 12)

            // For each field, append "name: " + value
            mut fi := 1
            mut field_slot := 0
            while fi < def.fields.len() {
                fld := def.fields[fi]
                ft := fld.type_id
                // Add separator ", " for second+ fields
                if fi > 1 {
                    mut sep_idx := mod_find_string(ll.module, ", ")
                    if sep_idx == 0 {
                        new_mod := mod_add_string(ll.module, ", ")
                        sep_idx = new_mod.string_constants.len() - 1
                        ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                                     table: ll.table, file: ll.file, module: new_mod,
                                     current_func: ll.current_func,
                                     temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                                     env_names: ll.env_names, env_slots: ll.env_slots,
                                     loop_start: ll.loop_start, loop_end: ll.loop_end,
                                     const_names: ll.const_names, const_vals: ll.const_vals,
                                     const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                                     temp_types: ll.temp_types, is_result: ll.is_result,
                                     fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
                    }
                    sep_nt := _lnew_str_temp(ll)
                    ll = sep_nt.l
                    ll = _lemit(ll, new_inst(OpConstStr, sep_nt.temp, sep_idx, 2, "", 0))
                    concat_nt := _lnew_str_temp(ll)
                    ll = concat_nt.l
                    ll = _lemit(ll, new_inst(OpStrConcat, concat_nt.temp, result_nt.temp, sep_nt.temp, "", 0))
                    result_nt = concat_nt
                }
                // Add "fieldname: "
                fname_str := fld.name + ": "
                mut fname_idx := mod_find_string(ll.module, fname_str)
                if fname_idx == 0 {
                    new_mod := mod_add_string(ll.module, fname_str)
                    fname_idx = new_mod.string_constants.len() - 1
                    ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                                 table: ll.table, file: ll.file, module: new_mod,
                                 current_func: ll.current_func,
                                 temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                                 env_names: ll.env_names, env_slots: ll.env_slots,
                                 loop_start: ll.loop_start, loop_end: ll.loop_end,
                                 const_names: ll.const_names, const_vals: ll.const_vals,
                                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                                 temp_types: ll.temp_types, is_result: ll.is_result,
                                 fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
                }
                fname_nt := _lnew_str_temp(ll)
                ll = fname_nt.l
                ll = _lemit(ll, new_inst(OpConstStr, fname_nt.temp, fname_idx, fname_str.len(), "", 0))
                c1 := _lnew_str_temp(ll)
                ll = c1.l
                ll = _lemit(ll, new_inst(OpStrConcat, c1.temp, result_nt.temp, fname_nt.temp, "", 0))

                // Get field value as string
                if ft == 12 {
                    // String field — get ptr+len and concat directly
                    fval := _lnew_str_temp(ll)
                    ll = fval.l
                    ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, obj, field_slot, fld.name, 0))
                    fidx_len := field_slot + 1
                    ll = _lemit(ll, new_inst(OpFieldGet, fval.temp + 1, obj, fidx_len, fld.name, 0))
                    c2 := _lnew_str_temp(ll)
                    ll = c2.l
                    ll = _lemit(ll, new_inst(OpStrConcat, c2.temp, c1.temp, fval.temp, "", 0))
                    result_nt = c2
                    field_slot = field_slot + 2
                } else {
                    // Numeric field — convert to string then concat
                    fval := _lnew_temp(ll)
                    ll = fval.l
                    ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, obj, field_slot, fld.name, 0))
                    fstr := _lnew_str_temp(ll)
                    ll = fstr.l
                    ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, fval.temp, 0, "", 0))
                    c2 := _lnew_str_temp(ll)
                    ll = c2.l
                    ll = _lemit(ll, new_inst(OpStrConcat, c2.temp, c1.temp, fstr.temp, "", 0))
                    result_nt = c2
                    field_slot = field_slot + 1
                }
                fi = fi + 1
            }

            // Add closing "}"
            mut close_idx := mod_find_string(ll.module, "\}")
            if close_idx == 0 {
                new_mod := mod_add_string(ll.module, "\}")
                close_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            close_nt := _lnew_str_temp(ll)
            ll = close_nt.l
            ll = _lemit(ll, new_inst(OpConstStr, close_nt.temp, close_idx, 1, "", 0))
            final_nt := _lnew_str_temp(ll)
            ll = final_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, final_nt.temp, result_nt.temp, close_nt.temp, "", 0))
            ll = _lset_type(ll, final_nt.temp, 12)
            return LT{l: ll, temp: final_nt.temp}
        }
        // Unknown struct — return empty string
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if method == "toString" || method == "toStr" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        obj_type := _lget_type(ll, obj)
        if obj_type == 12 {
            // Already a string — just return it
            return LT{l: ll, temp: obj}
        }
        if _is_float_type(obj_type) {
            ll = _lemit(ll, new_inst(OpIntToStr, nt.temp, obj, 0, "f64", 0))
        } else {
            ll = _lemit(ll, new_inst(OpIntToStr, nt.temp, obj, 0, "", 0))
        }
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    // Check for trait object dispatch (dyn Trait)
    dyn_obj_type := _lget_type(ll, obj)
    if dyn_obj_type == 500 {
        // Trait object — dispatch via vtable
        // Find the method's index in the trait's method list
        // We need to find which trait this object implements. Check all trait defs
        // for one that has this method.
        mut method_idx := 0
        mut ti := 1
        while ti < ll.treg.trait_defs.len() {
            tdef := ll.treg.trait_defs[ti]
            mut mi2 := 1
            while mi2 < tdef.method_names.len() {
                if tdef.method_names[mi2] == method {
                    method_idx = mi2 - 1
                }
                mi2 = mi2 + 1
            }
            ti = ti + 1
        }
        // Lower additional args beyond self
        mut extra_arg_temps := [0]
        mut extra_count := 0
        while _lk(ll) != ")" && _lk(ll) != "EOF" {
            ll = _lskip_nl(ll)
            if _lk(ll) == ")" { return LT{l: ll, temp: 0} }
            arg := _lower_expr(ll)
            ll = arg.l
            extra_arg_temps = extra_arg_temps.append(arg.temp)
            extra_count = extra_count + 1
            ll = _lskip_nl(ll)
            if _lk(ll) == "," { ll = _ladv(ll) }
        }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Look up the method's return type from any impl FnSig in the registry
        // to correctly allocate the result temp and generate the LLVM call signature.
        mut m_ret := 0
        mut fi := 1
        while fi < ll.registry.fn_sigs.len() {
            sig := ll.registry.fn_sigs[fi]
            // Function names are "TypeName_methodName" for impls
            slen := method.len()
            nlen := sig.name.len()
            if nlen > slen + 1 {
                suffix := sig.name.substring(nlen - slen - 1, nlen)
                if suffix == "_" + method {
                    m_ret = sig.return_type
                    fi = ll.registry.fn_sigs.len()
                }
            }
            fi = fi + 1
        }
        mut nt_temp := 0
        if m_ret == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
            if m_ret > 0 { ll = _lset_type(ll, nt.temp, m_ret) }
        }
        // type_id now holds return type (was extra_count, but extra_count is usually 0 for self-only methods)
        ll = _lemit(ll, new_inst(OpVtableCall, nt_temp, obj, method_idx, method, m_ret))
        return LT{l: ll, temp: nt_temp}
    }

    // Try user-defined method: qualified name first (Type_method), then plain name
    // Determine object type for qualified lookup
    obj_type := _lget_type(ll, obj)
    obj_sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
    mut qualified_method := method
    if obj_sname != "" {
        qualified_method = obj_sname + "_" + method
    }
    mut method_sig := reg_find_fn(ll.registry, qualified_method)
    // Specialized receiver (Box_i64) falling back to base method (Box_size).
    if method_sig.name == "" && obj_sname != "" {
        base_name := _base_generic_name(obj_sname)
        if base_name != obj_sname {
            base_qualified := base_name + "_" + method
            base_fallback := reg_find_fn(ll.registry, base_qualified)
            if base_fallback.name != "" {
                method_sig = base_fallback
                qualified_method = base_qualified
            }
        }
    }
    if method_sig.name == "" {
        // Fallback to plain method name
        method_sig = reg_find_fn(ll.registry, method)
        qualified_method = method
    }
    // Blanket impl dispatch: if method still not found, check if the object's type
    // implements a trait that has a blanket impl providing this method.
    if method_sig.name == "" && obj_sname != "" {
        // Look through all impls. If there's a blanket impl "*BoundTrait" that provides
        // this method, and obj_sname implements BoundTrait, use the blanket impl's method.
        mut ii := 1
        while ii < ll.treg.impl_defs.len() {
            bimp := ll.treg.impl_defs[ii]
            // Blanket impls have type_name starting with "*"
            if bimp.type_name.len() > 1 && bimp.type_name.charAt(0) == "*" {
                bound := bimp.type_name.substring(1, bimp.type_name.len())
                // Check if obj_sname has impl for the blanket's bound trait
                if treg_has_impl(ll.treg, obj_sname, bound) {
                    // Prefer specialized blanket method: "_method_ConcreteType"
                    // These aren't in the registry; check the module directly.
                    spec_fn := "_" + method + "_" + obj_sname
                    spec_fn_check := mod_find_func(ll.module, spec_fn)
                    if spec_fn_check.name != "" {
                        // Use the generic blanket's sig but with the specialized name
                        blanket_fn := "_" + method
                        method_sig = reg_find_fn(ll.registry, blanket_fn)
                        if method_sig.name != "" {
                            qualified_method = spec_fn
                            ii = ll.treg.impl_defs.len()
                        }
                    } else {
                        // Fall back to generic blanket method "_method"
                        blanket_fn := "_" + method
                        method_sig = reg_find_fn(ll.registry, blanket_fn)
                        if method_sig.name != "" {
                            qualified_method = blanket_fn
                            ii = ll.treg.impl_defs.len()
                        }
                    }
                }
            }
            ii = ii + 1
        }
    }
    if method_sig.name != "" {
        // Call as method: obj is first arg (self)
        mut first_arg := obj
        mut arg_count := 1
        while _lk(ll) != ")" && _lk(ll) != "EOF" {
            ll = _lskip_nl(ll)
            if _lk(ll) == ")" { return LT{l: _ladv(ll), temp: obj} }
            arg := _lower_expr(ll)
            ll = arg.l
            arg_count = arg_count + 1
            ll = _lskip_nl(ll)
            if _lk(ll) == "," { ll = _ladv(ll) }
        }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        // Generic method specialization: infer type args from call args
        if fn_is_generic(method_sig) {
            // Try blanket-specialized variant: "_method_ConcreteType"
            if obj_sname != "" {
                bspec := "_" + method + "_" + obj_sname
                bsig := reg_find_fn(ll.registry, bspec)
                if bsig.name != "" && fn_is_generic(bsig) {
                    method_sig = bsig
                    qualified_method = bspec
                }
            }
            // Infer U from arg types (self is first_arg, user args follow)
            mut resolved_suffix := ""
            mut gi := 2
            while gi < method_sig.param_types.len() && gi < arg_count + 1 {
                pt := method_sig.param_types[gi]
                if pt > 0 && pt < ll.store.types.len() {
                    ptinfo := store_get(ll.store, pt)
                    if type_kind_name(ptinfo.kind) == "TypeVar" {
                        at := _lget_type(ll, first_arg + gi - 1)
                        suffix := _type_name_suffix_l(ll.store, ll.registry, at)
                        if resolved_suffix == "" { resolved_suffix = suffix }
                    }
                }
                gi = gi + 1
            }
            if resolved_suffix != "" {
                spec_call := qualified_method + "_" + resolved_suffix
                sp := reg_find_fn(ll.registry, spec_call)
                if sp.name != "" {
                    qualified_method = spec_call
                    method_sig = sp
                } else {
                    // Create MonoSpec + specialized FnSig for the mono pass
                    at := _lget_type(ll, first_arg + 1)
                    sp_ptypes := [0]
                    mut spi := 1
                    while spi < method_sig.param_types.len() {
                        mut pt := method_sig.param_types[spi]
                        // Substitute TypeVar with concrete arg type
                        if pt > 0 && pt < ll.store.types.len() {
                            pti := store_get(ll.store, pt)
                            if type_kind_name(pti.kind) == "TypeVar" { pt = at }
                        }
                        sp_ptypes = sp_ptypes.append(pt)
                        spi = spi + 1
                    }
                    mut sp_ret := method_sig.return_type
                    if sp_ret > 0 && sp_ret < ll.store.types.len() {
                        rti := store_get(ll.store, sp_ret)
                        if type_kind_name(rti.kind) == "TypeVar" { sp_ret = at }
                    }
                    new_sig := new_fn_sig(spec_call, method_sig.param_names, sp_ptypes, sp_ret, method_sig.error_type)
                    ll = _lset_reg(ll, reg_add_fn(ll.registry, new_sig))
                    spec := MonoSpec{generic_name: qualified_method, specialized_name: spec_call,
                                     type_arg_0: at, type_arg_1: 0, type_arg_2: 0}
                    ll = _lset_reg(ll, reg_add_mono(ll.registry, spec))
                    qualified_method = spec_call
                    method_sig = new_sig
                }
            }
        }
        // Use _lnew_str_temp for string return types (2 consecutive slots)
        mut nt_temp := 0
        if method_sig.return_type == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
        }
        ll = _lemit(ll, new_inst(OpCall, nt_temp, first_arg, arg_count, qualified_method, 0))
        if method_sig.return_type == 12 {
            ll = _lset_type(ll, nt_temp, 12)
        } else if method_sig.return_type > 16 {
            // Use the sig's return type directly. For Optional/Array wrappers
            // around a TypeVar, rebuild with the receiver's concrete type arg
            // so the interp formatter sees the payload type.
            mut ret_ty := method_sig.return_type
            if ret_ty > 0 && ret_ty < ll.store.types.len() {
                rti := store_get(ll.store, ret_ty)
                rk := type_kind_name(rti.kind)
                if rk == "Optional" || rk == "Array" {
                    inner_id := rti.type_id
                    if inner_id > 0 && inner_id < ll.store.types.len() {
                        if type_kind_name(store_get(ll.store, inner_id).kind) == "TypeVar" {
                            // Derive concrete from specialized receiver.
                            if obj_sname != "" {
                                base := _base_generic_name(obj_sname)
                                if base != obj_sname {
                                    suffix := obj_sname.substring(base.len() + 1, obj_sname.len())
                                    concrete := _type_from_suffix(ll.store, ll.registry, suffix)
                                    if concrete > 0 {
                                        new_info := TypeInfo{kind: rti.kind, name: rti.name,
                                                              type_id: concrete, type_id2: rti.type_id2,
                                                              param_start: 0, param_count: rti.param_count}
                                        sar := store_add_canonical(ll.store, new_info)
                                        ll = _lset_store(ll, sar.store)
                                        ret_ty = sar.id
                                    }
                                }
                            }
                        }
                    }
                } else if rk == "Named" {
                    ret_st_id := _struct_type_id(ll.registry, rti.name)
                    if ret_st_id > 0 { ret_ty = ret_st_id }
                }
            }
            ll = _lset_type(ll, nt_temp, ret_ty)
        }
        return LT{l: ll, temp: nt_temp}
    }

    // .clone() on a primitive / generic-unresolved receiver: return the value
    // as-is. All primitives are 8-byte values with trivial copy semantics, and
    // generic bodies see .clone() calls before T is known.
    if method == "clone" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        return LT{l: ll, temp: obj}
    }
    // Unknown method. If the receiver type is known, this violates the trait
    // bound (no implicit fallback per spec pillar #5) — hard error + abort.
    // Empty obj_sname means the receiver type couldn't be determined (e.g.,
    // generic body lowered before monomorphization) — keep as warning.
    if obj_sname != "" {
        println("error: unresolved method '" + method + "' on type '" + obj_sname + "' at " + ll.file + ":" + i2s(_lcur(ll).line))
        _ariaExit(1)
    }
    println("warning: unresolved method '" + method + "' on type '" + obj_sname + "' at " + ll.file + ":" + i2s(_lcur(ll).line))
    while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
    if _lk(ll) == ")" { ll = _ladv(ll) }
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
    LT{l: ll, temp: nt.temp}
}

// --- Lower function call args ---

fn _lower_call_args(l: Lowerer, callee: i64) -> LT {
    mut ll := _ladv(l)  // skip (
    ll = _lskip_nl(ll)
    while _lk(ll) != ")" && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        arg := _lower_expr(ll)
        ll = arg.l
        ll = _lskip_nl(ll)
        if _lk(ll) == "," { ll = _ladv(ll) }
    }
    if _lk(ll) == ")" { ll = _ladv(ll) }
    return LT{l: ll, temp: callee}
}

// --- Field index lookup ---

fn _field_index(reg: TypeRegistry, struct_name: str, field_name: str) -> i64 {
    def := reg_find_struct(reg, struct_name)
    if def.name == "" { return 0 }
    // Compute memory-level slot index, accounting for string fields taking 2 slots
    mut slot := 0
    mut i := 1
    while i < def.fields.len() {
        if def.fields[i].name == field_name {
            return slot
        }
        if def.fields[i].type_id == 12 {
            slot = slot + 2  // string takes ptr + len
        } else {
            slot = slot + 1
        }
        i = i + 1
    }
    0
}


// Search all struct defs for a field name and return its memory-level slot index
// WARNING: Ambiguous if multiple structs have same field name. Prefer _field_index with known struct.
fn _field_index_any(reg: TypeRegistry, field_name: str) -> i64 {
    // Return the first match — relies on struct registration order
    // (diagnostic types like Span, TypeInfo registered before large containers)
    mut si := 1
    while si < reg.struct_defs.len() {
        def := reg.struct_defs[si]
        if def.name != "" {
            if def.is_sum == false {
                mut fi := 1
                while fi < def.fields.len() {
                    if def.fields[fi].name == field_name {
                        return _field_index(reg, def.name, field_name)
                    }
                    fi = fi + 1
                }
            }
        }
        si = si + 1
    }
    0
}

// Given a specialized struct name like "Pair_i64_str", return "Pair" by
// stripping the first `_` suffix whose base half names a registered struct.
// For a non-specialized name, returns it unchanged.
fn _base_generic_name(name: str) -> str {
    mut i := 1
    while i < name.len() {
        if name.charAt(i) == "_" {
            cand := name.substring(0, i)
            // We can't check the registry here without a reference, so just
            // return the first "_" prefix — callers that need validation
            // should consult reg_find_struct separately.
            return cand
        }
        i = i + 1
    }
    name
}

// Map a type-name suffix (e.g. "i64", "str", "Pair_i64") back to a type id.
fn _type_from_suffix(store: TypeStore, reg: TypeRegistry, suffix: str) -> i64 {
    if suffix == "i64" { return 1 }
    if suffix == "f64" { return 9 }
    if suffix == "bool" { return 8 }
    if suffix == "str" { return 12 }
    _struct_type_id(reg, suffix)
}

fn _struct_name_from_type(reg: TypeRegistry, type_id: i64) -> str {
    // type_id >= TY_STRUCT_BASE means struct index = type_id - TY_STRUCT_BASE + 1
    idx := type_id - TY_STRUCT_BASE + 1
    if idx >= 1 && idx < reg.struct_defs.len() {
        return reg.struct_defs[idx].name
    }
    return ""
}

// Resolve generic call name by matching argument types to TypeVar params.
// Returns the specialized function name (e.g., "map_i64_str").
fn _resolve_generic_call_name(store: TypeStore, reg: TypeRegistry, base_name: str, sig: FnSig, arg_types: [i64]) -> str {
    p := _resolve_generic_bindings(store, reg, sig, arg_types)
    mut result := base_name
    mut si := 1
    while si < p.tys.len() {
        result = result + "_" + p.tys[si]
        si = si + 1
    }
    result
}

// Resolve the (TvName, concrete suffix, concrete tid) bindings for every
// TypeVar found by walking sig.param_types in lockstep with arg_types.
fn _resolve_generic_bindings(store: TypeStore, reg: TypeRegistry, sig: FnSig, arg_types: [i64]) -> _TvPair {
    mut resolved_tvs := [""]
    mut resolved_tys := [""]
    mut resolved_tids := [0]
    mut gi := 1
    while gi < arg_types.len() && gi < sig.param_types.len() {
        pt := sig.param_types[gi]
        at := arg_types[gi]
        pair := _extract_typevar_bindings(store, reg, pt, at, resolved_tvs, resolved_tys, resolved_tids)
        resolved_tvs = pair.names
        resolved_tys = pair.tys
        resolved_tids = pair.tids
        gi = gi + 1
    }
    _TvPair{names: resolved_tvs, tys: resolved_tys, tids: resolved_tids}
}

struct _TvPair {
    names: [str]
    tys: [str]
    tids: [i64]
}

// Recursively substitute TypeVars in `tid` with the concrete tids from
// `bindings` (parallel `names`/`tids` arrays). Returns the substituted tid;
// adds any newly-constructed type to the store via the Lowerer.
fn _substitute_typevars(l: Lowerer, tid: i64, names: [str], tids: [i64]) -> LT {
    mut ll := l
    if tid <= 0 || tid >= ll.store.types.len() { return LT{l: ll, temp: tid} }
    ti := store_get(ll.store, tid)
    k := type_kind_name(ti.kind)
    if k == "TypeVar" {
        mut i := 1
        while i < names.len() {
            if names[i] == ti.name { return LT{l: ll, temp: tids[i]} }
            i = i + 1
        }
        return LT{l: ll, temp: tid}
    }
    if k == "Array" || k == "Optional" {
        inner := _substitute_typevars(ll, ti.type_id, names, tids)
        ll = inner.l
        if inner.temp == ti.type_id { return LT{l: ll, temp: tid} }
        new_ti := TypeInfo{kind: ti.kind, name: ti.name, type_id: inner.temp, type_id2: ti.type_id2, param_start: 0, param_count: ti.param_count}
        sar := store_add_canonical(ll.store, new_ti)
        ll = _lset_store(ll, sar.store)
        return LT{l: ll, temp: sar.id}
    }
    if k == "Result" {
        okr := _substitute_typevars(ll, ti.type_id, names, tids)
        ll = okr.l
        errr := _substitute_typevars(ll, ti.type_id2, names, tids)
        ll = errr.l
        if okr.temp == ti.type_id && errr.temp == ti.type_id2 { return LT{l: ll, temp: tid} }
        new_ti := TypeInfo{kind: ti.kind, name: ti.name, type_id: okr.temp, type_id2: errr.temp, param_start: 0, param_count: ti.param_count}
        sar := store_add_canonical(ll.store, new_ti)
        ll = _lset_store(ll, sar.store)
        return LT{l: ll, temp: sar.id}
    }
    if k == "Function" {
        retr := _substitute_typevars(ll, ti.type_id, names, tids)
        ll = retr.l
        errr := _substitute_typevars(ll, ti.type_id2, names, tids)
        ll = errr.l
        if retr.temp == ti.type_id && errr.temp == ti.type_id2 { return LT{l: ll, temp: tid} }
        new_ti := TypeInfo{kind: ti.kind, name: ti.name, type_id: retr.temp, type_id2: errr.temp, param_start: 0, param_count: ti.param_count}
        sar := store_add_canonical(ll.store, new_ti)
        ll = _lset_store(ll, sar.store)
        return LT{l: ll, temp: sar.id}
    }
    LT{l: ll, temp: tid}
}

// Walk pt and at in lockstep, pulling out TypeVar → concrete-type pairs.
// Handles Array / Optional / Result / Function containers by recursing on
// type_id (and type_id2 for Result/Function), so `fn() -> T!U` matched
// against `fn() -> str!DbError` resolves both T=str and U=DbError.
fn _extract_typevar_bindings(store: TypeStore, reg: TypeRegistry, pt: i64, at: i64, tvs: [str], tys: [str], tids: [i64]) -> _TvPair {
    mut out_tvs := tvs
    mut out_tys := tys
    mut out_tids := tids
    mut ppt := pt
    mut aat := at
    if aat == 13 && ppt > 0 && ppt < store.types.len() {
        ptik0 := type_kind_name(store_get(store, ppt).kind)
        if ptik0 == "Array" {
            ppt = store_get(store, ppt).type_id
            aat = 12
        }
    }
    if ppt <= 0 || ppt >= store.types.len() { return _TvPair{names: out_tvs, tys: out_tys, tids: out_tids} }
    pti := store_get(store, ppt)
    pk := type_kind_name(pti.kind)
    if pk == "TypeVar" {
        tv_name := pti.name
        mut already := false
        mut ri := 1
        while ri < out_tvs.len() {
            if out_tvs[ri] == tv_name { already = true }
            ri = ri + 1
        }
        if already == false && aat > 0 {
            suffix := _type_name_suffix_l(store, reg, aat)
            out_tvs = out_tvs.append(tv_name)
            out_tys = out_tys.append(suffix)
            out_tids = out_tids.append(aat)
        }
        return _TvPair{names: out_tvs, tys: out_tys, tids: out_tids}
    }
    if aat <= 0 || aat >= store.types.len() { return _TvPair{names: out_tvs, tys: out_tys, tids: out_tids} }
    ati := store_get(store, aat)
    ak := type_kind_name(ati.kind)
    if pk == "Array" && ak == "Array" {
        return _extract_typevar_bindings(store, reg, pti.type_id, ati.type_id, out_tvs, out_tys, out_tids)
    }
    if pk == "Optional" && ak == "Optional" {
        return _extract_typevar_bindings(store, reg, pti.type_id, ati.type_id, out_tvs, out_tys, out_tids)
    }
    if pk == "Result" && ak == "Result" {
        left := _extract_typevar_bindings(store, reg, pti.type_id, ati.type_id, out_tvs, out_tys, out_tids)
        return _extract_typevar_bindings(store, reg, pti.type_id2, ati.type_id2, left.names, left.tys, left.tids)
    }
    if pk == "Function" && ak == "Function" {
        left := _extract_typevar_bindings(store, reg, pti.type_id, ati.type_id, out_tvs, out_tys, out_tids)
        mut after_ret := left
        if pti.type_id2 > 0 && ati.type_id2 > 0 {
            next := _extract_typevar_bindings(store, reg, pti.type_id2, ati.type_id2, after_ret.names, after_ret.tys, after_ret.tids)
            after_ret = next
        }
        return after_ret
    }
    _TvPair{names: out_tvs, tys: out_tys, tids: out_tids}
}

// Lowerer-side type-name suffix: handles TY_STRUCT_BASE+N registry ids
// in addition to primitive and store-based type ids.
fn _type_name_suffix_l(store: TypeStore, reg: TypeRegistry, tid: i64) -> str {
    if tid >= TY_STRUCT_BASE {
        sname := _struct_name_from_type(reg, tid)
        if sname != "" { return sname }
    }
    _type_name_suffix(store, tid)
}

fn _struct_type_id(reg: TypeRegistry, struct_name: str) -> i64 {
    mut i := 1
    while i < reg.struct_defs.len() {
        if reg.struct_defs[i].name == struct_name {
            return TY_STRUCT_BASE - 1 + i
        }
        i = i + 1
    }
    0
}

fn _field_type_id_from_name(reg: TypeRegistry, struct_name: str, field_name: str) -> i64 {
    def := reg_find_struct(reg, struct_name)
    if def.name == "" { return 0 }
    mut i := 1
    while i < def.fields.len() {
        if def.fields[i].name == field_name {
            return def.fields[i].type_id
        }
        i = i + 1
    }
    0
}

fn _field_type_id(l: Lowerer, struct_name: str, field_name: str) -> i64 {
    def := reg_find_struct(l.registry, struct_name)
    if def.name == "" { return 0 }
    mut i := 1
    while i < def.fields.len() {
        if def.fields[i].name == field_name {
            return def.fields[i].type_id
        }
        i = i + 1
    }
    0
}

// Search all struct defs for a field name and return its type_id
// Returns first match — relies on struct registration order
fn _field_type_id_any(reg: TypeRegistry, field_name: str) -> i64 {
    mut si := 1
    while si < reg.struct_defs.len() {
        def := reg.struct_defs[si]
        if def.name != "" {
            if def.is_sum == false {
                mut fi := 1
                while fi < def.fields.len() {
                    if def.fields[fi].name == field_name {
                        return def.fields[fi].type_id
                    }
                    fi = fi + 1
                }
            }
        }
        si = si + 1
    }
    0
}

fn _struct_field_count(reg: TypeRegistry, struct_name: str) -> i64 {
    def := reg_find_struct(reg, struct_name)
    if def.name == "" { return 0 }
    // Count memory slots, accounting for string fields taking 2 slots
    mut slots := 0
    mut i := 1
    while i < def.fields.len() {
        if def.fields[i].type_id == 12 {
            slots = slots + 2
        } else {
            slots = slots + 1
        }
        i = i + 1
    }
    slots
}

// --- AST-based method call with pre-lowered arguments ---
// Mirrors _lower_method_call but uses arg temps instead of token-walking _lower_expr.
// This avoids unreliable _find_tok_pos positioning in multi-file compiled binaries.

fn _lower_method_with_args(l: Lowerer, obj: i64, method: str, arg1: i64, arg2: i64, arg_count: i64) -> LT {
    mut ll := l
    obj_type := _lget_type(ll, obj)

    // Option.ok_or(err) — Some(v) -> Ok(v); None -> Err(err_arg).
    if method == "ok_or" {
        err_is_str := _lget_type(ll, arg1) == 12
        mut ok_is_str := false
        if obj_type > 16 && obj_type < ll.store.types.len() {
            oi := store_get(ll.store, obj_type)
            if type_kind_name(oi.kind) == "Optional" && oi.type_id == 12 { ok_is_str = true }
        }
        mut slots := 2
        if err_is_str || ok_is_str { slots = 3 }
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, obj, 0, "_tag", 0))
        zero_nt := _lnew_temp(ll)
        ll = zero_nt.l
        ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        is_some := _lnew_temp(ll)
        ll = is_some.l
        ll = _lemit(ll, new_inst(OpEq, is_some.temp, tag_nt.temp, one_nt.temp, "", 0))
        result := _lnew_temp(ll)
        ll = result.l
        ll = _lemit(ll, new_inst(OpAlloc, result.temp, slots, 0, "_Result", 0))
        some_lbl := _lnew_label(ll)
        ll = some_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_some.temp, some_lbl.temp, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, result.temp, one_nt.temp, 0, "_tag", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, result.temp, arg1, 1, "_val", 0))
        if err_is_str {
            arg1_len := arg1 + 1
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, arg1_len, 2, "_val_len", 0))
        } else if slots == 3 {
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 2, "_val_len", 0))
        }
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, some_lbl.temp, 0, "", 0))
        if ok_is_str {
            val_nt := _lnew_str_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp, obj, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp + 1, obj, 2, "_val_len", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_nt.temp, 1, "_val", 0))
            val_len := val_nt.temp + 1
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_len, 2, "_val_len", 0))
        } else {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, val_nt.temp, obj, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, result.temp, val_nt.temp, 1, "_val", 0))
            if slots == 3 {
                ll = _lemit(ll, new_inst(OpFieldSet, result.temp, zero_nt.temp, 2, "_val_len", 0))
            }
        }
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_is_result(ll, result.temp)
        return LT{l: ll, temp: result.temp}
    }

    // --- Array join(sep) — concat each str element with separator ---
    if method == "join" {
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        mut empty_idx := mod_find_string(ll.module, "")
        if empty_idx == 0 {
            new_mod := mod_add_string(ll.module, "")
            empty_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        ll = _lemit(ll, new_inst(OpConstStr, result_nt.temp, empty_idx, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 12)
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, obj, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        first_nt := _lnew_temp(ll)
        ll = first_nt.l
        ll = _lemit(ll, new_inst(OpConst, first_nt.temp, 1, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpLt, cmp.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, end_lbl.temp, "", 0))
        is_first := _lnew_temp(ll)
        ll = is_first.l
        ll = _lemit(ll, new_inst(OpEq, is_first.temp, idx_nt.temp, first_nt.temp, "", 0))
        skip_sep := _lnew_label(ll)
        ll = skip_sep.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_first.temp, skip_sep.temp, "", 0))
        sep_cat := _lnew_str_temp(ll)
        ll = sep_cat.l
        ll = _lemit(ll, new_inst(OpStrConcat, sep_cat.temp, result_nt.temp, arg1, "", 0))
        ll = _lset_type(ll, sep_cat.temp, 12)
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, sep_cat.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, sep_cat.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, skip_sep.temp, 0, "", 0))
        elem := _lnew_str_temp(ll)
        ll = elem.l
        ll = _lemit(ll, new_inst(OpArrayGet, elem.temp, obj, idx_nt.temp, "", 12))
        ll = _lset_type(ll, elem.temp, 12)
        cat := _lnew_str_temp(ll)
        ll = cat.l
        ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, result_nt.temp, elem.temp, "", 0))
        ll = _lset_type(ll, cat.temp, 12)
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, cat.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, cat.temp + 1, 0, "", 0))
        inc := _lnew_temp(ll)
        ll = inc.l
        ll = _lemit(ll, new_inst(OpConst, inc.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpAdd, idx_nt.temp, idx_nt.temp, inc.temp, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_type(ll, result_nt.temp, 12)
        return LT{l: ll, temp: result_nt.temp}
    }

    // --- String methods (type 12) ---
    if method == "charAt" {
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrCharAt, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "startsWith" || method == "starts_with" {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrStartsWith, nt.temp, obj, arg1, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    if method == "endsWith" || method == "ends_with" {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrEndsWith, nt.temp, obj, arg1, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    if method == "indexOf" {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrIndexOf, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "contains" && obj_type == 12 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrContains, nt.temp, obj, arg1, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    if method == "substring" {
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrSubstring, nt.temp, obj, arg1, "", arg2))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "replace" {
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrReplace, nt.temp, obj, arg1, "", arg2))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "split" {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrSplit, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 13)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "repeat" && obj_type == 12 {
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpStrRepeat, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    // --- Array methods ---
    if method == "append" {
        nt := _lnew_temp(ll)
        ll = nt.l
        elem_type := _lget_type(ll, arg1)
        if elem_type == 12 || obj_type == 13 {
            ll = _lemit(ll, new_inst(OpArrayAppend, nt.temp, obj, arg1, "", 12))
            ll = _lset_type(ll, nt.temp, 13)
        } else {
            ll = _lemit(ll, new_inst(OpArrayAppend, nt.temp, obj, arg1, "", 0))
            if obj_type > 0 { ll = _lset_type(ll, nt.temp, obj_type) }
        }
        return LT{l: ll, temp: nt.temp}
    }
    if method == "contains" && obj_type != 12 && obj_type != 301 {
        // Array contains: use OpArrayContains → _aria_array_contains
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpArrayContains, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 11)
        return LT{l: ll, temp: nt.temp}
    }

    // --- Map methods (type 300) ---
    if method == "set" && obj_type == 300 {
        ll = _lemit(ll, new_inst(OpMapSet, 0, obj, arg1, "", arg2))
        return LT{l: ll, temp: obj}
    }
    if method == "get" && obj_type == 300 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpMapGet, nt.temp, obj, arg1, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    if (method == "has" || method == "contains_key" || method == "contains") && obj_type == 300 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpMapContains, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 11)
        return LT{l: ll, temp: nt.temp}
    }

    // --- Set methods (type 301) ---
    if method == "add" && obj_type == 301 {
        ll = _lemit(ll, new_inst(OpSetAdd, 0, obj, arg1, "", 0))
        return LT{l: ll, temp: obj}
    }
    if method == "contains" && obj_type == 301 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpSetContains, nt.temp, obj, arg1, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "remove" && (obj_type == 300 || obj_type == 301) {
        if obj_type == 301 {
            ll = _lemit(ll, new_inst(OpSetRemove, 0, obj, arg1, "", 0))
        }
        return LT{l: ll, temp: obj}
    }

    // --- Channel methods (AST path — mirror of _lower_method_call's L10681+) ---
    // Channel handles carry TY_CHAN (17) / TY_CHAN_SEND (19) / TY_CHAN_RECV (20);
    // Task handles carry TY_TASK (18). The AST MethodCall dispatch routes
    // method-with-args through here, so we duplicate the typed handlers so
    // send/close/await on AST paths hit the correct runtime intrinsic.
    if method == "send" && (obj_type == 17 || obj_type == 19 || obj_type == 21) {
        // _aria_chan_send(ch, val) — args must be consecutive temps.
        // chan[str] (21): box the (ptr, len) pair into a 2-slot cell.
        mut payload := arg1
        if obj_type == 21 {
            box := _lnew_temp(ll)
            ll = box.l
            ll = _lemit(ll, new_inst(OpAlloc, box.temp, 2, 0, "_StrBox", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, box.temp, arg1, 0, "_ptr", 0))
            arg1_len := arg1 + 1
            ll = _lemit(ll, new_inst(OpFieldSet, box.temp, arg1_len, 1, "_len", 0))
            payload = box.temp
        }
        pack0 := _lnew_temp(ll)
        ll = pack0.l
        ll = _lemit(ll, new_inst(OpStore, pack0.temp, obj, 0, "", 0))
        pack1 := _lnew_temp(ll)
        ll = pack1.l
        ll = _lemit(ll, new_inst(OpStore, pack1.temp, payload, 0, "", 0))
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, pack0.temp, 2, "_aria_chan_send", 1))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "recv" && (obj_type == 17 || obj_type == 20 || obj_type == 21) {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_chan_recv", 1))
        if obj_type == 21 {
            str_nt := _lnew_str_temp(ll)
            ll = str_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp, nt.temp, 0, "_ptr", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp + 1, nt.temp, 1, "_len", 0))
            ll = _lset_type(ll, str_nt.temp, 12)
            return LT{l: ll, temp: str_nt.temp}
        }
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "close" && (obj_type == 17 || obj_type == 19 || obj_type == 20 || obj_type == 21) {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_chan_close", 0))
        return LT{l: ll, temp: nt.temp}
    }
    // --- Task methods ---
    // _lower_spawn tags joinables as 1 (collides with TY_I64) and detached
    // as 18; we accept either — parallels the token-path dispatch at L10720.
    // arg_count == 0 for these zero-arg methods, so arg1 is unused.
    if method == "await" && (obj_type == 1 || obj_type == 18) && arg_count == 0 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_task_await", 1))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "done" && (obj_type == 1 || obj_type == 18) && arg_count == 0 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_task_done", 1))
        ll = _lset_type(ll, nt.temp, 11)
        return LT{l: ll, temp: nt.temp}
    }
    if method == "cancel" && (obj_type == 1 || obj_type == 18) && arg_count == 0 {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_task_cancel", 0))
        return LT{l: ll, temp: nt.temp}
    }

    // --- User-defined methods (qualified call: StructName_method) ---
    sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
    if sname.len() > 0 {
        mut qualified := sname + "_" + method
        mut sig := reg_find_fn(ll.registry, qualified)
        // If the receiver is a specialization (Stack_i64) but only the base
        // method (Stack_push) is registered, fall back to the base, specialize
        // it, and register a MonoSpec so the mono pass emits the body.
        if sig.name == "" {
            base_name := _base_generic_name(sname)
            if base_name != sname {
                base_method := base_name + "_" + method
                base_sig := reg_find_fn(ll.registry, base_method)
                if base_sig.name != "" {
                    if fn_is_generic(base_sig) {
                        specialized_method := base_method + sname.substring(base_name.len(), sname.len())
                        existing := reg_find_fn(ll.registry, specialized_method)
                        if existing.name != "" {
                            qualified = specialized_method
                            sig = existing
                        } else {
                            suffix := sname.substring(base_name.len() + 1, sname.len())
                            concrete := _type_from_suffix(ll.store, ll.registry, suffix)
                            // Substitute TypeVar params with concrete type; map
                            // `self` to the specialized receiver type, and
                            // Array<TypeVar> params to Array<concrete>.
                            mut sp_pt := [0]
                            mut spi := 1
                            while spi < base_sig.param_types.len() {
                                mut pt := base_sig.param_types[spi]
                                if spi == 1 && base_sig.param_names.len() > 1 && base_sig.param_names[1] == "self" {
                                    pt = obj_type
                                } else if pt > 0 && pt < ll.store.types.len() {
                                    pti := store_get(ll.store, pt)
                                    ptk := type_kind_name(pti.kind)
                                    if ptk == "TypeVar" { pt = concrete }
                                    else if ptk == "Array" {
                                        inner_id := pti.type_id
                                        if inner_id > 0 && inner_id < ll.store.types.len() {
                                            if type_kind_name(store_get(ll.store, inner_id).kind) == "TypeVar" {
                                                new_arr := TypeInfo{kind: pti.kind, name: pti.name,
                                                                     type_id: concrete, type_id2: 0,
                                                                     param_start: 0, param_count: 0}
                                                sar := store_add_canonical(ll.store, new_arr)
                                                ll = _lset_store(ll, sar.store)
                                                pt = sar.id
                                            }
                                        }
                                    }
                                }
                                sp_pt = sp_pt.append(pt)
                                spi = spi + 1
                            }
                            // Substitute return type: bare TypeVar -> concrete,
                            // Named(base) with generic struct -> specialized.
                            mut sp_ret := base_sig.return_type
                            if sp_ret > 0 && sp_ret < ll.store.types.len() {
                                rti := store_get(ll.store, sp_ret)
                                rk := type_kind_name(rti.kind)
                                if rk == "TypeVar" {
                                    if concrete > 0 { sp_ret = concrete }
                                } else if rk == "Named" {
                                    rname := rti.name
                                    if rname == base_name {
                                        sp_ret_tid := _struct_type_id(ll.registry, sname)
                                        if sp_ret_tid > 0 { sp_ret = sp_ret_tid }
                                    }
                                }
                            }
                            new_sig := new_fn_sig(specialized_method, base_sig.param_names, sp_pt, sp_ret, base_sig.error_type)
                            ll = _lset_reg(ll, reg_add_fn(ll.registry, new_sig))
                            ms_spec := MonoSpec{generic_name: base_method, specialized_name: specialized_method,
                                                 type_arg_0: concrete, type_arg_1: 0, type_arg_2: 0}
                            ll = _lset_reg(ll, reg_add_mono(ll.registry, ms_spec))
                            qualified = specialized_method
                            sig = new_sig
                        }
                    } else {
                        qualified = base_method
                        sig = base_sig
                    }
                }
            }
        }
        if sig.name != "" {
            // Emit OpCall: pack obj + args into consecutive temps
            base_nt := _lnew_temp(ll)
            ll = base_nt.l
            ll = _lemit(ll, new_inst(OpStore, base_nt.temp, obj, 0, "", 0))
            if arg_count >= 1 {
                a1_nt := _lnew_temp(ll)
                ll = a1_nt.l
                ll = _lemit(ll, new_inst(OpStore, a1_nt.temp, arg1, 0, "", 0))
            }
            if arg_count >= 2 {
                a2_nt := _lnew_temp(ll)
                ll = a2_nt.l
                ll = _lemit(ll, new_inst(OpStore, a2_nt.temp, arg2, 0, "", 0))
            }
            result_nt := _lnew_temp(ll)
            ll = result_nt.l
            ll = _lemit(ll, new_inst(OpCall, result_nt.temp, base_nt.temp, arg_count + 1, qualified, sig.return_type))
            if sig.return_type > 0 {
                ll = _lset_type(ll, result_nt.temp, sig.return_type)
            }
            return LT{l: ll, temp: result_nt.temp}
        }
    }

    // Blanket impl dispatch: same scheme as _lower_method_call (token path).
    // If obj's type implements some trait T, and there's a blanket impl
    // `impl[X: T] OtherTrait for X` that provides `method`, dispatch to the
    // blanket's `_method` fn. When the blanket fn is generic (e.g.
    // `fn wrap[U](self, val: U) -> U`), specialize on the arg type and
    // register a MonoSpec so the mono pass emits the body.
    if sname != "" {
        mut ii := 1
        while ii < ll.treg.impl_defs.len() {
            bimp := ll.treg.impl_defs[ii]
            if bimp.type_name.len() > 1 && bimp.type_name.charAt(0) == "*" {
                bound := bimp.type_name.substring(1, bimp.type_name.len())
                if treg_has_impl(ll.treg, sname, bound) {
                    blanket_fn := "_" + method
                    mut bsig := reg_find_fn(ll.registry, blanket_fn)
                    mut call_name := blanket_fn
                    if bsig.name != "" {
                        if fn_is_generic(bsig) {
                            // Infer a concrete type suffix from the first arg's
                            // TypeVar position (val: U in the canonical case).
                            arg1_t := _lget_type(ll, arg1)
                            suffix := _type_name_suffix_l(ll.store, ll.registry, arg1_t)
                            if suffix != "unknown" && suffix != "" {
                                spec_name := blanket_fn + "_" + sname + "_" + suffix
                                existing := reg_find_fn(ll.registry, spec_name)
                                if existing.name != "" {
                                    bsig = existing
                                    call_name = spec_name
                                } else {
                                    // Substitute TypeVars: self → sname, U → arg1_t
                                    self_tid := _struct_type_id(ll.registry, sname)
                                    mut sp_pt := [0]
                                    mut spi := 1
                                    while spi < bsig.param_types.len() {
                                        mut pt := bsig.param_types[spi]
                                        if spi == 1 && bsig.param_names.len() > 1 && bsig.param_names[1] == "self" {
                                            if self_tid > 0 { pt = self_tid }
                                        } else if pt > 0 && pt < ll.store.types.len() {
                                            pti := store_get(ll.store, pt)
                                            if type_kind_name(pti.kind) == "TypeVar" { pt = arg1_t }
                                        }
                                        sp_pt = sp_pt.append(pt)
                                        spi = spi + 1
                                    }
                                    mut sp_ret := bsig.return_type
                                    if sp_ret > 0 && sp_ret < ll.store.types.len() {
                                        rti := store_get(ll.store, sp_ret)
                                        if type_kind_name(rti.kind) == "TypeVar" { sp_ret = arg1_t }
                                    }
                                    new_sig := new_fn_sig(spec_name, bsig.param_names, sp_pt, sp_ret, bsig.error_type)
                                    ll = _lset_reg(ll, reg_add_fn(ll.registry, new_sig))
                                    ms := MonoSpec{generic_name: blanket_fn, specialized_name: spec_name,
                                                   type_arg_0: arg1_t, type_arg_1: 0, type_arg_2: 0}
                                    ll = _lset_reg(ll, reg_add_mono(ll.registry, ms))
                                    bsig = new_sig
                                    call_name = spec_name
                                }
                            }
                        }
                        base_nt := _lnew_temp(ll)
                        ll = base_nt.l
                        ll = _lemit(ll, new_inst(OpStore, base_nt.temp, obj, 0, "", 0))
                        if arg_count >= 1 {
                            a1_nt := _lnew_temp(ll)
                            ll = a1_nt.l
                            ll = _lemit(ll, new_inst(OpStore, a1_nt.temp, arg1, 0, "", 0))
                        }
                        if arg_count >= 2 {
                            a2_nt := _lnew_temp(ll)
                            ll = a2_nt.l
                            ll = _lemit(ll, new_inst(OpStore, a2_nt.temp, arg2, 0, "", 0))
                        }
                        result_nt := _lnew_temp(ll)
                        ll = result_nt.l
                        ll = _lemit(ll, new_inst(OpCall, result_nt.temp, base_nt.temp, arg_count + 1, call_name, bsig.return_type))
                        if bsig.return_type > 0 { ll = _lset_type(ll, result_nt.temp, bsig.return_type) }
                        return LT{l: ll, temp: result_nt.temp}
                    }
                }
            }
            ii = ii + 1
        }
    }

    // Fallback: return obj (method not recognized)
    _warn_unresolved(ll, "method", method)
    return LT{l: ll, temp: obj}
}

// --- Lower struct literal ---

fn _lower_struct_lit(l: Lowerer, name: str) -> LT {
    lb := "\{"
    rb := "\}"
    mut ll := _ladv(l)  // skip {
    ll = _lskip_nl(ll)

    // First pass: collect field name/value/type in source order so we can size
    // the alloc correctly (generic struct defs still carry TypeVar field
    // types, so counting declared fields isn't enough — a str value needs 2
    // slots even when the declared field type is a TypeVar).
    mut fnames := [""]
    mut fvals := [0]
    mut ftypes := [0]
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        if _lk(ll) == "IDENT" {
            fname := _lcur(ll).text
            ll = _ladv(ll)
            mut have_val := false
            mut fval_temp := 0
            mut fval_type := 0
            if _lk(ll) == ":" {
                ll = _ladv(ll)
                val := _lower_expr(ll)
                ll = val.l
                fval_temp = val.temp
                fval_type = _lget_type(ll, val.temp)
                have_val = true
            } else {
                slot := _lenv_lookup(ll, fname)
                if slot >= 0 {
                    slot_type := _lget_type(ll, slot)
                    if slot_type == 12 {
                        s_nt := _lnew_str_temp(ll)
                        ll = s_nt.l
                        ll = _lemit(ll, new_inst(OpLoad, s_nt.temp, slot, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpLoad, s_nt.temp + 1, slot + 1, 0, "", 0))
                        ll = _lset_type(ll, s_nt.temp, 12)
                        fval_temp = s_nt.temp
                        fval_type = 12
                    } else {
                        s_nt := _lnew_temp(ll)
                        ll = s_nt.l
                        ll = _lemit(ll, new_inst(OpLoad, s_nt.temp, slot, 0, "", 0))
                        if slot_type > 0 { ll = _lset_type(ll, s_nt.temp, slot_type) }
                        fval_temp = s_nt.temp
                        fval_type = slot_type
                    }
                    have_val = true
                }
            }
            if have_val {
                fnames = fnames.append(fname)
                fvals = fvals.append(fval_temp)
                ftypes = ftypes.append(fval_type)
            }
        } else {
            ll = _ladv(ll)
        }
        ll = _lskip_nl(ll)
        if _lk(ll) == "," {
            ll = _ladv(ll)
            ll = _lskip_nl(ll)
        }
    }
    if _lk(ll) == rb { ll = _ladv(ll) }

    // Fill in defaults for fields the user didnt specify. Look up the struct
    // def; for each declared field whose name isnt in fnames and which has a
    // non-zero field_default_tok_pos, seek to that token and lower the
    // expression there (saving/restoring the cursor).
    def_lookup := reg_find_struct(ll.registry, name)
    if def_lookup.name != "" && def_lookup.fields.len() == def_lookup.field_default_tok_pos.len() {
        mut di := 1
        while di < def_lookup.fields.len() {
            decl_name := def_lookup.fields[di].name
            mut already_provided := false
            mut pi := 1
            while pi < fnames.len() {
                if fnames[pi] == decl_name { already_provided = true }
                pi = pi + 1
            }
            if !already_provided {
                default_tok := def_lookup.field_default_tok_pos[di]
                if default_tok > 0 {
                    saved_pos := ll.pos
                    ll = _lset_pos(ll, default_tok)
                    def_val := _lower_expr(ll)
                    ll = _lset_pos(def_val.l, saved_pos)
                    fnames = fnames.append(decl_name)
                    fvals = fvals.append(def_val.temp)
                    ftypes = ftypes.append(_lget_type(ll, def_val.temp))
                }
            }
            di = di + 1
        }
    }

    // Pick a layout: for generic structs with concrete values, register (or
    // reuse) a specialized def like `Pair_i64_str` so FieldAccess later uses
    // the correct slot offsets for str payloads.
    mut layout_name := name
    sdef := reg_find_struct(ll.registry, name)
    if sdef.name != "" && sdef.generic_count > 0 {
        mut has_concrete := false
        mut ci := 1
        while ci < ftypes.len() {
            mut di := 1
            while di < sdef.fields.len() {
                if sdef.fields[di].name == fnames[ci] {
                    decl_ft := sdef.fields[di].type_id
                    if decl_ft > 0 && decl_ft < ll.store.types.len() {
                        dk := type_kind_name(store_get(ll.store, decl_ft).kind)
                        if dk == "TypeVar" && ftypes[ci] > 0 { has_concrete = true }
                    }
                    di = sdef.fields.len()
                }
                di = di + 1
            }
            ci = ci + 1
        }
        if has_concrete {
            mut spec_name := name
            mut si := 1
            while si < sdef.fields.len() {
                decl_name := sdef.fields[si].name
                decl_ft := sdef.fields[si].type_id
                mut chosen := decl_ft
                mut li := 1
                while li < fnames.len() {
                    if fnames[li] == decl_name && ftypes[li] > 0 { chosen = ftypes[li] }
                    li = li + 1
                }
                spec_name = spec_name + "_" + _type_name_suffix_l(ll.store, ll.registry, chosen)
                si = si + 1
            }
            if _struct_type_id(ll.registry, spec_name) == 0 {
                mut sp_fields := [FieldInfo{name: "", type_id: 0}]
                mut fi2 := 1
                while fi2 < sdef.fields.len() {
                    decl_name := sdef.fields[fi2].name
                    mut chosen := sdef.fields[fi2].type_id
                    mut li2 := 1
                    while li2 < fnames.len() {
                        if fnames[li2] == decl_name && ftypes[li2] > 0 { chosen = ftypes[li2] }
                        li2 = li2 + 1
                    }
                    sp_fields = sp_fields.append(FieldInfo{name: decl_name, type_id: chosen})
                    fi2 = fi2 + 1
                }
                sp_def := new_struct_def(spec_name, sp_fields, false, [""])
                ll = _lset_reg(ll, reg_add_struct(ll.registry, sp_def))
            }
            layout_name = spec_name
        }
    }

    // Allocate: str fields each take 2 slots.
    layout_def := reg_find_struct(ll.registry, layout_name)
    mut alloc_sz := 0
    if layout_def.name != "" {
        mut asi := 1
        while asi < layout_def.fields.len() {
            if layout_def.fields[asi].type_id == 12 { alloc_sz = alloc_sz + 2 } else { alloc_sz = alloc_sz + 1 }
            asi = asi + 1
        }
    } else {
        alloc_sz = _struct_field_count(ll.registry, name)
    }
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, layout_name, 0))
    st_id := _struct_type_id(ll.registry, layout_name)
    if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }

    // Second pass: emit field writes using the chosen layout's slot offsets.
    mut wi := 1
    while wi < fnames.len() {
        fname := fnames[wi]
        fval_temp := fvals[wi]
        fval_type := ftypes[wi]
        fidx := _field_index(ll.registry, layout_name, fname)
        ft := _field_type_id(ll, layout_name, fname)
        if fval_type == 12 || ft == 12 {
            fidx_len := fidx + 1
            val_len := fval_temp + 1
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval_temp, fidx, fname, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val_len, fidx_len, fname, 0))
        } else {
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval_temp, fidx, fname, 0))
        }
        wi = wi + 1
    }
    LT{l: ll, temp: nt.temp}
}

// --- Lower atom: primary + postfix (.field, .method(), [index]) ---
// Used as operand parser for binary ops and conditions.

// Lower a `recv.method(args)` call where recv is a module-like name (not an
// in-scope binding) and `recv_method` or bare `method` is a registered fn.
// Cursor is positioned at `(` on entry; on return, cursor is past `)`.
fn _lower_module_call_tokens(l: Lowerer, recv_name: str, method: str) -> LT {
    mut ll := l
    // Prefer the bare name (mod-scoped function) over the underscore-mangled
    // one. For `db.connect(...)`, this picks `fn connect` in `mod db` over a
    // helper function named `db_connect` in the same file. The mangled name is
    // the fallback for legacy snake_case style (e.g. `std.os.getenv` etc.).
    mut msig := reg_find_fn(ll.registry, method)
    mut call_name := method
    if msig.name == "" {
        qualified_name := recv_name + "_" + method
        msig = reg_find_fn(ll.registry, qualified_name)
        call_name = qualified_name
    }
    if _lk(ll) == "(" { ll = _ladv(ll) }
    ll = _lskip_nl(ll)
    // Lower args, collecting (temp, type) pairs.
    mut arg_temps := [0]
    mut arg_types := [0]
    while _lk(ll) != ")" && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        ar := _lower_expr(ll)
        ll = ar.l
        arg_temps = arg_temps.append(ar.temp)
        arg_types = arg_types.append(_lget_type(ll, ar.temp))
        ll = _lskip_nl(ll)
        if _lk(ll) == "," { ll = _ladv(ll) }
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == ")" { ll = _ladv(ll) }
    // `json.encode(x)` where x is a `@[derive(Json)]` struct — re-point the
    // call to `<T>_to_json(x)` before packing. Falls through to the stock
    // `encode(JsonValue) -> str` in lib/json.aria for non-derived args.
    if recv_name == "json" && method == "encode" && arg_temps.len() == 2 {
        arg_t_je := arg_types[1]
        sname_je := _struct_name_for_type(ll.store, ll.registry, arg_t_je)
        if sname_je != "" && treg_has_impl(ll.treg, sname_je, "Json") {
            call_name = sname_je + "_to_json"
            msig = reg_find_fn(ll.registry, call_name)
        }
    }
    // Count register slots (str args take 2).
    mut reg_count := 0
    mut ci := 1
    while ci < arg_temps.len() {
        if arg_types[ci] == 12 { reg_count = reg_count + 2 } else { reg_count = reg_count + 1 }
        ci = ci + 1
    }
    // Pack args into consecutive temps.
    mut fa := 0
    if arg_temps.len() > 1 {
        first_nt := _lnew_temp(ll)
        ll = first_nt.l
        mut ri := 1
        while ri < reg_count {
            extra := _lnew_temp(ll)
            ll = extra.l
            ri = ri + 1
        }
        mut mslot := 0
        ci = 1
        while ci < arg_temps.len() {
            if arg_types[ci] == 12 {
                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot, arg_temps[ci], 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot + 1, arg_temps[ci] + 1, 0, "", 0))
                mslot = mslot + 2
            } else {
                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot, arg_temps[ci], 0, "", 0))
                mslot = mslot + 1
            }
            ci = ci + 1
        }
        fa = first_nt.temp
    }
    // Determine return type.
    mut rt := 0
    if msig.name != "" { rt = msig.return_type }
    mut nt_temp := 0
    if rt == 12 {
        nt := _lnew_str_temp(ll)
        ll = nt.l
        nt_temp = nt.temp
    } else {
        nt := _lnew_temp(ll)
        ll = nt.l
        nt_temp = nt.temp
    }
    ll = _lemit(ll, new_inst(OpCall, nt_temp, fa, reg_count, call_name, rt))
    if rt > 0 { ll = _lset_type(ll, nt_temp, rt) }
    // Mark the result as Result-typed if either the sig explicitly carries an
    // error_type or the return_type itself is a Result TypeInfo (two ways the
    // type registry may encode `Struct!Err`).
    mut is_fallible := msig.error_type > 0
    if !is_fallible && rt > 16 && rt < ll.store.types.len() {
        rti := store_get(ll.store, rt)
        if type_kind_name(rti.kind) == "Result" { is_fallible = true }
    }
    if is_fallible { ll = _lset_is_result(ll, nt_temp) }
    LT{l: ll, temp: nt_temp}
}

fn _lower_atom(l: Lowerer) -> LT {
    lb := "\{"
    // Module-qualified call short-circuit: `IDENT . IDENT ( args )` where the
    // first IDENT isn't an in-scope binding but the second names a registered
    // function. Handle it directly so we don't emit the OpConst-0 fallback for
    // the module name and corrupt the arg packing with a stale temp.
    if _lk(l) == "IDENT" {
        recv_name := _lcur(l).text
        if _lenv_lookup(l, recv_name) < 0 {
            pk1 := l.pos + 1
            pk2 := l.pos + 2
            pk3 := l.pos + 3
            if pk2 < l.tokens.len() &&
               l.tokens[pk1].name == "." &&
               l.tokens[pk2].name == "IDENT" {
                method := l.tokens[pk2].text
                is_call := pk3 < l.tokens.len() && l.tokens[pk3].name == "("
                if is_call {
                    qualified := recv_name + "_" + method
                    if reg_find_fn(l.registry, qualified).name != "" ||
                       reg_find_fn(l.registry, method).name != "" {
                        ll0 := _lset_pos(l, pk3)
                        return _lower_module_call_tokens(ll0, recv_name, method)
                    }
                } else {
                    // Module-qualified const lookup (e.g. `time.ms` inside an
                    // expression like `50 * time.ms`). Without this we'd fall
                    // through to _lower_primary on the receiver and warn
                    // "unresolved identifier". Mirror the const/variant/prim
                    // short-circuits from _lower_expr.
                    cv := _lconst_lookup(l, method)
                    if cv != 0 - 9999999 {
                        nt := _lnew_temp(l)
                        mut ll := nt.l
                        ll = _lemit(ll, new_inst(OpConst, nt.temp, cv, 0, "", 0))
                        ll = _lset_type(ll, nt.temp, 1)
                        ll = _lset_pos(ll, l.pos + 3)
                        return LT{l: ll, temp: nt.temp}
                    }
                    // Built-in primitive constants i64.MAX / u8.MAX etc.
                    mut prim_v := 0
                    mut prim_hit := false
                    if recv_name == "i64" && method == "MAX" { prim_v = 9223372036854775807; prim_hit = true }
                    if recv_name == "i64" && method == "MIN" { prim_v = 0 - 9223372036854775807 - 1; prim_hit = true }
                    if recv_name == "i32" && method == "MAX" { prim_v = 2147483647; prim_hit = true }
                    if recv_name == "i32" && method == "MIN" { prim_v = 0 - 2147483648; prim_hit = true }
                    if recv_name == "i16" && method == "MAX" { prim_v = 32767; prim_hit = true }
                    if recv_name == "i16" && method == "MIN" { prim_v = 0 - 32768; prim_hit = true }
                    if recv_name == "i8"  && method == "MAX" { prim_v = 127; prim_hit = true }
                    if recv_name == "i8"  && method == "MIN" { prim_v = 0 - 128; prim_hit = true }
                    if recv_name == "u32" && method == "MAX" { prim_v = 4294967295; prim_hit = true }
                    if recv_name == "u16" && method == "MAX" { prim_v = 65535; prim_hit = true }
                    if recv_name == "u8"  && method == "MAX" { prim_v = 255; prim_hit = true }
                    if (recv_name == "u32" || recv_name == "u16" || recv_name == "u8" || recv_name == "u64") && method == "MIN" { prim_v = 0; prim_hit = true }
                    if prim_hit {
                        nt := _lnew_temp(l)
                        mut ll := nt.l
                        ll = _lemit(ll, new_inst(OpConst, nt.temp, prim_v, 0, "", 0))
                        ll = _lset_type(ll, nt.temp, 1)
                        ll = _lset_pos(ll, l.pos + 3)
                        return LT{l: ll, temp: nt.temp}
                    }
                    // Type-qualified no-data variant
                    mvtag := _variant_tag(l.registry, method)
                    if mvtag > 0 {
                        mvparent := _variant_parent(l.registry, method)
                        if variant_data_count(mvparent, mvtag) == 0 {
                            nt := _lnew_temp(l)
                            mut ll := nt.l
                            if sum_has_data(mvparent) {
                                alloc_sz := sum_alloc_size(mvparent)
                                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, mvparent.name, 0))
                                st_id := _struct_type_id(ll.registry, mvparent.name)
                                if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
                                tag_nt := _lnew_temp(ll)
                                ll = tag_nt.l
                                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, mvtag, 0, "", 0))
                                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                            } else {
                                ll = _lemit(ll, new_inst(OpConst, nt.temp, mvtag, 0, "", 0))
                            }
                            ll = _lset_pos(ll, l.pos + 3)
                            return LT{l: ll, temp: nt.temp}
                        }
                    }
                }
            }
        }
    }
    result := _lower_primary(l)
    mut ll := result.l
    mut left := result.temp

    // Handle postfix: .field, .method(), [index]
    mut running := true
    while running {
        k := _lk(ll)
        if k == "." {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" {
                field := _lcur(ll).text
                ll = _ladv(ll)
                if _lk(ll) == "(" {
                    mr := _lower_method_call(ll, left, field)
                    ll = mr.l
                    left = mr.temp
                } else if _lk(ll) == "[" && (field == "to" || field == "trunc" || field == "parse") {
                    // Conversion method with type arg: .to[Type]() / .trunc[Type]() / .parse[Type]()
                    // (parse aliases to "to" in the conversion impl.)
                    ll = _ladv(ll)  // skip [
                    mut target_type_name := ""
                    if _lk(ll) == "IDENT" {
                        target_type_name = _lcur(ll).text
                        ll = _ladv(ll)
                    }
                    if _lk(ll) == "]" { ll = _ladv(ll) }
                    if _lk(ll) == "(" { ll = _ladv(ll) }
                    if _lk(ll) == ")" { ll = _ladv(ll) }
                    conv_method := if field == "parse" { "to" } else { field }
                    mr := _lower_conversion(ll, left, conv_method, target_type_name)
                    ll = mr.l
                    left = mr.temp
                } else {
                    // Check for no-data variant: Type.Variant (no parens).
                    // For data variants or plain field access, fall through to
                    // the type-aware field-access path below.
                    mut handled := false
                    atom_vtag := _variant_tag(ll.registry, field)
                    if atom_vtag > 0 {
                        atom_vparent := _variant_parent(ll.registry, field)
                        atom_vdc := variant_data_count(atom_vparent, atom_vtag)
                        if atom_vdc == 0 {
                            atom_alloc := sum_alloc_size(atom_vparent)
                            if atom_alloc > 1 {
                                vnt := _lnew_temp(ll)
                                ll = vnt.l
                                ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, atom_alloc, 0, atom_vparent.name, 0))
                                ast_id := _struct_type_id(ll.registry, atom_vparent.name)
                                if ast_id > 0 { ll = _lset_type(ll, vnt.temp, ast_id) }
                                avt := _lnew_temp(ll)
                                ll = avt.l
                                ll = _lemit(ll, new_inst(OpConst, avt.temp, atom_vtag, 0, "", 0))
                                ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, avt.temp, 0, "_tag", 0))
                                left = vnt.temp
                            } else {
                                vnt := _lnew_temp(ll)
                                ll = vnt.l
                                ll = _lemit(ll, new_inst(OpConst, vnt.temp, atom_vtag, 0, "", 0))
                                left = vnt.temp
                            }
                            handled = true
                        }
                    }
                    if handled == false {
                        // Type-aware field access
                        left_type := _lget_type(ll, left)
                        sname := _struct_name_for_type(ll.store, ll.registry, left_type)
                        mut fidx := 0
                        mut ft := 0
                        if sname != "" {
                            fidx = _field_index(ll.registry, sname, field)
                            ft = _field_type_id(ll, sname, field)
                        } else {
                            fidx = _field_index_any(ll.registry, field)
                            ft = _field_type_id_any(ll.registry, field)
                        }
                        mut nt_temp := 0
                        if ft == 12 {
                            nt := _lnew_str_temp(ll)
                            ll = nt.l
                            nt_temp = nt.temp
                        } else {
                            nt := _lnew_temp(ll)
                            ll = nt.l
                            nt_temp = nt.temp
                        }
                        if ft == 12 {
                            fidx_len := fidx + 1
                            nt_len := nt_temp + 1
                            ll = _lemit(ll, new_inst(OpFieldGet, nt_temp, left, fidx, field, 0))
                            ll = _lemit(ll, new_inst(OpFieldGet, nt_len, left, fidx_len, field, 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpFieldGet, nt_temp, left, fidx, field, 0))
                        }
                        if ft > 0 { ll = _lset_type(ll, nt_temp, ft) }
                        left = nt_temp
                    }
                }
            } else {
                running = false
            }
        } else if k == "[" {
            ll = _ladv(ll)
            idx := _lower_expr(ll)
            ll = idx.l
            if _lk(ll) == "]" { ll = _ladv(ll) }
            // Determine container kind
            left_type := _lget_type(ll, left)
            if left_type == 300 {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpMapGet, nt.temp, left, idx.temp, "", 0))
                left = nt.temp
            } else {
                elem_type := _array_elem_type(ll.store, left_type)
                if elem_type == 12 {
                    nt := _lnew_str_temp(ll)
                    ll = nt.l
                    ll = _lemit(ll, new_inst(OpArrayGet, nt.temp, left, idx.temp, "", 12))
                    ll = _lset_type(ll, nt.temp, 12)
                    left = nt.temp
                } else {
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    ll = _lemit(ll, new_inst(OpArrayGet, nt.temp, left, idx.temp, "", 0))
                    if elem_type > 0 {
                        ll = _lset_type(ll, nt.temp, elem_type)
                    }
                    left = nt.temp
                }
            }
        } else if k == "(" {
            cr := _lower_call_args(ll, left)
            ll = cr.l
            left = cr.temp
        } else if k == "?" {
            // Error propagation: unwrap Ok or early-return Err
            ll = _ladv(ll)
            ll = _emit_result_null_guard(ll, left)
            // Extract tag from slot 0
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, left, 0, "_tag", 0))
            // Compare tag to 1 (Err)
            const_one := _lnew_temp(ll)
            ll = const_one.l
            ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
            is_err := _lnew_temp(ll)
            ll = is_err.l
            ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
            // Branch on error
            err_lbl := _lnew_label(ll)
            ll = err_lbl.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, err_lbl.temp, "", 0))
            // Ok path: extract value from slot 1
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
            // Err path: early return the Result
            ll = _lemit(ll, new_inst(OpLabel, 0, err_lbl.temp, 0, "", 0))
            ll = _emit_defers(ll)
            ll = _lemit(ll, new_inst(OpRet, 0, left, 0, "", 0))
            // Continue with Ok value
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            left = ok_val.temp
        } else if k == "!" {
            // Assert-unwrap: unwrap Ok or panic
            ll = _ladv(ll)
            // Extract tag from slot 0
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, left, 0, "_tag", 0))
            // Compare tag to 1 (Err)
            const_one := _lnew_temp(ll)
            ll = const_one.l
            ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
            is_err := _lnew_temp(ll)
            ll = is_err.l
            ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
            // Branch on error
            panic_lbl := _lnew_label(ll)
            ll = panic_lbl.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, panic_lbl.temp, "", 0))
            // Ok path: extract value
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
            // Panic path: call _aria_panic
            ll = _lemit(ll, new_inst(OpLabel, 0, panic_lbl.temp, 0, "", 0))
            // Add panic message as string constant
            mut panic_str_idx := mod_find_string(ll.module, "unwrap failed on Err value")
            if panic_str_idx == 0 {
                new_mod := mod_add_string(ll.module, "unwrap failed on Err value")
                panic_str_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            panic_ptr := _lnew_str_temp(ll)
            ll = panic_ptr.l
            ll = _lemit(ll, new_inst(OpConstStr, panic_ptr.temp, panic_str_idx, 25, "", 0))
            ll = _lemit(ll, new_inst(OpCall, 0, panic_ptr.temp, 2, "_aria_panic", 0))
            // Continue with Ok value
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            left = ok_val.temp
        } else {
            running = false
        }
    }
    LT{l: ll, temp: left}
}

fn _lower_if_cond(l: Lowerer) -> LT {
    lb := "\{"
    result := _lower_atom(l)
    mut ll := result.l
    mut left := result.temp

    mut running := true
    while running {
        k := _lk(ll)
        if k == lb || k == "EOF" || k == "NEWLINE" {
            running = false
        } else if k == "==" || k == "!=" || k == "<" || k == ">" || k == "<=" || k == ">=" {
            ll = _ladv(ll)
            right := _lower_additive(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if (k == "==" || k == "!=") && left_type == 12 {
                ll = _lemit(ll, new_inst(OpStrEq, nt.temp, left, right.temp, "", 0))
                if k == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    left = not_nt.temp
                } else {
                    left = nt.temp
                }
            } else if (k == "==" || k == "!=") && (_is_option_or_result_type(ll.store, left_type) || _is_option_or_result_type(ll.store, right_type) || _lis_result(ll, left) || _lis_result(ll, right.temp)) {
                // Option / Result equality — tag + payload compare. This path is
                // reached for `if expr == expr { ... }` conditions; _lower_if_cond
                // has its own eq handler distinct from _lower_expr / _lower_comparison.
                a_tag := _lnew_temp(ll)
                ll = a_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_tag.temp, left, 0, "_tag", 0))
                b_tag := _lnew_temp(ll)
                ll = b_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_tag.temp, right.temp, 0, "_tag", 0))
                tag_eq := _lnew_temp(ll)
                ll = tag_eq.l
                ll = _lemit(ll, new_inst(OpEq, tag_eq.temp, a_tag.temp, b_tag.temp, "", 0))
                ll = _lset_type(ll, tag_eq.temp, 1)
                a_pay := _lnew_temp(ll)
                ll = a_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_pay.temp, left, 1, "_val", 0))
                b_pay := _lnew_temp(ll)
                ll = b_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_pay.temp, right.temp, 1, "_val", 0))
                pay_eq := _lnew_temp(ll)
                ll = pay_eq.l
                ll = _lemit(ll, new_inst(OpEq, pay_eq.temp, a_pay.temp, b_pay.temp, "", 0))
                ll = _lset_type(ll, pay_eq.temp, 1)
                mut combined := pay_eq.temp
                if _is_option_type(ll.store, left_type) || _is_option_type(ll.store, right_type) {
                    zero_c := _lnew_temp(ll)
                    ll = zero_c.l
                    ll = _lemit(ll, new_inst(OpConst, zero_c.temp, 0, 0, "", 0))
                    is_none := _lnew_temp(ll)
                    ll = is_none.l
                    ll = _lemit(ll, new_inst(OpEq, is_none.temp, a_tag.temp, zero_c.temp, "", 0))
                    ll = _lset_type(ll, is_none.temp, 1)
                    or_nt := _lnew_temp(ll)
                    ll = or_nt.l
                    ll = _lemit(ll, new_inst(OpOr, or_nt.temp, is_none.temp, pay_eq.temp, "", 0))
                    ll = _lset_type(ll, or_nt.temp, 1)
                    combined = or_nt.temp
                }
                ll = _lemit(ll, new_inst(OpAnd, nt.temp, tag_eq.temp, combined, "", 0))
                if k == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    ll = _lset_type(ll, not_nt.temp, 1)
                    left = not_nt.temp
                } else {
                    left = nt.temp
                }
            } else if _is_float_type(left_type) || _is_float_type(right_type) {
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "f64", 0))
                left = nt.temp
            } else if left_type == 12 {
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpStrCmp, cmp_nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, cmp_nt.temp, 1)
                zero_nt := _lnew_temp(ll)
                ll = zero_nt.l
                ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
                ll = _lset_type(ll, zero_nt.temp, 1)
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, cmp_nt.temp, zero_nt.temp, "", 0))
                left = nt.temp
            } else {
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "", 0))
                left = nt.temp
            }
        } else if k == "&&" {
            ll = _ladv(ll)
            right := _lower_comparison(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAnd, nt.temp, left, right.temp, "", 0))
            left = nt.temp
        } else if k == "||" {
            ll = _ladv(ll)
            right := _lower_comparison(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpOr, nt.temp, left, right.temp, "", 0))
            left = nt.temp
        } else if k == "+" || k == "-" {
            ll = _ladv(ll)
            right := _lower_multiplicative(ll)
            ll = right.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if k == "+" && left_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpStrConcat, nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                left = nt.temp
            } else if _is_float_type(left_type) || _is_float_type(right_type) {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
                left = nt.temp
            } else {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
                left = nt.temp
            }
        } else if k == "*" || k == "/" || k == "%" {
            ll = _ladv(ll)
            right := _lower_atom(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if _is_float_type(left_type) || _is_float_type(right_type) {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
            } else {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
            }
            left = nt.temp
        } else {
            running = false
        }
    }
    // Skip remaining tokens until {
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }
    LT{l: ll, temp: left}
}

// --- Lower if expression ---

fn _lower_if(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip if
    lb := "\{"
    rb := "\}"

    // Lower condition using full expression parser
    cond := _lower_if_cond(ll)
    ll = cond.l

    else_lbl := _lnew_label(ll)
    ll = else_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l

    // Allocate result temp — use 2 slots for safety (string fat pointers need ptr+len)
    result_nt := _lnew_str_temp(ll)
    ll = result_nt.l

    // Branch to else if condition is false
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond.temp, else_lbl.temp, "", 0))

    // Then block — process statements and capture last expression
    mut then_last := -1
    if _lk(ll) == lb {
        ll = _ladv(ll)
        ll = _lskip_nl(ll)
        while _lk(ll) != rb && _lk(ll) != "EOF" {
            k := _lk(ll)
            if k == "return" || k == "mut" || k == "break" || k == "continue" || k == "for" || k == "while" || k == "loop" || k == "assert" || k == "defer" || k == "with" {
                ll = _lower_stmt(ll)
            } else if k == "if" {
                r := _lower_if(ll)
                ll = r.l
                then_last = r.temp
            } else {
                r := _lower_expr_result(ll)
                ll = r.l
                then_last = r.temp
            }
            ll = _lskip_nl(ll)
        }
        if _lk(ll) == rb { ll = _ladv(ll) }
        // Store last expression to result temp — only copy second slot for string types
        if then_last >= 0 {
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, then_last, 0, "", 0))
            then_type := _lget_type(ll, then_last)
            if then_type == 12 {
                then_len_dst := result_nt.temp + 1
                then_len_src := then_last + 1
                ll = _lemit(ll, new_inst(OpStore, then_len_dst, then_len_src, 0, "", 0))
            }
            ll = _lset_type(ll, result_nt.temp, then_type)
        }
    }
    ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))

    // Else label
    ll = _lemit(ll, new_inst(OpLabel, 0, else_lbl.temp, 0, "", 0))

    // Else block
    if _lk(ll) == "else" {
        ll = _ladv(ll)
        if _lk(ll) == "if" {
            else_result := _lower_if(ll)
            ll = else_result.l
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, else_result.temp, 0, "", 0))
            eif_type := _lget_type(ll, else_result.temp)
            if eif_type == 12 {
                eif_len_dst := result_nt.temp + 1
                eif_len_src := else_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, eif_len_dst, eif_len_src, 0, "", 0))
            }
            ll = _lset_type(ll, result_nt.temp, eif_type)
        } else if _lk(ll) == lb {
            ll = _ladv(ll)
            ll = _lskip_nl(ll)
            mut else_last := -1
            while _lk(ll) != rb && _lk(ll) != "EOF" {
                k := _lk(ll)
                if k == "return" || k == "mut" || k == "break" || k == "continue" || k == "for" || k == "while" || k == "loop" || k == "assert" || k == "defer" || k == "with" {
                    ll = _lower_stmt(ll)
                } else if k == "if" {
                    r := _lower_if(ll)
                    ll = r.l
                    else_last = r.temp
                } else {
                    r := _lower_expr_result(ll)
                    ll = r.l
                    else_last = r.temp
                }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == rb { ll = _ladv(ll) }
            if else_last >= 0 {
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, else_last, 0, "", 0))
                else_type := _lget_type(ll, else_last)
                if else_type == 12 {
                    else_len_dst := result_nt.temp + 1
                    else_len_src := else_last + 1
                    ll = _lemit(ll, new_inst(OpStore, else_len_dst, else_len_src, 0, "", 0))
                }
                ll = _lset_type(ll, result_nt.temp, else_type)
            }
        }
    }

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))

    LT{l: ll, temp: result_nt.temp}
}

// --- Lower while loop ---

fn _lower_while(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip while
    lb := "\{"

    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l

    // Loop start
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))

    // Lower condition using full expression parser (stops at {)
    cond := _lower_if_cond(ll)
    ll = cond.l

    // Branch to end if false
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond.temp, end_lbl.temp, "", 0))

    // Set loop labels for break/continue
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = _lset_loop(ll, loop_lbl.temp, end_lbl.temp)

    // Body
    ll = _lower_block(ll)

    // Restore loop labels
    ll = _lset_loop(ll, prev_start, prev_end)

    // Jump back to loop start
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll
}

// --- Lower for-in with range ---

fn _lower_for_range(l: Lowerer, var_name: str, inclusive: bool) -> Lowerer {
    mut ll := l
    lb := "\{"

    // Lower start expression (before .. or ..=)
    start := _lower_expr(ll)
    ll = start.l
    // Skip .. or ..=
    if _lk(ll) == ".." || _lk(ll) == "..=" { ll = _ladv(ll) }
    // Lower end expression
    end := _lower_expr(ll)
    ll = end.l
    // Skip remaining until {
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }

    // If inclusive, add 1 to end: end_val = end + 1
    mut limit_temp := end.temp
    if inclusive {
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        inc_nt := _lnew_temp(ll)
        ll = inc_nt.l
        ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, end.temp, one_nt.temp, "", 0))
        limit_temp = inc_nt.temp
    }

    // Initialize loop var to start
    idx_nt := _lnew_temp(ll)
    ll = idx_nt.l
    ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, start.temp, 0, "", 0))

    // Labels
    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    inc_lbl := _lnew_label(ll)
    ll = inc_lbl.l

    // Loop start
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))

    // Condition: idx < limit
    cond_nt := _lnew_temp(ll)
    ll = cond_nt.l
    ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, limit_temp, "", 0))
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))

    // Bind loop variable
    if var_name != "" {
        ll = _lenv_add(ll, var_name, idx_nt.temp)
    }

    // Set break/continue labels (continue jumps to increment)
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                 table: ll.table, file: ll.file, module: ll.module,
                 current_func: ll.current_func,
                 temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                 env_names: ll.env_names, env_slots: ll.env_slots,
                 loop_start: inc_lbl.temp, loop_end: end_lbl.temp,
                 const_names: ll.const_names, const_vals: ll.const_vals,
                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                 temp_types: ll.temp_types, is_result: ll.is_result,
            fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}

    // Body
    ll = _lower_block(ll)

    // Restore loop labels
    ll = _lset_loop(ll, prev_start, prev_end)

    // Increment label (continue target)
    ll = _lemit(ll, new_inst(OpLabel, 0, inc_lbl.temp, 0, "", 0))

    // Increment: idx = idx + 1
    one_nt := _lnew_temp(ll)
    ll = one_nt.l
    ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
    inc_nt := _lnew_temp(ll)
    ll = inc_nt.l
    ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
    ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))

    // Jump back
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll
}

// --- Lower loop (infinite) ---

fn _lower_loop(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip loop

    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l

    // Loop start
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))

    // Set loop labels for break/continue
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = _lset_loop(ll, loop_lbl.temp, end_lbl.temp)

    // Body
    ll = _lower_block(ll)

    // Restore loop labels
    ll = _lset_loop(ll, prev_start, prev_end)

    // Jump back to loop start
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll
}

// --- Lower for loop ---

fn _lower_for(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip for
    lb := "\{"

    // Get loop variable name(s)
    mut var_name := ""
    mut var_name2 := ""
    mut is_tuple_for := false
    if _lk(ll) == "(" {
        // Tuple destructuring: for (i, x) in arr
        ll = _ladv(ll)  // skip (
        if _lk(ll) == "IDENT" { var_name = _lcur(ll).text; ll = _ladv(ll) }
        if _lk(ll) == "," { ll = _ladv(ll) }
        if _lk(ll) == "IDENT" { var_name2 = _lcur(ll).text; ll = _ladv(ll); is_tuple_for = true }
        if _lk(ll) == ")" { ll = _ladv(ll) }
    } else if _lk(ll) == "IDENT" {
        var_name = _lcur(ll).text
        ll = _ladv(ll)
    }
    if _lk(ll) == "in" { ll = _ladv(ll) }

    // Check if iterator is a range expression (peek for .. or ..=)
    mut is_range := false
    mut is_inclusive := false
    mut peek := ll.pos
    while peek < ll.tokens.len() {
        pk := ll.tokens[peek].name
        if pk == ".." { is_range = true }
        if pk == "..=" { is_range = true }
        if pk == "..=" { is_inclusive = true }
        if pk == lb || pk == "EOF" || pk == "NEWLINE" { peek = ll.tokens.len() }
        peek = peek + 1
    }

    if is_range {
        return _lower_for_range(ll, var_name, is_inclusive)
    }

    // Lower iterator expression
    iter := _lower_expr(ll)
    ll = iter.l
    // Skip remaining until {
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }

    // Check if iterator is a channel (by TypeKind, not ID — ID 17 can collide with user types)
    iter_type_check := _lget_type(ll, iter.temp)
    mut is_chan := false
    if iter_type_check > 0 && iter_type_check < ll.store.types.len() {
        iter_kind := type_kind_name(ll.store.types[iter_type_check].kind)
        iname := ll.store.types[iter_type_check].name
        if iter_kind == "Named" && (iname == "chan" || iname == "chan.str" || iname == "Chan" || iname == "Channel") {
            is_chan = true
        }
    }
    if is_chan {
        return _lower_for_channel(ll, var_name, iter.temp)
    }

    // Array iteration path
    // Get array length
    len_nt := _lnew_temp(ll)
    ll = len_nt.l
    ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, iter.temp, 0, "", 0))

    // Initialize index to 0
    idx_nt := _lnew_temp(ll)
    ll = idx_nt.l
    ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))

    // Determine array element type
    iter_type := _lget_type(ll, iter.temp)

    // Labels
    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    inc_lbl := _lnew_label(ll)
    ll = inc_lbl.l

    // Loop start
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))

    // Condition: idx < len
    cond_nt := _lnew_temp(ll)
    ll = cond_nt.l
    ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, len_nt.temp, "", 0))
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))

    // Load arr[idx] into loop variable(s)
    if var_name != "" {
        if is_tuple_for {
            // Tuple: first name = index, second name = element
            ll = _lenv_add(ll, var_name, idx_nt.temp)
            if var_name2.len() > 0 {
                if iter_type == 13 || _is_str_array_type(ll.store, iter_type) {
                    elem_nt := _lnew_str_temp(ll)
                    ll = elem_nt.l
                    ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 12))
                    ll = _lset_type(ll, elem_nt.temp, 12)
                    ll = _lenv_add(ll, var_name2, elem_nt.temp)
                } else {
                    elem_nt := _lnew_temp(ll)
                    ll = elem_nt.l
                    ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
                    ll = _lenv_add(ll, var_name2, elem_nt.temp)
                }
            }
        } else if iter_type == 13 || _is_str_array_type(ll.store, iter_type) {
            elem_nt := _lnew_str_temp(ll)
            ll = elem_nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 12))
            ll = _lset_type(ll, elem_nt.temp, 12)
            ll = _lenv_add(ll, var_name, elem_nt.temp)
        } else {
            elem_nt := _lnew_temp(ll)
            ll = elem_nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
            // Propagate element type to the loop variable so downstream field
            // accesses can resolve `c.f` via the correct struct definition. Without
            // this, `_struct_name_for_type` returns "" and field lookups fall back
            // to a name-keyed any-match that can pick a wrong same-named field.
            elem_type := _array_elem_type(ll.store, iter_type)
            if elem_type > 0 { ll = _lset_type(ll, elem_nt.temp, elem_type) }
            ll = _lenv_add(ll, var_name, elem_nt.temp)
        }
    }

    // Set break/continue labels (continue jumps to increment)
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                 table: ll.table, file: ll.file, module: ll.module,
                 current_func: ll.current_func,
                 temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                 env_names: ll.env_names, env_slots: ll.env_slots,
                 loop_start: inc_lbl.temp, loop_end: end_lbl.temp,
                 const_names: ll.const_names, const_vals: ll.const_vals,
                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                 temp_types: ll.temp_types, is_result: ll.is_result,
            fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}

    // Body
    ll = _lower_block(ll)

    // Restore loop labels
    ll = _lset_loop(ll, prev_start, prev_end)

    // Increment label (continue target)
    ll = _lemit(ll, new_inst(OpLabel, 0, inc_lbl.temp, 0, "", 0))

    // Increment index: idx = idx + 1
    one_nt := _lnew_temp(ll)
    ll = one_nt.l
    ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
    inc_nt := _lnew_temp(ll)
    ll = inc_nt.l
    ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
    ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))

    // Jump back
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll
}

// --- Lower for-in-channel ---
// for msg in ch { body } desugars to:
//   loop { {val, status} = try_recv(ch); if status == 0 { break }; msg = val; body }

fn _lower_for_channel(l: Lowerer, var_name: str, ch_temp: i64) -> Lowerer {
    mut ll := l
    lb := "\{"
    rb := "\}"

    // Labels
    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l

    // Loop start
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))

    // Call _aria_chan_recv_ok(ch) -> {value, status}. Unlike try_recv,
    // this blocks when the channel is empty-but-not-closed, so the loop
    // waits for the next value instead of prematurely exiting between
    // producer sends. status=0 means the channel is drained for good.
    recv_nt := _lnew_str_temp(ll)
    ll = recv_nt.l
    ll = _lemit(ll, new_inst(OpCall, recv_nt.temp, ch_temp, 1, "_aria_chan_recv_ok", 0))

    // Check status (recv_nt.temp + 1): if 0, break
    status_nt := _lnew_temp(ll)
    ll = status_nt.l
    ll = _lemit(ll, new_inst(OpLoad, status_nt.temp, recv_nt.temp + 1, 0, "", 0))
    zero_nt := _lnew_temp(ll)
    ll = zero_nt.l
    ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
    cmp_nt := _lnew_temp(ll)
    ll = cmp_nt.l
    ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, status_nt.temp, zero_nt.temp, "", 0))
    ll = _lemit(ll, new_inst(OpBranchTrue, 0, cmp_nt.temp, end_lbl.temp, "", 0))

    // Bind value to loop variable. chan[str] (TY_CHAN_STR=21) carries a
    // 2-slot box containing (ptr, len) — unbox into a str-temp pair so the
    // loop body sees a real str value.
    if var_name != "" {
        ch_elem_is_str := _lget_type(ll, ch_temp) == 21
        if ch_elem_is_str {
            box_nt := _lnew_temp(ll)
            ll = box_nt.l
            ll = _lemit(ll, new_inst(OpLoad, box_nt.temp, recv_nt.temp, 0, "", 0))
            str_nt := _lnew_str_temp(ll)
            ll = str_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp, box_nt.temp, 0, "_ptr", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp + 1, box_nt.temp, 1, "_len", 0))
            ll = _lset_type(ll, str_nt.temp, 12)
            ll = _lenv_add(ll, var_name, str_nt.temp)
        } else {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpLoad, val_nt.temp, recv_nt.temp, 0, "", 0))
            ll = _lenv_add(ll, var_name, val_nt.temp)
        }
    }

    // Set loop labels
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = _lset_loop(ll, loop_lbl.temp, end_lbl.temp)

    // Body
    ll = _lower_block(ll)

    // Restore loop labels
    ll = _lset_loop(ll, prev_start, prev_end)

    // Jump back
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))

    // End
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll
}

// --- Lower interpolated string ---

// Convert an interpolated-position expression temp to a str temp for concat.
// Dispatches on the temp's static type: str → use as-is; f64 → hint "f64";
// Option<T> → branch on tag, emit "None" or "Some(<payload_str>)"; other
// scalars → OpIntToStr with no hint. Shared between the two emit blocks in
// _lower_interpolated_string (DRY — adding a new formatter is one branch).
fn _lower_interp_to_str(l: Lowerer, val: i64) -> LT {
    mut ll := l
    t := _lget_type(ll, val)
    if t == 12 { return LT{l: ll, temp: val} }
    // Bool interp: emit "true" / "false" instead of 1 / 0.
    if t == 11 {
        true_s := _lower_string_const(ll, "true")
        ll = true_s.l
        false_s := _lower_string_const(ll, "false")
        ll = false_s.l
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        ll = _lset_type(ll, result_nt.temp, 12)
        is_false := _lnew_temp(ll)
        ll = is_false.l
        zero_c := _lnew_temp(ll)
        ll = zero_c.l
        ll = _lemit(ll, new_inst(OpConst, zero_c.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpEq, is_false.temp, val, zero_c.temp, "", 0))
        true_lbl := _lnew_label(ll)
        ll = true_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_false.temp, true_lbl.temp, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, false_s.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, false_s.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, true_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, true_s.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, true_s.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: result_nt.temp}
    }
    // Option interp: print "None" or "Some(<payload>)". Covers common cases
    // like println("First: {arr.first()}") where first() returns Option<T>.
    if _is_option_type(ll.store, t) {
        payload_t := 1
        if t > 16 && t < ll.store.types.len() {
            info := store_get(ll.store, t)
            if info.type_id > 0 { payload_t = info.type_id }
        }
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, val, 0, "_tag", 0))
        zero_c := _lnew_temp(ll)
        ll = zero_c.l
        ll = _lemit(ll, new_inst(OpConst, zero_c.temp, 0, 0, "", 0))
        is_none := _lnew_temp(ll)
        ll = is_none.l
        ll = _lemit(ll, new_inst(OpEq, is_none.temp, tag_nt.temp, zero_c.temp, "", 0))
        // None text
        none_text := _lower_string_const(ll, "None")
        ll = none_text.l
        // Some branch: payload-to-str wrapped in "Some(...)"
        some_lbl := _lnew_label(ll)
        ll = some_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        ll = _lset_type(ll, result_nt.temp, 12)
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_none.temp, some_lbl.temp, "", 0))
        // None path
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, none_text.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, none_text.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        // Some path. String payloads span two slots (ptr + len); read both.
        ll = _lemit(ll, new_inst(OpLabel, 0, some_lbl.temp, 0, "", 0))
        mut payload_temp := 0
        if payload_t == 12 {
            payload := _lnew_str_temp(ll)
            ll = payload.l
            ll = _lemit(ll, new_inst(OpFieldGet, payload.temp, val, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, payload.temp + 1, val, 2, "_val_len", 0))
            ll = _lset_type(ll, payload.temp, 12)
            payload_temp = payload.temp
        } else {
            payload := _lnew_temp(ll)
            ll = payload.l
            ll = _lemit(ll, new_inst(OpFieldGet, payload.temp, val, 1, "_val", 0))
            if payload_t > 0 { ll = _lset_type(ll, payload.temp, payload_t) }
            payload_temp = payload.temp
        }
        // Convert payload to str (recursive via same helper handles nested Options)
        ps := _lower_interp_to_str(ll, payload_temp)
        ll = ps.l
        prefix := _lower_string_const(ll, "Some(")
        ll = prefix.l
        suffix := _lower_string_const(ll, ")")
        ll = suffix.l
        c1 := _lnew_str_temp(ll)
        ll = c1.l
        ll = _lemit(ll, new_inst(OpStrConcat, c1.temp, prefix.temp, ps.temp, "", 0))
        ll = _lset_type(ll, c1.temp, 12)
        c2 := _lnew_str_temp(ll)
        ll = c2.l
        ll = _lemit(ll, new_inst(OpStrConcat, c2.temp, c1.temp, suffix.temp, "", 0))
        ll = _lset_type(ll, c2.temp, 12)
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, c2.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, c2.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: result_nt.temp}
    }
    // User sum-type (enum) variants — interpolate as variant name.
    sname := _struct_name_for_type(ll.store, ll.registry, t)
    if sname != "" {
        sdef := reg_find_struct(ll.registry, sname)
        if sdef.is_sum && sdef.variant_names.len() > 1 {
            // Read tag: if any variant carries data, tag is at slot 0; else val
            // itself is the tag.
            tag_src := val
            mut tag_temp := tag_src
            if sum_has_data(sdef) {
                tnt := _lnew_temp(ll)
                ll = tnt.l
                ll = _lemit(ll, new_inst(OpFieldGet, tnt.temp, val, 0, "_tag", 0))
                tag_temp = tnt.temp
            }
            // Build a branch cascade over the known variant tags. Tags are 1-based.
            // Default (unreachable) falls through as "" to keep control flow sound.
            result_nt := _lnew_str_temp(ll)
            ll = result_nt.l
            ll = _lset_type(ll, result_nt.temp, 12)
            end_lbl := _lnew_label(ll)
            ll = end_lbl.l
            // Seed result with the first variant's name; then compare & overwrite
            // for later variants. This avoids needing a fall-through default.
            mut vi := 1
            while vi < sdef.variant_names.len() {
                vname := sdef.variant_names[vi]
                vstr := _lower_string_const(ll, vname)
                ll = vstr.l
                if vi == 1 {
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, vstr.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, vstr.temp + 1, 0, "", 0))
                } else {
                    vtag_c := _lnew_temp(ll)
                    ll = vtag_c.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_c.temp, vi, 0, "", 0))
                    vcmp := _lnew_temp(ll)
                    ll = vcmp.l
                    ll = _lemit(ll, new_inst(OpEq, vcmp.temp, tag_temp, vtag_c.temp, "", 0))
                    skip_lbl := _lnew_label(ll)
                    ll = skip_lbl.l
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, vcmp.temp, skip_lbl.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, vstr.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, vstr.temp + 1, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
                }
                vi = vi + 1
            }
            ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
            return LT{l: ll, temp: result_nt.temp}
        }
    }
    conv_nt := _lnew_str_temp(ll)
    ll = conv_nt.l
    mut hint := ""
    if _is_float_type(t) { hint = "f64" }
    // [i64] array interp: dispatch to the runtime array-formatter.
    if t > 16 && t < ll.store.types.len() {
        ainfo := store_get(ll.store, t)
        if type_kind_name(ainfo.kind) == "Array" {
            hint = "array_int"
        }
    }
    ll = _lemit(ll, new_inst(OpIntToStr, conv_nt.temp, val, 0, hint, 0))
    ll = _lset_type(ll, conv_nt.temp, 12)
    LT{l: ll, temp: conv_nt.temp}
}

fn _lower_interpolated_string(l: Lowerer) -> LT {
    // STRING_START text, expr tokens..., (STRING_MIDDLE text, expr tokens...)*, STRING_END text
    // Build result by concatenating: start_text + toString(expr) + middle_text + toString(expr2) + ... + end_text
    mut ll := l

    // Emit start string
    start_text := _lcur(ll).text
    start_result := _lower_string_const(ll, start_text)
    ll = start_result.l
    ll = _ladv(ll)  // skip STRING_START token
    mut result := start_result.temp

    // Process expression + optional middle segments
    mut running := true
    while running {
        if _lk(ll) == "STRING_END" || _lk(ll) == "STRING_MIDDLE" || _lk(ll) == "EOF" {
            running = false
        } else {
            expr := _lower_expr(ll)
            ll = expr.l
            s := _lower_interp_to_str(ll, expr.temp)
            ll = s.l
            cat_nt := _lnew_str_temp(ll)
            ll = cat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, result, s.temp, "", 0))
            ll = _lset_type(ll, cat_nt.temp, 12)
            result = cat_nt.temp
        }
    }

    // Process STRING_MIDDLE or STRING_END
    while _lk(ll) == "STRING_MIDDLE" {
        mid_text := _lcur(ll).text
        ll = _ladv(ll)  // skip STRING_MIDDLE
        // Concat middle text
        if mid_text.len() > 0 {
            mid_result := _lower_string_const(ll, mid_text)
            ll = mid_result.l
            cat_nt := _lnew_str_temp(ll)
            ll = cat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, result, mid_result.temp, "", 0))
            ll = _lset_type(ll, cat_nt.temp, 12)
            result = cat_nt.temp
        }
        // Lower next expression
        mut expr_running := true
        while expr_running {
            if _lk(ll) == "STRING_END" || _lk(ll) == "STRING_MIDDLE" || _lk(ll) == "EOF" {
                expr_running = false
            } else {
                expr := _lower_expr(ll)
                ll = expr.l
                s := _lower_interp_to_str(ll, expr.temp)
                ll = s.l
                cat_nt := _lnew_str_temp(ll)
                ll = cat_nt.l
                ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, result, s.temp, "", 0))
                ll = _lset_type(ll, cat_nt.temp, 12)
                result = cat_nt.temp
            }
        }
    }

    // STRING_END
    if _lk(ll) == "STRING_END" {
        end_text := _lcur(ll).text
        ll = _ladv(ll)  // skip STRING_END
        if end_text.len() > 0 {
            end_result := _lower_string_const(ll, end_text)
            ll = end_result.l
            cat_nt := _lnew_str_temp(ll)
            ll = cat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, result, end_result.temp, "", 0))
            ll = _lset_type(ll, cat_nt.temp, 12)
            result = cat_nt.temp
        }
    }

    ll = _lset_type(ll, result, 12)
    LT{l: ll, temp: result}
}

// --- Defer helpers ---

fn _lappend_defer(l: Lowerer, start: i64, end: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types, is_result: l.is_result,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts.append(start), defer_ends: l.defer_ends.append(end)}

// Emit deferred expressions in reverse order (LIFO)
// Emit a null-pointer guard before unwrapping a Result value. If `val`
// is 0 (e.g. a stub returned no Result), panic with a clear message
// rather than segfaulting on the downstream FieldGet("_tag").
fn _emit_result_null_guard(l: Lowerer, val: i64) -> Lowerer {
    mut ll := l
    zero_nt := _lnew_temp(ll)
    ll = zero_nt.l
    ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
    is_null := _lnew_temp(ll)
    ll = is_null.l
    ll = _lemit(ll, new_inst(OpEq, is_null.temp, val, zero_nt.temp, "", 0))
    skip_lbl := _lnew_label(ll)
    ll = skip_lbl.l
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_null.temp, skip_lbl.temp, "", 0))
    msg := "internal error: null Result"
    mut msg_idx := mod_find_string(ll.module, msg)
    if msg_idx == 0 {
        new_mod := mod_add_string(ll.module, msg)
        msg_idx = new_mod.string_constants.len() - 1
        ll = _lset_mod(ll, new_mod)
    }
    panic_ptr := _lnew_str_temp(ll)
    ll = panic_ptr.l
    ll = _lemit(ll, new_inst(OpConstStr, panic_ptr.temp, msg_idx, 27, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, panic_ptr.temp, 2, "_aria_panic", 0))
    ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
    ll
}

fn _emit_defers(l: Lowerer) -> Lowerer {
    mut ll := l
    // Emit drop calls for bindings whose types implement Drop (reverse order)
    ll = _emit_drops(ll)
    defer_count := ll.defer_starts.len() - 1
    if defer_count == 0 { return ll }
    // Emit in reverse order: last defer first
    mut di := defer_count
    while di >= 1 {
        ds := ll.defer_starts[di]
        de := ll.defer_ends[di]
        if ds > 0 && de > ds {
            saved_pos := ll.pos
            ll = _lset_pos(ll, ds)
            result := _lower_expr(ll)
            ll = result.l
            ll = _lset_pos(ll, saved_pos)
        }
        di = di - 1
    }
    ll
}

// --- Trait object (dyn Trait) construction ---
// Creates a fat pointer: (data_ptr, vtable_ptr) where vtable contains fn ptrs.
// concrete_type: the struct type name, trait_name: the trait being implemented
// The vtable stores fn ptrs for each method: ConcreteType_methodName
fn _lower_make_trait_object(l: Lowerer, data_temp: i64, concrete_type: str, trait_name: str) -> LT {
    mut ll := l
    // Build vtable using the trait's method list for consistent slot ordering
    tdef := treg_find_trait(ll.treg, trait_name)
    // Count trait methods (skip sentinel at index 0)
    method_count := tdef.method_names.len() - 1
    if method_count == 0 {
        return LT{l: ll, temp: data_temp}
    }
    // Allocate vtable with one slot per trait method
    vt_nt := _lnew_temp(ll)
    ll = vt_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, vt_nt.temp, method_count, 0, "_vtable", 0))
    // Store fn ptr for each trait method in order
    mut vi := 1
    while vi < tdef.method_names.len() {
        mname := tdef.method_names[vi]
        fn_name := concrete_type + "_" + mname
        // Verify function exists in registry
        sig := reg_find_fn(ll.registry, fn_name)
        fn_nt := _lnew_temp(ll)
        ll = fn_nt.l
        if sig.name != "" {
            ll = _lemit(ll, new_inst(OpFnRef, fn_nt.temp, 0, 0, fn_name, 0))
        } else {
            // Method not found — store null (will crash at dispatch, which is better than wrong slot)
            ll = _lemit(ll, new_inst(OpConst, fn_nt.temp, 0, 0, "", 0))
        }
        slot := vi - 1
        ll = _lemit(ll, new_inst(OpFieldSet, vt_nt.temp, fn_nt.temp, slot, "", 0))
        vi = vi + 1
    }
    // Create trait object: alloc 2 slots, store data_ptr and vtable_ptr
    to_nt := _lnew_temp(ll)
    ll = to_nt.l
    ll = _lemit(ll, new_inst(OpTraitObject, to_nt.temp, data_temp, vt_nt.temp, trait_name, 0))
    ll = _lset_type(ll, to_nt.temp, 500)  // 500 = trait object marker
    LT{l: ll, temp: to_nt.temp}
}

// Emit drop calls for bindings with Drop-implementing types
// scope_start: index in env_names where current scope begins (only drop bindings >= scope_start)
fn _emit_drops_scoped(l: Lowerer, scope_start: i64) -> Lowerer {
    mut ll := l
    // Walk bindings in reverse order (LIFO destruction order)
    mut i := ll.env_names.len() - 1
    while i >= scope_start && i > 0 {
        slot := ll.env_slots[i]
        // Check if this binding's type has a drop function
        obj_type := _lget_type(ll, slot)
        sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
        if sname != "" {
            drop_fn := sname + "_drop"
            // Don't call Type_drop from within Type_drop itself — infinite recursion
            // on the `self` parameter would otherwise happen for every Drop impl.
            if drop_fn != ll.current_func.name {
                drop_sig := reg_find_fn(ll.registry, drop_fn)
                if drop_sig.name != "" {
                    // Emit: TypeName_drop(binding)
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    ll = _lemit(ll, new_inst(OpCall, nt.temp, slot, 1, drop_fn, 0))
                }
            }
        }
        i = i - 1
    }
    ll
}

// Emit drops for all bindings (used at function exit)
fn _emit_drops(l: Lowerer) -> Lowerer =
    _emit_drops_scoped(l, 1)

// --- Lower closure expression ---

fn _lower_closure(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip fn
    // Optional `once` keyword — consume and ignore at lowering (semantic only)
    if _lk(ll) == "IDENT" && _lcur(ll).text == "once" {
        ll = _ladv(ll)
    }
    // Generate unique closure name using module-level counter
    closure_name := "_closure_" + i2s(ll.module.closure_count)
    ll = _lset_mod(ll, mod_next_closure(ll.module))

    // Parse parameter names and types from annotations via resolve_type_name
    mut param_names := [""]
    mut param_types := [0]
    if _lk(ll) == "(" {
        ll = _ladv(ll)  // skip (
        while _lk(ll) != ")" && _lk(ll) != "EOF" {
            if _lk(ll) == "IDENT" || _lk(ll) == "self" {
                ptext := _lcur(ll).text
                ll = _ladv(ll)
                // Parse type annotation — resolve to type id
                mut ptid := 0
                if _lk(ll) == ":" {
                    ll = _ladv(ll)
                    if _lk(ll) == "IDENT" {
                        resolved := resolve_type_name(ll.store, _lcur(ll).text)
                        if resolved != TY_UNKNOWN { ptid = resolved }
                    }
                    while _lk(ll) != "," && _lk(ll) != ")" && _lk(ll) != "EOF" {
                        ll = _ladv(ll)
                    }
                }
                param_names = param_names.append(ptext)
                param_types = param_types.append(ptid)
            } else {
                ll = _ladv(ll)
            }
            if _lk(ll) == "," { ll = _ladv(ll) }
        }
        if _lk(ll) == ")" { ll = _ladv(ll) }
    }
    param_count := param_names.len() - 1
    // Parse return type annotation
    mut ret_type := 1
    lb2 := "\{"
    if _lk(ll) == "->" {
        ll = _ladv(ll)
        if _lk(ll) == "IDENT" {
            rtid := resolve_type_name(ll.store, _lcur(ll).text)
            if rtid != TY_UNKNOWN { ret_type = rtid }
        }
        while _lk(ll) != "=>" && _lk(ll) != "=" && _lk(ll) != lb2 && _lk(ll) != "EOF" { ll = _ladv(ll) }
    }
    // Skip => or =
    if _lk(ll) == "=>" || _lk(ll) == "=" { ll = _ladv(ll) }
    ll = _lskip_nl(ll)

    // Save body position — we'll lower it inside the closure function
    body_start := ll.pos

    // Skip body expression to find the end (for the outer context)
    // The body is a single expression until newline or }
    lb := "\{"
    if _lk(ll) == lb {
        ll = _skip_braces_l(ll)
    } else {
        // Skip single expression — advance until statement boundary
        // Must NOT return early; just find the end position for the body
        mut depth := 0
        mut found_end := false
        while _lk(ll) != "NEWLINE" && _lk(ll) != "EOF" && found_end == false {
            if _lk(ll) == "(" { depth = depth + 1 }
            if _lk(ll) == ")" {
                if depth == 0 { found_end = true } else { depth = depth - 1 }
            }
            if found_end == false {
                if _lk(ll) == "," && depth == 0 { found_end = true }
            }
            if found_end == false { ll = _ladv(ll) }
        }
    }
    body_end := ll.pos

    // Save current function state
    saved_func := ll.current_func
    saved_temp := ll.temp_counter
    saved_label := ll.label_counter
    saved_env_names := ll.env_names
    saved_env_slots := ll.env_slots
    saved_types := ll.temp_types
    saved_is_result := ll.is_result
    saved_err_type := ll.fn_error_type

    // Scan for captured variables: identifiers in body that exist in outer env
    // but are NOT closure parameters
    mut cap_names := [""]
    mut cap_slots := [0]
    // Scan body tokens for captures
    mut scan_pos := body_start
    while scan_pos < body_end && scan_pos < ll.tokens.len() {
        stok := ll.tokens[scan_pos]
        if stok.name == "IDENT" {
            sname := stok.text
            // Check if it's in outer env
            outer_slot := _lenv_lookup(ll, sname)
            if outer_slot >= 0 {
                // Check it's not a closure parameter
                mut is_param := false
                mut pci := 1
                while pci < param_names.len() {
                    if param_names[pci] == sname { is_param = true }
                    pci = pci + 1
                }
                if is_param == false {
                    // Check not already captured
                    mut already := false
                    mut cci := 1
                    while cci < cap_names.len() {
                        if cap_names[cci] == sname { already = true }
                        cci = cci + 1
                    }
                    if already == false {
                        cap_names = cap_names.append(sname)
                        cap_slots = cap_slots.append(outer_slot)
                    }
                }
            }
        }
        scan_pos = scan_pos + 1
    }
    cap_count := cap_names.len() - 1

    // Create closure function: env_ptr + str-params take 2 regs each
    mut actual_params := 1
    mut reg_pi := 1
    while reg_pi < param_types.len() {
        if param_types[reg_pi] == 12 { actual_params = actual_params + 2 } else { actual_params = actual_params + 1 }
        reg_pi = reg_pi + 1
    }
    ll = _lset_func(ll, new_ir_func(closure_name, actual_params, ret_type))

    // First param is env_ptr
    env_param := _lnew_temp(ll)
    ll = env_param.l
    ll = _lenv_add(ll, "_env", env_param.temp)

    // Register closure parameters (after env_ptr); str params allocate 2 consecutive slots
    mut pi := 1
    while pi < param_names.len() {
        pt := param_types[pi]
        pn := param_names[pi]
        if pt == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, pn, nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, pn, nt.temp)
            if pt > 0 { ll = _lset_type(ll, nt.temp, pt) }
        }
        pi = pi + 1
    }

    // Load captured variables from env struct into local temps
    if cap_count > 0 {
        mut ci := 1
        while ci < cap_names.len() {
            cap_nt := _lnew_temp(ll)
            ll = cap_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, cap_nt.temp, env_param.temp, ci - 1, "", 0))
            ll = _lenv_add(ll, cap_names[ci], cap_nt.temp)
            ci = ci + 1
        }
    }

    // Lower body
    ll = _lset_pos(ll, body_start)
    lb3 := "\{"
    if body_start < body_end {
        if _lk(ll) == lb3 {
            // Block body: use _lower_fn_body which handles multi-statement blocks
            // and emits OpRet for the last expression
            ll = _lower_fn_body(ll, 1)
        } else {
            result := _lower_expr(ll)
            ll = result.l
            body_type := _lget_type(ll, result.temp)
            if body_type > 0 && ret_type == 1 { ret_type = body_type }
            ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", 0))
        }
    }

    // Update function return type if body inference changed it
    if ret_type != 1 || ret_type > 0 {
        ll = _lset_func(ll, func_set_return_type(ll.current_func, ret_type))
    }

    // Finish closure function
    ll = _lfinish_func(ll)

    // Restore outer function state
    ll = Lowerer{tokens: ll.tokens, pos: body_end, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                 table: ll.table, file: ll.file, module: ll.module,
                 current_func: saved_func,
                 temp_counter: saved_temp, label_counter: saved_label,
                 env_names: saved_env_names, env_slots: saved_env_slots,
                 loop_start: ll.loop_start, loop_end: ll.loop_end,
                 const_names: ll.const_names, const_vals: ll.const_vals,
                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                 temp_types: saved_types, is_result: saved_is_result,
                 fn_error_type: saved_err_type, defer_starts: [0], defer_ends: [0]}

    // Build fat pointer: {fn_ptr, env_ptr}
    // Allocate 2-slot struct
    fat_nt := _lnew_temp(ll)
    ll = fat_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, fat_nt.temp, 2, 0, "_closure", 0))

    // Store fn_ptr at slot 0
    fnref_nt := _lnew_temp(ll)
    ll = fnref_nt.l
    ll = _lemit(ll, new_inst(OpFnRef, fnref_nt.temp, 0, 0, closure_name, 0))
    ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, fnref_nt.temp, 0, "_fn", 0))

    // Build and store env_ptr at slot 1
    if cap_count > 0 {
        // Allocate env struct with cap_count slots
        env_nt := _lnew_temp(ll)
        ll = env_nt.l
        ll = _lemit(ll, new_inst(OpAlloc, env_nt.temp, cap_count, 0, "_env", 0))
        // Copy captured values into env
        mut ci := 1
        while ci < cap_slots.len() {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpLoad, val_nt.temp, cap_slots[ci], 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, env_nt.temp, val_nt.temp, ci - 1, "", 0))
            ci = ci + 1
        }
        ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, env_nt.temp, 1, "_env", 0))
    } else {
        // No captures: store 0 as env_ptr
        null_nt := _lnew_temp(ll)
        ll = null_nt.l
        ll = _lemit(ll, new_inst(OpConst, null_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, null_nt.temp, 1, "_env", 0))
    }

    // Tag the fat-pointer temp with a TyFunction TypeInfo whose type_id
    // holds the closure's return type (or Result(ret, err) when fallible).
    // This lets generic-call TypeVar extraction see a real Function shape
    // and resolve T/U from `fn() -> T!U` parameters. Falls back to the
    // 600 sentinel if we couldn't resolve any annotations.
    if ret_type > 0 {
        mut fn_ret := ret_type
        if err_type > 0 {
            rti := TypeInfo{kind: TyResult, name: "", type_id: ret_type, type_id2: err_type, param_start: 0, param_count: 0}
            rsar := store_add_canonical(ll.store, rti)
            ll = _lset_store(ll, rsar.store)
            fn_ret = rsar.id
        }
        fti := TypeInfo{kind: TyFunction, name: "", type_id: fn_ret, type_id2: 0, param_start: 0, param_count: 0}
        fsar := store_add_canonical(ll.store, fti)
        ll = _lset_store(ll, fsar.store)
        ll = _lset_type(ll, fat_nt.temp, fsar.id)
    } else {
        ll = _lset_type(ll, fat_nt.temp, 600)
    }
    LT{l: ll, temp: fat_nt.temp}
}

// --- AST-based closure lowering ---
// Avoids _find_tok_pos positioning bugs by using the AST directly.

fn _scan_captures_ast(l: Lowerer, pool: NodePool, idx: i64, params: [str]) -> [str] {
    if idx <= 0 { return [""] }
    node := pool_get(pool, idx)
    nk := expr_kind_name(node.kind)
    mut result := [""]

    // Ident nodes may reference captured variables
    if nk == "Ident" {
        name := node.s1
        outer := _lenv_lookup(l, name)
        if outer >= 0 {
            mut is_param := false
            mut pi := 1
            while pi < params.len() {
                if params[pi] == name { is_param = true }
                pi = pi + 1
            }
            if is_param == false {
                result = result.append(name)
            }
        }
        return result
    }

    // Recurse into children
    sub0 := _scan_captures_ast(l, pool, node.c0, params)
    mut si := 1
    while si < sub0.len() {
        result = result.append(sub0[si])
        si = si + 1
    }
    sub1 := _scan_captures_ast(l, pool, node.c1, params)
    si = 1
    while si < sub1.len() {
        result = result.append(sub1[si])
        si = si + 1
    }
    sub2 := _scan_captures_ast(l, pool, node.c2, params)
    si = 1
    while si < sub2.len() {
        result = result.append(sub2[si])
        si = si + 1
    }

    // Recurse into list children
    mut li := 0
    while li < node.list_count {
        child_idx := pool_get(pool, node.list_start + li).c0
        subl := _scan_captures_ast(l, pool, child_idx, params)
        si = 1
        while si < subl.len() {
            result = result.append(subl[si])
            si = si + 1
        }
        li = li + 1
    }
    result
}

fn _dedup_names(names: [str]) -> [str] {
    mut result := [""]
    mut i := 1
    while i < names.len() {
        mut found := false
        mut j := 1
        while j < result.len() {
            if result[j] == names[i] { found = true }
            j = j + 1
        }
        if found == false { result = result.append(names[i]) }
        i = i + 1
    }
    result
}

fn _lower_closure_node(l: Lowerer, node: Expr) -> LT {
    mut ll := l

    // Generate unique closure name
    closure_name := "_closure_" + i2s(ll.module.closure_count)
    ll = _lset_mod(ll, mod_next_closure(ll.module))

    // Parse parameter names from s1, resolve types from token stream
    mut param_names := [""]
    mut param_types := [0]

    // Parse param names from AST s1 field (comma-separated, reliable)
    if node.s1.len() > 0 {
        parts := node.s1.split(",")
        mut pi := 0
        while pi < parts.len() {
            if parts[pi].len() > 0 {
                param_names = param_names.append(parts[pi])
                param_types = param_types.append(1)  // default i64
            }
            pi = pi + 1
        }
    }
    // Try to resolve type annotations from token stream for each param
    tp := _find_tok_pos(ll, node.span.offset)
    mut scan := tp
    // Find the correct "fn" keyword for THIS closure (not a nearby function def)
    // Strategy: look for "fn" followed by "(" within a small window
    mut fn_found := false
    mut fn_limit := 0
    while scan < ll.tokens.len() && fn_found == false && fn_limit < 50 {
        if ll.tokens[scan].name == "fn" {
            next_scan := scan + 1
            if next_scan < ll.tokens.len() && ll.tokens[next_scan].text == "once" { next_scan = next_scan + 1 }
            if next_scan < ll.tokens.len() && ll.tokens[next_scan].name == "(" {
                fn_found = true
            }
        }
        if fn_found == false { scan = scan + 1 }
        fn_limit = fn_limit + 1
    }
    if fn_found {
        // Skip fn, optional once, (
        scan = scan + 1
        if scan < ll.tokens.len() && ll.tokens[scan].text == "once" { scan = scan + 1 }
        if scan < ll.tokens.len() && ll.tokens[scan].name == "(" { scan = scan + 1 }
        // Match each param name with type annotations from tokens
        mut tpi := 1
        while scan < ll.tokens.len() && ll.tokens[scan].name != ")" && ll.tokens[scan].name != "EOF" && tpi < param_names.len() {
            if ll.tokens[scan].name == "IDENT" && ll.tokens[scan].text == param_names[tpi] {
                scan = scan + 1
                if scan < ll.tokens.len() && ll.tokens[scan].name == ":" {
                    scan = scan + 1
                    if scan < ll.tokens.len() && ll.tokens[scan].name == "IDENT" {
                        tname := ll.tokens[scan].text
                        resolved := resolve_type_name(ll.store, tname)
                        if resolved != TY_UNKNOWN { param_types[tpi] = resolved }
                        if resolved == TY_UNKNOWN {
                            st_id := _struct_type_id(ll.registry, tname)
                            if st_id > 0 { param_types[tpi] = st_id }
                        }
                        scan = scan + 1
                    }
                }
                tpi = tpi + 1
            } else {
                scan = scan + 1
            }
            if scan < ll.tokens.len() && ll.tokens[scan].name == "," { scan = scan + 1 }
        }
    }

    // Determine return type (default i64) and error type if present.
    // After the closing `)` of params, look for `->` Type `!` ErrorType.
    mut ret_type := 1
    mut err_type := 0
    if fn_found {
        // scan is somewhere past params. Advance to ')'.
        mut rscan := scan
        mut depth := 1
        while rscan < ll.tokens.len() && depth > 0 {
            rn := ll.tokens[rscan].name
            if rn == "(" { depth = depth + 1 }
            if rn == ")" { depth = depth - 1 }
            if depth > 0 { rscan = rscan + 1 }
        }
        if rscan < ll.tokens.len() && ll.tokens[rscan].name == ")" { rscan = rscan + 1 }
        if rscan < ll.tokens.len() && ll.tokens[rscan].name == "->" {
            rscan = rscan + 1
            if rscan < ll.tokens.len() && ll.tokens[rscan].name == "IDENT" {
                rt_name := ll.tokens[rscan].text
                rt_resolved := resolve_type_name(ll.store, rt_name)
                if rt_resolved != TY_UNKNOWN { ret_type = rt_resolved }
                if rt_resolved == TY_UNKNOWN {
                    rt_sid := _struct_type_id(ll.registry, rt_name)
                    if rt_sid > 0 { ret_type = rt_sid }
                }
                rscan = rscan + 1
                if rscan < ll.tokens.len() && ll.tokens[rscan].name == "!" {
                    rscan = rscan + 1
                    if rscan < ll.tokens.len() && ll.tokens[rscan].name == "IDENT" {
                        et_name := ll.tokens[rscan].text
                        // Try primitive name first (str/i64/bool/etc.), then struct.
                        et_prim := resolve_type_name(ll.store, et_name)
                        if et_prim != TY_UNKNOWN {
                            err_type = et_prim
                        } else {
                            et_sid := _struct_type_id(ll.registry, et_name)
                            if et_sid > 0 {
                                err_type = et_sid
                            } else {
                                // Sentinel non-zero so body lowering knows we're fallible
                                err_type = 0 - 1
                            }
                        }
                    }
                }
            }
        }
    }

    // Scan for captured variables using AST walk
    raw_caps := _scan_captures_ast(ll, ll.pool, node.c0, param_names)
    cap_unique := _dedup_names(raw_caps)
    mut cap_names := [""]
    mut cap_slots := [0]
    mut ci := 1
    while ci < cap_unique.len() {
        cname := cap_unique[ci]
        slot := _lenv_lookup(ll, cname)
        if slot >= 0 {
            cap_names = cap_names.append(cname)
            cap_slots = cap_slots.append(slot)
        }
        ci = ci + 1
    }
    cap_count := cap_names.len() - 1

    // Heuristic param-type inference: for params left as i64-default (no
    // annotation), scan the body for string-typical method calls (parse,
    // contains, split, trim, replace, starts_with, ends_with, lines, chars,
    // split_whitespace). If found on a param name, promote to str. Cheap
    // approximation of bidirectional type inference — handles the common
    // `try_map(strings, fn(s) -> i64!E { s.parse[...]() })` pattern where
    // the closure has no explicit `s: str` annotation.
    mut ipi := 1
    while ipi < param_types.len() {
        if param_types[ipi] == 1 {
            pname := param_names[ipi]
            // Scan tokens forward from the closure's fn keyword until
            // matching close brace, tracking brace depth.
            mut bscan := tp
            mut depth := 0
            mut entered := false
            mut found_str_use := false
            lbc := "\{"
            rbc := "\}"
            while bscan < ll.tokens.len() && found_str_use == false {
                tname := ll.tokens[bscan].name
                if tname == lbc { depth = depth + 1; entered = true }
                else if tname == rbc {
                    depth = depth - 1
                    if entered && depth == 0 { bscan = ll.tokens.len() }
                }
                if bscan < ll.tokens.len() && tname == "IDENT" && ll.tokens[bscan].text == pname {
                    nx := bscan + 1
                    if nx < ll.tokens.len() && ll.tokens[nx].name == "." {
                        nx2 := nx + 1
                        if nx2 < ll.tokens.len() && ll.tokens[nx2].name == "IDENT" {
                            mname := ll.tokens[nx2].text
                            if mname == "parse" || mname == "contains" ||
                               mname == "split" || mname == "trim" ||
                               mname == "replace" || mname == "starts_with" ||
                               mname == "ends_with" || mname == "lines" ||
                               mname == "chars" || mname == "split_whitespace" {
                                found_str_use = true
                            }
                        }
                    }
                }
                bscan = bscan + 1
            }
            if found_str_use { param_types[ipi] = 12 }
        }
        ipi = ipi + 1
    }

    // Create closure function: env_ptr + user params
    mut actual_params := 1  // env_ptr
    mut rpi := 1
    while rpi < param_types.len() {
        if param_types[rpi] == 12 { actual_params = actual_params + 2 } else { actual_params = actual_params + 1 }
        rpi = rpi + 1
    }

    // Save current function state
    saved_func := ll.current_func
    saved_temp := ll.temp_counter
    saved_label := ll.label_counter
    saved_env_names := ll.env_names
    saved_env_slots := ll.env_slots
    saved_types := ll.temp_types
    saved_is_result := ll.is_result
    saved_err_type := ll.fn_error_type

    ll = _lset_func(ll, new_ir_func(closure_name, actual_params, ret_type))
    // Activate fallible-closure mode so `?`/`catch`/body-result wrapping work
    // like a regular fn with `fn foo() -> T!E`.
    if err_type != 0 { ll = _lset_error_type(ll, err_type) }

    // First param is env_ptr
    env_param := _lnew_temp(ll)
    ll = env_param.l
    ll = _lenv_add(ll, "_env", env_param.temp)

    // Register closure parameters
    mut pi := 1
    while pi < param_names.len() {
        pt := param_types[pi]
        pn := param_names[pi]
        if pt == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, pn, nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, pn, nt.temp)
            if pt > 0 { ll = _lset_type(ll, nt.temp, pt) }
        }
        pi = pi + 1
    }

    // Load captured variables from env struct
    if cap_count > 0 {
        ci = 1
        while ci < cap_names.len() {
            cap_nt := _lnew_temp(ll)
            ll = cap_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, cap_nt.temp, env_param.temp, ci - 1, "", 0))
            ll = _lenv_add(ll, cap_names[ci], cap_nt.temp)
            ci = ci + 1
        }
    }

    // Lower body from AST. For fallible closures (`-> T!E`), wrap the body
    // value in Ok Result before returning — callers expect a Result pointer.
    if node.c0 > 0 {
        body := _lower_expr_node(ll, node.c0)
        ll = body.l
        if body.temp >= 0 {
            if ll.fn_error_type != 0 && _lget_type(ll, body.temp) != 200 && !_lis_result(ll, body.temp) {
                body_rt := _lget_type(ll, body.temp)
                mut ok_slots := 2
                if body_rt == 12 { ok_slots = 3 }
                ok_nt := _lnew_temp(ll)
                ll = ok_nt.l
                ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
                if body_rt == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, body.temp, 1, "_val", 0))
                    body_len := body.temp + 1
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, body_len, 2, "_val_len", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, body.temp, 1, "_val", 0))
                }
                ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
            } else {
                ll = _lemit(ll, new_inst(OpRet, 0, body.temp, 0, "", 0))
            }
        }
    }

    // Finish closure function
    ll = _lfinish_func(ll)

    // Restore outer function state
    ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                 table: ll.table, file: ll.file, module: ll.module,
                 current_func: saved_func,
                 temp_counter: saved_temp, label_counter: saved_label,
                 env_names: saved_env_names, env_slots: saved_env_slots,
                 loop_start: ll.loop_start, loop_end: ll.loop_end,
                 const_names: ll.const_names, const_vals: ll.const_vals,
                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                 temp_types: saved_types, is_result: saved_is_result,
                 fn_error_type: saved_err_type, defer_starts: [0], defer_ends: [0]}

    // Build fat pointer: {fn_ptr, env_ptr}
    fat_nt := _lnew_temp(ll)
    ll = fat_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, fat_nt.temp, 2, 0, "_closure", 0))

    // Store fn_ptr at slot 0
    fnref_nt := _lnew_temp(ll)
    ll = fnref_nt.l
    ll = _lemit(ll, new_inst(OpFnRef, fnref_nt.temp, 0, 0, closure_name, 0))
    ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, fnref_nt.temp, 0, "_fn", 0))

    // Build and store env at slot 1
    if cap_count > 0 {
        env_nt := _lnew_temp(ll)
        ll = env_nt.l
        ll = _lemit(ll, new_inst(OpAlloc, env_nt.temp, cap_count, 0, "_env", 0))
        ci = 1
        while ci < cap_slots.len() {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpLoad, val_nt.temp, cap_slots[ci], 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, env_nt.temp, val_nt.temp, ci - 1, "", 0))
            ci = ci + 1
        }
        ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, env_nt.temp, 1, "_env", 0))
    } else {
        null_nt := _lnew_temp(ll)
        ll = null_nt.l
        ll = _lemit(ll, new_inst(OpConst, null_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, fat_nt.temp, null_nt.temp, 1, "_env", 0))
    }

    // Tag the closure temp with a real TyFunction type where possible so
    // generic TypeVar extraction can resolve `fn() -> T!U` params.
    if ret_type > 0 {
        mut fn_ret := ret_type
        if err_type > 0 {
            rti := TypeInfo{kind: TyResult, name: "", type_id: ret_type, type_id2: err_type, param_start: 0, param_count: 0}
            rsar := store_add_canonical(ll.store, rti)
            ll = _lset_store(ll, rsar.store)
            fn_ret = rsar.id
        }
        fti := TypeInfo{kind: TyFunction, name: "", type_id: fn_ret, type_id2: 0, param_start: 0, param_count: 0}
        fsar := store_add_canonical(ll.store, fti)
        ll = _lset_store(ll, fsar.store)
        ll = _lset_type(ll, fat_nt.temp, fsar.id)
    } else {
        ll = _lset_type(ll, fat_nt.temp, 600)
    }
    LT{l: ll, temp: fat_nt.temp}
}

// --- Newtype detection ---

fn _is_newtype(def: StructDef) -> bool {
    if def.fields.len() != 2 { return false }
    def.fields[1].name == "value"
}

// --- Variant tag lookup ---

fn _variant_tag(reg: TypeRegistry, name: str) -> i64 {
    // Search all sum types for a variant with this name
    mut si := 1
    while si < reg.struct_defs.len() {
        def := reg.struct_defs[si]
        if def.is_sum {
            mut vi := 1
            while vi < def.variant_names.len() {
                if def.variant_names[vi] == name {
                    return vi  // 1-based tag
                }
                vi = vi + 1
            }
        }
        si = si + 1
    }
    0  // not found
}

// Find the parent sum type StructDef for a variant name
fn _variant_parent(reg: TypeRegistry, name: str) -> StructDef {
    mut si := 1
    while si < reg.struct_defs.len() {
        def := reg.struct_defs[si]
        if def.is_sum {
            mut vi := 1
            while vi < def.variant_names.len() {
                if def.variant_names[vi] == name {
                    return def
                }
                vi = vi + 1
            }
        }
        si = si + 1
    }
    _sentinel_struct_def()
}

// --- Helper: parse integer literal string to i64 ---

fn _parse_int_literal(val: str) -> i64 {
    mut num := 0
    mut i := 0
    mut neg := false
    if val.len() > 0 && val.charAt(0) == "-" {
        neg = true
        i = 1
    }
    // Check for base prefix (0x, 0o, 0b)
    if val.len() > i + 1 && val.charAt(i) == "0" {
        p := val.charAt(i + 1)
        if p == "x" || p == "X" {
            num = _parse_hex(val, i + 2)
            if neg { num = 0 - num }
            return num
        }
        if p == "o" || p == "O" {
            num = _parse_oct(val, i + 2)
            if neg { num = 0 - num }
            return num
        }
        if p == "b" || p == "B" {
            num = _parse_bin(val, i + 2)
            if neg { num = 0 - num }
            return num
        }
    }
    while i < val.len() {
        ch := val.charAt(i)
        if ch != "_" {
            mut digit := 0
            if ch == "0" { digit = 0 } else if ch == "1" { digit = 1 } else if ch == "2" { digit = 2 } else if ch == "3" { digit = 3 } else if ch == "4" { digit = 4 } else if ch == "5" { digit = 5 } else if ch == "6" { digit = 6 } else if ch == "7" { digit = 7 } else if ch == "8" { digit = 8 } else if ch == "9" { digit = 9 }
            num = num * 10 + digit
        }
        i = i + 1
    }
    if neg { num = 0 - num }
    num
}

// Parse duration literal to nanoseconds: "30s" -> 30_000_000_000
fn _parse_duration(val: str) -> i64 {
    // Extract numeric part and suffix
    mut num_end := 0
    while num_end < val.len() {
        c := val.charAt(num_end)
        if (c >= "0" && c <= "9") || c == "_" {
            num_end = num_end + 1
        } else {
            break
        }
    }
    num_str := val.substring(0, num_end)
    suffix := val.substring(num_end, val.len())
    num := _parse_int_literal(num_str)
    if suffix == "ns" { return num }
    if suffix == "us" { return num * 1000 }
    if suffix == "ms" { return num * 1000000 }
    if suffix == "s" { return num * 1000000000 }
    if suffix == "m" { return num * 60000000000 }
    if suffix == "h" { return num * 3600000000000 }
    num
}

// Parse size literal to bytes: "4mb" -> 4_194_304
fn _parse_size(val: str) -> i64 {
    mut num_end := 0
    while num_end < val.len() {
        c := val.charAt(num_end)
        if (c >= "0" && c <= "9") || c == "_" {
            num_end = num_end + 1
        } else {
            break
        }
    }
    num_str := val.substring(0, num_end)
    suffix := val.substring(num_end, val.len())
    num := _parse_int_literal(num_str)
    if suffix == "b" { return num }
    if suffix == "kb" { return num * 1024 }
    if suffix == "mb" { return num * 1048576 }
    if suffix == "gb" { return num * 1073741824 }
    num
}

fn _char_to_code(ch: str) -> i64 {
    if ch == "\n" { return 10 }
    if ch == "\t" { return 9 }
    if ch == "\r" { return 13 }
    if ch == "\0" { return 0 }
    if ch == " " { return 32 }
    if ch == "!" { return 33 }
    if ch == "\"" { return 34 }
    if ch == "#" { return 35 }
    if ch == "$" { return 36 }
    if ch == "%" { return 37 }
    if ch == "&" { return 38 }
    if ch == "'" { return 39 }
    if ch == "(" { return 40 }
    if ch == ")" { return 41 }
    if ch == "*" { return 42 }
    if ch == "+" { return 43 }
    if ch == "," { return 44 }
    if ch == "-" { return 45 }
    if ch == "." { return 46 }
    if ch == "/" { return 47 }
    if ch == "0" { return 48 }
    if ch == "1" { return 49 }
    if ch == "2" { return 50 }
    if ch == "3" { return 51 }
    if ch == "4" { return 52 }
    if ch == "5" { return 53 }
    if ch == "6" { return 54 }
    if ch == "7" { return 55 }
    if ch == "8" { return 56 }
    if ch == "9" { return 57 }
    if ch == ":" { return 58 }
    if ch == ";" { return 59 }
    if ch == "<" { return 60 }
    if ch == "=" { return 61 }
    if ch == ">" { return 62 }
    if ch == "?" { return 63 }
    if ch == "@" { return 64 }
    if ch == "A" { return 65 }
    if ch == "B" { return 66 }
    if ch == "C" { return 67 }
    if ch == "D" { return 68 }
    if ch == "E" { return 69 }
    if ch == "F" { return 70 }
    if ch == "G" { return 71 }
    if ch == "H" { return 72 }
    if ch == "I" { return 73 }
    if ch == "J" { return 74 }
    if ch == "K" { return 75 }
    if ch == "L" { return 76 }
    if ch == "M" { return 77 }
    if ch == "N" { return 78 }
    if ch == "O" { return 79 }
    if ch == "P" { return 80 }
    if ch == "Q" { return 81 }
    if ch == "R" { return 82 }
    if ch == "S" { return 83 }
    if ch == "T" { return 84 }
    if ch == "U" { return 85 }
    if ch == "V" { return 86 }
    if ch == "W" { return 87 }
    if ch == "X" { return 88 }
    if ch == "Y" { return 89 }
    if ch == "Z" { return 90 }
    if ch == "[" { return 91 }
    if ch == "\\" { return 92 }
    if ch == "]" { return 93 }
    if ch == "^" { return 94 }
    if ch == "_" { return 95 }
    if ch == "`" { return 96 }
    if ch == "a" { return 97 }
    if ch == "b" { return 98 }
    if ch == "c" { return 99 }
    if ch == "d" { return 100 }
    if ch == "e" { return 101 }
    if ch == "f" { return 102 }
    if ch == "g" { return 103 }
    if ch == "h" { return 104 }
    if ch == "i" { return 105 }
    if ch == "j" { return 106 }
    if ch == "k" { return 107 }
    if ch == "l" { return 108 }
    if ch == "m" { return 109 }
    if ch == "n" { return 110 }
    if ch == "o" { return 111 }
    if ch == "p" { return 112 }
    if ch == "q" { return 113 }
    if ch == "r" { return 114 }
    if ch == "s" { return 115 }
    if ch == "t" { return 116 }
    if ch == "u" { return 117 }
    if ch == "v" { return 118 }
    if ch == "w" { return 119 }
    if ch == "x" { return 120 }
    if ch == "y" { return 121 }
    if ch == "z" { return 122 }
    if ch == "\{" { return 123 }
    if ch == "|" { return 124 }
    if ch == "\}" { return 125 }
    if ch == "~" { return 126 }
    0
}

fn _parse_hex(val: str, start: i64) -> i64 {
    mut num := 0
    mut i := start
    while i < val.len() {
        ch := val.charAt(i)
        if ch != "_" {
            mut digit := 0
            if ch == "0" { digit = 0 } else if ch == "1" { digit = 1 } else if ch == "2" { digit = 2 } else if ch == "3" { digit = 3 } else if ch == "4" { digit = 4 } else if ch == "5" { digit = 5 } else if ch == "6" { digit = 6 } else if ch == "7" { digit = 7 } else if ch == "8" { digit = 8 } else if ch == "9" { digit = 9 } else if ch == "a" || ch == "A" { digit = 10 } else if ch == "b" || ch == "B" { digit = 11 } else if ch == "c" || ch == "C" { digit = 12 } else if ch == "d" || ch == "D" { digit = 13 } else if ch == "e" || ch == "E" { digit = 14 } else if ch == "f" || ch == "F" { digit = 15 }
            num = num * 16 + digit
        }
        i = i + 1
    }
    num
}

fn _parse_oct(val: str, start: i64) -> i64 {
    mut num := 0
    mut i := start
    while i < val.len() {
        ch := val.charAt(i)
        if ch != "_" {
            mut digit := 0
            if ch == "0" { digit = 0 } else if ch == "1" { digit = 1 } else if ch == "2" { digit = 2 } else if ch == "3" { digit = 3 } else if ch == "4" { digit = 4 } else if ch == "5" { digit = 5 } else if ch == "6" { digit = 6 } else if ch == "7" { digit = 7 }
            num = num * 8 + digit
        }
        i = i + 1
    }
    num
}

fn _parse_bin(val: str, start: i64) -> i64 {
    mut num := 0
    mut i := start
    while i < val.len() {
        ch := val.charAt(i)
        if ch != "_" {
            if ch == "1" { num = num * 2 + 1 } else { num = num * 2 }
        }
        i = i + 1
    }
    num
}

// --- Helper: lower a string literal value to a temp (for pattern matching) ---

fn _lower_string_const(l: Lowerer, val: str) -> LT {
    mut ll := l
    mut str_idx := mod_find_string(ll.module, val)
    if str_idx == 0 {
        new_mod := mod_add_string(ll.module, val)
        str_idx = new_mod.string_constants.len() - 1
        ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                     table: ll.table, file: ll.file, module: new_mod,
                     current_func: ll.current_func,
                     temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                     env_names: ll.env_names, env_slots: ll.env_slots,
                     loop_start: ll.loop_start, loop_end: ll.loop_end,
                     const_names: ll.const_names, const_vals: ll.const_vals,
                     const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                     temp_types: ll.temp_types, is_result: ll.is_result,
            fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
    }
    nt := _lnew_str_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpConstStr, nt.temp, str_idx, val.len(), "", 0))
    ll = _lset_type(ll, nt.temp, 12)
    LT{l: ll, temp: nt.temp}
}

// --- Lower match subject (avoid greedy { consumption) ---

fn _lower_match_subject(l: Lowerer) -> LT {
    k := _lk(l)

    if k == "IDENT" {
        name := _lcur(l).text
        mut ll := _ladv(l)

        // Check for function call
        if _lk(ll) == "(" {
            sig := reg_find_fn(ll.registry, name)
            if sig.name != "" {
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                mut first_arg := -1
                mut arg_count := 0
                while _lk(ll) != ")" && _lk(ll) != "EOF" {
                    ll = _lskip_nl(ll)
                    arg := _lower_expr(ll)
                    ll = arg.l
                    if arg_count == 0 { first_arg = arg.temp }
                    arg_count = arg_count + 1
                    ll = _lskip_nl(ll)
                    if _lk(ll) == "," { ll = _ladv(ll) }
                }
                if _lk(ll) == ")" { ll = _ladv(ll) }
                nt := _lnew_temp(ll)
                ll = nt.l
                mut fa := 0
                if first_arg >= 0 { fa = first_arg }
                ll = _lemit(ll, new_inst(OpCall, nt.temp, fa, arg_count, name, 0))
                // Preserve return-type info so Ok/Err pattern binding can
                // infer the payload type from the Result's type_id/type_id2.
                if sig.error_type > 0 && sig.return_type > 0 {
                    res_ti := mk_result_type(sig.return_type, sig.error_type)
                    new_st := store_add_canonical(ll.store, res_ti)
                    ll = _lset_store(ll, new_st.store)
                    ll = _lset_type(ll, nt.temp, new_st.id)
                    ll = _lset_is_result(ll, nt.temp)
                } else if sig.return_type > 0 {
                    ll = _lset_type(ll, nt.temp, sig.return_type)
                }
                return LT{l: ll, temp: nt.temp}
            }
            // Not a registered fn — if env has a closure-typed binding, do
            // an indirect call. Without this, `match f() { ... }` with `f`
            // as a closure parameter falls through to the variable-load
            // path and the match subject is f itself, not its return.
            fslot := _lenv_lookup(ll, name)
            if fslot >= 0 {
                closure_nt := _lnew_temp(ll)
                ll = closure_nt.l
                ll = _lemit(ll, new_inst(OpLoad, closure_nt.temp, fslot, 0, "", 0))
                fn_ptr_nt := _lnew_temp(ll)
                ll = fn_ptr_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr_nt.temp, closure_nt.temp, 0, "_fn", 0))
                env_ptr_nt := _lnew_temp(ll)
                ll = env_ptr_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, env_ptr_nt.temp, closure_nt.temp, 1, "_env", 0))
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                pack_start := _lnew_temp(ll)
                ll = pack_start.l
                ll = _lemit(ll, new_inst(OpStore, pack_start.temp, env_ptr_nt.temp, 0, "", 0))
                mut pack_idx := 1
                mut total_regs := 1
                while _lk(ll) != ")" && _lk(ll) != "EOF" {
                    ll = _lskip_nl(ll)
                    arg := _lower_expr(ll)
                    ll = arg.l
                    arg_tid := _lget_type(ll, arg.temp)
                    if arg_tid == 12 {
                        ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg.temp, 0, "", 0))
                        pack_idx = pack_idx + 1
                        total_regs = total_regs + 1
                        ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg.temp + 1, 0, "", 0))
                        pack_idx = pack_idx + 1
                        total_regs = total_regs + 1
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg.temp, 0, "", 0))
                        pack_idx = pack_idx + 1
                        total_regs = total_regs + 1
                    }
                    ll = _lskip_nl(ll)
                    if _lk(ll) == "," { ll = _ladv(ll) }
                }
                if _lk(ll) == ")" { ll = _ladv(ll) }
                // Resolve callee's return shape from its TyFunction type.
                mut ret_hint := ""
                mut ic_is_result := false
                mut ic_ret_type := 0
                fn_tid_ic := _lget_type(ll, fslot)
                if fn_tid_ic > 16 && fn_tid_ic < ll.store.types.len() {
                    ti_ic := store_get(ll.store, fn_tid_ic)
                    if type_kind_name(ti_ic.kind) == "Function" {
                        ic_ret_type = type_info_type_id(ti_ic)
                        if ic_ret_type == 12 { ret_hint = "str" }
                        if ti_ic.type_id2 > 0 { ic_is_result = true }
                        if ic_ret_type > 16 && ic_ret_type < ll.store.types.len() {
                            ret_ti := store_get(ll.store, ic_ret_type)
                            if type_kind_name(ret_ti.kind) == "Result" {
                                ic_is_result = true
                                // Preserve the full Result type id so pattern
                                // binding (Ok/Err) can look up its ok/err types.
                                ok_id := type_info_type_id(ret_ti)
                                if ok_id == 12 { ret_hint = "str" }
                            }
                        }
                    }
                }
                ic_nt := _lnew_temp(ll)
                ll = ic_nt.l
                ll = _lemit(ll, new_inst(OpCallIndirect, ic_nt.temp, fn_ptr_nt.temp, total_regs, ret_hint, pack_start.temp))
                if ic_ret_type > 0 { ll = _lset_type(ll, ic_nt.temp, ic_ret_type) }
                if ic_is_result { ll = _lset_is_result(ll, ic_nt.temp) }
                return LT{l: ll, temp: ic_nt.temp}
            }
        }

        // Field access: obj.field (without consuming {)
        if _lk(ll) == "." {
            slot := _lenv_lookup(ll, name)
            if slot >= 0 {
                src_type := _lget_type(ll, slot)
                mut base_temp := 0
                if src_type == 12 {
                    nt_base := _lnew_str_temp(ll)
                    ll = nt_base.l
                    base_temp = nt_base.temp
                } else {
                    nt_base := _lnew_temp(ll)
                    ll = nt_base.l
                    base_temp = nt_base.temp
                }
                ll = _lemit(ll, new_inst(OpLoad, base_temp, slot, 0, "", 0))
                if src_type != 0 {
                    ll = _lset_type(ll, base_temp, src_type)
                }
                mut cur := base_temp
                while _lk(ll) == "." {
                    ll = _ladv(ll)
                    if _lk(ll) == "IDENT" {
                        field := _lcur(ll).text
                        ll = _ladv(ll)
                        if _lk(ll) == "(" {
                            // Method call on the match subject. Without this
                            // branch, `match obj.method() { Ok/Err ... }` read
                            // `method` as a struct field, returning garbage
                            // and causing all arms to fall through.
                            mr := _lower_method_call(ll, cur, field)
                            ll = mr.l
                            cur = mr.temp
                        } else {
                            nt := _lnew_temp(ll)
                            ll = nt.l
                            ll = _lemit(ll, new_inst(OpFieldGet, nt.temp, cur, 0, field, 0))
                            cur = nt.temp
                        }
                    }
                }
                return LT{l: ll, temp: cur}
            }
        }

        // Variable reference (do NOT try struct literal — the { is the match body)
        slot := _lenv_lookup(ll, name)
        if slot >= 0 {
            // Use _lnew_str_temp for string sources (2 consecutive slots)
            src_type := _lget_type(ll, slot)
            mut nt_temp := 0
            if src_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                nt_temp = nt.temp
            } else {
                nt := _lnew_temp(ll)
                ll = nt.l
                nt_temp = nt.temp
            }
            ll = _lemit(ll, new_inst(OpLoad, nt_temp, slot, 0, "", 0))
            if src_type != 0 {
                ll = _lset_type(ll, nt_temp, src_type)
            }
            return LT{l: ll, temp: nt_temp}
        }

        // Variant tag
        tag := _variant_tag(ll.registry, name)
        if tag > 0 {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpConst, nt.temp, tag, 0, "", 0))
            return LT{l: ll, temp: nt.temp}
        }

        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if k == "INT" {
        return _lower_primary(l)
    }

    if k == "(" {
        return _lower_primary(l)
    }

    // Fallback
    nt := _lnew_temp(l)
    ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, 0, 0, "", 0))
    LT{l: ll, temp: nt.temp}
}

// --- Lower match expression ---

// --- Lower spawn expression ---
// spawn <expr> desugars to: wrap expr in closure, call _aria_spawn(closure)
// spawn { block } desugars to: _aria_spawn(fn() -> i64 { block; 0 })

fn _lower_spawn(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip spawn
    lb := "\{"
    rb := "\}"
    // Check for spawn.detach
    mut is_detach := false
    if _lk(ll) == "." {
        next_pos := ll.pos + 1
        if next_pos < ll.tokens.len() && ll.tokens[next_pos].text == "detach" {
            ll = _ladv(ll)  // skip .
            ll = _ladv(ll)  // skip detach
            is_detach = true
        }
    }
    is_block := _lk(ll) == lb

    // Determine body token range (body_start .. body_end). Evaluation of
    // the body happens inside a synthesized thunk fn, not in the caller;
    // we only need to walk tokens here to find the end position and to
    // scan for captured identifiers.
    body_start := ll.pos
    if is_block {
        ll = _skip_braces_l(ll)
    } else {
        // Single expression — advance until statement boundary.
        mut depth := 0
        mut found_end := false
        while _lk(ll) != "NEWLINE" && _lk(ll) != "EOF" && found_end == false {
            if _lk(ll) == "(" { depth = depth + 1 }
            if _lk(ll) == ")" {
                if depth == 0 { found_end = true } else { depth = depth - 1 }
            }
            if _lk(ll) == "[" { depth = depth + 1 }
            if _lk(ll) == "]" {
                if depth == 0 { found_end = true } else { depth = depth - 1 }
            }
            if found_end == false && _lk(ll) == "," && depth == 0 { found_end = true }
            if found_end == false && _lk(ll) == rb && depth == 0 { found_end = true }
            if found_end == false { ll = _ladv(ll) }
        }
    }
    body_end := ll.pos

    // Scan body tokens for captures: identifiers that resolve to outer-env
    // slots. Skip identifiers that are field-access selectors (preceded by
    // `.`) and module-qualified names' trailing segments.
    mut cap_names := [""]
    mut cap_slots := [0]
    mut cap_types := [0]
    mut scan_pos := body_start
    while scan_pos < body_end && scan_pos < ll.tokens.len() {
        stok := ll.tokens[scan_pos]
        if stok.name == "IDENT" {
            mut is_field := false
            if scan_pos > 0 && ll.tokens[scan_pos - 1].name == "." { is_field = true }
            if is_field == false {
                sname := stok.text
                outer_slot := _lenv_lookup(ll, sname)
                if outer_slot >= 0 {
                    mut already := false
                    mut cci := 1
                    while cci < cap_names.len() {
                        if cap_names[cci] == sname { already = true }
                        cci = cci + 1
                    }
                    if already == false {
                        cap_names = cap_names.append(sname)
                        cap_slots = cap_slots.append(outer_slot)
                        cap_types = cap_types.append(_lget_type(ll, outer_slot))
                    }
                }
            }
        }
        scan_pos = scan_pos + 1
    }
    cap_count := cap_names.len() - 1

    // Save outer state before switching into the thunk function.
    fname := "_spawn_fn_" + i2s(ll.temp_counter)
    saved_func := ll.current_func
    saved_temp := ll.temp_counter
    saved_label := ll.label_counter
    saved_env_names := ll.env_names
    saved_env_slots := ll.env_slots
    saved_types := ll.temp_types
    saved_is_result := ll.is_result
    saved_err_type := ll.fn_error_type

    ll = _lset_func(ll, new_ir_func(fname, 1, 0))

    // Thunk param 0 = env pointer.
    env_param := _lnew_temp(ll)
    ll = env_param.l
    ll = _lemit(ll, new_inst(OpArg, env_param.temp, 0, 0, "", 0))
    ll = _lenv_add(ll, "_env", env_param.temp)

    // Load captured values from env struct into local temps.
    if cap_count > 0 {
        mut ci := 1
        while ci < cap_names.len() {
            cap_nt := _lnew_temp(ll)
            ll = cap_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, cap_nt.temp, env_param.temp, ci - 1, "", 0))
            ll = _lenv_add(ll, cap_names[ci], cap_nt.temp)
            if cap_types[ci] > 0 { ll = _lset_type(ll, cap_nt.temp, cap_types[ci]) }
            ci = ci + 1
        }
    }

    // Lower body inside the thunk.
    ll = _lset_pos(ll, body_start)
    if is_block {
        ll = _ladv(ll)  // skip {
        ll = _lskip_nl(ll)
        while _lk(ll) != rb && _lk(ll) != "EOF" {
            ll = _lower_stmt(ll)
            ll = _lskip_nl(ll)
        }
        if _lk(ll) == rb { ll = _ladv(ll) }
        // Return 0 (task result discarded for block-spawns)
        ret_nt := _lnew_temp(ll)
        ll = ret_nt.l
        ll = _lemit(ll, new_inst(OpConst, ret_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpRet, 0, ret_nt.temp, 0, "", 0))
    } else {
        // Single-expression spawn — capture return value.
        result := _lower_expr(ll)
        ll = result.l
        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", 0))
    }

    ll = _lfinish_func(ll)

    // Restore outer function state. Position stays at ll.pos — the thunk's
    // body lowering advanced past the final `}` (block) or past the trailing
    // `)` (call-expression), which is exactly where the outer caller expects
    // to continue. Using the pre-scan `body_end` would rewind to the closing
    // token and re-lower it as part of the outer expression.
    ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                 table: ll.table, file: ll.file, module: ll.module,
                 current_func: saved_func,
                 temp_counter: saved_temp, label_counter: saved_label,
                 env_names: saved_env_names, env_slots: saved_env_slots,
                 loop_start: ll.loop_start, loop_end: ll.loop_end,
                 const_names: ll.const_names, const_vals: ll.const_vals,
                 const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                 temp_types: saved_types, is_result: saved_is_result,
                 fn_error_type: saved_err_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}

    // Build env struct with captured values, or null if no captures.
    mut env_temp := 0
    if cap_count > 0 {
        env_nt := _lnew_temp(ll)
        ll = env_nt.l
        ll = _lemit(ll, new_inst(OpAlloc, env_nt.temp, cap_count, 0, "_env", 0))
        mut ci := 1
        while ci < cap_slots.len() {
            val_nt := _lnew_temp(ll)
            ll = val_nt.l
            ll = _lemit(ll, new_inst(OpLoad, val_nt.temp, cap_slots[ci], 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, env_nt.temp, val_nt.temp, ci - 1, "", 0))
            ci = ci + 1
        }
        env_temp = env_nt.temp
    } else {
        null_nt := _lnew_temp(ll)
        ll = null_nt.l
        ll = _lemit(ll, new_inst(OpConst, null_nt.temp, 0, 0, "", 0))
        env_temp = null_nt.temp
    }

    // Emit the spawn: _aria_spawn(fn_ptr, env_ptr) -> task handle.
    //
    // OpCall's LLVM emitter reads argc consecutive temps starting at
    // `first_arg` (second inst field). We must therefore allocate the
    // fn-ref temp and the env-copy temp back-to-back — allocating them
    // in order (pack_fn first, then pack_env) guarantees pack_env ==
    // pack_fn + 1. Re-using env_temp directly would break this invariant
    // because earlier lowering steps already advanced the temp counter.
    pack_fn := _lnew_temp(ll)
    ll = pack_fn.l
    ll = _lemit(ll, new_inst(OpFnRef, pack_fn.temp, 0, 0, fname, 0))
    pack_env := _lnew_temp(ll)
    ll = pack_env.l
    ll = _lemit(ll, new_inst(OpStore, pack_env.temp, env_temp, 0, "", 0))
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpCall, nt.temp, pack_fn.temp, 2, "_aria_spawn", 1))
    // Tag result: 1 (joinable, collides with TY_I64 but matches scope auto-join
    // heuristic which awaits all temps in scope frame; detached tasks get 18
    // so scope skips them). Method dispatch at L10720 accepts either.
    mut spawn_type := 1
    if is_detach { spawn_type = 18 }
    ll = _lset_type(ll, nt.temp, spawn_type)
    LT{l: ll, temp: nt.temp}
}

// Lower a { block } as a zero-arg closure returning i64
fn _lower_closure_from_block(l: Lowerer) -> LT {
    // Synthesize: fn() -> i64 { <block>; 0 }
    // Reuse the existing closure lowering by pretending we saw "fn() {"
    // For simplicity, directly lower the block contents in a new function
    mut ll := l
    lb := "\{"
    rb := "\}"
    // Create a new function for the closure body
    fname := "_spawn_fn_" + i2s(ll.temp_counter)
    saved_func := ll.current_func
    saved_tc := ll.temp_counter
    saved_lc := ll.label_counter
    saved_env := ll.env_names
    saved_slots := ll.env_slots
    ll = _lset_func(ll, new_ir_func(fname, 1, 0))
    // arg 0 = env pointer (unused for no-capture spawns)
    env_nt := _lnew_temp(ll)
    ll = env_nt.l
    ll = _lemit(ll, new_inst(OpArg, env_nt.temp, 0, 0, "", 0))
    // Lower block body
    ll = _ladv(ll)  // skip {
    ll = _lskip_nl(ll)
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lower_stmt(ll)
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    // Return 0
    ret_nt := _lnew_temp(ll)
    ll = ret_nt.l
    ll = _lemit(ll, new_inst(OpConst, ret_nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpRet, 0, ret_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    // Restore saved state
    ll = _lset_func(ll, saved_func)
    // Build closure: {fn_ptr, 0} — no captures for now
    fn_ref := _lnew_temp(ll)
    ll = fn_ref.l
    ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, fname, 0))
    clos := _lnew_temp(ll)
    ll = clos.l
    ll = _lemit(ll, new_inst(OpAlloc, clos.temp, 2, 0, "_Closure", 0))
    ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, fn_ref.temp, 0, "_fn", 0))
    null_nt := _lnew_temp(ll)
    ll = null_nt.l
    ll = _lemit(ll, new_inst(OpConst, null_nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, null_nt.temp, 1, "_env", 0))
    LT{l: ll, temp: clos.temp}
}

// --- Lower scope expression ---
// scope { stmts } — track spawned tasks, auto-join at block exit

fn _lower_scope(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip scope
    lb := "\{"
    rb := "\}"
    if _lk(ll) != lb {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    ll = _ladv(ll)  // skip {
    ll = _lskip_nl(ll)
    // scope_enter pushes a thread-local frame. Every _aria_spawn inside
    // registers its task with the current frame, so nested spawns (in
    // for/while loops, in called functions) are tracked dynamically —
    // the old 8-slot lexical tracker missed them. scope_exit awaits all
    // tasks in the frame and pops. Task handles are idempotent-join
    // trackers, so explicit `t.await()` + scope_exit don't double-join.
    enter_nt := _lnew_temp(ll)
    ll = enter_nt.l
    ll = _lemit(ll, new_inst(OpCall, enter_nt.temp, 0, 0, "_aria_scope_enter", 0))
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lower_stmt(ll)
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    exit_nt := _lnew_temp(ll)
    ll = exit_nt.l
    ll = _lemit(ll, new_inst(OpCall, exit_nt.temp, 0, 0, "_aria_scope_exit", 0))
    // Result is the last expression temp (or 0)
    result_nt := _lnew_temp(ll)
    ll = result_nt.l
    ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
    LT{l: ll, temp: result_nt.temp}
}

// --- Lower select expression ---
// select { msg from ch1 => body1, msg from ch2 => body2, default => body3 }

fn _lower_select(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip select
    lb := "\{"
    rb := "\}"
    if _lk(ll) != lb {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    ll = _ladv(ll)  // skip {
    ll = _lskip_nl(ll)
    // Collect channel handles and arm info
    // Each arm: binding_name from channel_expr => body
    // Or: default => body
    mut ch_count := 0
    mut has_default := false
    // Build array of channel handles
    arr_nt := _lnew_temp(ll)
    ll = arr_nt.l
    ll = _lemit(ll, new_inst(OpArrayNew, arr_nt.temp, 8, 0, "", 0))
    // Collect arms
    mut bind_name_0 := ""
    mut bind_name_1 := ""
    mut bind_name_2 := ""
    mut bind_name_3 := ""
    mut arm_start_0 := 0
    mut arm_start_1 := 0
    mut arm_start_2 := 0
    mut arm_start_3 := 0
    mut arm_end_0 := 0
    mut arm_end_1 := 0
    mut arm_end_2 := 0
    mut arm_end_3 := 0
    // Per-arm channel temps so the dispatch side can check chan elem type
    // (TY_CHAN_STR=21) and unbox the {ptr,len} box into a str-temp pair.
    mut ch_temp_0 := 0
    mut ch_temp_1 := 0
    mut ch_temp_2 := 0
    mut ch_temp_3 := 0
    mut default_start := 0
    mut default_end := 0
    // timeout-arm state (ex09 form: `timeout(d) => body` or spec `after d => body`).
    // Only one timeout arm is honoured per select — additional arms win by arrival,
    // which matches the spec's "first ready wins" semantics.
    mut has_timeout := false
    mut timeout_ms_temp := 0
    mut timeout_body_start := 0
    mut timeout_body_end := 0
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        if _lk(ll) == rb { break }
        // Check for default arm
        if _lk(ll) == "_" || (_lk(ll) == "IDENT" && _lcur(ll).text == "default") {
            has_default = true
            ll = _ladv(ll)
            if _lk(ll) == "=>" { ll = _ladv(ll) }
            ll = _lskip_nl(ll)
            default_start = ll.pos
            // Skip to next arm or end
            if _lk(ll) == lb {
                while _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == rb { ll = _ladv(ll) }
            } else {
                while _lk(ll) != "NEWLINE" && _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
            }
            default_end = ll.pos
        } else if _lk(ll) == "IDENT" && _lcur(ll).text == "timeout" && ll.pos + 1 < ll.tokens.len() && ll.tokens[ll.pos + 1].name == "(" {
            // timeout(dur_ms) => body  — dur_ms is an i64 expression (ms).
            // Runtime: _aria_chan_select(arr, timeout_ms) takes the ms directly.
            ll = _ladv(ll)  // skip timeout
            ll = _ladv(ll)  // skip (
            d := _lower_expr(ll)
            ll = d.l
            if _lk(ll) == ")" { ll = _ladv(ll) }
            timeout_ms_temp = d.temp
            has_timeout = true
            if _lk(ll) == "=>" { ll = _ladv(ll) }
            ll = _lskip_nl(ll)
            timeout_body_start = ll.pos
            if _lk(ll) == lb {
                while _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == rb { ll = _ladv(ll) }
            } else {
                while _lk(ll) != "NEWLINE" && _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
            }
            timeout_body_end = ll.pos
        } else if _lk(ll) == "IDENT" {
            // Two forms:
            //   binding_name from channel_expr => body        (spec form)
            //   binding_name := <-channel_expr => body         (ex09 form)
            bname := _lcur(ll).text
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" && _lcur(ll).text == "from" {
                ll = _ladv(ll)  // skip from
            } else if _lk(ll) == ":=" {
                ll = _ladv(ll)  // skip :=
                if _lk(ll) == "<" { ll = _ladv(ll) }
                if _lk(ll) == "-" { ll = _ladv(ll) }
            }
            // Lower channel expression
            ch_expr := _lower_expr(ll)
            ll = ch_expr.l
            // Append channel handle to array
            ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, ch_expr.temp, "", 0))
            // Save arm info
            if ch_count == 0 { bind_name_0 = bname }
            if ch_count == 1 { bind_name_1 = bname }
            if ch_count == 2 { bind_name_2 = bname }
            if ch_count == 3 { bind_name_3 = bname }
            if ch_count == 0 { ch_temp_0 = ch_expr.temp }
            if ch_count == 1 { ch_temp_1 = ch_expr.temp }
            if ch_count == 2 { ch_temp_2 = ch_expr.temp }
            if ch_count == 3 { ch_temp_3 = ch_expr.temp }
            if _lk(ll) == "=>" { ll = _ladv(ll) }
            ll = _lskip_nl(ll)
            // Record arm body position
            if ch_count == 0 { arm_start_0 = ll.pos }
            if ch_count == 1 { arm_start_1 = ll.pos }
            if ch_count == 2 { arm_start_2 = ll.pos }
            if ch_count == 3 { arm_start_3 = ll.pos }
            // Skip arm body
            if _lk(ll) == lb {
                while _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == rb { ll = _ladv(ll) }
            } else {
                while _lk(ll) != "NEWLINE" && _lk(ll) != rb && _lk(ll) != "EOF" { ll = _ladv(ll) }
            }
            if ch_count == 0 { arm_end_0 = ll.pos }
            if ch_count == 1 { arm_end_1 = ll.pos }
            if ch_count == 2 { arm_end_2 = ll.pos }
            if ch_count == 3 { arm_end_3 = ll.pos }
            ch_count = ch_count + 1
        } else {
            ll = _ladv(ll)
        }
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    // Call _aria_chan_select(array, timeout_ms)
    // timeout: 0 if has_default (non-blocking), -1 if no timeout arm (blocking),
    // or the user's duration (ms) if a `timeout(d)` arm is present.
    mut timeout_temp := 0
    if has_timeout {
        timeout_temp = timeout_ms_temp
    } else {
        tn := _lnew_temp(ll)
        ll = tn.l
        mut timeout_val := 0 - 1
        if has_default { timeout_val = 0 }
        ll = _lemit(ll, new_inst(OpConst, tn.temp, timeout_val, 0, "", 0))
        timeout_temp = tn.temp
    }
    pack0 := _lnew_temp(ll)
    ll = pack0.l
    ll = _lemit(ll, new_inst(OpStore, pack0.temp, arr_nt.temp, 0, "", 0))
    pack1 := _lnew_temp(ll)
    ll = pack1.l
    ll = _lemit(ll, new_inst(OpStore, pack1.temp, timeout_temp, 0, "", 0))
    sel_result := _lnew_str_temp(ll)  // 2 temps: {index, value}
    ll = sel_result.l
    ll = _lemit(ll, new_inst(OpCall, sel_result.temp, pack0.temp, 2, "_aria_chan_select", 0))
    // Dispatch based on returned index
    result_nt := _lnew_temp(ll)
    ll = result_nt.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    // Load index
    idx_nt := _lnew_temp(ll)
    ll = idx_nt.l
    ll = _lemit(ll, new_inst(OpLoad, idx_nt.temp, sel_result.temp, 0, "", 0))
    // Load value
    val_nt := _lnew_temp(ll)
    ll = val_nt.l
    ll = _lemit(ll, new_inst(OpLoad, val_nt.temp, sel_result.temp + 1, 0, "", 0))
    // For each arm, compare index and branch
    mut ai := 0
    while ai < ch_count {
        next_lbl := _lnew_label(ll)
        ll = next_lbl.l
        // Compare index == ai
        ai_nt := _lnew_temp(ll)
        ll = ai_nt.l
        ll = _lemit(ll, new_inst(OpConst, ai_nt.temp, ai, 0, "", 0))
        cmp := _lnew_temp(ll)
        ll = cmp.l
        ll = _lemit(ll, new_inst(OpEq, cmp.temp, idx_nt.temp, ai_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, next_lbl.temp, "", 0))
        // Bind received value to binding name
        mut bname := ""
        if ai == 0 { bname = bind_name_0 }
        if ai == 1 { bname = bind_name_1 }
        if ai == 2 { bname = bind_name_2 }
        if ai == 3 { bname = bind_name_3 }
        mut arm_ch_temp := 0
        if ai == 0 { arm_ch_temp = ch_temp_0 }
        if ai == 1 { arm_ch_temp = ch_temp_1 }
        if ai == 2 { arm_ch_temp = ch_temp_2 }
        if ai == 3 { arm_ch_temp = ch_temp_3 }
        mut bind_temp := val_nt.temp
        if arm_ch_temp != 0 && _lget_type(ll, arm_ch_temp) == 21 {
            // chan[str]: val_nt.temp points at the {ptr,len} box — unbox
            // into a str-temp pair so the arm body sees a real str.
            str_nt := _lnew_str_temp(ll)
            ll = str_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp, val_nt.temp, 0, "_ptr", 0))
            ll = _lemit(ll, new_inst(OpFieldGet, str_nt.temp + 1, val_nt.temp, 1, "_len", 0))
            ll = _lset_type(ll, str_nt.temp, 12)
            bind_temp = str_nt.temp
        }
        if bname != "" && bname != "_" {
            ll = _lenv_add(ll, bname, bind_temp)
        }
        // Lower arm body by re-positioning to saved tokens
        mut arm_s := 0
        mut arm_e := 0
        if ai == 0 { arm_s = arm_start_0 }
        if ai == 0 { arm_e = arm_end_0 }
        if ai == 1 { arm_s = arm_start_1 }
        if ai == 1 { arm_e = arm_end_1 }
        if ai == 2 { arm_s = arm_start_2 }
        if ai == 2 { arm_e = arm_end_2 }
        if ai == 3 { arm_s = arm_start_3 }
        if ai == 3 { arm_e = arm_end_3 }
        if arm_s > 0 {
            saved_pos := ll.pos
            ll = _lset_pos(ll, arm_s)
            if _lk(ll) == "\{" {
                ll = _lower_block(ll)
            } else {
                arm_result := _lower_expr(ll)
                ll = arm_result.l
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
            }
            ll = _lset_pos(ll, saved_pos)
        }
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
        ai = ai + 1
    }
    // Default arm (index == -1) — also handles the `timeout(d)` arm since the
    // runtime returns index=-1 when its timeout fires. timeout + default in the
    // same select aren't well-defined; timeout wins.
    if has_timeout && timeout_body_start > 0 {
        saved_pos := ll.pos
        ll = _lset_pos(ll, timeout_body_start)
        if _lk(ll) == "\{" {
            ll = _lower_block(ll)
        } else {
            arm_result := _lower_expr(ll)
            ll = arm_result.l
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
        }
        ll = _lset_pos(ll, saved_pos)
    } else if has_default && default_start > 0 {
        saved_pos := ll.pos
        ll = _lset_pos(ll, default_start)
        if _lk(ll) == "\{" {
            ll = _lower_block(ll)
        } else {
            arm_result := _lower_expr(ll)
            ll = arm_result.l
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
        }
        ll = _lset_pos(ll, saved_pos)
    }
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    LT{l: ll, temp: result_nt.temp}
}

// AST-based match lowering — avoids unreliable _find_tok_pos token positioning.
// Uses pool indices directly: node.c0 = subject, list_start + i*2 = pattern, list_start + i*2+1 = body
fn _lower_match_node(l: Lowerer, node: Expr) -> LT {
    mut ll := l

    // 1. Lower subject expression from AST
    subj := _lower_expr_node(ll, node.c0)
    ll = subj.l

    // 2. Determine if sum type (tag-based) or direct value match
    subj_type := _lget_type(ll, subj.temp)
    mut subj_tag := subj.temp  // for tag-only sums, subject IS the tag
    // For data sum types (struct-allocated), extract tag from slot 0
    // Simple enums (no payload variants) are just i64 tags — no FieldGet needed
    // Detect if any arm uses Ok/Err/Some/None patterns → subject is Result/Optional
    mut has_result_arms := false
    if subj_type == 200 || subj_type == 201 { has_result_arms = true }
    if has_result_arms == false {
        mut scan_i := 0
        while scan_i < node.list_count && has_result_arms == false {
            scan_pat_holder := pool_get(ll.pool, node.list_start + scan_i * 2)
            scan_pat := pool_get(ll.pool, scan_pat_holder.c0)
            scan_pname := scan_pat.s1
            if scan_pname == "Ok" || scan_pname == "Err" || scan_pname == "Some" || scan_pname == "None" {
                has_result_arms = true
            }
            scan_i = scan_i + 1
        }
    }
    if has_result_arms {
        // Guard against null Result pointer (from unimplemented function bodies)
        null_guard := _lnew_temp(ll)
        ll = null_guard.l
        null_zero := _lnew_temp(ll)
        ll = null_zero.l
        ll = _lemit(ll, new_inst(OpConst, null_zero.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpEq, null_guard.temp, subj.temp, null_zero.temp, "", 0))
        null_safe_lbl := _lnew_label(ll)
        ll = null_safe_lbl.l
        null_err_lbl := _lnew_label(ll)
        ll = null_err_lbl.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, null_guard.temp, null_err_lbl.temp, "", 0))
        // Non-null: extract tag normally
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, subj.temp, 0, "_tag", 0))
        subj_tag = tag_nt.temp
        ll = _lemit(ll, new_inst(OpJump, 0, null_safe_lbl.temp, 0, "", 0))
        // Null pointer: allocate a minimal Err Result so arms can safely read fields
        ll = _lemit(ll, new_inst(OpLabel, 0, null_err_lbl.temp, 0, "", 0))
        null_res := _lnew_temp(ll)
        ll = null_res.l
        ll = _lemit(ll, new_inst(OpAlloc, null_res.temp, 3, 0, "_Result", 0))
        null_tag := _lnew_temp(ll)
        ll = null_tag.l
        ll = _lemit(ll, new_inst(OpConst, null_tag.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, null_res.temp, null_tag.temp, 0, "_tag", 0))
        ll = _lemit(ll, new_inst(OpStore, subj.temp, null_res.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, null_safe_lbl.temp, 0, "", 0))
    } else {
        sname := _struct_name_for_type(ll.store, ll.registry, subj_type)
        if sname.len() > 0 {
            sdef := reg_find_struct(ll.registry, sname)
            if sdef.is_sum && sum_has_data(sdef) {
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, subj.temp, 0, "_tag", 0))
                subj_tag = tag_nt.temp
            }
        }
    }

    // 3. Allocate result temp and end label
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    // Tracks the type of arm bodies for setting the match-expression result
    // type after all arms have lowered.
    mut arm_body_type := 0
    result_nt := _lnew_str_temp(ll)
    ll = result_nt.l

    // 4. Process each arm
    mut ai := 0
    while ai < node.list_count {
        pat_idx_node := pool_get(ll.pool, node.list_start + ai * 2)
        body_idx_node := pool_get(ll.pool, node.list_start + ai * 2 + 1)
        pat := pool_get(ll.pool, pat_idx_node.c0)
        body_idx := body_idx_node.c0
        pat_kind := expr_kind_name(pat.kind)
        pat_name := pat.s1

        // Generate arm label for this arm's body
        next_lbl := _lnew_label(ll)
        ll = next_lbl.l

        // Guard expression info (from parser)
        guard_idx := pat_idx_node.c1
        has_guard := guard_idx > 0
        // Or-pattern alternatives (from parser): each alt is wrapped in an EkNone holder
        alts_start := pat_idx_node.list_start
        alts_count := pat_idx_node.list_count
        has_alts := alts_count > 0

        is_wildcard := pat_name == "_"
        is_last_raw := ai == node.list_count - 1
        // Don't treat as unconditional default if there's a guard or or-pattern alts
        is_last := is_last_raw && has_guard == false && has_alts == false

        if (is_wildcard && has_guard == false) || is_last {
            // Default/wildcard: no comparison needed
            // Still need to bind/destructure if pattern requires it
            if pat_kind == "Ident" && pat_name != "_" {
                // Variant-name idents (None, Red, etc.) are tag-only variant patterns,
                // not bindings. Adding them to env would shadow the variant in later
                // expressions — `val2 := None` would resolve to the subject binding
                // instead of allocating a fresh None.
                is_variant_name := _variant_tag(ll.registry, pat_name) > 0 || (pat_name == "None" && has_result_arms) || (pat_name == "Ok" && has_result_arms) || (pat_name == "Err" && has_result_arms) || (pat_name == "Some" && has_result_arms)
                if is_variant_name == false {
                    bind_nt := _lnew_temp(ll)
                    ll = bind_nt.l
                    ll = _lemit(ll, new_inst(OpLoad, bind_nt.temp, subj.temp, 0, "", 0))
                    ll = _lenv_add(ll, pat_name, bind_nt.temp)
                }
            } else if pat_kind == "Call" {
                // Variant destructuring: extract fields without comparison
                wvname := pat.s1
                wvtag := _variant_tag(ll.registry, wvname)
                wvparent := _variant_parent(ll.registry, wvname)
                // For universal Ok/Err/Some without a registered parent, infer
                // the payload type from the subject's Result/Optional shape.
                mut w_inferred_ft := 0
                if wvparent.name == "" && (wvname == "Ok" || wvname == "Err" || wvname == "Some") {
                    if subj_type > 16 && subj_type < ll.store.types.len() {
                        wsi := store_get(ll.store, subj_type)
                        wsik := type_kind_name(wsi.kind)
                        if wsik == "Result" {
                            if wvname == "Err" { w_inferred_ft = wsi.type_id2 }
                            else { w_inferred_ft = wsi.type_id }
                        } else if wsik == "Optional" && wvname == "Some" {
                            w_inferred_ft = wsi.type_id
                        }
                    }
                }
                if pat.b2 {
                    // Struct pattern: Move{x, y} or Repeat{count, cmd: inner}
                    // Field nodes: s1=binding_name, s2=field_name
                    mut sfi := 0
                    while sfi < pat.list_count {
                        field_node := pool_get(ll.pool, pat.list_start + sfi)
                        bname := field_node.s1   // binding name
                        fld_name := field_node.s2  // actual field name in variant
                        // Find field slot by name in variant's field list
                        mut fslot := 0
                        mut ftype := 0
                        wvfc := variant_data_count(wvparent, wvtag)
                        wv_foff := wvparent.variant_field_offsets[wvtag]
                        mut wvfi := 0
                        mut wv_slot := 1  // slot 0 is _tag
                        while wvfi < wvfc {
                            wv_idx := wv_foff + wvfi
                            wv_ft := 0
                            if wv_idx < wvparent.variant_field_types.len() { wv_ft = wvparent.variant_field_types[wv_idx] }
                            if wv_idx < wvparent.variant_field_names.len() && wvparent.variant_field_names[wv_idx] == fld_name {
                                fslot = wv_slot
                                ftype = wv_ft
                            }
                            if wv_ft == 12 { wv_slot = wv_slot + 2 } else { wv_slot = wv_slot + 1 }
                            wvfi = wvfi + 1
                        }
                        // fslot already includes tag offset (starts at 1)
                        actual_slot := fslot
                        if bname != "_" {
                            if ftype == 12 {
                                wfld_nt := _lnew_str_temp(ll)
                                ll = wfld_nt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp, subj.temp, actual_slot, bname, 0))
                                slen := actual_slot + 1
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp + 1, subj.temp, slen, bname, 0))
                                ll = _lset_type(ll, wfld_nt.temp, 12)
                                ll = _lenv_add(ll, bname, wfld_nt.temp)
                            } else {
                                wfld_nt := _lnew_temp(ll)
                                ll = wfld_nt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp, subj.temp, actual_slot, bname, 0))
                                if ftype > 0 { ll = _lset_type(ll, wfld_nt.temp, ftype) }
                                ll = _lenv_add(ll, bname, wfld_nt.temp)
                            }
                        }
                        sfi = sfi + 1
                    }
                } else {
                    // Nested variant in wildcard arm: Err(Type.Variant(s))
                    mut wild_handled_nested := false
                    if pat.list_count == 1 {
                        mut wfirst := pool_get(ll.pool, pat.list_start)
                        mut wfkind := expr_kind_name(wfirst.kind)
                        if wfkind == "Ident" {
                            wnext := pool_get(ll.pool, pat.list_start + 1)
                            wnk := expr_kind_name(wnext.kind)
                            if wnk == "Call" && wnext.list_count > 0 && wnext.s1.contains(".") {
                                wfirst = wnext
                                wfkind = wnk
                            }
                        }
                        wfvname_raw := wfirst.s1
                        mut wfvname := wfvname_raw
                        if wfvname_raw.contains(".") {
                            wparts := wfvname_raw.split(".")
                            wfvname = wparts[wparts.len() - 1]
                        }
                        wfvtag := _variant_tag(ll.registry, wfvname)
                        if wfvtag > 0 && wfirst.list_count > 0 &&
                           (wfkind == "Call" || wfkind == "MethodCall") {
                            wild_handled_nested = true
                            wfv_parent := _variant_parent(ll.registry, wfvname)
                            w_outer := _lnew_temp(ll)
                            ll = w_outer.l
                            ll = _lemit(ll, new_inst(OpFieldGet, w_outer.temp, subj.temp, 1, "_val", 0))
                            mut iwbi := 0
                            mut iwslot := 1
                            while iwbi < wfirst.list_count {
                                iwarg := pool_get(ll.pool, wfirst.list_start + iwbi)
                                iwname := iwarg.s1
                                iwft := variant_field_type(wfv_parent, wfvtag, iwbi)
                                if iwft == 12 {
                                    iwbnt := _lnew_str_temp(ll)
                                    ll = iwbnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, iwbnt.temp, w_outer.temp, iwslot, "", 0))
                                    ll = _lemit(ll, new_inst(OpFieldGet, iwbnt.temp + 1, w_outer.temp, iwslot + 1, "", 0))
                                    ll = _lset_type(ll, iwbnt.temp, 12)
                                    if iwname != "_" { ll = _lenv_add(ll, iwname, iwbnt.temp) }
                                    iwslot = iwslot + 2
                                } else {
                                    iwbnt := _lnew_temp(ll)
                                    ll = iwbnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, iwbnt.temp, w_outer.temp, iwslot, "", 0))
                                    if iwft > 0 { ll = _lset_type(ll, iwbnt.temp, iwft) }
                                    if iwname != "_" { ll = _lenv_add(ll, iwname, iwbnt.temp) }
                                    iwslot = iwslot + 1
                                }
                                iwbi = iwbi + 1
                            }
                        }
                    }
                    if wild_handled_nested == false {
                    // Tuple pattern: Variant(a, b, c)
                    mut wfi := 0
                    mut wslot := 1
                    while wfi < pat.list_count {
                        field_node := pool_get(ll.pool, pat.list_start + wfi)
                        fname := field_node.s1
                        mut wftype := variant_field_type(wvparent, wvtag, wfi)
                        if wftype == 0 && wfi == 0 && w_inferred_ft != 0 { wftype = w_inferred_ft }
                        if fname != "_" {
                            if wftype == 12 {
                                wfld_nt := _lnew_str_temp(ll)
                                ll = wfld_nt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp, subj.temp, wslot, fname, 0))
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp + 1, subj.temp, wslot + 1, fname, 0))
                                ll = _lset_type(ll, wfld_nt.temp, 12)
                                ll = _lenv_add(ll, fname, wfld_nt.temp)
                            } else {
                                wfld_nt := _lnew_temp(ll)
                                ll = wfld_nt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, wfld_nt.temp, subj.temp, wslot, fname, 0))
                                if wftype > 0 { ll = _lset_type(ll, wfld_nt.temp, wftype) }
                                ll = _lenv_add(ll, fname, wfld_nt.temp)
                            }
                        }
                        if wftype == 12 { wslot = wslot + 2 } else { wslot = wslot + 1 }
                        wfi = wfi + 1
                    }
                    }   // end if wild_handled_nested == false
                }
            }
            body := _lower_expr_node(ll, body_idx)
            ll = body.l
            if body.temp >= 0 {
                body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                if body_type == 12 {
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                }
            }
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        } else {
            // Pattern match: compare subject tag with variant tag
            mut vtag := 0
            if pat_kind == "Ident" {
                vtag = _variant_tag(ll.registry, pat_name)
            }
            // None (no parens) is a built-in Option variant with tag=0
            if vtag == 0 && pat_kind == "Ident" && pat_name == "None" && has_result_arms {
                none_tag_nt := _lnew_temp(ll)
                ll = none_tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, none_tag_nt.temp, 0, 0, "", 0))
                none_cmp_nt := _lnew_temp(ll)
                ll = none_cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, none_cmp_nt.temp, subj_tag, none_tag_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, none_cmp_nt.temp, next_lbl.temp, "", 0))
                if has_guard {
                    g := _lower_expr_node(ll, guard_idx)
                    ll = g.l
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                }
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if vtag > 0 {
                // Sum type variant match (no destructuring)
                // For or-patterns (Red | Blue | Yellow), emit a chain of comparisons:
                // each match jumps to matched_lbl; non-match falls through to next test;
                // final non-match jumps to next_lbl.
                if has_alts {
                    matched_lbl := _lnew_label(ll)
                    ll = matched_lbl.l
                    // Test main pattern's tag
                    vtag_nt := _lnew_temp(ll)
                    ll = vtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                    cmp_nt := _lnew_temp(ll)
                    ll = cmp_nt.l
                    ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj_tag, vtag_nt.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchTrue, 0, cmp_nt.temp, matched_lbl.temp, "", 0))
                    // Test each alt
                    mut alti := 0
                    while alti < alts_count {
                        alt_holder := pool_get(ll.pool, alts_start + alti)
                        alt_pat := pool_get(ll.pool, alt_holder.c0)
                        alt_name := alt_pat.s1
                        alt_vtag := _variant_tag(ll.registry, alt_name)
                        if alt_vtag > 0 {
                            avt_nt := _lnew_temp(ll)
                            ll = avt_nt.l
                            ll = _lemit(ll, new_inst(OpConst, avt_nt.temp, alt_vtag, 0, "", 0))
                            acmp_nt := _lnew_temp(ll)
                            ll = acmp_nt.l
                            ll = _lemit(ll, new_inst(OpEq, acmp_nt.temp, subj_tag, avt_nt.temp, "", 0))
                            mut is_last_alt := alti == alts_count - 1
                            if is_last_alt {
                                ll = _lemit(ll, new_inst(OpBranchFalse, 0, acmp_nt.temp, next_lbl.temp, "", 0))
                            } else {
                                ll = _lemit(ll, new_inst(OpBranchTrue, 0, acmp_nt.temp, matched_lbl.temp, "", 0))
                            }
                        }
                        alti = alti + 1
                    }
                    ll = _lemit(ll, new_inst(OpLabel, 0, matched_lbl.temp, 0, "", 0))
                } else {
                    vtag_nt := _lnew_temp(ll)
                    ll = vtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                    cmp_nt := _lnew_temp(ll)
                    ll = cmp_nt.l
                    ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj_tag, vtag_nt.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                }
                // Guard check (after pattern match)
                if has_guard {
                    g := _lower_expr_node(ll, guard_idx)
                    ll = g.l
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                }

                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "Ident" && pat_name != "_" {
                // Binding pattern: bind subject value to name, always matches
                // Create a new temp with the subject's value for the binding
                bind_nt := _lnew_temp(ll)
                ll = bind_nt.l
                ll = _lemit(ll, new_inst(OpLoad, bind_nt.temp, subj.temp, 0, "", 0))
                ll = _lenv_add(ll, pat_name, bind_nt.temp)
                // Guard check after binding
                if has_guard {
                    g := _lower_expr_node(ll, guard_idx)
                    ll = g.l
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                }
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "Call" {
                // Variant destructuring: Circle(r), Move{x, y}, Ok(n), Err(e)
                vname := pat.s1
                mut dvtag := _variant_tag(ll.registry, vname)
                // Special case: Ok/Err are built-in Result variants, Some/None are Option variants
                if dvtag == 0 && vname == "Ok" { dvtag = 0 - 1 }
                if dvtag == 0 && vname == "Err" { dvtag = 0 - 2 }
                if dvtag == 0 && vname == "Some" { dvtag = 0 - 3 }
                if dvtag == 0 && vname == "None" { dvtag = 0 - 4 }
                if dvtag == 0 - 1 || dvtag == 0 - 2 || dvtag == 0 - 3 || dvtag == 0 - 4 {
                    // Ok(n) has tag=0, Err(e) has tag=1, Some(v) has tag=1, None has tag=0
                    mut result_tag := 0
                    if dvtag == 0 - 2 { result_tag = 1 }
                    if dvtag == 0 - 3 { result_tag = 1 }
                    // None (tag=0) and Ok (tag=0) already default to 0
                    dvtag_nt := _lnew_temp(ll)
                    ll = dvtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, dvtag_nt.temp, result_tag, 0, "", 0))
                    dcmp_nt := _lnew_temp(ll)
                    ll = dcmp_nt.l
                    ll = _lemit(ll, new_inst(OpEq, dcmp_nt.temp, subj_tag, dvtag_nt.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, dcmp_nt.temp, next_lbl.temp, "", 0))
                    // Extract value from slot 1. Determine the payload type
                    // from the subject's TyOptional/TyResult so the binding's
                    // env entry has the right type for interp/string handling.
                    if pat.list_count > 0 {
                        field_node := pool_get(ll.pool, pat.list_start)
                        mut fname := field_node.s1
                        mut fkind := expr_kind_name(field_node.kind)
                        // Nested variant: Err(ParseErr.BadInt(s)). With old list_start,
                        // field_node points at inner `s` Ident; the Call wrapper is at +1.
                        mut handled_nested := false
                        mut inner_node := field_node
                        if fkind == "Ident" && pat.list_count == 1 {
                            next_node := pool_get(ll.pool, pat.list_start + 1)
                            next_kind := expr_kind_name(next_node.kind)
                            if next_kind == "Call" && next_node.list_count > 0 && next_node.s1.contains(".") {
                                inner_node = next_node
                                fname = inner_node.s1
                                fkind = next_kind
                            }
                        }
                        raw_vname := inner_node.s1
                        mut nested_vname := raw_vname
                        if raw_vname.contains(".") {
                            dparts := raw_vname.split(".")
                            nested_vname = dparts[dparts.len() - 1]
                        }
                        nv_tag := _variant_tag(ll.registry, nested_vname)
                        if nv_tag > 0 && inner_node.list_count > 0 &&
                           (fkind == "Call" || fkind == "MethodCall") {
                            handled_nested = true
                            nv_parent := _variant_parent(ll.registry, nested_vname)
                            outer_payload := _lnew_temp(ll)
                            ll = outer_payload.l
                            ll = _lemit(ll, new_inst(OpFieldGet, outer_payload.temp, subj.temp, 1, "_val", 0))
                            inner_tag_val := _lnew_temp(ll)
                            ll = inner_tag_val.l
                            ll = _lemit(ll, new_inst(OpFieldGet, inner_tag_val.temp, outer_payload.temp, 0, "_tag", 0))
                            nv_tag_c := _lnew_temp(ll)
                            ll = nv_tag_c.l
                            ll = _lemit(ll, new_inst(OpConst, nv_tag_c.temp, nv_tag, 0, "", 0))
                            nv_cmp := _lnew_temp(ll)
                            ll = nv_cmp.l
                            ll = _lemit(ll, new_inst(OpEq, nv_cmp.temp, inner_tag_val.temp, nv_tag_c.temp, "", 0))
                            ll = _lemit(ll, new_inst(OpBranchFalse, 0, nv_cmp.temp, next_lbl.temp, "", 0))
                            mut ibi := 0
                            mut idata_slot := 1
                            while ibi < inner_node.list_count {
                                inner_arg := pool_get(ll.pool, inner_node.list_start + ibi)
                                ibname := inner_arg.s1
                                iv_ft := variant_field_type(nv_parent, nv_tag, ibi)
                                if iv_ft == 12 {
                                    ibnt := _lnew_str_temp(ll)
                                    ll = ibnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, outer_payload.temp, idata_slot, "", 0))
                                    ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp + 1, outer_payload.temp, idata_slot + 1, "", 0))
                                    ll = _lset_type(ll, ibnt.temp, 12)
                                    if ibname != "_" { ll = _lenv_add(ll, ibname, ibnt.temp) }
                                    idata_slot = idata_slot + 2
                                } else {
                                    ibnt := _lnew_temp(ll)
                                    ll = ibnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, outer_payload.temp, idata_slot, "", 0))
                                    if iv_ft > 0 { ll = _lset_type(ll, ibnt.temp, iv_ft) }
                                    if ibname != "_" { ll = _lenv_add(ll, ibname, ibnt.temp) }
                                    idata_slot = idata_slot + 1
                                }
                                ibi = ibi + 1
                            }
                        }
                        // Look up payload type from subject's container type.
                        // Ok/Some → ok type (type_id); Err → err type (type_id2).
                        mut payload_type := 0
                        if subj_type > 16 && subj_type < ll.store.types.len() {
                            si := store_get(ll.store, subj_type)
                            sik := type_kind_name(si.kind)
                            if sik == "Optional" { payload_type = si.type_id }
                            if sik == "Result" {
                                if dvtag == 0 - 2 { payload_type = si.type_id2 }
                                else { payload_type = si.type_id }
                            }
                        }
                        // Fallible-call results carry the payload type directly in subj_type
                        // (e.g. return 9 for f64!E). Fall back to that when no container type.
                        if payload_type == 0 && subj_type > 0 && subj_type < 16 && _lis_result(ll, subj.temp) {
                            payload_type = subj_type
                        }
                        if handled_nested {
                            // nested handler already bound — skip default
                        } else if payload_type == 12 {
                            // String payload: load both ptr (slot 1) and len (slot 2)
                            sfld_nt := _lnew_str_temp(ll)
                            ll = sfld_nt.l
                            ll = _lemit(ll, new_inst(OpFieldGet, sfld_nt.temp, subj.temp, 1, fname, 0))
                            ll = _lemit(ll, new_inst(OpFieldGet, sfld_nt.temp + 1, subj.temp, 2, fname, 0))
                            ll = _lset_type(ll, sfld_nt.temp, 12)
                            if fname != "_" && fkind != "IntLit" && fkind != "StringLit" {
                                ll = _lenv_add(ll, fname, sfld_nt.temp)
                            }
                        } else {
                            fld_nt := _lnew_temp(ll)
                            ll = fld_nt.l
                            ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, subj.temp, 1, fname, 0))
                            if payload_type > 0 { ll = _lset_type(ll, fld_nt.temp, payload_type) }
                            if fkind == "IntLit" {
                                lit_val := _parse_int_literal(fname)
                                lit_nt := _lnew_temp(ll)
                                ll = lit_nt.l
                                ll = _lemit(ll, new_inst(OpConst, lit_nt.temp, lit_val, 0, "", 0))
                                lcmp_nt := _lnew_temp(ll)
                                ll = lcmp_nt.l
                                ll = _lemit(ll, new_inst(OpEq, lcmp_nt.temp, fld_nt.temp, lit_nt.temp, "", 0))
                                ll = _lemit(ll, new_inst(OpBranchFalse, 0, lcmp_nt.temp, next_lbl.temp, "", 0))
                            } else if fname != "_" {
                                ll = _lenv_add(ll, fname, fld_nt.temp)
                            }
                        }
                    }
                    // Guard check
                    if has_guard {
                        g := _lower_expr_node(ll, guard_idx)
                        ll = g.l
                        ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                    }
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    if body.temp >= 0 {
                        body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                        if body_type == 12 {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        }
                    }
                    ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
                } else if dvtag > 0 {
                    // Compare tag
                    dvtag_nt := _lnew_temp(ll)
                    ll = dvtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, dvtag_nt.temp, dvtag, 0, "", 0))
                    dcmp_nt := _lnew_temp(ll)
                    ll = dcmp_nt.l
                    ll = _lemit(ll, new_inst(OpEq, dcmp_nt.temp, subj_tag, dvtag_nt.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, dcmp_nt.temp, next_lbl.temp, "", 0))
                    dvparent := _variant_parent(ll.registry, vname)
                    if pat.b2 {
                        // Struct pattern: Move{x, y}, Repeat{count, cmd: inner}
                        mut sfi := 0
                        while sfi < pat.list_count {
                            field_node := pool_get(ll.pool, pat.list_start + sfi)
                            bname := field_node.s1
                            fld_name := field_node.s2
                            // Look up field slot in variant's named fields
                            mut fslot := 0
                            mut ftype := 0
                            dv_fc := variant_data_count(dvparent, dvtag)
                            dv_foff := dvparent.variant_field_offsets[dvtag]
                            mut dvfi := 0
                            mut dv_slot := 1
                            while dvfi < dv_fc {
                                dv_idx := dv_foff + dvfi
                                dv_ft := 0
                                if dv_idx < dvparent.variant_field_types.len() { dv_ft = dvparent.variant_field_types[dv_idx] }
                                if dv_idx < dvparent.variant_field_names.len() && dvparent.variant_field_names[dv_idx] == fld_name {
                                    fslot = dv_slot
                                    ftype = dv_ft
                                }
                                if dv_ft == 12 { dv_slot = dv_slot + 2 } else { dv_slot = dv_slot + 1 }
                                dvfi = dvfi + 1
                            }
                            actual_slot := fslot
                            if bname != "_" {
                                if ftype == 12 {
                                    fld_nt := _lnew_str_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, subj.temp, actual_slot, bname, 0))
                                    slen := actual_slot + 1
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp + 1, subj.temp, slen, bname, 0))
                                    ll = _lset_type(ll, fld_nt.temp, 12)
                                    ll = _lenv_add(ll, bname, fld_nt.temp)
                                } else {
                                    fld_nt := _lnew_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, subj.temp, actual_slot, bname, 0))
                                    if ftype > 0 { ll = _lset_type(ll, fld_nt.temp, ftype) }
                                    ll = _lenv_add(ll, bname, fld_nt.temp)
                                }
                            }
                            sfi = sfi + 1
                        }
                    } else {
                        // Tuple pattern: Circle(r), Rect(w, h), Solid(Rgb(r,g,b))
                        mut dfi := 0
                        mut dslot := 1
                        while dfi < pat.list_count {
                            field_node := pool_get(ll.pool, pat.list_start + dfi)
                            fname := field_node.s1
                            fkind := expr_kind_name(field_node.kind)
                            ftype := variant_field_type(dvparent, dvtag, dfi)
                            // Detect nested variant pattern: inner is Ident or Call whose name is a variant.
                            // Compare inner tag, recurse into sub-args.
                            mut nested_vt := 0
                            if fkind == "Ident" || fkind == "Call" || fkind == "MethodCall" {
                                nested_vt = _variant_tag(ll.registry, fname)
                            }
                            if nested_vt > 0 {
                                inner_nt := _lnew_temp(ll)
                                ll = inner_nt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, inner_nt.temp, subj.temp, dslot, "", 0))
                                inner_tag_val := _lnew_temp(ll)
                                ll = inner_tag_val.l
                                ll = _lemit(ll, new_inst(OpFieldGet, inner_tag_val.temp, inner_nt.temp, 0, "_tag", 0))
                                inner_tag_c := _lnew_temp(ll)
                                ll = inner_tag_c.l
                                ll = _lemit(ll, new_inst(OpConst, inner_tag_c.temp, nested_vt, 0, "", 0))
                                inner_cmp := _lnew_temp(ll)
                                ll = inner_cmp.l
                                ll = _lemit(ll, new_inst(OpEq, inner_cmp.temp, inner_tag_val.temp, inner_tag_c.temp, "", 0))
                                ll = _lemit(ll, new_inst(OpBranchFalse, 0, inner_cmp.temp, next_lbl.temp, "", 0))
                                if (fkind == "Call" || fkind == "MethodCall") && field_node.list_count > 0 {
                                    nv_parent := _variant_parent(ll.registry, fname)
                                    mut nbi := 0
                                    mut nslot := 1
                                    while nbi < field_node.list_count {
                                        nb_arg := pool_get(ll.pool, field_node.list_start + nbi)
                                        nb_name := nb_arg.s1
                                        nb_kind := expr_kind_name(nb_arg.kind)
                                        nb_ft := variant_field_type(nv_parent, nested_vt, nbi)
                                        if nb_kind == "Ident" && nb_name != "_" {
                                            if nb_ft == 12 {
                                                ibnt := _lnew_str_temp(ll)
                                                ll = ibnt.l
                                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, inner_nt.temp, nslot, "", 0))
                                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp + 1, inner_nt.temp, nslot + 1, "", 0))
                                                ll = _lset_type(ll, ibnt.temp, 12)
                                                ll = _lenv_add(ll, nb_name, ibnt.temp)
                                            } else {
                                                ibnt := _lnew_temp(ll)
                                                ll = ibnt.l
                                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, inner_nt.temp, nslot, "", 0))
                                                if nb_ft > 0 { ll = _lset_type(ll, ibnt.temp, nb_ft) }
                                                ll = _lenv_add(ll, nb_name, ibnt.temp)
                                            }
                                        }
                                        if nb_ft == 12 { nslot = nslot + 2 } else { nslot = nslot + 1 }
                                        nbi = nbi + 1
                                    }
                                }
                            } else if fname != "_" {
                                if ftype == 12 {
                                    fld_nt := _lnew_str_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, subj.temp, dslot, fname, 0))
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp + 1, subj.temp, dslot + 1, fname, 0))
                                    ll = _lset_type(ll, fld_nt.temp, 12)
                                    ll = _lenv_add(ll, fname, fld_nt.temp)
                                } else {
                                    fld_nt := _lnew_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, subj.temp, dslot, fname, 0))
                                    if ftype > 0 { ll = _lset_type(ll, fld_nt.temp, ftype) }
                                    ll = _lenv_add(ll, fname, fld_nt.temp)
                                }
                            }
                            if ftype == 12 { dslot = dslot + 2 } else { dslot = dslot + 1 }
                            dfi = dfi + 1
                        }
                    }
                    // Guard check after destructuring bindings
                    if has_guard {
                        g := _lower_expr_node(ll, guard_idx)
                        ll = g.l
                        ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                    }
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    if body.temp >= 0 {
                        body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                        if body_type == 12 {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        }
                    }
                    ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
                } else {
                    // Unknown Call pattern — treat as wildcard
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    if body.temp >= 0 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                    ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
                }
            } else if pat_kind == "Range" {
                // Range pattern: `lo..=hi` / `lo..hi` (in match arms)
                lo_node := pool_get(ll.pool, pat.c0)
                hi_node := pool_get(ll.pool, pat.c1)
                lo_num := _parse_int_literal(lo_node.s1)
                hi_num := _parse_int_literal(hi_node.s1)
                lo_c := _lnew_temp(ll)
                ll = lo_c.l
                ll = _lemit(ll, new_inst(OpConst, lo_c.temp, lo_num, 0, "", 0))
                hi_c := _lnew_temp(ll)
                ll = hi_c.l
                ll = _lemit(ll, new_inst(OpConst, hi_c.temp, hi_num, 0, "", 0))
                ge_nt := _lnew_temp(ll)
                ll = ge_nt.l
                ll = _lemit(ll, new_inst(OpGte, ge_nt.temp, subj_tag, lo_c.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, ge_nt.temp, next_lbl.temp, "", 0))
                hi_cmp := _lnew_temp(ll)
                ll = hi_cmp.l
                if pat.b1 {
                    ll = _lemit(ll, new_inst(OpLte, hi_cmp.temp, subj_tag, hi_c.temp, "", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpLt, hi_cmp.temp, subj_tag, hi_c.temp, "", 0))
                }
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, hi_cmp.temp, next_lbl.temp, "", 0))
                if has_guard {
                    g := _lower_expr_node(ll, guard_idx)
                    ll = g.l
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, g.temp, next_lbl.temp, "", 0))
                }
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "IntLit" {
                // Integer literal pattern
                num := _parse_int_literal(pat_name)
                cval := _lnew_temp(ll)
                ll = cval.l
                ll = _lemit(ll, new_inst(OpConst, cval.temp, num, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj_tag, cval.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "FloatLit" {
                // Float literal pattern — lower literal via FloatLit path, compare f64
                flt := _lower_expr_node(ll, pat_idx_node.c0)
                ll = flt.l
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, flt.temp, "f64", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "StringLit" {
                // String literal pattern
                sconst := _lower_string_const(ll, pat.s1)
                ll = sconst.l
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpStrEq, cmp_nt.temp, subj.temp, sconst.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else if pat_kind == "BoolLit" {
                // Bool literal pattern
                mut bval := 0
                if pat.b1 { bval = 1 }
                cval := _lnew_temp(ll)
                ll = cval.l
                ll = _lemit(ll, new_inst(OpConst, cval.temp, bval, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, cval.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else {
                // Unknown pattern — treat as wildcard
                body := _lower_expr_node(ll, body_idx)
                ll = body.l
                if body.temp >= 0 {
                    body_type := _lget_type(ll, body.temp)
                    if arm_body_type == 0 && body_type > 0 { arm_body_type = body_type }
                    if body_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                    }
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            }
        }
        ai = ai + 1
    }

    // 5. End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))

    // Set result type from body branches (not subject). arm_body_type is
    // tracked across arms so `match i { 0 => "a", _ => "b" }` returns str.
    if arm_body_type > 0 {
        ll = _lset_type(ll, result_nt.temp, arm_body_type)
    } else if subj_type == 12 {
        ll = _lset_type(ll, result_nt.temp, 12)
    }

    LT{l: ll, temp: result_nt.temp}
}

fn _lower_match(l: Lowerer) -> LT {
    mut ll := _ladv(l)  // skip match
    lb := "\{"
    rb := "\}"

    // Lower subject — use _lower_match_subject to avoid greedy struct literal parsing
    subj := _lower_match_subject(ll)
    ll = subj.l
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }

    ll = _lskip_nl(ll)
    if _lk(ll) != lb {
        nt := _lnew_temp(ll)
        return LT{l: nt.l, temp: nt.temp}
    }
    ll = _ladv(ll)  // skip {
    ll = _lskip_nl(ll)

    // Allocate result temp and end label
    // Use str temp (2 slots) since match may return strings
    result_nt := _lnew_str_temp(ll)
    ll = result_nt.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l

    // Determine if the subject is a data sum type (struct-allocated with tag at slot 0)
    // Scan the arms to find the first non-wildcard variant name and check its parent type
    mut is_data_sum := false
    mut subj_tag_temp := subj.temp  // for tag-only sums, subject IS the tag
    // Peek at arm patterns (we're already past { and newlines at this point)
    mut peek_pos := ll.pos
    while peek_pos < ll.tokens.len() && ll.tokens[peek_pos].name == "NEWLINE" {
        peek_pos = peek_pos + 1
    }
    // First token in arm should be a pattern name (or binding for named patterns)
    if peek_pos < ll.tokens.len() && ll.tokens[peek_pos].name == "IDENT" {
        mut first_pat := ll.tokens[peek_pos].text
        // If followed by @, this is a named pattern (binding @ pattern) — skip to actual pattern
        mut at_pos := peek_pos + 1
        if at_pos < ll.tokens.len() && ll.tokens[at_pos].text == "@" {
            pat_pos := at_pos + 1
            if pat_pos < ll.tokens.len() && ll.tokens[pat_pos].name == "IDENT" {
                first_pat = ll.tokens[pat_pos].text
            }
        }
        if first_pat != "_" {
            pat_parent := _variant_parent(ll.registry, first_pat)
            mut needs_tag_extract := false
            if pat_parent.name != "" && sum_has_data(pat_parent) {
                needs_tag_extract = true
            }
            // Built-in Ok/Err/Some/None patterns always indicate a
            // struct-allocated Result/Option subject; extract tag from slot 0.
            if first_pat == "Ok" || first_pat == "Err" || first_pat == "Some" || first_pat == "None" {
                needs_tag_extract = true
            }
            if needs_tag_extract {
                is_data_sum = true
                tag_ext := _lnew_temp(ll)
                ll = tag_ext.l
                ll = _lemit(ll, new_inst(OpFieldGet, tag_ext.temp, subj.temp, 0, "_tag", 0))
                subj_tag_temp = tag_ext.temp
            }
        }
    }

    // Process each arm
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        if _lk(ll) == rb || _lk(ll) == "EOF" { return LT{l: ll, temp: result_nt.temp} }

        // Read pattern — determine pattern kind
        mut pattern := _lcur(ll).text
        mut pattern_kind := _lk(ll)  // "IDENT", "INT", "STRING", "FLOAT", "true", "false"
        mut is_wildcard := pattern == "_"
        mut is_variant := false
        mut is_literal := false
        mut is_binding := false
        mut is_tuple_pattern := false
        mut is_array_pattern := false
        mut at_bind_name := ""
        if pattern_kind == "INT" || pattern_kind == "STRING" || pattern_kind == "FLOAT" || pattern_kind == "true" || pattern_kind == "false" {
            is_literal = true
        }
        // Tuple pattern: starts with ( without preceding IDENT
        if pattern_kind == "(" {
            is_tuple_pattern = true
        }
        // Array pattern: starts with [
        if pattern_kind == "[" {
            is_array_pattern = true
        }
        if pattern_kind == "IDENT" && is_wildcard == false {
            vtag_check := _variant_tag(ll.registry, pattern)
            if vtag_check > 0 {
                is_variant = true
            } else if pattern == "Ok" || pattern == "Err" || pattern == "Some" || pattern == "None" {
                // Built-in Result/Option variants — treat as variants so the
                // arm dispatch compares tags instead of binding the whole
                // subject to the pattern name.
                is_variant = true
            } else {
                // Check for named pattern: name @ Pattern
                at_pos := ll.pos + 1
                if at_pos < ll.tokens.len() && ll.tokens[at_pos].name == "@" {
                    // Named pattern: save bind name, advance past name and @, re-read pattern
                    at_bind_name = pattern
                    ll = _ladv(ll)  // skip name
                    ll = _ladv(ll)  // skip @
                    // Re-read the actual sub-pattern
                    pattern = _lcur(ll).text
                    pattern_kind = _lk(ll)
                    is_wildcard = pattern == "_"
                    if pattern_kind == "INT" || pattern_kind == "STRING" || pattern_kind == "FLOAT" || pattern_kind == "true" || pattern_kind == "false" {
                        is_literal = true
                    } else if pattern_kind == "IDENT" && is_wildcard == false {
                        vtag2 := _variant_tag(ll.registry, pattern)
                        if vtag2 > 0 {
                            is_variant = true
                        } else if pattern == "Ok" || pattern == "Err" || pattern == "Some" || pattern == "None" {
                            is_variant = true
                        } else {
                            is_binding = true
                        }
                    }
                } else {
                    // Identifier that's not a variant name = binding pattern
                    is_binding = true
                }
            }
        }

        if is_wildcard {
            ll = _ladv(ll)  // skip _
        } else if is_tuple_pattern == false && is_array_pattern == false {
            ll = _ladv(ll)  // skip pattern token
        }

        // Check for or-pattern: Red | Blue => ... (multiple patterns for same arm)
        // Collect additional or-pattern variant names
        mut or_count := 0
        mut or_name_0 := ""
        mut or_name_1 := ""
        mut or_name_2 := ""
        mut or_name_3 := ""
        if is_variant && _lk(ll) == "|" {
            while _lk(ll) == "|" {
                ll = _ladv(ll)  // skip |
                ll = _lskip_nl(ll)
                if _lk(ll) == "IDENT" {
                    oname := _lcur(ll).text
                    if or_count == 0 { or_name_0 = oname }
                    if or_count == 1 { or_name_1 = oname }
                    if or_count == 2 { or_name_2 = oname }
                    if or_count == 3 { or_name_3 = oname }
                    or_count = or_count + 1
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
            }
        }

        // Collect destructuring binding names into parallel token-saved arrays
        mut has_bindings := false
        mut bind_name_0 := ""
        mut bind_name_1 := ""
        mut bind_name_2 := ""
        mut bind_name_3 := ""
        mut bind_total := 0
        // Struct variant destructuring: Variant{field: v, ...}
        mut is_struct_destr := false
        mut struct_field_name_0 := ""
        mut struct_field_name_1 := ""
        mut struct_field_name_2 := ""
        mut struct_field_name_3 := ""
        // Tuple pattern sub-elements: literal values for comparison
        mut tuple_bind_is_lit_0 := false
        mut tuple_bind_is_lit_1 := false
        mut tuple_bind_is_lit_2 := false
        mut tuple_bind_is_lit_3 := false
        mut tuple_bind_lit_val_0 := 0
        mut tuple_bind_lit_val_1 := 0
        mut tuple_bind_lit_val_2 := 0
        mut tuple_bind_lit_val_3 := 0
        // Nested pattern flags: bind_name is a variant that needs further matching
        mut nested_variant_0 := ""
        mut nested_variant_1 := ""
        mut nested_variant_2 := ""
        mut nested_variant_3 := ""
        mut nested_bind_0 := ""
        mut nested_bind_1 := ""
        mut nested_bind_2 := ""
        mut nested_bind_3 := ""
        // Array pattern variables
        mut arr_pat_fixed_count := 0
        mut arr_pat_rest_name := ""
        mut arr_pat_has_rest := false

        if is_array_pattern {
            // Array pattern: [first, second, ..rest] or [a, b]
            ll = _ladv(ll)  // skip [
            ll = _lskip_nl(ll)
            while _lk(ll) != "]" && _lk(ll) != "EOF" {
                if _lk(ll) == "." {
                    // Check for ..rest
                    dot_pos := ll.pos + 1
                    if dot_pos < ll.tokens.len() && ll.tokens[dot_pos].name == "." {
                        ll = _ladv(ll)  // skip first .
                        ll = _ladv(ll)  // skip second .
                        arr_pat_has_rest = true
                        if _lk(ll) == "IDENT" {
                            arr_pat_rest_name = _lcur(ll).text
                            ll = _ladv(ll)
                        }
                    } else {
                        ll = _ladv(ll)
                    }
                } else if _lk(ll) == "IDENT" || _lk(ll) == "INT" {
                    btext := _lcur(ll).text
                    if bind_total == 0 { bind_name_0 = btext }
                    if bind_total == 1 { bind_name_1 = btext }
                    if bind_total == 2 { bind_name_2 = btext }
                    if bind_total == 3 { bind_name_3 = btext }
                    bind_total = bind_total + 1
                    has_bindings = true
                    ll = _ladv(ll)
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == "]" { ll = _ladv(ll) }
            arr_pat_fixed_count = bind_total
        } else if is_tuple_pattern {
            // Tuple pattern: (a, b) or (0, y) etc.
            ll = _ladv(ll)  // skip (
            ll = _lskip_nl(ll)
            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                tk := _lk(ll)
                if tk == "INT" {
                    // Literal sub-element
                    lit_v := _parse_int_literal(_lcur(ll).text)
                    if bind_total == 0 { tuple_bind_is_lit_0 = true }
                    if bind_total == 0 { tuple_bind_lit_val_0 = lit_v }
                    if bind_total == 0 { bind_name_0 = "_lit_" }
                    if bind_total == 1 { tuple_bind_is_lit_1 = true }
                    if bind_total == 1 { tuple_bind_lit_val_1 = lit_v }
                    if bind_total == 1 { bind_name_1 = "_lit_" }
                    if bind_total == 2 { tuple_bind_is_lit_2 = true }
                    if bind_total == 2 { tuple_bind_lit_val_2 = lit_v }
                    if bind_total == 2 { bind_name_2 = "_lit_" }
                    if bind_total == 3 { tuple_bind_is_lit_3 = true }
                    if bind_total == 3 { tuple_bind_lit_val_3 = lit_v }
                    if bind_total == 3 { bind_name_3 = "_lit_" }
                    bind_total = bind_total + 1
                    has_bindings = true
                    ll = _ladv(ll)
                } else if tk == "IDENT" {
                    btext := _lcur(ll).text
                    if btext == "_" {
                        if bind_total == 0 { bind_name_0 = "_" }
                        if bind_total == 1 { bind_name_1 = "_" }
                        if bind_total == 2 { bind_name_2 = "_" }
                        if bind_total == 3 { bind_name_3 = "_" }
                    } else {
                        if bind_total == 0 { bind_name_0 = btext }
                        if bind_total == 1 { bind_name_1 = btext }
                        if bind_total == 2 { bind_name_2 = btext }
                        if bind_total == 3 { bind_name_3 = btext }
                    }
                    bind_total = bind_total + 1
                    has_bindings = true
                    ll = _ladv(ll)
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == ")" { ll = _ladv(ll) }
        } else if _lk(ll) == "(" {
            ll = _ladv(ll)  // skip (
            ll = _lskip_nl(ll)
            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                if _lk(ll) == "IDENT" {
                    btext := _lcur(ll).text
                    // Check for nested variant pattern: e.g., Some(Circle(r))
                    nv_tag := _variant_tag(ll.registry, btext)
                    if nv_tag > 0 {
                        // Nested variant — save variant name
                        if bind_total == 0 { nested_variant_0 = btext }
                        if bind_total == 0 { bind_name_0 = btext }
                        if bind_total == 1 { nested_variant_1 = btext }
                        if bind_total == 1 { bind_name_1 = btext }
                        if bind_total == 2 { nested_variant_2 = btext }
                        if bind_total == 2 { bind_name_2 = btext }
                        if bind_total == 3 { nested_variant_3 = btext }
                        if bind_total == 3 { bind_name_3 = btext }
                        ll = _ladv(ll)
                        // Check for nested destructuring (...)
                        if _lk(ll) == "(" {
                            ll = _ladv(ll)  // skip (
                            ll = _lskip_nl(ll)
                            if _lk(ll) == "IDENT" {
                                nb := _lcur(ll).text
                                if bind_total == 0 { nested_bind_0 = nb }
                                if bind_total == 1 { nested_bind_1 = nb }
                                if bind_total == 2 { nested_bind_2 = nb }
                                if bind_total == 3 { nested_bind_3 = nb }
                                ll = _ladv(ll)
                            }
                            // Skip remaining nested args
                            while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
                            if _lk(ll) == ")" { ll = _ladv(ll) }
                        }
                        bind_total = bind_total + 1
                        has_bindings = true
                    } else {
                        if bind_total == 0 { bind_name_0 = btext }
                        if bind_total == 1 { bind_name_1 = btext }
                        if bind_total == 2 { bind_name_2 = btext }
                        if bind_total == 3 { bind_name_3 = btext }
                        bind_total = bind_total + 1
                        has_bindings = true
                        ll = _ladv(ll)
                    }
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == ")" { ll = _ladv(ll) }
        } else if _lk(ll) == "\{" && is_variant {
            // Struct variant destructuring: Variant{field: v, ...}
            is_struct_destr = true
            ll = _ladv(ll)  // skip {
            ll = _lskip_nl(ll)
            while _lk(ll) != "\}" && _lk(ll) != "EOF" {
                if _lk(ll) == "IDENT" {
                    fname := _lcur(ll).text
                    ll = _ladv(ll)
                    mut bname := fname  // shorthand: {name} means {name: name}
                    if _lk(ll) == ":" {
                        ll = _ladv(ll)  // skip :
                        ll = _lskip_nl(ll)
                        if _lk(ll) == "IDENT" {
                            bname = _lcur(ll).text
                            ll = _ladv(ll)
                        }
                    }
                    if bind_total == 0 { bind_name_0 = bname }
                    if bind_total == 0 { struct_field_name_0 = fname }
                    if bind_total == 1 { bind_name_1 = bname }
                    if bind_total == 1 { struct_field_name_1 = fname }
                    if bind_total == 2 { bind_name_2 = bname }
                    if bind_total == 2 { struct_field_name_2 = fname }
                    if bind_total == 3 { bind_name_3 = bname }
                    if bind_total == 3 { struct_field_name_3 = fname }
                    bind_total = bind_total + 1
                    has_bindings = true
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == "\}" { ll = _ladv(ll) }
        }

        // Check for guard clause: `if <expr>` before `=>`
        mut has_guard := false
        mut guard_start := 0
        mut guard_end := 0
        if _lk(ll) == "if" {
            has_guard = true
            ll = _ladv(ll)  // skip `if`
            guard_start = ll.pos
            // Skip until => to find guard end
            while _lk(ll) != "=>" && _lk(ll) != "EOF" {
                ll = _ladv(ll)
            }
            guard_end = ll.pos
        }

        // Skip =>
        if _lk(ll) == "=>" { ll = _ladv(ll) }
        ll = _lskip_nl(ll)

        if is_array_pattern {
            // Array pattern: [first, ..rest] or [a, b]
            next_lbl := _lnew_label(ll)
            ll = next_lbl.l
            // Check array length
            alen_nt := _lnew_temp(ll)
            ll = alen_nt.l
            ll = _lemit(ll, new_inst(OpArrayLen, alen_nt.temp, subj.temp, 0, "", 0))
            expected_len := _lnew_temp(ll)
            ll = expected_len.l
            ll = _lemit(ll, new_inst(OpConst, expected_len.temp, arr_pat_fixed_count, 0, "", 0))
            len_cmp := _lnew_temp(ll)
            ll = len_cmp.l
            if arr_pat_has_rest {
                // Minimum length: len >= fixed_count
                ll = _lemit(ll, new_inst(OpGte, len_cmp.temp, alen_nt.temp, expected_len.temp, "", 0))
            } else {
                // Exact length: len == fixed_count
                ll = _lemit(ll, new_inst(OpEq, len_cmp.temp, alen_nt.temp, expected_len.temp, "", 0))
            }
            ll = _lemit(ll, new_inst(OpBranchFalse, 0, len_cmp.temp, next_lbl.temp, "", 0))
            // Extract fixed elements
            mut ai := 0
            while ai < arr_pat_fixed_count {
                mut abname := ""
                if ai == 0 { abname = bind_name_0 }
                if ai == 1 { abname = bind_name_1 }
                if ai == 2 { abname = bind_name_2 }
                if ai == 3 { abname = bind_name_3 }
                aidx_nt := _lnew_temp(ll)
                ll = aidx_nt.l
                ll = _lemit(ll, new_inst(OpConst, aidx_nt.temp, ai, 0, "", 0))
                aelem_nt := _lnew_temp(ll)
                ll = aelem_nt.l
                ll = _lemit(ll, new_inst(OpArrayGet, aelem_nt.temp, subj.temp, aidx_nt.temp, "", 0))
                if abname != "_" {
                    ll = _lenv_add(ll, abname, aelem_nt.temp)
                }
                ai = ai + 1
            }
            // Rest binding: ..rest
            if arr_pat_has_rest && arr_pat_rest_name != "" {
                rest_start := _lnew_temp(ll)
                ll = rest_start.l
                ll = _lemit(ll, new_inst(OpConst, rest_start.temp, arr_pat_fixed_count, 0, "", 0))
                rest_nt := _lnew_temp(ll)
                ll = rest_nt.l
                ll = _lemit(ll, new_inst(OpArraySlice, rest_nt.temp, subj.temp, rest_start.temp, "", 0))
                ll = _lenv_add(ll, arr_pat_rest_name, rest_nt.temp)
            }
            // Guard
            if has_guard {
                saved_pos := ll.pos
                ll = _lset_pos(ll, guard_start)
                guard_result := _lower_expr(ll)
                ll = guard_result.l
                ll = _lset_pos(ll, saved_pos)
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, guard_result.temp, next_lbl.temp, "", 0))
            }
            // Arm body
            if _lk(ll) == lb {
                ll = _lower_block(ll)
                ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
            } else {
                arm_result := _lower_expr(ll)
                ll = arm_result.l
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                result_len := result_nt.temp + 1
                arm_len := arm_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
            }
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
        } else if is_tuple_pattern {
            // Tuple pattern: extract fields positionally and compare literals
            next_lbl := _lnew_label(ll)
            ll = next_lbl.l
            mut ti := 0
            while ti < bind_total {
                mut tbname := ""
                if ti == 0 { tbname = bind_name_0 }
                if ti == 1 { tbname = bind_name_1 }
                if ti == 2 { tbname = bind_name_2 }
                if ti == 3 { tbname = bind_name_3 }
                // Extract field at position ti
                fnt := _lnew_temp(ll)
                ll = fnt.l
                ll = _lemit(ll, new_inst(OpFieldGet, fnt.temp, subj.temp, ti, "", 0))
                mut is_lit_elem := false
                mut lit_elem_val := 0
                if ti == 0 { is_lit_elem = tuple_bind_is_lit_0 }
                if ti == 0 { lit_elem_val = tuple_bind_lit_val_0 }
                if ti == 1 { is_lit_elem = tuple_bind_is_lit_1 }
                if ti == 1 { lit_elem_val = tuple_bind_lit_val_1 }
                if ti == 2 { is_lit_elem = tuple_bind_is_lit_2 }
                if ti == 2 { lit_elem_val = tuple_bind_lit_val_2 }
                if ti == 3 { is_lit_elem = tuple_bind_is_lit_3 }
                if ti == 3 { lit_elem_val = tuple_bind_lit_val_3 }
                if is_lit_elem {
                    // Compare extracted field against literal
                    clit := _lnew_temp(ll)
                    ll = clit.l
                    ll = _lemit(ll, new_inst(OpConst, clit.temp, lit_elem_val, 0, "", 0))
                    tcmp := _lnew_temp(ll)
                    ll = tcmp.l
                    ll = _lemit(ll, new_inst(OpEq, tcmp.temp, fnt.temp, clit.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, tcmp.temp, next_lbl.temp, "", 0))
                } else if tbname != "_" {
                    // Binding sub-element
                    ll = _lenv_add(ll, tbname, fnt.temp)
                }
                ti = ti + 1
            }
            // Named pattern binding for tuple patterns
            if at_bind_name != "" { ll = _lenv_add(ll, at_bind_name, subj.temp) }
            // Guard
            if has_guard {
                saved_pos := ll.pos
                ll = _lset_pos(ll, guard_start)
                guard_result := _lower_expr(ll)
                ll = guard_result.l
                ll = _lset_pos(ll, saved_pos)
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, guard_result.temp, next_lbl.temp, "", 0))
            }
            // Arm body
            if _lk(ll) == lb {
                ll = _lower_block(ll)
                ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
            } else {
                arm_result := _lower_expr(ll)
                ll = arm_result.l
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                result_len := result_nt.temp + 1
                arm_len := arm_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
            }
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
        } else if is_wildcard || is_binding {
            // Wildcard or binding: no comparison needed
            // For binding patterns, bind subject to the pattern name
            if is_binding {
                ll = _lenv_add(ll, pattern, subj.temp)
            }
            // Named pattern: also bind the whole subject to at_bind_name
            if at_bind_name != "" { ll = _lenv_add(ll, at_bind_name, subj.temp) }

            // Evaluate guard clause if present
            if has_guard {
                next_lbl := _lnew_label(ll)
                ll = next_lbl.l
                saved_pos := ll.pos
                ll = _lset_pos(ll, guard_start)
                guard_result := _lower_expr(ll)
                ll = guard_result.l
                ll = _lset_pos(ll, saved_pos)
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, guard_result.temp, next_lbl.temp, "", 0))

                // Lower arm body
                if _lk(ll) == lb {
                    ll = _lower_block(ll)
                    ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
                } else {
                    arm_result := _lower_expr(ll)
                    ll = arm_result.l
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                    result_len := result_nt.temp + 1
                    arm_len := arm_result.temp + 1
                    ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
            } else {
                if _lk(ll) == lb {
                    ll = _lower_block(ll)
                    ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
                } else {
                    arm_result := _lower_expr(ll)
                    ll = arm_result.l
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                    result_len := result_nt.temp + 1
                    arm_len := arm_result.temp + 1
                    ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
                }
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            }
        } else if is_literal {
            // Literal pattern: compare subject against literal value
            next_lbl := _lnew_label(ll)
            ll = next_lbl.l

            // Use independent if blocks to avoid bootstrap else-if chain bug
            mut lit_done := false
            if pattern_kind == "FLOAT" {
                // Float literal comparison — store as string constant, load with OpConstStr marker
                mut fll := ll
                mut fstr_idx := mod_find_string(fll.module, pattern)
                if fstr_idx == 0 {
                    fnew_mod := mod_add_string(fll.module, pattern)
                    fstr_idx = fnew_mod.string_constants.len() - 1
                    fll = Lowerer{tokens: fll.tokens, pos: fll.pos, store: fll.store, registry: fll.registry, treg: fll.treg, pool: fll.pool,
                                 table: fll.table, file: fll.file, module: fnew_mod,
                                 current_func: fll.current_func,
                                 temp_counter: fll.temp_counter, label_counter: fll.label_counter,
                                 env_names: fll.env_names, env_slots: fll.env_slots,
                                 loop_start: fll.loop_start, loop_end: fll.loop_end,
                                 const_names: fll.const_names, const_vals: fll.const_vals,
                                 const_str_names: fll.const_str_names, const_str_vals: fll.const_str_vals,
                                 temp_types: fll.temp_types, is_result: fll.is_result,
                                 fn_error_type: fll.fn_error_type, defer_starts: fll.defer_starts, defer_ends: fll.defer_ends}
                }
                ll = fll
                flit_nt := _lnew_temp(ll)
                ll = flit_nt.l
                ll = _lemit(ll, new_inst(OpConstStr, flit_nt.temp, fstr_idx, 0 - 9, "", 0))
                ll = _lset_type(ll, flit_nt.temp, 9)
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, flit_nt.temp, "f64", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                lit_done = true
            }
            if pattern_kind == "INT" && lit_done == false {
                // Integer literal comparison
                lit_nt := _lnew_temp(ll)
                ll = lit_nt.l
                lit_val := _parse_int_literal(pattern)
                ll = _lemit(ll, new_inst(OpConst, lit_nt.temp, lit_val, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, lit_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                lit_done = true
            }
            if pattern_kind == "true" && lit_done == false {
                // true literal: subject == 1
                lit_nt := _lnew_temp(ll)
                ll = lit_nt.l
                ll = _lemit(ll, new_inst(OpConst, lit_nt.temp, 1, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, lit_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                lit_done = true
            }
            if pattern_kind == "false" && lit_done == false {
                // false literal: subject == 0
                lit_nt := _lnew_temp(ll)
                ll = lit_nt.l
                ll = _lemit(ll, new_inst(OpConst, lit_nt.temp, 0, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj.temp, lit_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                lit_done = true
            }
            if pattern_kind == "STRING" && lit_done == false {
                // String literal comparison
                lit_result := _lower_string_const(ll, pattern)
                ll = lit_result.l
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpStrEq, cmp_nt.temp, subj.temp, lit_result.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
                lit_done = true
            }
            // FLOAT case handled above as first check

            // Named pattern binding for literal patterns
            if at_bind_name != "" { ll = _lenv_add(ll, at_bind_name, subj.temp) }

            // Evaluate guard clause if present
            if has_guard {
                saved_pos := ll.pos
                ll = _lset_pos(ll, guard_start)
                guard_result := _lower_expr(ll)
                ll = guard_result.l
                ll = _lset_pos(ll, saved_pos)
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, guard_result.temp, next_lbl.temp, "", 0))
            }

            // Lower arm body
            if _lk(ll) == lb {
                ll = _lower_block(ll)
                ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
            } else {
                arm_result := _lower_expr(ll)
                ll = arm_result.l
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                result_len := result_nt.temp + 1
                arm_len := arm_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
            }
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
        } else {
            // Variant pattern: compare subject tag with variant tag.
            // Built-in Result/Option patterns aren't in the variant registry;
            // hard-code their tags (Ok=0, Err=1, Some=1, None=0).
            mut tag := _variant_tag(ll.registry, pattern)
            if tag == 0 && _variant_parent(ll.registry, pattern).name == "" {
                if pattern == "Ok" { tag = 0 }
                if pattern == "Err" { tag = 1 }
                if pattern == "Some" { tag = 1 }
                if pattern == "None" { tag = 0 }
            }
            next_lbl := _lnew_label(ll)
            ll = next_lbl.l

            if or_count > 0 {
                // Or-pattern: check primary tag OR any or-pattern tag
                body_lbl := _lnew_label(ll)
                ll = body_lbl.l

                // Check primary pattern
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, tag, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj_tag_temp, tag_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchTrue, 0, cmp_nt.temp, body_lbl.temp, "", 0))

                // Check or-patterns
                mut oi := 0
                while oi < or_count {
                    mut oname := ""
                    if oi == 0 { oname = or_name_0 }
                    if oi == 1 { oname = or_name_1 }
                    if oi == 2 { oname = or_name_2 }
                    if oi == 3 { oname = or_name_3 }
                    otag := _variant_tag(ll.registry, oname)
                    otag_nt := _lnew_temp(ll)
                    ll = otag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, otag_nt.temp, otag, 0, "", 0))
                    ocmp_nt := _lnew_temp(ll)
                    ll = ocmp_nt.l
                    ll = _lemit(ll, new_inst(OpEq, ocmp_nt.temp, subj_tag_temp, otag_nt.temp, "", 0))
                    if oi == or_count - 1 {
                        // Last or-pattern: branch false to next arm
                        ll = _lemit(ll, new_inst(OpBranchFalse, 0, ocmp_nt.temp, next_lbl.temp, "", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpBranchTrue, 0, ocmp_nt.temp, body_lbl.temp, "", 0))
                    }
                    oi = oi + 1
                }

                // Body label
                ll = _lemit(ll, new_inst(OpLabel, 0, body_lbl.temp, 0, "", 0))
            } else {
                // Simple single-variant check
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, tag, 0, "", 0))

                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, subj_tag_temp, tag_nt.temp, "", 0))

                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, next_lbl.temp, "", 0))
            }

            // Bindings first, then guard, so guard can use bound vars

            // Named pattern: bind whole subject to at_bind_name
            if at_bind_name != "" { ll = _lenv_add(ll, at_bind_name, subj.temp) }

            // Bind destructured fields: extract from struct and add to env
            if has_bindings && is_struct_destr {
                // Struct variant destructuring: use field names to find slot indices
                parent := _variant_parent(ll.registry, pattern)
                mut bi := 0
                while bi < bind_total {
                    mut bname := ""
                    mut sfname := ""
                    if bi == 0 { bname = bind_name_0 }
                    if bi == 0 { sfname = struct_field_name_0 }
                    if bi == 1 { bname = bind_name_1 }
                    if bi == 1 { sfname = struct_field_name_1 }
                    if bi == 2 { bname = bind_name_2 }
                    if bi == 2 { sfname = struct_field_name_2 }
                    if bi == 3 { bname = bind_name_3 }
                    if bi == 3 { sfname = struct_field_name_3 }
                    // Find slot index for this field name within the variant's data fields
                    // Variant data fields start at slot 1 (slot 0 is _tag)
                    // Use variant_field_index to find the positional index of this field
                    mut field_pos := 0
                    mut found_field := false
                    if parent.name != "" {
                        // Scan variant field names to find position
                        mut fi := 0
                        mut scan_done := false
                        while fi < 8 && scan_done == false {
                            vft_name := variant_field_name(parent, tag, fi)
                            if vft_name == "" { scan_done = true }
                            if vft_name == sfname { field_pos = fi }
                            if vft_name == sfname { found_field = true }
                            if vft_name == sfname { scan_done = true }
                            fi = fi + 1
                        }
                    }
                    // Compute data slot from field_pos
                    mut data_slot := 1
                    mut si := 0
                    while si < field_pos {
                        ft := variant_field_type(parent, tag, si)
                        if ft == 12 {
                            data_slot = data_slot + 2
                        } else {
                            data_slot = data_slot + 1
                        }
                        si = si + 1
                    }
                    ft := variant_field_type(parent, tag, field_pos)
                    if ft == 12 {
                        bnt := _lnew_str_temp(ll)
                        ll = bnt.l
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp, subj.temp, data_slot, "", 0))
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp + 1, subj.temp, data_slot + 1, "", 0))
                        ll = _lset_type(ll, bnt.temp, 12)
                        ll = _lenv_add(ll, bname, bnt.temp)
                    } else {
                        bnt := _lnew_temp(ll)
                        ll = bnt.l
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp, subj.temp, data_slot, "", 0))
                        if ft != 0 { ll = _lset_type(ll, bnt.temp, ft) }
                        ll = _lenv_add(ll, bname, bnt.temp)
                    }
                    bi = bi + 1
                }
            } else if has_bindings {
                // Positional tuple destructuring (with nested pattern support)
                parent := _variant_parent(ll.registry, pattern)
                // For universal Ok/Err/Some patterns without registered parent,
                // infer payload type from the subject's Result/Optional type.
                mut inferred_ft := 0
                if parent.name == "" && (pattern == "Ok" || pattern == "Err" || pattern == "Some") {
                    subj_tid := _lget_type(ll, subj.temp)
                    if subj_tid > 0 {
                        si_info := store_get(ll.store, subj_tid)
                        sk := type_kind_name(si_info.kind)
                        if sk == "Result" {
                            if pattern == "Ok" { inferred_ft = si_info.type_id }
                            if pattern == "Err" { inferred_ft = si_info.type_id2 }
                        } else if sk == "Optional" && pattern == "Some" {
                            inferred_ft = si_info.type_id
                        }
                    }
                }
                mut bi := 0
                while bi < bind_total {
                    mut bname := ""
                    if bi == 0 { bname = bind_name_0 }
                    if bi == 1 { bname = bind_name_1 }
                    if bi == 2 { bname = bind_name_2 }
                    if bi == 3 { bname = bind_name_3 }
                    mut data_slot := 1
                    mut si := 0
                    while si < bi {
                        ft := variant_field_type(parent, tag, si)
                        if ft == 12 {
                            data_slot = data_slot + 2
                        } else {
                            data_slot = data_slot + 1
                        }
                        si = si + 1
                    }
                    mut ft := variant_field_type(parent, tag, bi)
                    if ft == 0 && bi == 0 && inferred_ft != 0 { ft = inferred_ft }

                    // Check if this is a nested variant pattern
                    mut nv := ""
                    mut nb := ""
                    if bi == 0 { nv = nested_variant_0 }
                    if bi == 0 { nb = nested_bind_0 }
                    if bi == 1 { nv = nested_variant_1 }
                    if bi == 1 { nb = nested_bind_1 }
                    if bi == 2 { nv = nested_variant_2 }
                    if bi == 2 { nb = nested_bind_2 }
                    if bi == 3 { nv = nested_variant_3 }
                    if bi == 3 { nb = nested_bind_3 }

                    if nv != "" {
                        // Nested variant pattern: extract inner value, check its tag, extract inner fields
                        inner_nt := _lnew_temp(ll)
                        ll = inner_nt.l
                        ll = _lemit(ll, new_inst(OpFieldGet, inner_nt.temp, subj.temp, data_slot, "", 0))
                        // Check inner tag
                        inner_tag := _variant_tag(ll.registry, nv)
                        inner_tag_nt := _lnew_temp(ll)
                        ll = inner_tag_nt.l
                        // Extract tag from inner struct (slot 0)
                        inner_tag_val := _lnew_temp(ll)
                        ll = inner_tag_val.l
                        ll = _lemit(ll, new_inst(OpFieldGet, inner_tag_val.temp, inner_nt.temp, 0, "_tag", 0))
                        itag_const := _lnew_temp(ll)
                        ll = itag_const.l
                        ll = _lemit(ll, new_inst(OpConst, itag_const.temp, inner_tag, 0, "", 0))
                        icmp := _lnew_temp(ll)
                        ll = icmp.l
                        ll = _lemit(ll, new_inst(OpEq, icmp.temp, inner_tag_val.temp, itag_const.temp, "", 0))
                        ll = _lemit(ll, new_inst(OpBranchFalse, 0, icmp.temp, next_lbl.temp, "", 0))
                        // If nested bind exists, extract inner data field (slot 1) and bind
                        if nb != "" {
                            inner_parent := _variant_parent(ll.registry, nv)
                            inner_ft := variant_field_type(inner_parent, inner_tag, 0)
                            if inner_ft == 12 {
                                ibnt := _lnew_str_temp(ll)
                                ll = ibnt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, inner_nt.temp, 1, "", 0))
                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp + 1, inner_nt.temp, 2, "", 0))
                                ll = _lset_type(ll, ibnt.temp, 12)
                                ll = _lenv_add(ll, nb, ibnt.temp)
                            } else {
                                ibnt := _lnew_temp(ll)
                                ll = ibnt.l
                                ll = _lemit(ll, new_inst(OpFieldGet, ibnt.temp, inner_nt.temp, 1, "", 0))
                                if inner_ft != 0 { ll = _lset_type(ll, ibnt.temp, inner_ft) }
                                ll = _lenv_add(ll, nb, ibnt.temp)
                            }
                        }
                    } else if ft == 12 {
                        bnt := _lnew_str_temp(ll)
                        ll = bnt.l
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp, subj.temp, data_slot, "", 0))
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp + 1, subj.temp, data_slot + 1, "", 0))
                        ll = _lset_type(ll, bnt.temp, 12)
                        ll = _lenv_add(ll, bname, bnt.temp)
                    } else {
                        bnt := _lnew_temp(ll)
                        ll = bnt.l
                        ll = _lemit(ll, new_inst(OpFieldGet, bnt.temp, subj.temp, data_slot, "", 0))
                        if ft != 0 { ll = _lset_type(ll, bnt.temp, ft) }
                        ll = _lenv_add(ll, bname, bnt.temp)
                    }
                    bi = bi + 1
                }
            }

            // Evaluate guard clause if present
            if has_guard {
                saved_pos := ll.pos
                ll = _lset_pos(ll, guard_start)
                guard_result := _lower_expr(ll)
                ll = guard_result.l
                ll = _lset_pos(ll, saved_pos)
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, guard_result.temp, next_lbl.temp, "", 0))
            }

            // Lower arm body
            mut arm_ends_in_return := false
            if _lk(ll) == lb {
                ll = _lower_block(ll)
                ll = _lemit(ll, new_inst(OpConst, result_nt.temp, 0, 0, "", 0))
            } else if _lk(ll) == "return" {
                // `return <expr>` arm body — emit OpRet (wrapped in Ok Result
                // when the enclosing fn is fallible), skip the trailing
                // OpJump to end_lbl so the block doesn't have two terminators
                // and the next arm's label is reachable.
                ll = _ladv(ll)  // skip return
                rexpr := _lower_expr(ll)
                ll = rexpr.l
                ll = _emit_defers(ll)
                if ll.fn_error_type != 0 && _lget_type(ll, rexpr.temp) != 200 && !_lis_result(ll, rexpr.temp) {
                    r_rt := _lget_type(ll, rexpr.temp)
                    mut ok_slots := 2
                    if r_rt == 12 { ok_slots = 3 }
                    ok_nt := _lnew_temp(ll)
                    ll = ok_nt.l
                    ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
                    tag_nt := _lnew_temp(ll)
                    ll = tag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
                    if r_rt == 12 {
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, rexpr.temp, 1, "_val", 0))
                        r_len := rexpr.temp + 1
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, r_len, 2, "_val_len", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, rexpr.temp, 1, "_val", 0))
                    }
                    ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
                } else {
                    r_rt := _lget_type(ll, rexpr.temp)
                    ll = _lemit(ll, new_inst(OpRet, 0, rexpr.temp, 0, "", r_rt))
                }
                arm_ends_in_return = true
            } else {
                arm_result := _lower_expr(ll)
                ll = arm_result.l
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, arm_result.temp, 0, "", 0))
                result_len := result_nt.temp + 1
                arm_len := arm_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, result_len, arm_len, 0, "", 0))
            }

            if arm_ends_in_return == false {
                ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            }
            ll = _lemit(ll, new_inst(OpLabel, 0, next_lbl.temp, 0, "", 0))
        }

        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }

    // End label
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))

    LT{l: ll, temp: result_nt.temp}
}

fn _skip_braces_l(l: Lowerer) -> Lowerer {
    lb := "\{"
    rb := "\}"
    if _lk(l) != lb { return l }
    mut ll := _ladv(l)
    mut d := 1
    while d > 0 && _lk(ll) != "EOF" {
        if _lk(ll) == lb { d = d + 1 }
        if _lk(ll) == rb { d = d - 1 }
        if d > 0 { ll = _ladv(ll) }
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    return ll
}

// --- Lower assert ---

fn _lower_assert(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip assert
    result := _lower_expr(ll)
    ll = result.l
    // If false, print a FAIL: marker then call exit(1). Without the print, a
    // failing assert is silent — test runners can't report which test died,
    // and callers see an exit code with no indication of why.
    // When inside a test body (current_func.name matches "_test_N"), include
    // the test label so the failing test is identifiable in output.
    ok_lbl := _lnew_label(ll)
    ll = ok_lbl.l
    ll = _lemit(ll, new_inst(OpBranchTrue, 0, result.temp, ok_lbl.temp, "", 0))

    // Build "FAIL: <test label>: assertion failed" when in a test, else
    // fall back to the generic "FAIL: assertion failed".
    fn_name := ll.current_func.name
    mut test_idx := -1
    if fn_name.len() > 6 && fn_name.substring(0, 6) == "_test_" {
        suffix := fn_name.substring(6, fn_name.len())
        test_idx = _parse_int_literal(suffix)
    }
    mut fail_msg := "FAIL: assertion failed"
    if test_idx >= 0 {
        label_idx := test_idx + 1  // test_names is 1-indexed, sentinel at 0
        if label_idx < ll.module.test_names.len() {
            fail_msg = "FAIL: " + ll.module.test_names[label_idx] + ": assertion failed"
        }
    }
    mut fail_idx := mod_find_string(ll.module, fail_msg)
    if fail_idx == 0 {
        new_mod := mod_add_string(ll.module, fail_msg)
        fail_idx = new_mod.string_constants.len() - 1
        ll = _lset_mod(ll, new_mod)
    }
    fail_nt := _lnew_str_temp(ll)
    ll = fail_nt.l
    ll = _lemit(ll, new_inst(OpConstStr, fail_nt.temp, fail_idx, fail_msg.len(), "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, fail_nt.temp, 2, "_aria_println_str", 0))
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpConst, nt.temp, 1, 0, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, nt.temp, 1, "_aria_exit", 0))
    ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
    ll
}

// --- Skip type tokens ---

fn _skip_type_l(l: Lowerer) -> Lowerer {
    mut ll := l
    k := _lk(ll)
    if k == "IDENT" || k == "Self" {
        ll = _ladv(ll)
        while _lk(ll) == "." { ll = _ladv(_ladv(ll)) }
        if _lk(ll) == "[" {
            mut d := 1
            ll = _ladv(ll)
            while d > 0 && _lk(ll) != "EOF" {
                if _lk(ll) == "[" { d = d + 1 }
                if _lk(ll) == "]" { d = d - 1 }
                if d > 0 { ll = _ladv(ll) }
            }
            if _lk(ll) == "]" { ll = _ladv(ll) }
        }
        if _lk(ll) == "?" { ll = _ladv(ll) }
        if _lk(ll) == "!" {
            ll = _ladv(ll)
            ll = _skip_type_l(ll)
        }
        return ll
    }
    if k == "[" {
        ll = _ladv(ll)
        ll = _skip_type_l(ll)
        if _lk(ll) == "]" { ll = _ladv(ll) }
        return ll
    }
    if k == "fn" {
        ll = _ladv(ll)
        // Optional `once`
        if _lk(ll) == "IDENT" && _lcur(ll).text == "once" { ll = _ladv(ll) }
        if _lk(ll) == "(" {
            ll = _ladv(ll)
            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                ll = _skip_type_l(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
            }
            if _lk(ll) == ")" { ll = _ladv(ll) }
        }
        if _lk(ll) == "->" {
            ll = _ladv(ll)
            ll = _skip_type_l(ll)
        }
        return ll
    }
    ll
}

// ============================================================
// Public API
// ============================================================

// --- Derives codegen ---
// Generate method bodies for types with `derives [Eq, Clone, Debug, Hash]`

fn _lower_derives(l: Lowerer) -> Lowerer {
    mut ll := l
    // Scan all struct defs for derived trait impls
    mut si := 1
    while si < ll.registry.struct_defs.len() {
        def := ll.registry.struct_defs[si]
        // Skip the unspecialized generic base: its field types are TypeVars
        // that the derive-body emitters can't lower. Specializations like
        // `Pair_i64` are registered as concrete structs with generic_count=0
        // and are iterated separately.
        if def.name != "" && def.is_sum == false && def.fields.len() > 1 && def.generic_count == 0 {
            // Check if this type has derived Eq
            if treg_has_impl(ll.treg, def.name, "Eq") {
                // Only generate if no user-defined TypeName_eq function exists
                eq_name := def.name + "_eq"
                existing := reg_find_fn(ll.registry, eq_name)
                if existing.name == "" {
                    ll = _lower_derive_eq(ll, def)
                }
            }
            // Check if this type has derived Clone
            if treg_has_impl(ll.treg, def.name, "Clone") {
                clone_name := def.name + "_clone"
                existing := reg_find_fn(ll.registry, clone_name)
                if existing.name == "" {
                    ll = _lower_derive_clone(ll, def)
                }
            }
            // Check if this type has derived Debug
            if treg_has_impl(ll.treg, def.name, "Debug") {
                debug_name := def.name + "_debug_str"
                existing := reg_find_fn(ll.registry, debug_name)
                if existing.name == "" {
                    ll = _lower_derive_debug(ll, def)
                }
            }
            // Check if this type has derived Display
            if treg_has_impl(ll.treg, def.name, "Display") {
                display_name := def.name + "_display"
                existing := reg_find_fn(ll.registry, display_name)
                if existing.name == "" {
                    ll = _lower_derive_display(ll, def)
                }
            }
            // Check if this type has derived Default
            if treg_has_impl(ll.treg, def.name, "Default") {
                default_name := def.name + "_default"
                existing := reg_find_fn(ll.registry, default_name)
                if existing.name == "" {
                    ll = _lower_derive_default(ll, def)
                }
            }
            // Check if this type has derived Ord
            if treg_has_impl(ll.treg, def.name, "Ord") {
                cmp_name := def.name + "_cmp"
                existing := reg_find_fn(ll.registry, cmp_name)
                if existing.name == "" {
                    ll = _lower_derive_ord(ll, def)
                }
            }
            // Check if this type has derived Hash
            if treg_has_impl(ll.treg, def.name, "Hash") {
                hash_name := def.name + "_hash"
                existing := reg_find_fn(ll.registry, hash_name)
                if existing.name == "" {
                    ll = _lower_derive_hash(ll, def)
                }
            }
            // Check if this type has derived Json. A signature may already
            // be in the registry from the checker's pre-registration pass —
            // those have token_start == 0, meaning "no user-written body".
            // Only skip emission when a real user fn (token_start > 0) exists.
            if treg_has_impl(ll.treg, def.name, "Json") {
                to_name := def.name + "_to_json"
                existing := reg_find_fn(ll.registry, to_name)
                if existing.name == "" || existing.token_start == 0 {
                    ll = _lower_derive_json_to(ll, def)
                }
                from_name := def.name + "_from_json"
                existing2 := reg_find_fn(ll.registry, from_name)
                if existing2.name == "" || existing2.token_start == 0 {
                    ll = _lower_derive_json_from(ll, def)
                }
            }
        }
        si = si + 1
    }
    ll
}

fn _lower_derive_eq(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_eq(self, other) -> bool = field-by-field ==
    fname := def.name + "_eq"
    mut ll := _lset_func(l, new_ir_func(fname, 2, 0))
    // self = arg 0, other = arg 1
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    other_nt := _lnew_temp(ll)
    ll = other_nt.l
    ll = _lemit(ll, new_inst(OpArg, other_nt.temp, 1, 0, "", 0))
    // Compare each field
    result_nt := _lnew_temp(ll)
    ll = result_nt.l
    ll = _lower_struct_eq(ll, self_nt.temp, other_nt.temp, def.name, result_nt.temp)
    ll = _lemit(ll, new_inst(OpRet, 0, result_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_clone(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_clone(self) -> TypeName = copy all fields
    fname := def.name + "_clone"
    mut ll := _lset_func(l, new_ir_func(fname, 1, 0))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    // Allocate new struct and copy each field
    alloc_size := def.fields.len() - 1  // skip sentinel
    new_nt := _lnew_temp(ll)
    ll = new_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, new_nt.temp, alloc_size, 0, def.name, 0))
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if ft == 12 {
            // String: copy both ptr and len
            src_val := _lnew_temp(ll)
            ll = src_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, src_val.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, src_val.temp, slot, fld.name, 0))
            src_len := _lnew_temp(ll)
            ll = src_len.l
            ll = _lemit(ll, new_inst(OpFieldGet, src_len.temp, self_nt.temp, slot + 1, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, src_len.temp, slot + 1, "", 0))
            slot = slot + 2
        } else {
            src_val := _lnew_temp(ll)
            ll = src_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, src_val.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, src_val.temp, slot, fld.name, 0))
            slot = slot + 1
        }
        fi = fi + 1
    }
    ll = _lemit(ll, new_inst(OpRet, 0, new_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_debug(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_debug_str(self) -> str = "TypeName{field1: val, ...}"
    fname := def.name + "_debug_str"
    mut ll := _lset_func(l, new_ir_func(fname, 1, 0))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    // Build string: start with "TypeName{"
    prefix := def.name + "\{"
    prefix_res := _lower_string_const(ll, prefix)
    ll = prefix_res.l
    mut cur_str := prefix_res.temp
    // For each field, append "name: " + value
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        // Add ", " separator (skip for first field)
        if fi > 1 {
            sep_res := _lower_string_const(ll, ", ")
            ll = sep_res.l
            cat_nt := _lnew_str_temp(ll)
            ll = cat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, cur_str, sep_res.temp, "", 0))
            cur_str = cat_nt.temp
        }
        // Add "field_name: "
        flabel := fld.name + ": "
        flabel_res := _lower_string_const(ll, flabel)
        ll = flabel_res.l
        cat2 := _lnew_str_temp(ll)
        ll = cat2.l
        ll = _lemit(ll, new_inst(OpStrConcat, cat2.temp, cur_str, flabel_res.temp, "", 0))
        cur_str = cat2.temp
        // Get field value as string
        if ft == 12 {
            // String field: wrap in quotes
            fval := _lnew_str_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp + 1, self_nt.temp, slot + 1, "", 0))
            cat3 := _lnew_str_temp(ll)
            ll = cat3.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat3.temp, cur_str, fval.temp, "", 0))
            cur_str = cat3.temp
            slot = slot + 2
        } else {
            // Numeric field: convert to string
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            fstr := _lnew_str_temp(ll)
            ll = fstr.l
            ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, fval.temp, 0, "", 0))
            cat3 := _lnew_str_temp(ll)
            ll = cat3.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat3.temp, cur_str, fstr.temp, "", 0))
            cur_str = cat3.temp
            slot = slot + 1
        }
        fi = fi + 1
    }
    // Append closing "}"
    close_res := _lower_string_const(ll, "\}")
    ll = close_res.l
    final_cat := _lnew_str_temp(ll)
    ll = final_cat.l
    ll = _lemit(ll, new_inst(OpStrConcat, final_cat.temp, cur_str, close_res.temp, "", 0))
    ll = _lemit(ll, new_inst(OpRet, 0, final_cat.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_display(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_display(self) -> str = "field1_val, field2_val, ..."
    // Like Debug but without type name prefix and field names
    fname := def.name + "_display"
    mut ll := _lset_func(l, new_ir_func(fname, 1, 0))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    // Build from empty string
    empty_res := _lower_string_const(ll, "")
    ll = empty_res.l
    mut cur_str := empty_res.temp
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if fi > 1 {
            sep_res := _lower_string_const(ll, ", ")
            ll = sep_res.l
            cat_nt := _lnew_str_temp(ll)
            ll = cat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat_nt.temp, cur_str, sep_res.temp, "", 0))
            cur_str = cat_nt.temp
        }
        if ft == 12 {
            fval := _lnew_str_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp + 1, self_nt.temp, slot + 1, "", 0))
            cat3 := _lnew_str_temp(ll)
            ll = cat3.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat3.temp, cur_str, fval.temp, "", 0))
            cur_str = cat3.temp
            slot = slot + 2
        } else {
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            fstr := _lnew_str_temp(ll)
            ll = fstr.l
            ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, fval.temp, 0, "", 0))
            cat3 := _lnew_str_temp(ll)
            ll = cat3.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat3.temp, cur_str, fstr.temp, "", 0))
            cur_str = cat3.temp
            slot = slot + 1
        }
        fi = fi + 1
    }
    ll = _lemit(ll, new_inst(OpRet, 0, cur_str, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_default(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_default() -> TypeName = zero-initialized struct
    fname := def.name + "_default"
    mut ll := _lset_func(l, new_ir_func(fname, 0, 0))
    alloc_size := def.fields.len() - 1
    new_nt := _lnew_temp(ll)
    ll = new_nt.l
    ll = _lemit(ll, new_inst(OpAlloc, new_nt.temp, alloc_size, 0, def.name, 0))
    // Zero-initialize each field
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if ft == 12 {
            // String: empty string
            empty_res := _lower_string_const(ll, "")
            ll = empty_res.l
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, empty_res.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, empty_res.temp + 1, slot + 1, "", 0))
            slot = slot + 2
        } else {
            // Numeric: zero
            zero_nt := _lnew_temp(ll)
            ll = zero_nt.l
            ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, new_nt.temp, zero_nt.temp, slot, fld.name, 0))
            slot = slot + 1
        }
        fi = fi + 1
    }
    ll = _lemit(ll, new_inst(OpRet, 0, new_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_ord(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_cmp(self, other) -> i64 = field-by-field comparison (-1, 0, 1)
    fname := def.name + "_cmp"
    mut ll := _lset_func(l, new_ir_func(fname, 2, 0))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    other_nt := _lnew_temp(ll)
    ll = other_nt.l
    ll = _lemit(ll, new_inst(OpArg, other_nt.temp, 1, 0, "", 0))
    // Compare fields lexicographically: for each field, if a < b return -1, if a > b return 1, else continue
    mut fi := 1
    mut slot := 0
    end_lbl := _lnew_temp(ll)
    ll = end_lbl.l
    result_nt := _lnew_temp(ll)
    ll = result_nt.l
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if ft == 12 {
            // String comparison — use strcmp-like approach (compare lengths and content)
            // For simplicity, use string equality + length comparison
            a_str := _lnew_str_temp(ll)
            ll = a_str.l
            ll = _lemit(ll, new_inst(OpFieldGet, a_str.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, a_str.temp + 1, self_nt.temp, slot + 1, "", 0))
            b_str := _lnew_str_temp(ll)
            ll = b_str.l
            ll = _lemit(ll, new_inst(OpFieldGet, b_str.temp, other_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, b_str.temp + 1, other_nt.temp, slot + 1, "", 0))
            // If not equal, compare by length as approximation
            eq_nt := _lnew_temp(ll)
            ll = eq_nt.l
            ll = _lemit(ll, new_inst(OpStrEq, eq_nt.temp, a_str.temp, b_str.temp, "", 0))
            skip_lbl := _lnew_temp(ll)
            ll = skip_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, skip_lbl.temp, eq_nt.temp, "", 0))
            // Not equal: compare lengths
            lt_nt := _lnew_temp(ll)
            ll = lt_nt.l
            ll = _lemit(ll, new_inst(OpLt, lt_nt.temp, a_str.temp + 1, b_str.temp + 1, "", 0))
            neg_lbl := _lnew_temp(ll)
            ll = neg_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, neg_lbl.temp, lt_nt.temp, "", 0))
            // a >= b in length, return 1
            one_nt := _lnew_temp(ll)
            ll = one_nt.l
            ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, one_nt.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            // a < b in length, return -1
            ll = _lemit(ll, new_inst(OpLabel, 0, neg_lbl.temp, 0, "", 0))
            neg_one := _lnew_temp(ll)
            ll = neg_one.l
            ll = _lemit(ll, new_inst(OpConst, neg_one.temp, 0 - 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, neg_one.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
            slot = slot + 2
        } else {
            // Numeric: compare a_field vs b_field
            a_val := _lnew_temp(ll)
            ll = a_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, a_val.temp, self_nt.temp, slot, fld.name, 0))
            b_val := _lnew_temp(ll)
            ll = b_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, b_val.temp, other_nt.temp, slot, fld.name, 0))
            // if a < b, return -1
            lt_nt := _lnew_temp(ll)
            ll = lt_nt.l
            ll = _lemit(ll, new_inst(OpLt, lt_nt.temp, a_val.temp, b_val.temp, "", 0))
            neg_lbl := _lnew_temp(ll)
            ll = neg_lbl.l
            skip1_lbl := _lnew_temp(ll)
            ll = skip1_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, neg_lbl.temp, lt_nt.temp, "", 0))
            // if a > b, return 1
            gt_nt := _lnew_temp(ll)
            ll = gt_nt.l
            ll = _lemit(ll, new_inst(OpGt, gt_nt.temp, a_val.temp, b_val.temp, "", 0))
            pos_lbl := _lnew_temp(ll)
            ll = pos_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, pos_lbl.temp, gt_nt.temp, "", 0))
            // Equal — continue to next field
            ll = _lemit(ll, new_inst(OpJump, 0, skip1_lbl.temp, 0, "", 0))
            // a < b path
            ll = _lemit(ll, new_inst(OpLabel, 0, neg_lbl.temp, 0, "", 0))
            neg_one := _lnew_temp(ll)
            ll = neg_one.l
            ll = _lemit(ll, new_inst(OpConst, neg_one.temp, 0 - 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, neg_one.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            // a > b path
            ll = _lemit(ll, new_inst(OpLabel, 0, pos_lbl.temp, 0, "", 0))
            one_nt := _lnew_temp(ll)
            ll = one_nt.l
            ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, one_nt.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            // Continue
            ll = _lemit(ll, new_inst(OpLabel, 0, skip1_lbl.temp, 0, "", 0))
            slot = slot + 1
        }
        fi = fi + 1
    }
    // All fields equal — return 0
    zero_nt := _lnew_temp(ll)
    ll = zero_nt.l
    ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, result_nt.temp, zero_nt.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpRet, 0, result_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

fn _lower_derive_hash(l: Lowerer, def: StructDef) -> Lowerer {
    // Generate: fn TypeName_hash(self) -> i64 = XOR of field hashes
    fname := def.name + "_hash"
    mut ll := _lset_func(l, new_ir_func(fname, 1, 0))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))
    // Start with hash = 0
    hash_nt := _lnew_temp(ll)
    ll = hash_nt.l
    ll = _lemit(ll, new_inst(OpConst, hash_nt.temp, 0, 0, "", 0))
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if ft == 12 {
            // String: use length as hash (simple)
            flen := _lnew_temp(ll)
            ll = flen.l
            ll = _lemit(ll, new_inst(OpFieldGet, flen.temp, self_nt.temp, slot + 1, "", 0))
            // hash = hash * 31 + len
            mul_nt := _lnew_temp(ll)
            ll = mul_nt.l
            c31 := _lnew_temp(ll)
            ll = c31.l
            ll = _lemit(ll, new_inst(OpConst, c31.temp, 31, 0, "", 0))
            ll = _lemit(ll, new_inst(OpMul, mul_nt.temp, hash_nt.temp, c31.temp, "", 0))
            new_hash := _lnew_temp(ll)
            ll = new_hash.l
            ll = _lemit(ll, new_inst(OpAdd, new_hash.temp, mul_nt.temp, flen.temp, "", 0))
            hash_nt = new_hash
            slot = slot + 2
        } else {
            // Numeric: hash = hash * 31 + field_value
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            mul_nt := _lnew_temp(ll)
            ll = mul_nt.l
            c31 := _lnew_temp(ll)
            ll = c31.l
            ll = _lemit(ll, new_inst(OpConst, c31.temp, 31, 0, "", 0))
            ll = _lemit(ll, new_inst(OpMul, mul_nt.temp, hash_nt.temp, c31.temp, "", 0))
            new_hash := _lnew_temp(ll)
            ll = new_hash.l
            ll = _lemit(ll, new_inst(OpAdd, new_hash.temp, mul_nt.temp, fval.temp, "", 0))
            hash_nt = new_hash
            slot = slot + 1
        }
        fi = fi + 1
    }
    ll = _lemit(ll, new_inst(OpRet, 0, hash_nt.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

// Emit a str const + concat it onto cur_str. Returns the new temp holding
// the accumulated string. Used by the Json derive to build `{…}` pieces.
fn _json_append_const(l: Lowerer, cur_str: i64, lit: str) -> LT {
    mut ll := l
    lit_res := _lower_string_const(ll, lit)
    ll = lit_res.l
    cat := _lnew_str_temp(ll)
    ll = cat.l
    ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, cur_str, lit_res.temp, "", 0))
    LT{l: ll, temp: cat.temp}
}

// Emit a concat of `cur_str` with the str-typed temp at `s_temp`.
fn _json_append_str(l: Lowerer, cur_str: i64, s_temp: i64) -> LT {
    mut ll := l
    cat := _lnew_str_temp(ll)
    ll = cat.l
    ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, cur_str, s_temp, "", 0))
    LT{l: ll, temp: cat.temp}
}

// Emit IR that converts a single value to its JSON string representation.
// Returns an LT whose .temp points to a str (ptr at .temp, len at .temp+1).
// For str inputs, val_temp must be the 2-slot str layout (ptr/len). For
// other primitives and struct pointers, val_temp is a 1-slot value.
// Falls back to literal "null" for unsupported types (nested arrays /
// optionals — to be layered on).
fn _emit_value_to_json(l: Lowerer, val_temp: i64, type_id: i64) -> LT {
    mut ll := l
    if type_id == 12 {
        quoted := _lnew_str_temp(ll)
        ll = quoted.l
        ll = _lemit(ll, new_inst(OpCall, quoted.temp, val_temp, 2, "_aria_json_escape", 12))
        ll = _lset_type(ll, quoted.temp, 12)
        return LT{l: ll, temp: quoted.temp}
    }
    if type_id == 1 {
        fstr := _lnew_str_temp(ll)
        ll = fstr.l
        ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, val_temp, 0, "", 0))
        ll = _lset_type(ll, fstr.temp, 12)
        return LT{l: ll, temp: fstr.temp}
    }
    if type_id == 9 {
        fstr := _lnew_str_temp(ll)
        ll = fstr.l
        ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, val_temp, 0, "f64", 0))
        ll = _lset_type(ll, fstr.temp, 12)
        return LT{l: ll, temp: fstr.temp}
    }
    if type_id == 11 {
        true_lbl := _lnew_label(ll)
        ll = true_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        lit_slot := _lnew_str_temp(ll)
        ll = lit_slot.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, val_temp, true_lbl.temp, "", 0))
        f_lit := _lower_string_const(ll, "false")
        ll = f_lit.l
        ll = _lemit(ll, new_inst(OpStore, lit_slot.temp, f_lit.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, lit_slot.temp + 1, f_lit.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, true_lbl.temp, 0, "", 0))
        t_lit := _lower_string_const(ll, "true")
        ll = t_lit.l
        ll = _lemit(ll, new_inst(OpStore, lit_slot.temp, t_lit.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, lit_slot.temp + 1, t_lit.temp + 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        ll = _lset_type(ll, lit_slot.temp, 12)
        return LT{l: ll, temp: lit_slot.temp}
    }
    nested_name := _struct_name_for_type(ll.store, ll.registry, type_id)
    if nested_name != "" && treg_has_impl(ll.treg, nested_name, "Json") {
        call_ret := _lnew_str_temp(ll)
        ll = call_ret.l
        ll = _lemit(ll, new_inst(OpCall, call_ret.temp, val_temp, 1, nested_name + "_to_json", 12))
        ll = _lset_type(ll, call_ret.temp, 12)
        return LT{l: ll, temp: call_ret.temp}
    }
    null_lit := _lower_string_const(ll, "null")
    ll = null_lit.l
    LT{l: ll, temp: null_lit.temp}
}

// Generate `fn TypeName_to_json(self: T) -> str`. Emits a flat string
// directly (no JsonValue pool) so the derive is self-contained — the
// runtime helper `_aria_json_escape` handles string field escaping, and
// nested structs chain into their own generated `_to_json` via OpCall.
//
// Supported field types: str, i64, bool, f64, [T] for primitive T,
// Option[T] for primitive T, and nested structs that also derive Json.
fn _lower_derive_json_to(l: Lowerer, def: StructDef) -> Lowerer {
    fname := def.name + "_to_json"
    mut ll := _lset_func(l, new_ir_func(fname, 1, 12))
    self_nt := _lnew_temp(ll)
    ll = self_nt.l
    ll = _lemit(ll, new_inst(OpArg, self_nt.temp, 0, 0, "", 0))

    // Start with "{"
    open_res := _lower_string_const(ll, "\{")
    ll = open_res.l
    mut cur_str := open_res.temp

    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id

        // Comma separator between fields.
        if fi > 1 {
            r := _json_append_const(ll, cur_str, ",")
            ll = r.l
            cur_str = r.temp
        }

        // `"field_name":`
        r2 := _json_append_const(ll, cur_str, "\"" + fld.name + "\":")
        ll = r2.l
        cur_str = r2.temp

        if ft == 12 {
            // str — _aria_json_escape returns already-quoted, escaped str.
            raw := _lnew_str_temp(ll)
            ll = raw.l
            ll = _lemit(ll, new_inst(OpFieldGet, raw.temp, self_nt.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, raw.temp + 1, self_nt.temp, slot + 1, "", 0))
            quoted := _lnew_str_temp(ll)
            ll = quoted.l
            ll = _lemit(ll, new_inst(OpCall, quoted.temp, raw.temp, 2, "_aria_json_escape", 12))
            ll = _lset_type(ll, quoted.temp, 12)
            r3 := _json_append_str(ll, cur_str, quoted.temp)
            ll = r3.l
            cur_str = r3.temp
            slot = slot + 2
        } else if ft == 1 {
            // i64 — decimal literal.
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            fstr := _lnew_str_temp(ll)
            ll = fstr.l
            ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, fval.temp, 0, "", 0))
            r3 := _json_append_str(ll, cur_str, fstr.temp)
            ll = r3.l
            cur_str = r3.temp
            slot = slot + 1
        } else if ft == 9 {
            // f64 — route OpIntToStr with s1="f64" to _aria_float_to_str,
            // which formats the bits as a JSON-safe number literal.
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            fstr := _lnew_str_temp(ll)
            ll = fstr.l
            ll = _lemit(ll, new_inst(OpIntToStr, fstr.temp, fval.temp, 0, "f64", 0))
            ll = _lset_type(ll, fstr.temp, 12)
            r3 := _json_append_str(ll, cur_str, fstr.temp)
            ll = r3.l
            cur_str = r3.temp
            slot = slot + 1
        } else if ft == 11 {
            // bool (TY_BOOL=11) — branch on 0/1 and append "true"/"false".
            fval := _lnew_temp(ll)
            ll = fval.l
            ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
            true_lbl := _lnew_label(ll)
            ll = true_lbl.l
            end_lbl := _lnew_label(ll)
            ll = end_lbl.l
            // Materialize the "true"/"false" literal into a stable temp
            // (phi isn't wired, so we store into a single slot via conditional jumps).
            lit_slot := _lnew_str_temp(ll)
            ll = lit_slot.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, fval.temp, true_lbl.temp, "", 0))
            // False branch
            f_lit := _lower_string_const(ll, "false")
            ll = f_lit.l
            ll = _lemit(ll, new_inst(OpStore, lit_slot.temp, f_lit.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, lit_slot.temp + 1, f_lit.temp + 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            // True branch
            ll = _lemit(ll, new_inst(OpLabel, 0, true_lbl.temp, 0, "", 0))
            t_lit := _lower_string_const(ll, "true")
            ll = t_lit.l
            ll = _lemit(ll, new_inst(OpStore, lit_slot.temp, t_lit.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, lit_slot.temp + 1, t_lit.temp + 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
            ll = _lset_type(ll, lit_slot.temp, 12)
            r3 := _json_append_str(ll, cur_str, lit_slot.temp)
            ll = r3.l
            cur_str = r3.temp
            slot = slot + 1
        } else if ft > 16 && ft < ll.store.types.len() {
            ft_kind := type_kind_name(ll.store.types[ft].kind)
            if ft_kind == "Array" {
                // [T] — emit "[" + comma-joined per-elem JSON + "]". Uses
                // a 2-slot buffer slot so cur_str can flow through the loop
                // in phi-less IR.
                elem_tid := ll.store.types[ft].type_id
                r_open := _json_append_const(ll, cur_str, "[")
                ll = r_open.l
                buf_slot := _lnew_str_temp(ll)
                ll = buf_slot.l
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp, r_open.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp + 1, r_open.temp + 1, 0, "", 0))
                arr_nt := _lnew_temp(ll)
                ll = arr_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, arr_nt.temp, self_nt.temp, slot, fld.name, 0))
                len_nt := _lnew_temp(ll)
                ll = len_nt.l
                ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, arr_nt.temp, 0, "", 0))
                i_slot := _lnew_temp(ll)
                ll = i_slot.l
                zero_nt := _lnew_temp(ll)
                ll = zero_nt.l
                ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, i_slot.temp, zero_nt.temp, 0, "", 0))
                loop_lbl := _lnew_label(ll)
                ll = loop_lbl.l
                end_lbl := _lnew_label(ll)
                ll = end_lbl.l
                ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
                i_cur := _lnew_temp(ll)
                ll = i_cur.l
                ll = _lemit(ll, new_inst(OpLoad, i_cur.temp, i_slot.temp, 0, "", 0))
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpLt, cmp_nt.temp, i_cur.temp, len_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp_nt.temp, end_lbl.temp, "", 0))
                // if i > 0 append ","
                zero2 := _lnew_temp(ll)
                ll = zero2.l
                ll = _lemit(ll, new_inst(OpConst, zero2.temp, 0, 0, "", 0))
                cmp2 := _lnew_temp(ll)
                ll = cmp2.l
                ll = _lemit(ll, new_inst(OpGt, cmp2.temp, i_cur.temp, zero2.temp, "", 0))
                skip_comma := _lnew_label(ll)
                ll = skip_comma.l
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp2.temp, skip_comma.temp, "", 0))
                cur_load := _lnew_str_temp(ll)
                ll = cur_load.l
                ll = _lemit(ll, new_inst(OpLoad, cur_load.temp, buf_slot.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLoad, cur_load.temp + 1, buf_slot.temp + 1, 0, "", 0))
                ll = _lset_type(ll, cur_load.temp, 12)
                comma_r := _json_append_const(ll, cur_load.temp, ",")
                ll = comma_r.l
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp, comma_r.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp + 1, comma_r.temp + 1, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, skip_comma.temp, 0, "", 0))
                // Load element. Str elements take 2 slots.
                mut elem_temp := 0
                if elem_tid == 12 {
                    e := _lnew_str_temp(ll)
                    ll = e.l
                    ll = _lemit(ll, new_inst(OpArrayGet, e.temp, arr_nt.temp, i_cur.temp, "", 12))
                    ll = _lset_type(ll, e.temp, 12)
                    elem_temp = e.temp
                } else {
                    e := _lnew_temp(ll)
                    ll = e.l
                    ll = _lemit(ll, new_inst(OpArrayGet, e.temp, arr_nt.temp, i_cur.temp, "", 0))
                    if elem_tid > 0 { ll = _lset_type(ll, e.temp, elem_tid) }
                    elem_temp = e.temp
                }
                // Encode element and append.
                elem_json := _emit_value_to_json(ll, elem_temp, elem_tid)
                ll = elem_json.l
                cur_load2 := _lnew_str_temp(ll)
                ll = cur_load2.l
                ll = _lemit(ll, new_inst(OpLoad, cur_load2.temp, buf_slot.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLoad, cur_load2.temp + 1, buf_slot.temp + 1, 0, "", 0))
                ll = _lset_type(ll, cur_load2.temp, 12)
                app_r := _json_append_str(ll, cur_load2.temp, elem_json.temp)
                ll = app_r.l
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp, app_r.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, buf_slot.temp + 1, app_r.temp + 1, 0, "", 0))
                // i++
                one_nt := _lnew_temp(ll)
                ll = one_nt.l
                ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
                next_i := _lnew_temp(ll)
                ll = next_i.l
                ll = _lemit(ll, new_inst(OpAdd, next_i.temp, i_cur.temp, one_nt.temp, "", 0))
                ll = _lemit(ll, new_inst(OpStore, i_slot.temp, next_i.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
                // Load final cur_str, append "]"
                final_load := _lnew_str_temp(ll)
                ll = final_load.l
                ll = _lemit(ll, new_inst(OpLoad, final_load.temp, buf_slot.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLoad, final_load.temp + 1, buf_slot.temp + 1, 0, "", 0))
                ll = _lset_type(ll, final_load.temp, 12)
                close_r := _json_append_const(ll, final_load.temp, "]")
                ll = close_r.l
                cur_str = close_r.temp
            } else if ft_kind == "Optional" {
                // Option[T] — _tag at slot 0 (0=None, 1=Some), _val at slot 1.
                inner_tid := ll.store.types[ft].type_id
                opt_nt := _lnew_temp(ll)
                ll = opt_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, opt_nt.temp, self_nt.temp, slot, fld.name, 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, opt_nt.temp, 0, "_tag", 0))
                some_lbl := _lnew_label(ll)
                ll = some_lbl.l
                opt_end := _lnew_label(ll)
                ll = opt_end.l
                opt_slot := _lnew_str_temp(ll)
                ll = opt_slot.l
                ll = _lemit(ll, new_inst(OpBranchTrue, 0, tag_nt.temp, some_lbl.temp, "", 0))
                // None → store "null"
                null_lit := _lower_string_const(ll, "null")
                ll = null_lit.l
                ll = _lemit(ll, new_inst(OpStore, opt_slot.temp, null_lit.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, opt_slot.temp + 1, null_lit.temp + 1, 0, "", 0))
                ll = _lemit(ll, new_inst(OpJump, 0, opt_end.temp, 0, "", 0))
                // Some → load _val, encode per T
                ll = _lemit(ll, new_inst(OpLabel, 0, some_lbl.temp, 0, "", 0))
                mut val_temp := 0
                if inner_tid == 12 {
                    v := _lnew_str_temp(ll)
                    ll = v.l
                    ll = _lemit(ll, new_inst(OpFieldGet, v.temp, opt_nt.temp, 1, "_val", 0))
                    ll = _lemit(ll, new_inst(OpFieldGet, v.temp + 1, opt_nt.temp, 2, "", 0))
                    ll = _lset_type(ll, v.temp, 12)
                    val_temp = v.temp
                } else {
                    v := _lnew_temp(ll)
                    ll = v.l
                    ll = _lemit(ll, new_inst(OpFieldGet, v.temp, opt_nt.temp, 1, "_val", 0))
                    if inner_tid > 0 { ll = _lset_type(ll, v.temp, inner_tid) }
                    val_temp = v.temp
                }
                val_json := _emit_value_to_json(ll, val_temp, inner_tid)
                ll = val_json.l
                ll = _lemit(ll, new_inst(OpStore, opt_slot.temp, val_json.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, opt_slot.temp + 1, val_json.temp + 1, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, opt_end.temp, 0, "", 0))
                ll = _lset_type(ll, opt_slot.temp, 12)
                r3 := _json_append_str(ll, cur_str, opt_slot.temp)
                ll = r3.l
                cur_str = r3.temp
            } else {
                // Nested user struct. If it derives Json, forward to its _to_json.
                nested_name := _struct_name_for_type(ll.store, ll.registry, ft)
                if nested_name != "" && treg_has_impl(ll.treg, nested_name, "Json") {
                    fval := _lnew_temp(ll)
                    ll = fval.l
                    ll = _lemit(ll, new_inst(OpFieldGet, fval.temp, self_nt.temp, slot, fld.name, 0))
                    nested_call := _lnew_str_temp(ll)
                    ll = nested_call.l
                    ll = _lemit(ll, new_inst(OpCall, nested_call.temp, fval.temp, 1, nested_name + "_to_json", 12))
                    ll = _lset_type(ll, nested_call.temp, 12)
                    r3 := _json_append_str(ll, cur_str, nested_call.temp)
                    ll = r3.l
                    cur_str = r3.temp
                } else {
                    r3 := _json_append_const(ll, cur_str, "null")
                    ll = r3.l
                    cur_str = r3.temp
                }
            }
            slot = slot + 1
        } else {
            r3 := _json_append_const(ll, cur_str, "null")
            ll = r3.l
            cur_str = r3.temp
            slot = slot + 1
        }
        fi = fi + 1
    }

    // Closing `}`
    close_r := _json_append_const(ll, cur_str, "\}")
    ll = close_r.l
    ll = _lemit(ll, new_inst(OpRet, 0, close_r.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

// Emit an OpCall to a 2-slot str-arg helper that returns str, like
// `json_get_str(v, key)`. Returns a fresh str temp. Packs the 3-slot arg
// block (v, key_ptr, key_len) into consecutive temps so the called fn
// sees them in the expected order.
fn _json_call_get_str(l: Lowerer, v_temp: i64, key: str, callee: str) -> LT {
    mut ll := l
    key_lt := _lower_string_const(ll, key)
    ll = key_lt.l
    pack := _lnew_temp(ll)
    ll = pack.l
    extra1 := _lnew_temp(ll)
    ll = extra1.l
    extra2 := _lnew_temp(ll)
    ll = extra2.l
    ll = _lemit(ll, new_inst(OpStore, pack.temp, v_temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, pack.temp + 1, key_lt.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, pack.temp + 2, key_lt.temp + 1, 0, "", 0))
    ret := _lnew_str_temp(ll)
    ll = ret.l
    ll = _lemit(ll, new_inst(OpCall, ret.temp, pack.temp, 3, callee, 12))
    ll = _lset_type(ll, ret.temp, 12)
    LT{l: ll, temp: ret.temp}
}

// OpCall to a helper returning i64 (e.g. json_get_int/json_get_bool/
// json_object_get). Same arg layout as _json_call_get_str.
fn _json_call_get_i64(l: Lowerer, v_temp: i64, key: str, callee: str) -> LT {
    mut ll := l
    key_lt := _lower_string_const(ll, key)
    ll = key_lt.l
    pack := _lnew_temp(ll)
    ll = pack.l
    extra1 := _lnew_temp(ll)
    ll = extra1.l
    extra2 := _lnew_temp(ll)
    ll = extra2.l
    ll = _lemit(ll, new_inst(OpStore, pack.temp, v_temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, pack.temp + 1, key_lt.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, pack.temp + 2, key_lt.temp + 1, 0, "", 0))
    ret := _lnew_temp(ll)
    ll = ret.l
    ll = _lemit(ll, new_inst(OpCall, ret.temp, pack.temp, 3, callee, 1))
    ll = _lset_type(ll, ret.temp, 1)
    LT{l: ll, temp: ret.temp}
}

// Generate `fn TypeName_from_json_value(v: JsonValue) -> T` and
// `fn TypeName_from_json(s: str) -> T`. The first does the real work —
// pull each field via `json_get_str` / `json_get_int` / `json_get_bool`
// or recurse via `<NestedT>_from_json_value`. The str-entry variant just
// wraps `json_parse(s)` and forwards.
//
// Missing keys and type-mismatched values produce the json lib's defaults
// ("", 0, false) rather than an Err — this matches phase 1 scope (simple
// structs, happy-path parsing). A fallible variant can layer on later.
fn _lower_derive_json_from(l: Lowerer, def: StructDef) -> Lowerer {
    mut ll := l
    // --- Part 1: <T>_from_json_value(v: JsonValue) -> T ---
    value_fname := def.name + "_from_json_value"
    struct_id := _struct_type_id(ll.registry, def.name)
    ll = _lset_func(ll, new_ir_func(value_fname, 1, struct_id))
    v_arg := _lnew_temp(ll)
    ll = v_arg.l
    ll = _lemit(ll, new_inst(OpArg, v_arg.temp, 0, 0, "", 0))
    // Allocate the result struct
    alloc_size := def.fields.len() - 1
    inst := _lnew_temp(ll)
    ll = inst.l
    ll = _lemit(ll, new_inst(OpAlloc, inst.temp, alloc_size, 0, def.name, 0))
    if struct_id > 0 { ll = _lset_type(ll, inst.temp, struct_id) }
    mut fi := 1
    mut slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id
        if ft == 12 {
            got := _json_call_get_str(ll, v_arg.temp, fld.name, "json_get_str")
            ll = got.l
            ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, got.temp, slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, got.temp + 1, slot + 1, "", 0))
            slot = slot + 2
        } else if ft == 1 {
            got := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_get_int")
            ll = got.l
            ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, got.temp, slot, fld.name, 0))
            slot = slot + 1
        } else if ft == 9 {
            // f64 — json_get_float returns f64 bits in the i64 slot.
            got := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_get_float")
            ll = got.l
            ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, got.temp, slot, fld.name, 0))
            slot = slot + 1
        } else if ft == 11 {
            got := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_get_bool")
            ll = got.l
            ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, got.temp, slot, fld.name, 0))
            slot = slot + 1
        } else if ft > 16 && ft < ll.store.types.len() {
            ft_kind := type_kind_name(ll.store.types[ft].kind)
            if ft_kind == "Optional" {
                inner_tid := ll.store.types[ft].type_id
                sub_v := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_object_get")
                ll = sub_v.l
                kind_t := _lnew_temp(ll)
                ll = kind_t.l
                ll = _lemit(ll, new_inst(OpCall, kind_t.temp, sub_v.temp, 1, "json_kind", 1))
                ll = _lset_type(ll, kind_t.temp, 1)
                zero_k := _lnew_temp(ll)
                ll = zero_k.l
                ll = _lemit(ll, new_inst(OpConst, zero_k.temp, 0, 0, "", 0))
                is_null := _lnew_temp(ll)
                ll = is_null.l
                ll = _lemit(ll, new_inst(OpEq, is_null.temp, kind_t.temp, zero_k.temp, "", 0))
                some_lbl := _lnew_label(ll)
                ll = some_lbl.l
                opt_end := _lnew_label(ll)
                ll = opt_end.l
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_null.temp, some_lbl.temp, "", 0))
                // None branch
                none_opt := _lnew_temp(ll)
                ll = none_opt.l
                ll = _lemit(ll, new_inst(OpAlloc, none_opt.temp, 2, 0, "_Optional", 0))
                zero_tag := _lnew_temp(ll)
                ll = zero_tag.l
                ll = _lemit(ll, new_inst(OpConst, zero_tag.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, none_opt.temp, zero_tag.temp, 0, "_tag", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, none_opt.temp, slot, fld.name, 0))
                ll = _lemit(ll, new_inst(OpJump, 0, opt_end.temp, 0, "", 0))
                // Some branch
                ll = _lemit(ll, new_inst(OpLabel, 0, some_lbl.temp, 0, "", 0))
                mut opt_slots := 2
                if inner_tid == 12 { opt_slots = 3 }
                some_opt := _lnew_temp(ll)
                ll = some_opt.l
                ll = _lemit(ll, new_inst(OpAlloc, some_opt.temp, opt_slots, 0, "_Optional", 0))
                one_tag := _lnew_temp(ll)
                ll = one_tag.l
                ll = _lemit(ll, new_inst(OpConst, one_tag.temp, 1, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, some_opt.temp, one_tag.temp, 0, "_tag", 0))
                if inner_tid == 12 {
                    sv := _lnew_str_temp(ll)
                    ll = sv.l
                    ll = _lemit(ll, new_inst(OpCall, sv.temp, sub_v.temp, 1, "json_str_val", 12))
                    ll = _lset_type(ll, sv.temp, 12)
                    ll = _lemit(ll, new_inst(OpFieldSet, some_opt.temp, sv.temp, 1, "_val", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, some_opt.temp, sv.temp + 1, 2, "", 0))
                } else if inner_tid == 1 || inner_tid == 11 {
                    iv := _lnew_temp(ll)
                    ll = iv.l
                    ll = _lemit(ll, new_inst(OpCall, iv.temp, sub_v.temp, 1, "json_int_val", 1))
                    ll = _lset_type(ll, iv.temp, 1)
                    ll = _lemit(ll, new_inst(OpFieldSet, some_opt.temp, iv.temp, 1, "_val", 0))
                } else if inner_tid == 9 {
                    fv := _lnew_temp(ll)
                    ll = fv.l
                    ll = _lemit(ll, new_inst(OpCall, fv.temp, sub_v.temp, 1, "json_float_val", 9))
                    ll = _lset_type(ll, fv.temp, 9)
                    ll = _lemit(ll, new_inst(OpFieldSet, some_opt.temp, fv.temp, 1, "_val", 0))
                }
                ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, some_opt.temp, slot, fld.name, 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, opt_end.temp, 0, "", 0))
            } else if ft_kind == "Array" {
                elem_tid := ll.store.types[ft].type_id
                sub_v := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_object_get")
                ll = sub_v.l
                arr_len := _lnew_temp(ll)
                ll = arr_len.l
                ll = _lemit(ll, new_inst(OpCall, arr_len.temp, sub_v.temp, 1, "json_array_len", 1))
                ll = _lset_type(ll, arr_len.temp, 1)
                // Start with empty array; append per element so str elems get
                // properly boxed via OpArrayAppend's str path.
                arr_slot := _lnew_temp(ll)
                ll = arr_slot.l
                zero_cap := _lnew_temp(ll)
                ll = zero_cap.l
                ll = _lemit(ll, new_inst(OpConst, zero_cap.temp, 0, 0, "", 0))
                init_arr := _lnew_temp(ll)
                ll = init_arr.l
                ll = _lemit(ll, new_inst(OpArrayNew, init_arr.temp, zero_cap.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, arr_slot.temp, init_arr.temp, 0, "", 0))
                // i := 0
                i_slot := _lnew_temp(ll)
                ll = i_slot.l
                zi := _lnew_temp(ll)
                ll = zi.l
                ll = _lemit(ll, new_inst(OpConst, zi.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, i_slot.temp, zi.temp, 0, "", 0))
                a_loop := _lnew_label(ll)
                ll = a_loop.l
                a_end := _lnew_label(ll)
                ll = a_end.l
                ll = _lemit(ll, new_inst(OpLabel, 0, a_loop.temp, 0, "", 0))
                i_cur := _lnew_temp(ll)
                ll = i_cur.l
                ll = _lemit(ll, new_inst(OpLoad, i_cur.temp, i_slot.temp, 0, "", 0))
                cmp := _lnew_temp(ll)
                ll = cmp.l
                ll = _lemit(ll, new_inst(OpLt, cmp.temp, i_cur.temp, arr_len.temp, "", 0))
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, cmp.temp, a_end.temp, "", 0))
                // elem_v := json_array_get(sub_v, i). 2-arg OpCall.
                pack := _lnew_temp(ll)
                ll = pack.l
                extra := _lnew_temp(ll)
                ll = extra.l
                ll = _lemit(ll, new_inst(OpStore, pack.temp, sub_v.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpStore, pack.temp + 1, i_cur.temp, 0, "", 0))
                elem_v := _lnew_temp(ll)
                ll = elem_v.l
                ll = _lemit(ll, new_inst(OpCall, elem_v.temp, pack.temp, 2, "json_array_get", 1))
                ll = _lset_type(ll, elem_v.temp, 1)
                // Load current arr
                cur_arr := _lnew_temp(ll)
                ll = cur_arr.l
                ll = _lemit(ll, new_inst(OpLoad, cur_arr.temp, arr_slot.temp, 0, "", 0))
                new_arr := _lnew_temp(ll)
                ll = new_arr.l
                if elem_tid == 12 {
                    sv := _lnew_str_temp(ll)
                    ll = sv.l
                    ll = _lemit(ll, new_inst(OpCall, sv.temp, elem_v.temp, 1, "json_str_val", 12))
                    ll = _lset_type(ll, sv.temp, 12)
                    ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, cur_arr.temp, sv.temp, "", 12))
                } else if elem_tid == 1 || elem_tid == 11 {
                    iv := _lnew_temp(ll)
                    ll = iv.l
                    ll = _lemit(ll, new_inst(OpCall, iv.temp, elem_v.temp, 1, "json_int_val", 1))
                    ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, cur_arr.temp, iv.temp, "", 0))
                } else if elem_tid == 9 {
                    fv := _lnew_temp(ll)
                    ll = fv.l
                    ll = _lemit(ll, new_inst(OpCall, fv.temp, elem_v.temp, 1, "json_float_val", 9))
                    ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, cur_arr.temp, fv.temp, "", 0))
                } else {
                    // Unsupported elem — push 0 to keep length aligned.
                    z := _lnew_temp(ll)
                    ll = z.l
                    ll = _lemit(ll, new_inst(OpConst, z.temp, 0, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpArrayAppend, new_arr.temp, cur_arr.temp, z.temp, "", 0))
                }
                ll = _lemit(ll, new_inst(OpStore, arr_slot.temp, new_arr.temp, 0, "", 0))
                // i++
                one := _lnew_temp(ll)
                ll = one.l
                ll = _lemit(ll, new_inst(OpConst, one.temp, 1, 0, "", 0))
                nxt := _lnew_temp(ll)
                ll = nxt.l
                ll = _lemit(ll, new_inst(OpAdd, nxt.temp, i_cur.temp, one.temp, "", 0))
                ll = _lemit(ll, new_inst(OpStore, i_slot.temp, nxt.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpJump, 0, a_loop.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, a_end.temp, 0, "", 0))
                // inst.field = final arr
                final_arr := _lnew_temp(ll)
                ll = final_arr.l
                ll = _lemit(ll, new_inst(OpLoad, final_arr.temp, arr_slot.temp, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, final_arr.temp, slot, fld.name, 0))
            } else {
                nested_name := _struct_name_for_type(ll.store, ll.registry, ft)
                if nested_name != "" && treg_has_impl(ll.treg, nested_name, "Json") {
                    sub_v := _json_call_get_i64(ll, v_arg.temp, fld.name, "json_object_get")
                    ll = sub_v.l
                    nested_ret := _lnew_temp(ll)
                    ll = nested_ret.l
                    ll = _lemit(ll, new_inst(OpCall, nested_ret.temp, sub_v.temp, 1, nested_name + "_from_json_value", 1))
                    nested_tid := _struct_type_id(ll.registry, nested_name)
                    if nested_tid > 0 { ll = _lset_type(ll, nested_ret.temp, nested_tid) }
                    ll = _lemit(ll, new_inst(OpFieldSet, inst.temp, nested_ret.temp, slot, fld.name, 0))
                }
            }
            slot = slot + 1
        } else {
            // Unsupported primitive — leave field zeroed.
            slot = slot + 1
        }
        fi = fi + 1
    }
    ll = _lemit(ll, new_inst(OpRet, 0, inst.temp, 0, "", 0))
    ll = _lfinish_func(ll)

    // --- Part 2: <T>_from_json(s: str) -> T ---
    str_fname := def.name + "_from_json"
    ll = _lset_func(ll, new_ir_func(str_fname, 2, struct_id))
    s_ptr := _lnew_str_temp(ll)
    ll = s_ptr.l
    ll = _lemit(ll, new_inst(OpArg, s_ptr.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpArg, s_ptr.temp + 1, 1, 0, "", 0))
    // Pack str arg into 2 consecutive slots, then call json_parse.
    pack := _lnew_temp(ll)
    ll = pack.l
    extra1 := _lnew_temp(ll)
    ll = extra1.l
    ll = _lemit(ll, new_inst(OpStore, pack.temp, s_ptr.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpStore, pack.temp + 1, s_ptr.temp + 1, 0, "", 0))
    v_ret := _lnew_temp(ll)
    ll = v_ret.l
    ll = _lemit(ll, new_inst(OpCall, v_ret.temp, pack.temp, 2, "json_parse", 1))
    // Forward to from_json_value.
    final_ret := _lnew_temp(ll)
    ll = final_ret.l
    ll = _lemit(ll, new_inst(OpCall, final_ret.temp, v_ret.temp, 1, value_fname, 1))
    if struct_id > 0 { ll = _lset_type(ll, final_ret.temp, struct_id) }
    ll = _lemit(ll, new_inst(OpRet, 0, final_ret.temp, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

// Generate trampoline wrapper functions for each fn referenced as a value.
// Each trampoline accepts an env_ptr as its first arg (closure ABI) and forwards
// the remaining args to the original function. This bridges the ABI gap between
// named functions (no env_ptr) and closures (env_ptr as first arg).
fn _lower_trampolines(l: Lowerer) -> Lowerer {
    mut ll := l
    mut i := 1
    while i < ll.registry.fn_value_refs.len() {
        fname := ll.registry.fn_value_refs[i]
        sig := reg_find_fn(ll.registry, fname)
        if sig.name != "" {
            tramp_name := "_tramp_" + fname
            existing := mod_find_func(ll.module, tramp_name)
            if existing.name == "" {
                // Compute ABI arg count: str params take 2 register slots
                mut abi_args := 0
                mut pi := 1
                while pi < sig.param_types.len() {
                    if sig.param_types[pi] == 12 {
                        abi_args = abi_args + 2
                    } else {
                        abi_args = abi_args + 1
                    }
                    pi = pi + 1
                }
                // Trampoline takes 1 extra arg (env_ptr) prepended.
                // Normalize unit (14) to 0 so llvm.aria emits a void signature
                // matching the `ret void` we emit for void user fns below.
                total_args := 1 + abi_args
                mut tramp_ret := sig.return_type
                if tramp_ret == 14 { tramp_ret = 0 }
                ll = _lset_func(ll, new_ir_func(tramp_name, total_args, tramp_ret))
                // Emit OpArg for each param (arg 0 = env_ptr, unused)
                mut ai := 0
                while ai < total_args {
                    arg_temp := _lnew_temp(ll)
                    ll = arg_temp.l
                    ll = _lemit(ll, new_inst(OpArg, arg_temp.temp, ai, 0, "", 0))
                    ai = ai + 1
                }
                // Forward to original function with args starting at index 1 (skip env_ptr)
                // First forwarded arg temp is env_arg_temp + 1
                // The temp counter for args 0..total_args-1 corresponds to the first
                // total_args temps after entering the function (their IDs are known).
                // Actually: each _lnew_temp returns sequential IDs. First arg was temp 0
                // (or whatever starting id), then 1, 2, ...
                // We emit OpCall with first_arg = temp_of(arg_1), arg_count = abi_args.
                // The temps we allocated are sequential from the first _lnew_temp call.
                // Need to track the first forwarded arg temp.
                // Re-emit: track first_forwarded_temp explicitly.
                first_forward := 1  // arg 0 is env_ptr, arg 1 starts the forwarded args (temp id = 1 in fresh func)
                // Allocate return temp
                mut ret_temp := 0
                if sig.return_type == 12 {
                    rt := _lnew_str_temp(ll)
                    ll = rt.l
                    ret_temp = rt.temp
                    ll = _lemit(ll, new_inst(OpCall, ret_temp, first_forward, abi_args, fname, sig.return_type))
                    ll = _lemit(ll, new_inst(OpRet, 0, ret_temp, 0, "", 0))
                } else if sig.return_type == 0 || sig.return_type == 14 {
                    // void / unit
                    ll = _lemit(ll, new_inst(OpCall, 0, first_forward, abi_args, fname, sig.return_type))
                    ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
                } else {
                    rt := _lnew_temp(ll)
                    ll = rt.l
                    ret_temp = rt.temp
                    ll = _lemit(ll, new_inst(OpCall, ret_temp, first_forward, abi_args, fname, sig.return_type))
                    ll = _lemit(ll, new_inst(OpRet, 0, ret_temp, 0, "", 0))
                }
                ll = _lfinish_func(ll)
            }
        }
        i = i + 1
    }
    // Bound method ref trampolines: extract self from env[0], forward to method
    mut bi := 1
    while bi < ll.registry.bound_fn_value_refs.len() {
        bfname := ll.registry.bound_fn_value_refs[bi]
        bsig := reg_find_fn(ll.registry, bfname)
        if bsig.name != "" {
            btramp := "_bound_tramp_" + bfname
            bexist := mod_find_func(ll.module, btramp)
            if bexist.name == "" {
                // Count ABI args for the original method (including self)
                mut babi := 0
                mut bpi := 1
                while bpi < bsig.param_types.len() {
                    if bsig.param_types[bpi] == 12 { babi = babi + 2 } else { babi = babi + 1 }
                    bpi = bpi + 1
                }
                // Bound trampoline: (env_ptr, extra_args...)
                // self extracted from env[0], then forwarded with extra args
                // Total incoming args = 1 (env_ptr) + (babi - self_slots)
                // For simplicity: self takes 1 slot (struct pointer). Extra args = babi - 1.
                extra_args := babi - 1
                total_in := 1 + extra_args
                ll = _lset_func(ll, new_ir_func(btramp, total_in, bsig.return_type))
                // Arg 0: env_ptr
                env_t := _lnew_temp(ll)
                ll = env_t.l
                ll = _lemit(ll, new_inst(OpArg, env_t.temp, 0, 0, "", 0))
                // Extract self from env[0]
                self_t := _lnew_temp(ll)
                ll = self_t.l
                ll = _lemit(ll, new_inst(OpFieldGet, self_t.temp, env_t.temp, 0, "_self", 0))
                // Read extra args (indices 1..extra_args)
                mut eai := 0
                while eai < extra_args {
                    ea_t := _lnew_temp(ll)
                    ll = ea_t.l
                    ll = _lemit(ll, new_inst(OpArg, ea_t.temp, eai + 1, 0, "", 0))
                    eai = eai + 1
                }
                // Pack: self + extra args into consecutive temps for OpCall
                // self_t.temp is temp 1 (after env_t at 0), extra args at 2..
                // We need self as first arg to the method. Temps are:
                // 0=env, 1=self, 2..=extra_args
                // Call with first_arg=self_t.temp, arg_count=babi
                if bsig.return_type == 12 {
                    brt := _lnew_str_temp(ll)
                    ll = brt.l
                    ll = _lemit(ll, new_inst(OpCall, brt.temp, self_t.temp, babi, bfname, bsig.return_type))
                    ll = _lemit(ll, new_inst(OpRet, 0, brt.temp, 0, "", 0))
                } else if bsig.return_type == 0 || bsig.return_type == 14 {
                    ll = _lemit(ll, new_inst(OpCall, 0, self_t.temp, babi, bfname, bsig.return_type))
                    ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
                } else {
                    brt := _lnew_temp(ll)
                    ll = brt.l
                    ll = _lemit(ll, new_inst(OpCall, brt.temp, self_t.temp, babi, bfname, bsig.return_type))
                    ll = _lemit(ll, new_inst(OpRet, 0, brt.temp, 0, "", 0))
                }
                ll = _lfinish_func(ll)
            }
        }
        bi = bi + 1
    }
    ll
}

fn lower(tokens: [Token], index: DeclIndex, pool: NodePool, store: TypeStore, reg: TypeRegistry, treg: TraitRegistry, table: SymbolTable, file: str) -> IrModule {
    mut l := _new_lowerer(tokens, pool, store, reg, treg, table, file)
    l = _scan_consts(l, index)
    l = _lower_bodies(l, index)
    l = _lower_trampolines(l)
    l = _lower_derives(l)
    l = _lower_mono_pass(l)
    return l.module
}

// Lower for test mode: compile test blocks and generate a test runner _main
// Skips entry blocks to avoid duplicate _main (test runner generates its own)
fn lower_for_tests(tokens: [Token], index: DeclIndex, pool: NodePool, store: TypeStore, reg: TypeRegistry, treg: TraitRegistry, table: SymbolTable, file: str, parallel: bool) -> IrModule {
    mut l := _new_lowerer(tokens, pool, store, reg, treg, table, file)
    l = _scan_consts(l, index)
    l = _lower_bodies_skip_entry(l, index)
    // For parallel tests, register test fns as value refs so trampolines are generated
    if parallel {
        mut ti := 0
        while ti < l.module.test_count {
            test_fn := "_test_" + i2s(ti)
            // Register a FnSig for the test fn so trampolines can look it up
            test_sig := new_fn_sig(test_fn, [""], [0], 0, 0)
            l = _lset_reg(l, reg_add_fn(l.registry, test_sig))
            l = _lset_reg(l, reg_add_fn_value_ref(l.registry, test_fn))
            ti = ti + 1
        }
    }
    l = _lower_trampolines(l)
    l = _lower_derives(l)
    l = _lower_mono_pass(l)
    // Generate test runner _main that calls each _test_N function
    l = _generate_test_runner_p(l, parallel)
    return l.module
}

fn _generate_test_runner_p(l: Lowerer, parallel: bool) -> Lowerer {
    mut ll := l
    test_count := ll.module.test_count
    if test_count == 0 {
        // No tests — generate empty _main that prints "no tests found"
        ll = _lset_func(ll, new_ir_func("_main", 0, 0))
        mut no_tests_idx := mod_find_string(ll.module, "no tests found")
        if no_tests_idx == 0 {
            new_mod := mod_add_string(ll.module, "no tests found")
            no_tests_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConstStr, nt.temp, no_tests_idx, 14, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, nt.temp, 2, "_aria_println_str", 0))
        exit_nt := _lnew_temp(ll)
        ll = exit_nt.l
        ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))
        ll = _lfinish_func(ll)
        mut new_mod2 := mod_set_entry(ll.module, "_main")
        ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                     table: ll.table, file: ll.file, module: new_mod2,
                     current_func: ll.current_func,
                     temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                     env_names: ll.env_names, env_slots: ll.env_slots,
                     loop_start: ll.loop_start, loop_end: ll.loop_end,
                     const_names: ll.const_names, const_vals: ll.const_vals,
                     const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                     temp_types: ll.temp_types, is_result: ll.is_result,
                     fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
        return ll
    }

    // Generate _main that calls each test, prints results
    ll = _lset_func(ll, new_ir_func("_main", 0, 0))

    // Parallel mode: spawn all tests, then await all handles
    if parallel && test_count > 0 {
        // Pre-allocate handle temps (consecutive)
        first_handle := _lnew_temp(ll)
        ll = first_handle.l
        mut hi := 1
        while hi < test_count {
            pad := _lnew_temp(ll)
            ll = pad.l
            hi = hi + 1
        }
        // Spawn each test into its handle slot
        mut si := 0
        while si < test_count {
            test_fn_name := "_test_" + i2s(si)
            tramp_name := "_tramp_" + test_fn_name
            fn_ref := _lnew_temp(ll)
            ll = fn_ref.l
            ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, tramp_name, 0))
            null_env := _lnew_temp(ll)
            ll = null_env.l
            ll = _lemit(ll, new_inst(OpConst, null_env.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpCall, first_handle.temp + si, fn_ref.temp, 2, "_aria_spawn", 1))
            si = si + 1
        }
        // Await all handles
        mut ai := 0
        while ai < test_count {
            await_nt := _lnew_temp(ll)
            ll = await_nt.l
            ll = _lemit(ll, new_inst(OpCall, await_nt.temp, first_handle.temp + ai, 1, "_aria_task_await", 1))
            ai = ai + 1
        }
        // Print summary
        mut done_idx := mod_find_string(ll.module, "all tests passed")
        if done_idx == 0 {
            new_mod := mod_add_string(ll.module, "all tests passed")
            done_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        done_nt := _lnew_str_temp(ll)
        ll = done_nt.l
        ll = _lemit(ll, new_inst(OpConstStr, done_nt.temp, done_idx, 16, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, done_nt.temp, 2, "_aria_println_str", 0))
        ll = _lfinish_func(ll)
        mut new_mod_e := mod_set_entry(ll.module, "_main")
        ll = _lset_mod(ll, new_mod_e)
        return ll
    }

    // Sequential mode: For each test, call it and print pass
    mut ti := 0
    while ti < test_count {
        test_fn_name := "_test_" + i2s(ti)
        // 1-based index into test_names (0 is sentinel)
        test_label_idx := ti + 1

        // Print test name
        mut label_str_idx := 0
        if test_label_idx < ll.module.test_names.len() {
            label_text := ll.module.test_names[test_label_idx]
            label_str_idx = mod_find_string(ll.module, label_text)
        }

        // Call before fixture if it exists
        before_fn := mod_find_func(ll.module, "_before")
        if before_fn.name != "" {
            ll = _lemit(ll, new_inst(OpCall, 0, 0, 0, "_before", 0))
        }
        // Call the test function
        ll = _lemit(ll, new_inst(OpCall, 0, 0, 0, test_fn_name, 0))

        // Print "PASS: <test name>"
        // Add "PASS: " string
        mut pass_idx := mod_find_string(ll.module, "PASS: ")
        if pass_idx == 0 {
            new_mod := mod_add_string(ll.module, "PASS: ")
            pass_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        // Print "PASS: " + test name by concatenating
        pass_nt := _lnew_str_temp(ll)
        ll = pass_nt.l
        ll = _lemit(ll, new_inst(OpConstStr, pass_nt.temp, pass_idx, 6, "", 0))
        if label_str_idx > 0 {
            label_nt := _lnew_str_temp(ll)
            ll = label_nt.l
            label_text := ll.module.test_names[test_label_idx]
            ll = _lemit(ll, new_inst(OpConstStr, label_nt.temp, label_str_idx, label_text.len(), "", 0))
            concat_nt := _lnew_str_temp(ll)
            ll = concat_nt.l
            ll = _lemit(ll, new_inst(OpStrConcat, concat_nt.temp, pass_nt.temp, label_nt.temp, "", 0))
            ll = _lemit(ll, new_inst(OpCall, 0, concat_nt.temp, 2, "_aria_println_str", 0))
        } else {
            ll = _lemit(ll, new_inst(OpCall, 0, pass_nt.temp, 2, "_aria_println_str", 0))
        }
        // Call after fixture if it exists
        after_fn := mod_find_func(ll.module, "_after")
        if after_fn.name != "" {
            ll = _lemit(ll, new_inst(OpCall, 0, 0, 0, "_after", 0))
        }

        ti = ti + 1
    }

    // Print summary
    mut done_idx := mod_find_string(ll.module, "all tests passed")
    if done_idx == 0 {
        new_mod := mod_add_string(ll.module, "all tests passed")
        done_idx = new_mod.string_constants.len() - 1
        ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                     table: ll.table, file: ll.file, module: new_mod,
                     current_func: ll.current_func,
                     temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                     env_names: ll.env_names, env_slots: ll.env_slots,
                     loop_start: ll.loop_start, loop_end: ll.loop_end,
                     const_names: ll.const_names, const_vals: ll.const_vals,
                     const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                     temp_types: ll.temp_types, is_result: ll.is_result,
                     fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
    }
    done_nt := _lnew_str_temp(ll)
    ll = done_nt.l
    ll = _lemit(ll, new_inst(OpConstStr, done_nt.temp, done_idx, 16, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, done_nt.temp, 2, "_aria_println_str", 0))

    // Exit 0
    exit_nt := _lnew_temp(ll)
    ll = exit_nt.l
    ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))

    ll = _lfinish_func(ll)
    mut new_mod := mod_set_entry(ll.module, "_main")
    _lset_mod(ll, new_mod)
}

// Monomorphization pass: generate specialized copies of generic functions
fn _lower_mono_pass(l: Lowerer) -> Lowerer {
    mut ll := l
    mut mi := 1
    while mi < ll.registry.mono_specs.len() {
        spec := ll.registry.mono_specs[mi]
        generic_sig := reg_find_fn(ll.registry, spec.generic_name)
        if generic_sig.name != "" && fn_is_generic(generic_sig) {
            ll = _lset_pos(ll, generic_sig.token_start)
            ll = _lower_mono_fn(ll, spec)
        }
        mi = mi + 1
    }
    ll
}

// Lower a monomorphized copy of a generic function
fn _lower_mono_fn(l: Lowerer, spec: MonoSpec) -> Lowerer {
    mut ll := _ladv(l)  // skip fn
    if _lk(ll) != "IDENT" { return ll }
    ll = _ladv(ll)  // skip generic fn name

    // Skip generic params [T, U, ...]
    if _lk(ll) == "[" {
        mut d := 1
        ll = _ladv(ll)
        while d > 0 && _lk(ll) != "EOF" {
            if _lk(ll) == "[" { d = d + 1 }
            if _lk(ll) == "]" { d = d - 1 }
            if d > 0 { ll = _ladv(ll) }
        }
        if _lk(ll) == "]" { ll = _ladv(ll) }
    }

    // Look up the specialized FnSig
    sig := reg_find_fn(ll.registry, spec.specialized_name)
    if sig.name == "" {
        println("warning: unresolved generic specialization '" + spec.specialized_name + "' at " + ll.file + ":" + i2s(_lcur(ll).line))
        return ll
    }

    // Count actual register args
    mut actual_param_count := 0
    mut pi := 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            actual_param_count = actual_param_count + 2
        } else {
            actual_param_count = actual_param_count + 1
        }
        pi = pi + 1
    }

    // Start a new IR function with the specialized name
    ll = _lset_func(ll, new_ir_func(spec.specialized_name, actual_param_count, sig.return_type))

    // Track error type for Ok wrapping and ? operator (specialized E)
    mut mono_err_type := sig.error_type
    if mono_err_type == 0 && sig.return_type > 0 {
        mrt_info := store_get(ll.store, sig.return_type)
        if type_kind_name(mrt_info.kind) == "Result" {
            mono_err_type = mrt_info.type_id2
        }
    }
    if mono_err_type > 0 {
        ll = _lset_error_type(ll, mono_err_type)
    }

    // Allocate temps for parameters
    pi = 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                pt := sig.param_types[pi]
                if _is_str_array_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 13)
                } else if _is_trait_object_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 500)
                } else {
                    ll = _lset_type(ll, nt.temp, pt)
                }
            }
        }
        pi = pi + 1
    }

    // Skip past parameter declaration tokens to body
    // We need to skip: (params...) -> RetType
    if _lk(ll) == "(" {
        mut d := 1
        ll = _ladv(ll)
        while d > 0 && _lk(ll) != "EOF" {
            if _lk(ll) == "(" { d = d + 1 }
            if _lk(ll) == ")" { d = d - 1 }
            if d > 0 { ll = _ladv(ll) }
        }
        if _lk(ll) == ")" { ll = _ladv(ll) }
    }

    // Skip return type annotation. May include nested brackets like
    // `-> Pair[A, B]`, so we track bracket depth and also accept `,` when
    // inside them.
    if _lk(ll) == "->" {
        ll = _ladv(ll)
        mut rt_depth := 0
        mut keep := true
        while keep {
            rk := _lk(ll)
            if rk == "[" { rt_depth = rt_depth + 1; ll = _ladv(ll) }
            else if rk == "]" { rt_depth = rt_depth - 1; ll = _ladv(ll) }
            else if rk == "IDENT" || rk == "!" || rk == "?" { ll = _ladv(ll) }
            else if rk == "," && rt_depth > 0 { ll = _ladv(ll) }
            else { keep = false }
        }
    }

    // Skip error type
    if _lk(ll) == "!" {
        ll = _ladv(ll)
        while _lk(ll) == "IDENT" { ll = _ladv(ll) }
    }

    // Skip optional newline+indent before `where` (common formatting).
    ll = _lskip_nl(ll)
    // Skip where clause: where T: Trait + Trait2, U: Trait3
    if _lk(ll) == "where" {
        ll = _ladv(ll)  // skip where
        lb2 := "\{"
        // Allow the where clause to span multiple lines up to the body brace.
        while _lk(ll) != "=" && _lk(ll) != lb2 && _lk(ll) != "EOF" {
            ll = _ladv(ll)
        }
    }

    // Now lower the body
    lb := "\{"
    if _lk(ll) == "=" {
        ll = _ladv(ll)
        ll = _lskip_nl(ll)
        result := _lower_expr(ll)
        ll = result.l
        ll = _emit_defers(ll)
        ret_type := _lget_type(ll, result.temp)
        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
    } else if _lk(ll) == lb {
        ll = _lower_fn_body(ll, sig.return_type)
    } else {
        ll = _lskip_nl(ll)
        if _lk(ll) == lb {
            ll = _lower_fn_body(ll, sig.return_type)
        }
    }

    ll = _lfinish_func(ll)
    return ll
}
