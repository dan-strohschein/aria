                                mut n_spec_tid := _struct_type_id(ll.registry, n_cand)
                                if n_spec_tid == 0 {
                                    mut n_sp_fields := [FieldInfo{name: "", type_id: 0}]
                                    mut n_rfi := 1
                                    while n_rfi < n_sdef.fields.len() {
                                        n_decl_ft := n_sdef.fields[n_rfi].type_id
                                        mut n_chosen_ft := n_decl_ft
                                        if n_decl_ft > 0 && n_decl_ft < ll.store.types.len() {
                                            n_dk := type_kind_name(store_get(ll.store, n_decl_ft).kind)
                                            if n_dk == "TypeVar" { n_chosen_ft = type_arg }
                                            if n_dk == "Array" {
                                                n_inner := store_get(ll.store, n_decl_ft).type_id
                                                if n_inner > 0 && n_inner < ll.store.types.len() && type_kind_name(store_get(ll.store, n_inner).kind) == "TypeVar" {
                                                    new_arr := TypeInfo{kind: store_get(ll.store, n_decl_ft).kind, name: store_get(ll.store, n_decl_ft).name,
                                                                         type_id: type_arg, type_id2: 0, param_start: 0, param_count: 0}
