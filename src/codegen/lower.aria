                // Lower as regular struct literal with specialized name
                if _lk(ll) == lb {
                    return _lower_struct_lit(ll, spec_sname)
                }
            }
        }

        // Struct literal — only if name is a known struct type
        if _lk(ll) == lb {
            sdef := reg_find_struct(ll.registry, name)
            if sdef.name != "" {
                return _lower_struct_lit(ll, name)
            }
        }

        // None — Optional empty value, but only if no user sum type owns "None".
        // Allocate 2 slots (tag + payload) so structural equality can FieldGet
        // slot 1 without reading past the allocation.
        if name == "None" {
            vp := _variant_parent(ll.registry, "None")
            if vp.name == "" {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, 2, 0, "_Optional", 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                ll = _lset_type(ll, nt.temp, 201)
                return LT{l: ll, temp: nt.temp}
            }
        }

        // Variable reference
        slot := _lenv_lookup(ll, name)
        if slot >= 0 {
            src_type := _lget_type(ll, slot)
            if src_type == 12 {
                // String: copy both ptr (slot) and len (slot+1)
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpLoad, nt.temp, slot, 0, "", 0))
                ll = _lemit(ll, new_inst(OpLoad, nt.temp + 1, slot + 1, 0, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                return LT{l: ll, temp: nt.temp}
            } else {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpLoad, nt.temp, slot, 0, "", 0))
                if src_type != 0 {
                    ll = _lset_type(ll, nt.temp, src_type)
                }
                return LT{l: ll, temp: nt.temp}
            }
        }

        // Sum type variant — tag-only (data variants handled above in function call section)
        tag := _variant_tag(ll.registry, name)
        if tag > 0 {
            parent := _variant_parent(ll.registry, name)
            if sum_has_data(parent) {
                // Tag-only variant in a sum type that has data variants:
                // allocate struct with tag but no data
                alloc_sz := sum_alloc_size(parent)
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, parent.name, 0))
                st_id := _struct_type_id(ll.registry, parent.name)
                if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, tag, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                return LT{l: ll, temp: nt.temp}
            }
            // Pure tag-only sum type (no variant has data) — just emit tag constant
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpConst, nt.temp, tag, 0, "", 0))
            return LT{l: ll, temp: nt.temp}
        }

        // Const integer lookup
        if _lconst_has(ll, name) {
            cval := _lconst_lookup(ll, name)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpConst, nt.temp, cval, 0, "", 0))
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }

        // Const string lookup
        if _lconst_str_has(ll, name) {
            sval := _lconst_str_lookup(ll, name)
            // Float const sentinel — emit as f64 literal.
            if sval.len() > 7 && sval.substring(0, 7) == "$FLOAT:" {
                fval := sval.substring(7, sval.len())
                mut fstr_idx := mod_find_string(ll.module, fval)
                if fstr_idx == 0 {
                    new_mod := mod_add_string(ll.module, fval)
                    fstr_idx = new_mod.string_constants.len() - 1
                    ll = _lset_mod(ll, new_mod)
                }
                nt := _lnew_temp(ll)
                ll = _lemit(nt.l, new_inst(OpConstStr, nt.temp, fstr_idx, 0 - 9, "", 0))
                ll = _lset_type(ll, nt.temp, 9)
                return LT{l: ll, temp: nt.temp}
            }
            // Add to string constant pool
            mut str_idx := mod_find_string(ll.module, sval)
            if str_idx == 0 {
                new_mod := mod_add_string(ll.module, sval)
                str_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            nt := _lnew_str_temp(ll)
            ll = _lemit(nt.l, new_inst(OpConstStr, nt.temp, str_idx, sval.len(), "", 0))
            ll = _lset_type(ll, nt.temp, 12)
            return LT{l: ll, temp: nt.temp}
        }

        // Function reference (name resolves to a function, used as value)
        fsig := reg_find_fn(ll.registry, name)
        if fsig.name != "" {
            ll = _lset_reg(ll, reg_add_fn_value_ref(ll.registry, name))
            clos := _lnew_temp(ll)
            ll = clos.l
            ll = _lemit(ll, new_inst(OpAlloc, clos.temp, 2, 0, "_Closure", 0))
            fn_ref := _lnew_temp(ll)
            ll = fn_ref.l
            ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, "_tramp_" + name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, fn_ref.temp, 0, "_fn", 0))
            null_env := _lnew_temp(ll)
            ll = null_env.l
            ll = _lemit(ll, new_inst(OpConst, null_env.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, null_env.temp, 1, "_env", 0))
            return LT{l: ll, temp: clos.temp}
        }
        // Unknown identifier — return 0
        _warn_unresolved(ll, "identifier", name)
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if k == "(" {
        mut ll := _ladv(l)
        ll = _lskip_nl(ll)
        result := _lower_expr(ll)
        ll = result.l
        // Check for tuple: comma means tuple literal
        if _lk(ll) == "," {
            // Gather all elements + types first so we can allocate a tuple
            // with the correct total slot count (str = ptr + len = 2 slots).
            mut t_temps := [result.temp]
            mut t_types := [_lget_type(ll, result.temp)]
            while _lk(ll) == "," && _lk(ll) != "EOF" {
                ll = _ladv(ll)
                ll = _lskip_nl(ll)
                if _lk(ll) != ")" {
                    elem := _lower_expr(ll)
                    ll = elem.l
                    t_temps = t_temps.append(elem.temp)
                    t_types = t_types.append(_lget_type(ll, elem.temp))
                }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == ")" { ll = _ladv(ll) }
            mut total_slots := 0
            mut ci := 0
            while ci < t_types.len() {
                if t_types[ci] == 12 { total_slots = total_slots + 2 } else { total_slots = total_slots + 1 }
                ci = ci + 1
            }
            if total_slots < 1 { total_slots = 1 }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, total_slots, 0, "_Tuple", 0))
            mut slot := 0
            mut ei := 0
            mut ids_csv := ""
            while ei < t_temps.len() {
                et := t_types[ei]
                etemp := t_temps[ei]
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, etemp, slot, i2s(slot), 0))
                if et == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, etemp + 1, slot + 1, i2s(slot + 1), 0))
                    slot = slot + 2
                } else {
                    slot = slot + 1
                }
                if ei == 0 { ids_csv = i2s(et) } else { ids_csv = ids_csv + "," + i2s(et) }
                ei = ei + 1
            }
            // Register a tuple type so .N access knows element layout.
            sar := store_add_canonical(ll.store, mk_tuple_type(ids_csv, t_temps.len()))
            ll = _lset_store(ll, sar.store)
            ll = _lset_type(ll, nt.temp, sar.id)
            return LT{l: ll, temp: nt.temp}
        }
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        return LT{l: ll, temp: result.temp}
    }

    if k == "[" {
        mut ll := _ladv(l)
        ll = _lskip_nl(ll)
        // Empty array
        if _lk(ll) == "]" {
            ll = _ladv(ll)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpArrayNew, nt.temp, 0, 0, "", 0))
            return LT{l: ll, temp: nt.temp}
        }
        // Peek ahead for list comprehension: save position, skip expr, check for "for"
        mut is_listcomp := false
        mut peek_pos := ll.pos
        mut depth := 0
        while peek_pos < ll.tokens.len() {
            pk := ll.tokens[peek_pos].name
            if pk == "[" || pk == "(" { depth = depth + 1 }
            if pk == "]" {
                if depth == 0 { peek_pos = ll.tokens.len() } else { depth = depth - 1 }
            }
            if pk == ")" { if depth > 0 { depth = depth - 1 } }
            if pk == "for" && depth == 0 { is_listcomp = true }
            peek_pos = peek_pos + 1
        }
        if is_listcomp {
            // List comprehension: [expr for x in iter] or [expr for x in iter where cond]
            // Save the mapping expression start position (don't lower yet)
            map_expr_pos := ll.pos
            // Skip past the mapping expression to find "for"
            mut skip_depth := 0
            while _lk(ll) != "for" || skip_depth > 0 {
                sk := _lk(ll)
                if sk == "(" || sk == "[" { skip_depth = skip_depth + 1 }
                if sk == ")" || sk == "]" { if skip_depth > 0 { skip_depth = skip_depth - 1 } }
                if sk == "EOF" { return LT{l: ll, temp: 0} }
                ll = _ladv(ll)
            }
            ll = _ladv(ll)  // skip "for"
            mut lc_var := ""
            if _lk(ll) == "IDENT" {
                lc_var = _lcur(ll).text
                ll = _ladv(ll)
            }
            if _lk(ll) == "in" { ll = _ladv(ll) }
            // Lower iterator
            iter := _lower_expr(ll)
            ll = iter.l
            ll = _lskip_nl(ll)
            // Check for where/if filter
            mut has_where := false
            mut where_pos := 0
            if _lk(ll) == "where" || _lk(ll) == "if" {
                has_where = true
                ll = _ladv(ll)
                where_pos = ll.pos
                while _lk(ll) != "]" && _lk(ll) != "EOF" { ll = _ladv(ll) }
            }
            if _lk(ll) == "]" { ll = _ladv(ll) }
            end_pos := ll.pos
            // Result array
            arr_nt := _lnew_temp(ll)
            ll = arr_nt.l
            ll = _lemit(ll, new_inst(OpArrayNew, arr_nt.temp, 0, 0, "", 0))
            // Loop setup
            len_nt := _lnew_temp(ll)
            ll = len_nt.l
            ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, iter.temp, 0, "", 0))
            idx_nt := _lnew_temp(ll)
            ll = idx_nt.l
            ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
            loop_lbl := _lnew_label(ll)
            ll = loop_lbl.l
            end_lbl := _lnew_label(ll)
            ll = end_lbl.l
            ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
            cond_nt := _lnew_temp(ll)
            ll = cond_nt.l
            ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, len_nt.temp, "", 0))
            ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))
            // Load element and bind loop variable
            elem_nt := _lnew_temp(ll)
            ll = elem_nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
            if lc_var != "" { ll = _lenv_add(ll, lc_var, elem_nt.temp) }
            // Where filter (optional)
            if has_where {
                ll = _lset_pos(ll, where_pos)
                wcond := _lower_expr(ll)
                ll = wcond.l
                skip_lbl := _lnew_label(ll)
                ll = skip_lbl.l
                ll = _lemit(ll, new_inst(OpBranchFalse, 0, wcond.temp, skip_lbl.temp, "", 0))
                // Lower mapping expression inside the loop
                ll = _lset_pos(ll, map_expr_pos)
                mval := _lower_expr(ll)
                ll = mval.l
                ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, mval.temp, "", 0))
                ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
            } else {
                // Lower mapping expression inside the loop
                ll = _lset_pos(ll, map_expr_pos)
                mval := _lower_expr(ll)
                ll = mval.l
                ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, mval.temp, "", 0))
            }
            // Increment
            one_nt := _lnew_temp(ll)
            ll = one_nt.l
            ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
            inc_nt := _lnew_temp(ll)
            ll = inc_nt.l
            ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
            ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
            ll = _lset_pos(ll, end_pos)
            return LT{l: ll, temp: arr_nt.temp}
        }
        // Regular array literal
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpArrayNew, nt.temp, 0, 0, "", 0))
        mut arr_elem_tid := 0
        while _lk(ll) != "]" && _lk(ll) != "EOF" {
            ll = _lskip_nl(ll)
            elem := _lower_expr(ll)
            ll = elem.l
            elem_tid := _lget_type(ll, elem.temp)
            if elem_tid > 0 { arr_elem_tid = elem_tid }
            ll = _lemit(ll, new_inst(OpArrayAppend, nt.temp, nt.temp, elem.temp, "", elem_tid))
            ll = _lskip_nl(ll)
            if _lk(ll) == "," { ll = _ladv(ll) }
        }
        if _lk(ll) == "]" { ll = _ladv(ll) }
        // Track array type so for-loops and field accesses see the element type.
        // 13 is a sentinel for [str]; for other element types build/reuse a
        // store-based TyArray entry. Without this, `cases := [Struct{...}]` leaves
        // `cases` untyped, the for-loop can't resolve its element struct, and
        // `c.field` falls back to any-match — wrong when multiple structs share
        // a field name with different types.
        if arr_elem_tid == 12 {
            ll = _lset_type(ll, nt.temp, 13)
        } else if arr_elem_tid > 0 {
            arr_info := TypeInfo{kind: TyArray, name: "", type_id: arr_elem_tid, type_id2: 0, param_start: 0, param_count: 0}
            sar := store_add_canonical(ll.store, arr_info)
            ll = _lset_store(ll, sar.store)
            ll = _lset_type(ll, nt.temp, sar.id)
        }
        return LT{l: ll, temp: nt.temp}
    }

    // Keywords used as identifiers (before, after, where, scope, etc.)
    // The lexer tokenizes these as keywords, not IDENTs. Check the environment
    // to see if the token text matches a variable name.
    keyword_name := _lcur(l).text
    kw_slot := _lenv_lookup(l, keyword_name)
    if kw_slot >= 0 {
        mut ll := _ladv(l)
        kw_type := _lget_type(ll, kw_slot)
        if kw_type == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpLoad, nt.temp, kw_slot, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLoad, nt.temp + 1, kw_slot + 1, 0, "", 0))
            ll = _lset_type(ll, nt.temp, 12)
            return LT{l: ll, temp: nt.temp}
        }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpLoad, nt.temp, kw_slot, 0, "", 0))
        if kw_type != 0 { ll = _lset_type(ll, nt.temp, kw_type) }
        return LT{l: ll, temp: nt.temp}
    }

    // Default: unrecognized token in expression position — emit 0
    nt := _lnew_temp(l)
    mut ll := _ladv(nt.l)
    ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
    LT{l: ll, temp: nt.temp}
}

// --- Lower method call ---

// Lower type conversion: .to[Type]() or .trunc[Type]()
fn _lower_conversion(l: Lowerer, obj: i64, method: str, target: str) -> LT {
    mut ll := l
    obj_type := _lget_type(ll, obj)

    if method == "to" {
        // Checked conversion — returns Result
        if obj_type == 12 && target == "i64" {
            // String to int — call _aria_str_to_int, wrap in Result
            result_nt := _lnew_temp(ll)
            ll = result_nt.l
            extra := _lnew_temp(ll)
            ll = extra.l
            ll = _lemit(ll, new_inst(OpStrToInt, result_nt.temp, obj, 0, "", 0))
            // result_nt = parsed value, result_nt+1 = success flag
            // Build Result: if success, Ok(value), else Err(0)
            success_nt := _lnew_temp(ll)
            ll = success_nt.l
            ll = _lemit(ll, new_inst(OpLoad, success_nt.temp, result_nt.temp + 1, 0, "", 0))
            err_lbl := _lnew_label(ll)
            ll = err_lbl.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            end_lbl := _lnew_label(ll)
            ll = end_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, success_nt.temp, ok_lbl.temp, "", 0))
            // Err path: allocate Result with tag=1 and a proper error struct as payload
            err_res := _lnew_temp(ll)
            ll = err_res.l
            ll = _lemit(ll, new_inst(OpAlloc, err_res.temp, 2, 0, "_Result", 0))
            err_tag := _lnew_temp(ll)
            ll = err_tag.l
            ll = _lemit(ll, new_inst(OpConst, err_tag.temp, 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, err_res.temp, err_tag.temp, 0, "_tag", 0))
            // Allocate a minimal error struct so catch handlers can safely read _tag
            err_payload := _lnew_temp(ll)
            ll = err_payload.l
            ll = _lemit(ll, new_inst(OpAlloc, err_payload.temp, 2, 0, "_ConvError", 0))
            err_ptag := _lnew_temp(ll)
            ll = err_ptag.l
            ll = _lemit(ll, new_inst(OpConst, err_ptag.temp, 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, err_payload.temp, err_ptag.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, err_res.temp, err_payload.temp, 1, "_val", 0))
            final_nt := _lnew_temp(ll)
            ll = final_nt.l
            ll = _lemit(ll, new_inst(OpStore, final_nt.temp, err_res.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
            // Ok path: allocate Result with tag=0
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            ok_res := _lnew_temp(ll)
            ll = ok_res.l
            ll = _lemit(ll, new_inst(OpAlloc, ok_res.temp, 2, 0, "_Result", 0))
            ok_tag := _lnew_temp(ll)
            ll = ok_tag.l
            ll = _lemit(ll, new_inst(OpConst, ok_tag.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, ok_res.temp, ok_tag.temp, 0, "_tag", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, ok_res.temp, result_nt.temp, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpStore, final_nt.temp, ok_res.temp, 0, "", 0))
            // End
            ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
            ll = _lset_type(ll, final_nt.temp, 200)
            // Flag as Result so `?` / catch correctly unwrap. Without this,
            // `s.parse[i64]()?` treated the result as opaque and returned the
            // whole Result struct pointer instead of the parsed i64.
            ll = _lset_is_result(ll, final_nt.temp)
            return LT{l: ll, temp: final_nt.temp}
        }
        // String to float
        if obj_type == 12 && target == "f64" {
            fnt := _lnew_temp(ll)
            ll = fnt.l
            ll = _lemit(ll, new_inst(OpCall, fnt.temp, obj, 2, "_aria_str_to_float", 0))
            ll = _lset_type(ll, fnt.temp, 9)
            return LT{l: ll, temp: fnt.temp}
        }
        // Numeric to numeric checked — for MVP, just pass through (same i64 representation)
        return LT{l: ll, temp: obj}
    }

    if method == "trunc" {
        obj_type := _lget_type(ll, obj)
        // f64 → integer: emit a real fptosi truncation so the stored bits are
        // the integer value, not the original double's bit pattern.
        if obj_type == 9 && (target == "i64" || target == "i32" || target == "i16" || target == "i8") {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpFloatToInt, nt.temp, obj, 0, "", 0))
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }
        // Integer-to-integer truncation is a no-op in our i64-uniform IR.
        return LT{l: ll, temp: obj}
    }

    // Unknown conversion — pass through
    LT{l: ll, temp: obj}
}

fn _lower_method_call(l: Lowerer, obj: i64, method: str) -> LT {
    // Skip `(` only when actually at one. AST-pipe-dispatched 0-arg calls
    // (e.g. `arr |> reverse()`) may arrive with the cursor somewhere else
    // because the Call AST node's span offset isn't reliable.
    mut ll := l
    if _lk(ll) == "(" { ll = _ladv(ll) }
    ll = _lskip_nl(ll)

    // sqrt() — math square root (f64 → f64)
    if method == "sqrt" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_sqrt", 0))
        ll = _lset_type(ll, nt.temp, 9)  // f64
        return LT{l: ll, temp: nt.temp}
    }

    // abs() — absolute value
    if method == "abs" {
        while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        if _lk(ll) == ")" { ll = _ladv(ll) }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpCall, nt.temp, obj, 1, "_aria_abs", 0))
