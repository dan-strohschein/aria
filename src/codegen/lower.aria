                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                // Collect arg temps and types
                mut arg_temps := [0]
                mut arg_types := [0]
                mut param_idx := 1
                while _lk(ll) != ")" && _lk(ll) != "EOF" {
