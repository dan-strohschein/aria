                            mut ta_sp_ret := bm_sig.return_type
                            if ta_sp_ret > 0 && ta_sp_ret < ll.store.types.len() {
                                rti := store_get(ll.store, ta_sp_ret)
                                if type_kind_name(rti.kind) == "Named" {
                                    rbase := rti.name
                                    r_sdef := reg_find_struct(ll.registry, rbase)
                                    if r_sdef.name != "" && r_sdef.generic_count > 0 {
                                        cand := rbase + "_" + type_arg_name
                                        mut spec_tid := _struct_type_id(ll.registry, cand)
