                    mut tph_hint := ""
                    if _is_float_type(_lget_type(ll, arg.temp)) { tph_hint = "f64" }
                    ll = _lemit(ll, new_inst(OpIntToStr, vstr.temp, arg.temp, 0, tph_hint, 0))
                    cat := _lnew_str_temp(ll)
                    ll = cat.l
                    ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, prefix_res.temp, vstr.temp, "", 0))
                    pnt := _lnew_temp(ll)
                    ll = pnt.l
                    ll = _lemit(ll, new_inst(OpCall, pnt.temp, cat.temp, 2, "_aria_println_str", 0))
                }
                return LT{l: ll, temp: arg.temp}
            }
            if name == "assertEqual" {
                ll = _ladv(ll)
                arg_a := _lower_expr(ll)
