mod codegen

// ============================================================
// Lowering — Token Stream to IR
// Multi-pass token walker (mirrors checker pattern).
// Pass 1: Collect type layouts (struct sizes, field offsets)
// Pass 2: Collect function signatures
// Pass 3: Lower function/entry/test bodies to IR
// ============================================================

use diagnostic
use lexer
use parser
use resolver
use checker

// --- Lowerer state ---

struct Lowerer {
    tokens: [Token]
    pos: i64
    store: TypeStore
    registry: TypeRegistry
    treg: TraitRegistry
    pool: NodePool
    table: SymbolTable
    file: str
    module: IrModule
    current_func: IrFunc
    temp_counter: i64
    label_counter: i64
    env_names: [str]
    env_slots: [i64]
    loop_start: i64
    loop_end: i64
    // Const pre-scan arrays
    const_names: [str]
    const_vals: [i64]
    const_str_names: [str]
    const_str_vals: [str]
    // Type tracking per temp: 0=unknown, 1=i64, 12=str, 100+=struct
    temp_types: [i64]
    // Error type for current function (0 = not fallible)
    fn_error_type: i64
    // Defer tracking: token positions of deferred expressions (dynamic)
    defer_starts: [i64]
    defer_ends: [i64]
}

// --- Lowerer + temp result (like CE) ---

struct LT {
    l: Lowerer
    temp: i64
}

// --- Constructor ---

fn _new_lowerer(tokens: [Token], pool: NodePool, store: TypeStore, reg: TypeRegistry, treg: TraitRegistry, table: SymbolTable, file: str) -> Lowerer =
    Lowerer{
        tokens: tokens, pos: 0, store: store, registry: reg, treg: treg,
        pool: pool, table: table, file: file,
        module: new_ir_module(),
        current_func: _sentinel_func(),
        temp_counter: 0, label_counter: 0,
        env_names: [""], env_slots: [0],
        loop_start: -1, loop_end: -1,
        const_names: [""], const_vals: [0],
        const_str_names: [""], const_str_vals: [""],
        temp_types: [0],
        fn_error_type: 0, defer_starts: [0], defer_ends: [0]
    }

// --- Helpers ---

fn _lcur(l: Lowerer) -> Token {
    if l.pos >= l.tokens.len() {
        return Token{kind: TkEof, text: "", line: 0, col: 0, offset: 0, name: "EOF", file: ""}
    }
    return l.tokens[l.pos]
}


fn _lk(l: Lowerer) -> str = _lcur(l).name

fn _ladv(l: Lowerer) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos + 1, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

// Skip pub modifier, including optional (pkg) scope qualifier
fn _lskip_pub(l: Lowerer) -> Lowerer {
    mut ll := l
    if _lk(ll) == "pub" {
        ll = _ladv(ll)
        if _lk(ll) == "(" {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" { ll = _ladv(ll) }
            if _lk(ll) == ")" { ll = _ladv(ll) }
        }
    }
    ll
}

fn _lset_reg(l: Lowerer, reg: TypeRegistry) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: reg, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lset_store(l: Lowerer, store: TypeStore) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lset_pos(l: Lowerer, pos: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lskip_nl(l: Lowerer) -> Lowerer {
    mut ll := l
    while _lk(ll) == "NEWLINE" { ll = _ladv(ll) }
    ll
}

fn _lnew_temp(l: Lowerer) -> LT {
    temp := l.temp_counter
    ll := Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
                  table: l.table, file: l.file, module: l.module,
                  current_func: l.current_func,
                  temp_counter: l.temp_counter + 1, label_counter: l.label_counter,
                  env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
    // Default new temps to type=0 (unknown/potential pointer). The lowerer
    // explicitly sets type=1 (scalar) for known integers and type=12 (str)
    // for strings. Unknown temps are conservatively treated as GC roots.
    LT{l: ll, temp: temp}
}

fn _lnew_label(l: Lowerer) -> LT {
    lbl := l.label_counter
    ll := Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
                  table: l.table, file: l.file, module: l.module,
                  current_func: l.current_func,
                  temp_counter: l.temp_counter, label_counter: l.label_counter + 1,
                  env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
    LT{l: ll, temp: lbl}
}

fn _lemit(l: Lowerer, inst: IrInst) -> Lowerer {
    new_func := func_add_inst(l.current_func, inst)
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: new_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

fn _lset_func(l: Lowerer, f: IrFunc) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: f,
            temp_counter: 0, label_counter: 0,
            env_names: [""], env_slots: [0],
            loop_start: -1, loop_end: -1,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: [0],
            fn_error_type: 0, defer_starts: [0], defer_ends: [0]}

fn _lset_mod(l: Lowerer, m: IrModule) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: m,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lfinish_func(l: Lowerer) -> Lowerer {
    f0 := func_set_locals(l.current_func, l.temp_counter)
    f := func_set_temp_types(f0, l.temp_types)
    new_mod := mod_add_func(l.module, f)
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: new_mod,
            current_func: _sentinel_func(),
            temp_counter: 0, label_counter: l.label_counter,
            env_names: [""], env_slots: [0],
            loop_start: -1, loop_end: -1,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

fn _lset_loop(l: Lowerer, start: i64, end_l: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: start, loop_end: end_l,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lenv_add(l: Lowerer, name: str, slot: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names.append(name), env_slots: l.env_slots.append(slot),
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lenv_lookup(l: Lowerer, name: str) -> i64 {
    mut i := l.env_names.len() - 1
    while i > 0 {
        if l.env_names[i] == name { return l.env_slots[i] }
        i = i - 1
    }
    return -1
}

// Emit a warning for unresolved lookups during lowering (DRY: single warning format)
// Suppresses false positives for diagnostic codes (E0100, W0009)
fn _warn_unresolved(l: Lowerer, kind: str, name: str) {
    mut suppress := false
    if name.len() > 0 {
        ch := name.charAt(0)
        if ch == "E" || ch == "W" { suppress = true }
    }
    if suppress == false {
        println(l.file + ":" + i2s(_lcur(l).line) + ": warning: unresolved " + kind + " '" + name + "'")
    }
}

// --- Additional DRY helpers (SRP: each changes exactly one field group) ---

fn _lset_error_type(l: Lowerer, et: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: et, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _ladd_const(l: Lowerer, name: str, val: i64) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names.append(name), const_vals: l.const_vals.append(val),
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _ladd_const_str(l: Lowerer, name: str, val: str) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names.append(name), const_str_vals: l.const_str_vals.append(val),
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

fn _lenv_restore(l: Lowerer, names: [str], slots: [i64]) -> Lowerer =
    Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: names, env_slots: slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: l.temp_types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}

// Helper: allocate 2 consecutive temp slots for a string fat pointer (ptr + len)
fn _lnew_str_temp(l: Lowerer) -> LT {
    nt := _lnew_temp(l)
    nt2 := _lnew_temp(nt.l)
    LT{l: nt2.l, temp: nt.temp}
}

// --- Const lookup helpers ---

fn _lconst_lookup(l: Lowerer, name: str) -> i64 {
    mut i := 1
    while i < l.const_names.len() {
        if l.const_names[i] == name { return l.const_vals[i] }
        i = i + 1
    }
    return -9999999  // sentinel: not found
}

fn _lconst_str_lookup(l: Lowerer, name: str) -> str {
    mut i := 1
    while i < l.const_str_names.len() {
        if l.const_str_names[i] == name { return l.const_str_vals[i] }
        i = i + 1
    }
    return ""  // not found
}

fn _lconst_has(l: Lowerer, name: str) -> bool {
    mut i := 1
    while i < l.const_names.len() {
        if l.const_names[i] == name { return true }
        i = i + 1
    }
    return false
}

fn _lconst_str_has(l: Lowerer, name: str) -> bool {
    mut i := 1
    while i < l.const_str_names.len() {
        if l.const_str_names[i] == name { return true }
        i = i + 1
    }
    return false
}

// Get the element type of an array type. Returns the element's type_id, or 0 if unknown.
// For [str] (type 13 in lowerer), returns 12 (TY_STR).
// For store-based array types, looks up the element type in the store.
fn _array_elem_type(store: TypeStore, arr_type: i64) -> i64 {
    if arr_type == 13 { return 12 }
    if arr_type <= 16 { return 0 }
    info := store_get(store, arr_type)
    if type_kind_name(info.kind) == "Array" {
        return info.type_id
    }
    return 0
}

// Check if a type_id from the store represents [str] (array of strings)
fn _is_str_array_type(store: TypeStore, tid: i64) -> bool {
    info := store_get(store, tid)
    if type_kind_name(info.kind) == "Array" && info.type_id == 12 {
        return true
    }
    return false
}

fn _is_trait_object_type(store: TypeStore, tid: i64) -> bool {
    if tid <= 16 { return false }
    if tid >= store.types.len() { return false }
    info := store.types[tid]
    return type_kind_name(info.kind) == "TraitObject"
}

// Check if a type_id represents a named/struct type (not a builtin)
fn _is_named_type(store: TypeStore, tid: i64) -> bool {
    if tid >= TY_STRUCT_BASE { return true }
    if tid <= 16 { return false }
    info := store_get(store, tid)
    if type_kind_name(info.kind) == "Named" { return true }
    return false
}

// Get struct name for a type_id using the store + registry
// Handles both store-based type_ids (from checker) and registry-based 100+ ids (from lowerer)
// Generate field-by-field struct equality comparison.
// Sets result_temp to 1 if all fields equal, 0 otherwise.
fn _lower_struct_eq(l: Lowerer, a: i64, b: i64, sname: str, result_temp: i64) -> Lowerer {
    mut ll := l
    def := reg_find_struct(ll.registry, sname)
    if def.name == "" || def.fields.len() <= 1 {
        ll = _lemit(ll, new_inst(OpEq, result_temp, a, b, "", 0))
        return ll
    }

    // Compare each field, chain with AND into fresh temps
    mut last_cmp := -1
    mut fi := 1  // skip sentinel
    mut field_slot := 0
    while fi < def.fields.len() {
        fld := def.fields[fi]
        ft := fld.type_id

        if ft == 12 {
            a_str := _lnew_str_temp(ll)
            ll = a_str.l
            ll = _lemit(ll, new_inst(OpFieldGet, a_str.temp, a, field_slot, fld.name, 0))
            fidx_len := field_slot + 1
            ll = _lemit(ll, new_inst(OpFieldGet, a_str.temp + 1, a, fidx_len, fld.name, 0))
            b_str := _lnew_str_temp(ll)
            ll = b_str.l
            ll = _lemit(ll, new_inst(OpFieldGet, b_str.temp, b, field_slot, fld.name, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, b_str.temp + 1, b, fidx_len, fld.name, 0))
            cmp := _lnew_temp(ll)
            ll = cmp.l
            ll = _lemit(ll, new_inst(OpStrEq, cmp.temp, a_str.temp, b_str.temp, "", 0))
            if last_cmp >= 0 {
                and_nt := _lnew_temp(ll)
                ll = and_nt.l
                ll = _lemit(ll, new_inst(OpAnd, and_nt.temp, last_cmp, cmp.temp, "", 0))
                last_cmp = and_nt.temp
            } else {
                last_cmp = cmp.temp
            }
            field_slot = field_slot + 2
        } else {
            a_val := _lnew_temp(ll)
            ll = a_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, a_val.temp, a, field_slot, fld.name, 0))
            b_val := _lnew_temp(ll)
            ll = b_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, b_val.temp, b, field_slot, fld.name, 0))
            cmp := _lnew_temp(ll)
            ll = cmp.l
            ll = _lemit(ll, new_inst(OpEq, cmp.temp, a_val.temp, b_val.temp, "", 0))
            if last_cmp >= 0 {
                and_nt := _lnew_temp(ll)
                ll = and_nt.l
                ll = _lemit(ll, new_inst(OpAnd, and_nt.temp, last_cmp, cmp.temp, "", 0))
                last_cmp = and_nt.temp
            } else {
                last_cmp = cmp.temp
            }
            field_slot = field_slot + 1
        }
        fi = fi + 1
    }
    // Copy final result to result_temp
    if last_cmp >= 0 {
        ll = _lemit(ll, new_inst(OpStore, result_temp, last_cmp, 0, "", 0))
    } else {
        ll = _lemit(ll, new_inst(OpConst, result_temp, 1, 0, "", 0))
    }
    ll
}

// True when tid refers to an Option/Result — either the sentinel ids 200/201
// produced by Ok/Err/Some/None constructors, or a store-based TyOptional /
// TyResult type. Tags at slot 0 allow structural equality.
fn _is_option_or_result_type(store: TypeStore, tid: i64) -> bool {
    if tid == 200 || tid == 201 { return true }
    if tid <= 16 { return false }
    if tid >= store.types.len() { return false }
    info := store_get(store, tid)
    k := type_kind_name(info.kind)
    k == "Optional" || k == "Result"
}

// True when tid refers specifically to an Option type.
fn _is_option_type(store: TypeStore, tid: i64) -> bool {
    if tid == 201 { return true }
    if tid <= 16 { return false }
    if tid >= store.types.len() { return false }
    info := store_get(store, tid)
    type_kind_name(info.kind) == "Optional"
}

fn _is_struct_type(store: TypeStore, reg: TypeRegistry, tid: i64) -> bool {
    if tid >= TY_STRUCT_BASE { return true }
    if tid <= 16 { return false }
    info := store_get(store, tid)
    if type_kind_name(info.kind) == "Named" {
        def := reg_find_struct(reg, info.name)
        if def.name != "" && def.is_sum == false { return true }
    }
    false
}

fn _struct_name_for_type(store: TypeStore, reg: TypeRegistry, tid: i64) -> str {
    // Check registry-based struct types first
    if tid >= TY_STRUCT_BASE {
        return _struct_name_from_type(reg, tid)
    }
    // Check store-based type_ids
    if tid <= 16 { return "" }
    info := store_get(store, tid)
    if type_kind_name(info.kind) == "Named" {
        return info.name
    }
    return ""
}

// --- Type tracking helpers ---
// Type IDs: 0=unknown, 1-20=builtins, 21-99=store types, TY_STRUCT_BASE+=registry struct types

fn _lset_type(l: Lowerer, temp: i64, type_id: i64) -> Lowerer {
    if temp < 0 { return l }
    if temp > 50000 { return l }
    target := temp + 1
    cur_len := l.temp_types.len()
    // Fast path: target is in-bounds — mutate the underlying buffer in place via
    // _aria_array_set (lowered from `types[target] = type_id`). This requires that the
    // bootstrap compiler correctly lowers index assignment in helpers; gen0_c does not,
    // so this fast path was previously disabled. Now that gen2_speed can lower it, we
    // re-enable it. The Lowerer's reference is unchanged, so we can return l directly,
    // saving the 19-field struct rebuild on the common path.
    if target < cur_len {
        mut types := l.temp_types
        types[target] = type_id
        return l
    }
    // Common grow path: setting the type for a freshly created temp (target == old length).
    // Single amortized-O(1) append, then rebuild Lowerer.
    if target == cur_len {
        new_types := l.temp_types.append(type_id)
        return Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
                table: l.table, file: l.file, module: l.module,
                current_func: l.current_func,
                temp_counter: l.temp_counter, label_counter: l.label_counter,
                env_names: l.env_names, env_slots: l.env_slots,
                loop_start: l.loop_start, loop_end: l.loop_end,
                const_names: l.const_names, const_vals: l.const_vals,
                const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
                temp_types: new_types,
                fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
    }
    // Sparse grow path: target is beyond cur_len. Append zeros until target, then set.
    mut types := l.temp_types
    while types.len() <= target { types = types.append(0) }
    types[target] = type_id
    return Lowerer{tokens: l.tokens, pos: l.pos, store: l.store, registry: l.registry, treg: l.treg, pool: l.pool,
            table: l.table, file: l.file, module: l.module,
            current_func: l.current_func,
            temp_counter: l.temp_counter, label_counter: l.label_counter,
            env_names: l.env_names, env_slots: l.env_slots,
            loop_start: l.loop_start, loop_end: l.loop_end,
            const_names: l.const_names, const_vals: l.const_vals,
            const_str_names: l.const_str_names, const_str_vals: l.const_str_vals,
            temp_types: types,
            fn_error_type: l.fn_error_type, defer_starts: l.defer_starts, defer_ends: l.defer_ends}
}

fn _lget_type(l: Lowerer, temp: i64) -> i64 {
    idx := temp + 1
    if idx >= 0 && idx < l.temp_types.len() {
        return l.temp_types[idx]
    }
    return 0
}

// --- Op selection helpers (avoid mut reassignment of sum types) ---

fn _arith_op(k: str) -> IrOp {
    if k == "+" { return OpAdd }
    if k == "-" { return OpSub }
    if k == "*" { return OpMul }
    if k == "/" { return OpDiv }
    if k == "%" { return OpMod }
    return OpAdd
}

fn _cmp_op(k: str) -> IrOp {
    if k == "==" { return OpEq }
    if k == "!=" { return OpNeq }
    if k == "<" { return OpLt }
    if k == ">" { return OpGt }
    if k == "<=" { return OpLte }
    if k == ">=" { return OpGte }
    return OpEq
}

fn _unary_op(k: str) -> IrOp {
    if k == "!" { return OpNot }
    return OpNeg
}

fn _cmp_or_logic_op(k: str) -> IrOp {
    if k == "==" { return OpEq }
    if k == "!=" { return OpNeq }
    if k == "<" { return OpLt }
    if k == ">" { return OpGt }
    if k == "<=" { return OpLte }
    if k == ">=" { return OpGte }
    if k == "&&" { return OpAnd }
    if k == "||" { return OpOr }
    return OpEq
}

fn _is_float_type(t: i64) -> bool = t == 9

// Expression continuation check
fn _is_cont_l(k: str) -> bool =
    k == "+" || k == "-" || k == "*" || k == "/" || k == "%" ||
    k == "==" || k == "!=" || k == "<" || k == ">" || k == "<=" || k == ">=" ||
    k == "&&" || k == "||" || k == "&" || k == "|" || k == "^" ||
    k == "<<" || k == ">>" || k == "|>" ||
    k == "." || k == ".\{" || k == "(" || k == "[" || k == "?" || k == "!" ||
    k == "," || k == "=>"

// ============================================================
// Pass 1-2: Skip (reuse checker's TypeStore and TypeRegistry)
// ============================================================

// ============================================================
// Const pre-scan: collect const values before lowering bodies
// ============================================================

fn _scan_consts(l: Lowerer, index: DeclIndex) -> Lowerer {
    mut ll := l
    mut di := 1
    while di < decl_index_len(index) {
        decl := decl_index_get(index, di)
        kname := decl_kind_name(decl.kind)
        if kname == "const" {
            ll = _lset_pos(ll, decl.token_start)
            ll = _lskip_pub(ll)
            ll = _ladv(ll)  // skip const
            if _lk(ll) == "IDENT" {
                cname := _lcur(ll).text
                ll = _ladv(ll)  // skip name
                // Skip : TYPE if present
                if _lk(ll) == ":" {
                    ll = _ladv(ll)
                    ll = _skip_type_l(ll)
                }
                if _lk(ll) == "=" {
                    ll = _ladv(ll)
                    ll = _lskip_nl(ll)
                    if _lk(ll) == "INT" {
                        // Parse integer value
                        val_text := _lcur(ll).text
                        mut num := 0
                        mut ci := 0
                        mut neg := false
                        if val_text.len() > 0 && val_text.charAt(0) == "-" {
                            neg = true
                            ci = 1
                        }
                        while ci < val_text.len() {
                            ch := val_text.charAt(ci)
                            if ch != "_" {
                                mut digit := 0
                                if ch == "0" { digit = 0 } else if ch == "1" { digit = 1 } else if ch == "2" { digit = 2 } else if ch == "3" { digit = 3 } else if ch == "4" { digit = 4 } else if ch == "5" { digit = 5 } else if ch == "6" { digit = 6 } else if ch == "7" { digit = 7 } else if ch == "8" { digit = 8 } else if ch == "9" { digit = 9 }
                                num = num * 10 + digit
                            }
                            ci = ci + 1
                        }
                        if neg { num = 0 - num }
                        ll = _ladd_const(ll, cname, num)
                        ll = _ladv(ll)
                    } else if _lk(ll) == "STRING" {
                        sval := _lcur(ll).text
                        ll = _ladd_const_str(ll, cname, sval)
                        ll = _ladv(ll)
                    } else if _lk(ll) == "FLOAT" {
                        // Track as a const-string with a "$FLOAT:" sentinel so
                        // lookup sites can emit the literal text as an f64.
                        fval := _lcur(ll).text
                        ll = _ladd_const_str(ll, cname, "$FLOAT:" + fval)
                        ll = _ladv(ll)
                    } else if _lk(ll) == "-" {
                        // Negative int: - INT
                        ll = _ladv(ll)
                        if _lk(ll) == "INT" {
                            val_text := _lcur(ll).text
                            mut num := 0
                            mut ci := 0
                            while ci < val_text.len() {
                                ch := val_text.charAt(ci)
                                if ch != "_" {
                                    mut digit := 0
                                    if ch == "0" { digit = 0 } else if ch == "1" { digit = 1 } else if ch == "2" { digit = 2 } else if ch == "3" { digit = 3 } else if ch == "4" { digit = 4 } else if ch == "5" { digit = 5 } else if ch == "6" { digit = 6 } else if ch == "7" { digit = 7 } else if ch == "8" { digit = 8 } else if ch == "9" { digit = 9 }
                                    num = num * 10 + digit
                                }
                                ci = ci + 1
                            }
                            num = 0 - num
                            ll = Lowerer{tokens: ll.tokens, pos: ll.pos, store: ll.store, registry: ll.registry, treg: ll.treg, pool: ll.pool,
                                         table: ll.table, file: ll.file, module: ll.module,
                                         current_func: ll.current_func,
                                         temp_counter: ll.temp_counter, label_counter: ll.label_counter,
                                         env_names: ll.env_names, env_slots: ll.env_slots,
                                         loop_start: ll.loop_start, loop_end: ll.loop_end,
                                         const_names: ll.const_names.append(cname), const_vals: ll.const_vals.append(num),
                                         const_str_names: ll.const_str_names, const_str_vals: ll.const_str_vals,
                                         temp_types: ll.temp_types,
            fn_error_type: ll.fn_error_type, defer_starts: ll.defer_starts, defer_ends: ll.defer_ends}
                            ll = _ladv(ll)
                        }
                    }
                }
            }
        }
        di = di + 1
    }
    ll
}

// ============================================================
// Pass 3: Lower function/entry/test bodies
// ============================================================

fn _lower_bodies(l: Lowerer, index: DeclIndex) -> Lowerer {
    mut ll := l
    mut di := 1
    while di < decl_index_len(index) {
        decl := decl_index_get(index, di)
        kname := decl_kind_name(decl.kind)

        // Position to the token_start of this declaration
        ll = _lset_pos(ll, decl.token_start)

        // Skip pub keyword if present
        ll = _lskip_pub(ll)

        // Skip annotations
        if _lk(ll) == "@" {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" { ll = _ladv(ll) }
            if _lk(ll) == "(" {
                ll = _ladv(ll)
                while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == ")" { ll = _ladv(ll) }
            }
            ll = _lskip_nl(ll)
        }

        k := _lk(ll)
        if kname == "fn" && k == "fn" {
            // Check for extern fn (name starts with _extern)
            if decl.name == "_extern" {
                ll = _lower_extern(ll)
            } else if decl.name.startsWith("_fixture:") {
                // before/after fixture — pass the actual keyword to _lower_fixture
                ll = _lower_fixture(ll, _lk(ll))
            } else {
                ll = _lower_fn_d(ll, decl)
            }
        } else if kname == "entry" {
            ll = _lower_entry_ast(ll, decl)
        } else if kname == "test" {
            if decl.name.startsWith("_bench:") {
                ll = _lower_bench(ll)
            } else {
                ll = _lower_test(ll)
            }
        } else if kname == "impl" {
            ll = _lower_impl_d(ll, decl)
        } else {
            // type, enum, trait, const, use — skip (already handled by checker/const scan)
            ll = _lset_pos(ll, decl.body_end)
        }
        di = di + 1
    }
    ll
}

// Like _lower_bodies but skips entry blocks (for test mode)
fn _lower_bodies_skip_entry(l: Lowerer, index: DeclIndex) -> Lowerer {
    mut ll := l
    mut di := 1
    while di < decl_index_len(index) {
        decl := decl_index_get(index, di)
        kname := decl_kind_name(decl.kind)
        ll = _lset_pos(ll, decl.token_start)
        ll = _lskip_pub(ll)
        if _lk(ll) == "@" {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" { ll = _ladv(ll) }
            if _lk(ll) == "(" {
                ll = _ladv(ll)
                while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == ")" { ll = _ladv(ll) }
            }
            ll = _lskip_nl(ll)
        }
        k := _lk(ll)
        if kname == "fn" && k == "fn" {
            if decl.name == "_extern" {
                ll = _lower_extern(ll)
            } else if decl.name.startsWith("_fixture:") {
                ll = _lower_fixture(ll, _lk(ll))
            } else {
                ll = _lower_fn_d(ll, decl)
            }
        } else if kname == "entry" {
            // Skip entry blocks in test mode — test runner generates _main
            ll = _lset_pos(ll, decl.body_end)
        } else if kname == "test" {
            if decl.name.startsWith("_bench:") {
                ll = _lower_bench(ll)
            } else {
                ll = _lower_test(ll)
            }
        } else if kname == "impl" {
            ll = _lower_impl_d(ll, decl)
        } else {
            ll = _lset_pos(ll, decl.body_end)
        }
        di = di + 1
    }
    ll
}

fn _skip_to_next_l(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)
    lb := "\{"
    rb := "\}"
    while _lk(ll) != "EOF" {
        if _lk(ll) == lb {
            mut d := 1
            ll = _ladv(ll)
            while d > 0 && _lk(ll) != "EOF" {
                if _lk(ll) == lb { d = d + 1 }
                if _lk(ll) == rb { d = d - 1 }
                if d > 0 { ll = _ladv(ll) }
            }
            if _lk(ll) == rb { ll = _ladv(ll) }
            return ll
        }
        if _lk(ll) == "NEWLINE" {
            ll = _lskip_nl(ll)
            nk := _lk(ll)
            if nk == "fn" || nk == "pub" || nk == "type" || nk == "struct" ||
               nk == "enum" || nk == "trait" || nk == "impl" || nk == "const" ||
               nk == "entry" || nk == "test" || nk == "EOF" {
                return ll
            }
        }
        ll = _ladv(ll)
    }
    ll
}

// --- Lower function ---

// DeclInfo-aware fn lowering — jumps directly to body_start
fn _lower_fn_d(l: Lowerer, decl: DeclInfo) -> Lowerer {
    name := decl.name
    mut ll := l

    sig := reg_find_fn(ll.registry, name)
    if sig.name == "" { return _lset_pos(ll, decl.body_end) }

    // Skip generic function bodies — they are lowered via monomorphization
    if fn_is_generic(sig) { return _lset_pos(ll, decl.body_end) }

    // Count actual register args (strings take 2 regs each)
    mut actual_param_count := 0
    mut pi := 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            actual_param_count = actual_param_count + 2
        } else {
            actual_param_count = actual_param_count + 1
        }
        pi = pi + 1
    }

    // Start a new IR function with actual register arg count
    ll = _lset_func(ll, new_ir_func(name, actual_param_count, sig.return_type))

    // Track error type for Ok wrapping and ? operator
    if sig.error_type > 0 {
        ll = _lset_error_type(ll, sig.error_type)
    }

    // Allocate temps for parameters
    pi = 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                pt := sig.param_types[pi]
                if _is_str_array_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 13)
                } else if _is_trait_object_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 500)
                } else {
                    ll = _lset_type(ll, nt.temp, pt)
                }
            }
        }
        pi = pi + 1
    }

    // Position token cursor to function body (needed for string interpolation fallback)
    ll = _lset_pos(ll, decl.body_start)
    // Try AST path if FnDecl has body in pool
    if decl.node_idx > 0 {
        fn_node := pool_get(ll.pool, decl.node_idx)
        if fn_node.c0 > 0 {
            return _lower_fn_body_ast(ll, fn_node.c0, sig)
        }
    }
    // Legacy: token-walking path
    _lower_fn_body_d(ll, sig)
}

// Shared body-lowering logic for _lower_fn_d — dispatches to = expr or { block } forms
fn _lower_fn_body_d(l: Lowerer, sig: FnSig) -> Lowerer {
    mut ll := l
    lb := "\{"

    if _lk(ll) == "=" {
        ll = _ladv(ll)
        ll = _lskip_nl(ll)
        result := _lower_expr(ll)
        ll = result.l
        ll = _emit_defers(ll)
        if ll.fn_error_type > 0 && _lget_type(ll, result.temp) != 200 {
            ret_type := _lget_type(ll, result.temp)
            mut ok_slots := 2
            if ret_type == 12 { ok_slots = 3 }
            ok_nt := _lnew_temp(ll)
            ll = ok_nt.l
            ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
            if ret_type == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
                val_len := result.temp + 1
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
            }
            ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
        } else {
            ret_type := _lget_type(ll, result.temp)
            ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
        }
        ll = _lfinish_func(ll)
    } else if _lk(ll) == lb {
        ll = _lower_fn_body(ll, sig.return_type)
        ll = _lfinish_func(ll)
    } else {
        ll = _lskip_nl(ll)
        if _lk(ll) == lb {
            ll = _lower_fn_body(ll, sig.return_type)
            ll = _lfinish_func(ll)
        } else {
            ll = _lfinish_func(ll)
        }
    }
    ll
}

// ============================================================
// AST-Walking Expression Lowerer
// Replaces token-walking for expression lowering.
// Uses AST nodes from the parser's NodePool.
// ============================================================

// Find token position whose offset >= the given source offset.
// Searches from position 0 to handle AST iteration where statement
// order may not match token stream advancement.
fn _find_tok_pos(l: Lowerer, offset: i64) -> i64 {
    // First try forward from current position (common case)
    mut p := l.pos
    if p < l.tokens.len() && l.tokens[p].offset <= offset {
        while p < l.tokens.len() {
            if l.tokens[p].offset >= offset { return p }
            p = p + 1
        }
    }
    // Search from beginning for backward references
    p = 0
    while p < l.tokens.len() {
        if l.tokens[p].offset >= offset { return p }
        p = p + 1
    }
    p
}

// Find the leftmost token offset of an expression (for positioning token stream)
fn _expr_start_offset(pool: NodePool, idx: i64) -> i64 {
    if idx <= 0 { return 0 }
    node := pool_get(pool, idx)
    nk := expr_kind_name(node.kind)
    // For binary/assign/pipeline, the leftmost token is in c0 (left operand)
    if nk == "Binary" || nk == "Pipeline" || nk == "Range" || nk == "Assign" {
        return _expr_start_offset(pool, node.c0)
    }
    if nk == "Unary" || nk == "Propagate" || nk == "AssertOk" {
        return _expr_start_offset(pool, node.c0)
    }
    // For Call, the leftmost token is the callee
    if nk == "Call" {
        return _expr_start_offset(pool, node.c0)
    }
    // For MethodCall/FieldAccess/Index, the leftmost is the receiver
    if nk == "MethodCall" || nk == "FieldAccess" || nk == "Index" {
        return _expr_start_offset(pool, node.c0)
    }
    // For Catch, the leftmost is the expression being caught
    if nk == "Catch" {
        return _expr_start_offset(pool, node.c0)
    }
    // For leaf nodes, the span points to the token itself
    node.span.offset
}

// Lower function body from AST node (called when FnDecl.c0 > 0)
fn _lower_fn_body_ast(l: Lowerer, body_idx: i64, sig: FnSig) -> Lowerer {
    mut ll := l
    body := pool_get(ll.pool, body_idx)
    nk := expr_kind_name(body.kind)

    if nk == "Block" {
        // Block body { ... } — iterate children, track last expression for implicit return
        result := _lower_block_node_result(ll, body)
        ll = result.l
        last_temp := result.temp
        if last_temp >= 0 {
            inst_count := ll.current_func.insts.len()
            mut already_returned := false
            if inst_count > 1 {
                last_op := ir_op_name(ll.current_func.insts[inst_count - 1].op)
                if last_op == "Ret" || last_op == "RetVoid" { already_returned = true }
            }
            if already_returned == false {
                ll = _emit_defers(ll)
                if ll.fn_error_type > 0 && _lget_type(ll, last_temp) != 200 {
                    ret_type := _lget_type(ll, last_temp)
                    mut ok_slots := 2
                    if ret_type == 12 { ok_slots = 3 }
                    ok_nt := _lnew_temp(ll)
                    ll = ok_nt.l
                    ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
                    tag_nt := _lnew_temp(ll)
                    ll = tag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
                    if ret_type == 12 {
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, last_temp, 1, "_val", 0))
                        val_len := last_temp + 1
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
                    } else {
                        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, last_temp, 1, "_val", 0))
                    }
                    ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
                } else {
                    ret_type := _lget_type(ll, last_temp)
                    ll = _lemit(ll, new_inst(OpRet, 0, last_temp, 0, "", ret_type))
                }
            }
        }
    } else {
        // Expression body (= expr form)
        result := _lower_expr_node(ll, body_idx)
        ll = result.l
        ll = _emit_defers(ll)
        if ll.fn_error_type > 0 && _lget_type(ll, result.temp) != 200 {
            ret_type := _lget_type(ll, result.temp)
            mut ok_slots := 2
            if ret_type == 12 { ok_slots = 3 }
            ok_nt := _lnew_temp(ll)
            ll = ok_nt.l
            ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
            if ret_type == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
                val_len := result.temp + 1
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
            }
            ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
        } else {
            ret_type := _lget_type(ll, result.temp)
            ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
        }
    }
    ll = _lfinish_func(ll)
    ll
}

// Lower a block node, returning the last expression's temp.
// Uses token-walking for each statement since the parser doesn't capture
// compound assignments (+=, -=, etc.) or `or`/`must` in the AST.
fn _lower_block_node_result(l: Lowerer, node: Expr) -> LT {
    mut ll := l
    scope_start := ll.env_names.len()
    mut last_temp := -1
    mut si := 0
    while si < node.list_count {
        idx_node := pool_get(ll.pool, node.list_start + si)
        child := pool_get(ll.pool, idx_node.c0)
        // Dispatch ALL statements via AST path — token-walking is unreliable
        // because _find_tok_pos returns wrong positions in multi-file compiled binaries.
        child_kind := expr_kind_name(child.kind)
        is_last := si == node.list_count - 1
        // Position to statement tokens (needed for token-walking fallbacks in sub-dispatchers)
        tp := _find_tok_pos(ll, _expr_start_offset(ll.pool, idx_node.c0))
        ll = _lset_pos(ll, tp)

        if child_kind == "Return" {
            if child.b1 {
                r := _lower_expr_node(ll, child.c0)
                ll = r.l
                ll = _emit_defers(ll)
                ret_type := _lget_type(ll, r.temp)
                ll = _lemit(ll, new_inst(OpRet, 0, r.temp, 0, "", ret_type))
            } else {
                ll = _emit_defers(ll)
                ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
            }
            last_temp = -1
        } else if is_last {
            r := _lower_expr_node(ll, idx_node.c0)
            ll = r.l
            last_temp = r.temp
        } else {
            r := _lower_expr_node(ll, idx_node.c0)
            ll = r.l
        }
        ll = _lskip_nl(ll)
        si = si + 1
    }
    ll = _emit_drops_scoped(ll, scope_start)
    LT{l: ll, temp: last_temp}
}

// Main AST expression dispatcher
fn _lower_expr_node(l: Lowerer, idx: i64) -> LT {
    if idx <= 0 { return LT{l: l, temp: -1} }
    node := pool_get(l.pool, idx)
    nk := expr_kind_name(node.kind)
    mut ll := l

    // --- Literals ---

    if nk == "IntLit" {
        num := _parse_int_literal(node.s1)
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConst, nt.temp, num, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if nk == "FloatLit" {
        val := node.s1
        mut str_idx := mod_find_string(ll.module, val)
        if str_idx == 0 {
            new_mod := mod_add_string(ll.module, val)
            str_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConstStr, nt.temp, str_idx, 0 - 9, "", 0))
        ll = _lset_type(ll, nt.temp, 9)
        return LT{l: ll, temp: nt.temp}
    }

    if nk == "StringLit" {
        val := node.s1
        // Empty s1 with c0 > 0 indicates interpolated string — c0 is the STRING_START token index
        if val.len() == 0 && node.c0 > 0 {
            found_pos := node.c0
            if found_pos < ll.tokens.len() && ll.tokens[found_pos].name == "STRING_START" {
                ll = _lset_pos(ll, found_pos)
                return _lower_interpolated_string(ll)
            }
        }
        // Non-interpolated or actual empty string
        return _lower_string_const(ll, val)
    }

    if nk == "BoolLit" {
        nt := _lnew_temp(ll)
        ll = nt.l
        mut bval := 0
        if node.b1 { bval = 1 }
        ll = _lemit(ll, new_inst(OpConst, nt.temp, bval, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if nk == "None" {
        // None — allocate Optional with tag=0
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpAlloc, nt.temp, 2, 0, "_Optional", 0))
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
        ll = _lset_type(ll, nt.temp, 201)
        return LT{l: ll, temp: nt.temp}
    }

    // --- Ident ---

    if nk == "Ident" {
        name := node.s1
        // Check environment (local variables, params)
        slot := _lenv_lookup(ll, name)
        if slot >= 0 {
            src_type := _lget_type(ll, slot)
            if src_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpLoad, nt.temp, slot, 0, "", 0))
                slot_len := slot + 1
                nt_len := nt.temp + 1
                ll = _lemit(ll, new_inst(OpLoad, nt_len, slot_len, 0, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                return LT{l: ll, temp: nt.temp}
            }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpLoad, nt.temp, slot, 0, "", 0))
            if src_type != 0 { ll = _lset_type(ll, nt.temp, src_type) }
            return LT{l: ll, temp: nt.temp}
        }
        // Check integer constants
        cv := _lconst_lookup(ll, name)
        if cv != 0 - 9999999 {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpConst, nt.temp, cv, 0, "", 0))
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }
        // Check string constants
        csv := _lconst_str_lookup(ll, name)
        if csv.len() > 0 {
            return _lower_string_const(ll, csv)
        }
        // Option `None` (built-in): allocate a 2-slot Optional so downstream
        // field access (e.g. equality vs `Some(x)`) has a valid payload slot.
        if name == "None" {
            vp0 := _variant_parent(ll.registry, "None")
            if vp0.name == "" {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, 2, 0, "_Optional", 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                ll = _lset_type(ll, nt.temp, 201)
                return LT{l: ll, temp: nt.temp}
            }
        }
        // Check for variant (tag-only sum type)
        vtag := _variant_tag(ll.registry, name)
        if vtag >= 0 {
            vparent := _variant_parent(ll.registry, name)
            if sum_has_data(vparent) {
                // Data sum type variant — allocate struct with tag
                alloc_sz := sum_alloc_size(vparent)
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, vparent.name, 0))
                st_id := _struct_type_id(ll.registry, vparent.name)
                if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
                vtag_nt := _lnew_temp(ll)
                ll = vtag_nt.l
                ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, vtag_nt.temp, 0, "_tag", 0))
                return LT{l: ll, temp: nt.temp}
            }
            // Tag-only variant
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpConst, nt.temp, vtag, 0, "", 0))
            return LT{l: ll, temp: nt.temp}
        }
        // Check if name refers to a function — emit fn-as-value fat pointer
        fsig := reg_find_fn(ll.registry, name)
        if fsig.name != "" {
            // Register this fn as a value reference (dedup in registry)
            ll = _lset_reg(ll, reg_add_fn_value_ref(ll.registry, name))
            // Build closure fat pointer: {trampoline_fn_ptr, null_env}
            clos := _lnew_temp(ll)
            ll = clos.l
            ll = _lemit(ll, new_inst(OpAlloc, clos.temp, 2, 0, "_Closure", 0))
            fn_ref := _lnew_temp(ll)
            ll = fn_ref.l
            ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, "_tramp_" + name, 0))
            ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, fn_ref.temp, 0, "_fn", 0))
            null_env := _lnew_temp(ll)
            ll = null_env.l
            ll = _lemit(ll, new_inst(OpConst, null_env.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, null_env.temp, 1, "_env", 0))
            return LT{l: ll, temp: clos.temp}
        }
        // Unknown ident — return dummy temp
        nt := _lnew_temp(ll)
        ll = nt.l
        return LT{l: ll, temp: nt.temp}
    }

    // --- Unary ---

    if nk == "Unary" {
        operand := _lower_expr_node(ll, node.c0)
        ll = operand.l
        nt := _lnew_temp(ll)
        ll = nt.l
        op_type := _lget_type(ll, operand.temp)
        if node.s1 == "-" && _is_float_type(op_type) {
            ll = _lemit(ll, new_inst(OpNeg, nt.temp, operand.temp, 0, "f64", 0))
            ll = _lset_type(ll, nt.temp, 9)
        } else {
            ll = _lemit(ll, new_inst(_unary_op(node.s1), nt.temp, operand.temp, 0, "", 0))
        }
        return LT{l: ll, temp: nt.temp}
    }

    // --- Binary ---

    if nk == "Binary" {
        op := node.s1

        // `or default` — unwrap Result, use default on Err
        if op == "or" {
            left_lt := _lower_expr_node(ll, node.c0)
            ll = left_lt.l
            default_lt := _lower_expr_node(ll, node.c1)
            ll = default_lt.l
            // Extract tag (slot 0)
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, left_lt.temp, 0, "_tag", 0))
            const_one := _lnew_temp(ll)
            ll = const_one.l
            ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
            is_err := _lnew_temp(ll)
            ll = is_err.l
            ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
            or_err_lbl := _lnew_label(ll)
            ll = or_err_lbl.l
            or_end_lbl := _lnew_label(ll)
            ll = or_end_lbl.l
            final_nt := _lnew_temp(ll)
            ll = final_nt.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, or_err_lbl.temp, "", 0))
            // Ok path: unwrap value from slot 1
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left_lt.temp, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpStore, final_nt.temp, ok_val.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, or_end_lbl.temp, 0, "", 0))
            // Err path: use default
            ll = _lemit(ll, new_inst(OpLabel, 0, or_err_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpStore, final_nt.temp, default_lt.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, or_end_lbl.temp, 0, "", 0))
            return LT{l: ll, temp: final_nt.temp}
        }

        // `must "msg"` — unwrap or panic with message
        if op == "must" {
            left_lt := _lower_expr_node(ll, node.c0)
            ll = left_lt.l
            msg_lt := _lower_expr_node(ll, node.c1)
            ll = msg_lt.l
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, left_lt.temp, 0, "_tag", 0))
            const_one := _lnew_temp(ll)
            ll = const_one.l
            ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
            is_err := _lnew_temp(ll)
            ll = is_err.l
            ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
            panic_lbl := _lnew_label(ll)
            ll = panic_lbl.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, panic_lbl.temp, "", 0))
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left_lt.temp, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, panic_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpCall, 0, msg_lt.temp, 2, "_aria_panic", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            return LT{l: ll, temp: ok_val.temp}
        }


        // Binding: x := expr
        if op == ":=" {
            lhs := pool_get(ll.pool, node.c0)
            result := _lower_expr_node(ll, node.c1)
            ll = result.l
            if expr_kind_name(lhs.kind) == "Ident" {
                ll = _lenv_add(ll, lhs.s1, result.temp)
            }
            return LT{l: ll, temp: result.temp}
        }

        // Assignment: lhs = rhs
        if op == "=" {
            return _lower_assign_node(ll, node)
        }

        // Compound assignment: +=, -=, *=, /=, %=
        if op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" {
            lhs := pool_get(ll.pool, node.c0)
            right := _lower_expr_node(ll, node.c1)
            ll = right.l
            if expr_kind_name(lhs.kind) == "Ident" {
                slot := _lenv_lookup(ll, lhs.s1)
                if slot >= 0 {
                    cur := _lnew_temp(ll)
                    ll = cur.l
                    ll = _lemit(ll, new_inst(OpLoad, cur.temp, slot, 0, "", 0))
                    res := _lnew_temp(ll)
                    ll = res.l
                    // Extract the arithmetic operator from compound (e.g., "+" from "+=")
                    mut arith_str := "+"
                    if op == "-=" { arith_str = "-" }
                    if op == "*=" { arith_str = "*" }
                    if op == "/=" { arith_str = "/" }
                    if op == "%=" { arith_str = "%" }
                    left_type := _lget_type(ll, slot)
                    if _is_float_type(left_type) || _is_float_type(_lget_type(ll, right.temp)) {
                        ll = _lemit(ll, new_inst(_arith_op(arith_str), res.temp, cur.temp, right.temp, "f64", 0))
                        ll = _lset_type(ll, res.temp, 9)
                    } else {
                        ll = _lemit(ll, new_inst(_arith_op(arith_str), res.temp, cur.temp, right.temp, "", 0))
                    }
                    ll = _lemit(ll, new_inst(OpStore, slot, res.temp, 0, "", 0))
                    return LT{l: ll, temp: res.temp}
                }
            }
            return LT{l: ll, temp: -1}
        }

        // Arithmetic and comparison
        left := _lower_expr_node(ll, node.c0)
        ll = left.l
        right := _lower_expr_node(ll, node.c1)
        ll = right.l
        left_type := _lget_type(ll, left.temp)
        right_type := _lget_type(ll, right.temp)

        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            if op == "+" && left_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpStrConcat, nt.temp, left.temp, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                return LT{l: ll, temp: nt.temp}
            }
            if _is_float_type(left_type) || _is_float_type(right_type) {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(op), nt.temp, left.temp, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
                return LT{l: ll, temp: nt.temp}
            }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(_arith_op(op), nt.temp, left.temp, right.temp, "", 0))
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }

        if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
            nt := _lnew_temp(ll)
            ll = nt.l
            if (op == "==" || op == "!=") && left_type == 12 {
                ll = _lemit(ll, new_inst(OpStrEq, nt.temp, left.temp, right.temp, "", 0))
                if op == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    ll = _lset_type(ll, not_nt.temp, 1)
                    return LT{l: ll, temp: not_nt.temp}
                }
                ll = _lset_type(ll, nt.temp, 1)
                return LT{l: ll, temp: nt.temp}
            }
            if (op == "==" || op == "!=") && _is_struct_type(ll.store, ll.registry, left_type) {
                sname := _struct_name_for_type(ll.store, ll.registry, left_type)
                if sname != "" {
                    eq_result := _lower_struct_eq(ll, left.temp, right.temp, sname, nt.temp)
                    ll = eq_result
                    if op == "!=" {
                        not_nt := _lnew_temp(ll)
                        ll = not_nt.l
                        ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                        ll = _lset_type(ll, not_nt.temp, 1)
                        return LT{l: ll, temp: not_nt.temp}
                    }
                    ll = _lset_type(ll, nt.temp, 1)
                    return LT{l: ll, temp: nt.temp}
                }
            }
            // Option (201) / Result (200) equality: compare tag then payload.
            // Without this, the fallthrough compares raw pointers and fails for
            // values from different allocations (e.g. `zero_div == None`).
            if (op == "==" || op == "!=") && _is_option_or_result_type(ll.store, left_type) {
                a_tag := _lnew_temp(ll)
                ll = a_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_tag.temp, left.temp, 0, "_tag", 0))
                b_tag := _lnew_temp(ll)
                ll = b_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_tag.temp, right.temp, 0, "_tag", 0))
                tag_eq := _lnew_temp(ll)
                ll = tag_eq.l
                ll = _lemit(ll, new_inst(OpEq, tag_eq.temp, a_tag.temp, b_tag.temp, "", 0))
                ll = _lset_type(ll, tag_eq.temp, 1)
                a_pay := _lnew_temp(ll)
                ll = a_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_pay.temp, left.temp, 1, "_val", 0))
                b_pay := _lnew_temp(ll)
                ll = b_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_pay.temp, right.temp, 1, "_val", 0))
                pay_eq := _lnew_temp(ll)
                ll = pay_eq.l
                ll = _lemit(ll, new_inst(OpEq, pay_eq.temp, a_pay.temp, b_pay.temp, "", 0))
                ll = _lset_type(ll, pay_eq.temp, 1)
                // For Option (201) tag 0 = None (no payload) — skip payload check.
                // For Result (200) both variants carry a payload — always require it.
                mut combined := pay_eq.temp
                if _is_option_type(ll.store, left_type) {
                    zero_c := _lnew_temp(ll)
                    ll = zero_c.l
                    ll = _lemit(ll, new_inst(OpConst, zero_c.temp, 0, 0, "", 0))
                    is_none := _lnew_temp(ll)
                    ll = is_none.l
                    ll = _lemit(ll, new_inst(OpEq, is_none.temp, a_tag.temp, zero_c.temp, "", 0))
                    ll = _lset_type(ll, is_none.temp, 1)
                    or_nt := _lnew_temp(ll)
                    ll = or_nt.l
                    ll = _lemit(ll, new_inst(OpOr, or_nt.temp, is_none.temp, pay_eq.temp, "", 0))
                    ll = _lset_type(ll, or_nt.temp, 1)
                    combined = or_nt.temp
                }
                ll = _lemit(ll, new_inst(OpAnd, nt.temp, tag_eq.temp, combined, "", 0))
                if op == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    ll = _lset_type(ll, not_nt.temp, 1)
                    return LT{l: ll, temp: not_nt.temp}
                }
                ll = _lset_type(ll, nt.temp, 1)
                return LT{l: ll, temp: nt.temp}
            }
            if _is_float_type(left_type) || _is_float_type(right_type) {
                ll = _lemit(ll, new_inst(_cmp_op(op), nt.temp, left.temp, right.temp, "f64", 0))
            } else {
                if left_type == 12 {
                    // str ordering: compute lex cmp, then compare result against 0
                    cmp_nt := _lnew_temp(ll)
                    ll = cmp_nt.l
                    ll = _lemit(ll, new_inst(OpStrCmp, cmp_nt.temp, left.temp, right.temp, "", 0))
                    ll = _lset_type(ll, cmp_nt.temp, 1)
                    zero_nt := _lnew_temp(ll)
                    ll = zero_nt.l
                    ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
                    ll = _lset_type(ll, zero_nt.temp, 1)
                    ll = _lemit(ll, new_inst(_cmp_op(op), nt.temp, cmp_nt.temp, zero_nt.temp, "", 0))
                } else {
                    ll = _lemit(ll, new_inst(_cmp_op(op), nt.temp, left.temp, right.temp, "", 0))
                }
            }
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }

        if op == "&&" {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAnd, nt.temp, left.temp, right.temp, "", 0))
            return LT{l: ll, temp: nt.temp}
        }
        if op == "||" {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpOr, nt.temp, left.temp, right.temp, "", 0))
            return LT{l: ll, temp: nt.temp}
        }
        if op == "|>" {
            // Pipeline: left |> right where right is a function name
            right_node := pool_get(ll.pool, node.c1)
            if expr_kind_name(right_node.kind) == "Ident" {
                fname := right_node.s1
                fsig := reg_find_fn(ll.registry, fname)
                if fsig.name != "" {
                    // Generic pipe target: resolve specialization from left_type.
                    mut call_name := fname
                    mut call_sig := fsig
                    if fn_is_generic(fsig) {
                        suffix := _type_name_suffix_l(ll.store, ll.registry, left_type)
                        if suffix != "unknown" {
                            cand := fname + "_" + suffix
                            sp_sig := reg_find_fn(ll.registry, cand)
                            if sp_sig.name != "" && fn_is_generic(sp_sig) == false {
                                call_name = cand
                                call_sig = sp_sig
                            }
                        }
                    }
                    mut reg_count := 1
                    if left_type == 12 { reg_count = 2 }
                    mut nt_temp := 0
                    if call_sig.return_type == 12 {
                        nt := _lnew_str_temp(ll)
                        ll = nt.l
                        nt_temp = nt.temp
                    } else {
                        nt := _lnew_temp(ll)
                        ll = nt.l
                        nt_temp = nt.temp
                    }
                    ll = _lemit(ll, new_inst(OpCall, nt_temp, left.temp, reg_count, call_name, call_sig.return_type))
                    if call_sig.return_type > 0 { ll = _lset_type(ll, nt_temp, call_sig.return_type) }
                    return LT{l: ll, temp: nt_temp}
                }
            }
            // Pipeline with Call right side (e.g., |> filter(fn(x) => ...))
            // Skip lowering to avoid state corruption from unresolved function closures
            if expr_kind_name(right_node.kind) == "Call" {
                return LT{l: ll, temp: left.temp}
            }
            // Pipe target not found
            if expr_kind_name(right_node.kind) == "Ident" {
                _warn_unresolved(ll, "pipe target", right_node.s1)
            }
            return LT{l: ll, temp: left.temp}
        }
        // Bitwise operators
        if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(_arith_op(op), nt.temp, left.temp, right.temp, "", 0))
            ll = _lset_type(ll, nt.temp, 1)
            return LT{l: ll, temp: nt.temp}
        }
        // Fallback
        return LT{l: ll, temp: left.temp}
    }

    // --- Block ---

    if nk == "Block" {
        return _lower_block_node_result(ll, node)
    }

    // --- If ---

    if nk == "If" {
        // c0=cond, c1=then, c2=else (if b1)
        cond := _lower_expr_node(ll, node.c0)
        ll = cond.l
        else_lbl := _lnew_label(ll)
        ll = else_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond.temp, else_lbl.temp, "", 0))
        // Then branch
        then_result := _lower_expr_node(ll, node.c1)
        ll = then_result.l
        mut branch_type := 0
        if then_result.temp >= 0 {
            branch_type = _lget_type(ll, then_result.temp)
            ll = _lemit(ll, new_inst(OpStore, result_nt.temp, then_result.temp, 0, "", 0))
            then_len_dst := result_nt.temp + 1
            then_len_src := then_result.temp + 1
            ll = _lemit(ll, new_inst(OpStore, then_len_dst, then_len_src, 0, "", 0))
        }
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        // Else label
        ll = _lemit(ll, new_inst(OpLabel, 0, else_lbl.temp, 0, "", 0))
        if node.b1 {
            else_result := _lower_expr_node(ll, node.c2)
            ll = else_result.l
            if else_result.temp >= 0 {
                if branch_type == 0 { branch_type = _lget_type(ll, else_result.temp) }
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, else_result.temp, 0, "", 0))
                else_len_dst := result_nt.temp + 1
                else_len_src := else_result.temp + 1
                ll = _lemit(ll, new_inst(OpStore, else_len_dst, else_len_src, 0, "", 0))
            }
        }
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        if branch_type > 0 { ll = _lset_type(ll, result_nt.temp, branch_type) }
        return LT{l: ll, temp: result_nt.temp}
    }

    // --- While ---

    if nk == "While" {
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cond := _lower_expr_node(ll, node.c0)
        ll = cond.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond.temp, end_lbl.temp, "", 0))
        prev_start := ll.loop_start
        prev_end := ll.loop_end
        ll = _lset_loop(ll, loop_lbl.temp, end_lbl.temp)
        body := _lower_expr_node(ll, node.c1)
        ll = body.l
        ll = _lset_loop(ll, prev_start, prev_end)
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: -1}
    }

    // --- Loop ---

    if nk == "Loop" {
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        prev_start := ll.loop_start
        prev_end := ll.loop_end
        ll = _lset_loop(ll, loop_lbl.temp, end_lbl.temp)
        body := _lower_expr_node(ll, node.c0)
        ll = body.l
        ll = _lset_loop(ll, prev_start, prev_end)
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: -1}
    }

    // --- For ---

    if nk == "For" {
        // s1=var_name (or first in tuple), s2=second name OR label, b1=is_tuple, b2=is_labeled
        // c0=iterator, c1=body
        var_name := node.s1
        mut var_name2 := node.s2
        is_tuple_for := node.b1
        mut loop_label := ""
        if node.b2 && is_tuple_for == false { loop_label = node.s2; var_name2 = "" }
        iter_node := pool_get(ll.pool, node.c0)
        iter_nk := expr_kind_name(iter_node.kind)
        // Check if iterator is a Range node or Binary with .. / ..= operator
        if iter_nk == "Range" {
            return _lower_for_range_node(ll, var_name, iter_node, node.c1)
        }
        if iter_nk == "Binary" && (iter_node.s1 == ".." || iter_node.s1 == "..=") {
            // Binary range: treat as Range — pass inclusive flag
            return _lower_for_range_parts(ll, var_name, iter_node.c0, iter_node.c1, iter_node.s1 == "..=", node.c1)
        }
        // Array iteration
        iter := _lower_expr_node(ll, node.c0)
        ll = iter.l
        iter_type := _lget_type(ll, iter.temp)
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, iter.temp, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        inc_lbl := _lnew_label(ll)
        ll = inc_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cond_nt := _lnew_temp(ll)
        ll = cond_nt.l
        ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))
        if var_name != "" {
            if is_tuple_for {
                // Tuple destructuring: (i, x) — first name = index, second = element
                ll = _lenv_add(ll, var_name, idx_nt.temp)
                if var_name2.len() > 0 {
                    if iter_type == 13 || _is_str_array_type(ll.store, iter_type) {
                        elem_nt := _lnew_str_temp(ll)
                        ll = elem_nt.l
                        ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 12))
                        ll = _lset_type(ll, elem_nt.temp, 12)
                        ll = _lenv_add(ll, var_name2, elem_nt.temp)
                    } else {
                        elem_nt := _lnew_temp(ll)
                        ll = elem_nt.l
                        ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
                        elem_type := _array_elem_type(ll.store, iter_type)
                        if elem_type > 0 { ll = _lset_type(ll, elem_nt.temp, elem_type) }
                        ll = _lenv_add(ll, var_name2, elem_nt.temp)
                    }
                }
            } else if iter_type == 13 || _is_str_array_type(ll.store, iter_type) {
                elem_nt := _lnew_str_temp(ll)
                ll = elem_nt.l
                ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 12))
                ll = _lset_type(ll, elem_nt.temp, 12)
                ll = _lenv_add(ll, var_name, elem_nt.temp)
            } else {
                elem_nt := _lnew_temp(ll)
                ll = elem_nt.l
                ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
                elem_type := _array_elem_type(ll.store, iter_type)
                if elem_type > 0 { ll = _lset_type(ll, elem_nt.temp, elem_type) }
                ll = _lenv_add(ll, var_name, elem_nt.temp)
            }
        }
        prev_start := ll.loop_start
        prev_end := ll.loop_end
        ll = _lset_loop(ll, inc_lbl.temp, end_lbl.temp)
        // Register labeled loop endpoints for `break label` / `continue label`
        if loop_label.len() > 0 {
            ll = _lenv_add(ll, "_label_" + loop_label, end_lbl.temp)
            ll = _lenv_add(ll, "_label_" + loop_label + "_start", inc_lbl.temp)
        }
        body := _lower_expr_node(ll, node.c1)
        ll = body.l
        ll = _lset_loop(ll, prev_start, prev_end)
        ll = _lemit(ll, new_inst(OpLabel, 0, inc_lbl.temp, 0, "", 0))
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        inc_nt := _lnew_temp(ll)
        ll = inc_nt.l
        ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: -1}
    }

    // --- Break / Continue ---

    if nk == "Break" {
        // Check for labeled break: break label → jump to _label_NAME's stored end label
        if node.s1.len() > 0 {
            label_key := "_label_" + node.s1
            label_end := _lenv_lookup(ll, label_key)
            if label_end >= 0 {
                ll = _lemit(ll, new_inst(OpJump, 0, label_end, 0, "", 0))
            }
        } else if ll.loop_end >= 0 {
            ll = _lemit(ll, new_inst(OpJump, 0, ll.loop_end, 0, "", 0))
        }
        return LT{l: ll, temp: -1}
    }
    if nk == "Continue" {
        // Check for labeled continue: continue label → jump to _label_NAME_start
        if node.s1.len() > 0 {
            label_key := "_label_" + node.s1 + "_start"
            label_start := _lenv_lookup(ll, label_key)
            if label_start >= 0 {
                ll = _lemit(ll, new_inst(OpJump, 0, label_start, 0, "", 0))
            }
        } else if ll.loop_start >= 0 {
            ll = _lemit(ll, new_inst(OpJump, 0, ll.loop_start, 0, "", 0))
        }
        return LT{l: ll, temp: -1}
    }

    // --- Return ---

    if nk == "Return" {
        if node.b1 {
            result := _lower_expr_node(ll, node.c0)
            ll = result.l
            ll = _emit_defers(ll)
            if ll.fn_error_type > 0 && _lget_type(ll, result.temp) != 200 {
                ret_type := _lget_type(ll, result.temp)
                mut ok_slots := 2
                if ret_type == 12 { ok_slots = 3 }
                ok_nt := _lnew_temp(ll)
                ll = ok_nt.l
                ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
                if ret_type == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
                    val_len := result.temp + 1
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
                }
                ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
            } else {
                ret_type := _lget_type(ll, result.temp)
                ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
            }
        } else {
            ll = _emit_defers(ll)
            ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
        }
        return LT{l: ll, temp: -1}
    }

    // --- Binding ---

    if nk == "Binding" {
        // s1=name, b1=is_mut, c0=value
        result := _lower_expr_node(ll, node.c0)
        ll = result.l
        ll = _lenv_add(ll, node.s1, result.temp)
        return LT{l: ll, temp: result.temp}
    }

    // --- Assign ---

    if nk == "Assign" {
        return _lower_assign_node(ll, node)
    }

    // --- Call ---

    if nk == "Call" {
        return _lower_call_node(ll, node)
    }

    // --- MethodCall ---

    if nk == "MethodCall" {
        method := node.s1
        // Check if this is qualified variant construction: Type.Variant(args)
        // The receiver (c0) is an Ident that names the type, method is the variant
        vtag := _variant_tag(ll.registry, method)
        if vtag > 0 {
            vparent := _variant_parent(ll.registry, method)
            vdc := variant_data_count(vparent, vtag)
            if vdc == 0 {
                // No-data variant: check if parent has any data variants
                alloc_sz := sum_alloc_size(vparent)
                if alloc_sz > 1 {
                    // Parent has data variants — allocate as heap object for uniform representation
                    vnt := _lnew_temp(ll)
                    ll = vnt.l
                    ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, alloc_sz, 0, vparent.name, 0))
                    st_id := _struct_type_id(ll.registry, vparent.name)
                    if st_id > 0 { ll = _lset_type(ll, vnt.temp, st_id) }
                    vtag_nt := _lnew_temp(ll)
                    ll = vtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, vtag_nt.temp, 0, "_tag", 0))
                    return LT{l: ll, temp: vnt.temp}
                }
                // Pure no-data sum type: just return the tag value
                vnt := _lnew_temp(ll)
                ll = vnt.l
                ll = _lemit(ll, new_inst(OpConst, vnt.temp, vtag, 0, "", 0))
                return LT{l: ll, temp: vnt.temp}
            }
            if vdc > 0 && node.list_count > 0 {
                // Data variant construction: allocate struct, set tag, fill fields
                alloc_sz := sum_alloc_size(vparent)
                vnt := _lnew_temp(ll)
                ll = vnt.l
                ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, alloc_sz, 0, vparent.name, 0))
                st_id := _struct_type_id(ll.registry, vparent.name)
                if st_id > 0 { ll = _lset_type(ll, vnt.temp, st_id) }
                vtag_nt := _lnew_temp(ll)
                ll = vtag_nt.l
                ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, vtag_nt.temp, 0, "_tag", 0))
                mut vfi := 0
                mut vslot := 1
                while vfi < node.list_count {
                    arg_holder := pool_get(ll.pool, node.list_start + vfi)
                    val := _lower_expr_node(ll, arg_holder.c0)
                    ll = val.l
                    vft := variant_field_type(vparent, vtag, vfi)
                    if vft == 12 {
                        ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp, vslot, "", 0))
                        ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp + 1, vslot + 1, "", 0))
                        vslot = vslot + 2
                    } else {
                        ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp, vslot, "", 0))
                        vslot = vslot + 1
                    }
                    vfi = vfi + 1
                }
                return LT{l: ll, temp: vnt.temp}
            }
        }
        // Check if this is a module-qualified function call: mod.func(args)
        // If the receiver is an unresolved Ident and the method is a known function, emit a direct call
        recv_node := pool_get(ll.pool, node.c0)
        if expr_kind_name(recv_node.kind) == "Ident" {
            recv_name := recv_node.s1
            recv_slot := _lenv_lookup(ll, recv_name)
            if recv_slot < 0 {
                // Receiver not in scope — check if method is a registered function
                // Try qualified name first: Type.method → Type_method
                mut msig := reg_find_fn(ll.registry, recv_name + "_" + method)
                mut mcall_name := recv_name + "_" + method
                if msig.name == "" {
                    // Try bare method name (module-qualified call)
                    msig = reg_find_fn(ll.registry, method)
                    mcall_name = method
                }
                if msig.name != "" {
                    // Module-qualified call: lower args, then emit direct function call
                    mut marg_temps := [0]
                    mut marg_types := [0]
                    mut mai := 0
                    while mai < node.list_count {
                        arg_holder := pool_get(ll.pool, node.list_start + mai)
                        arg_r := _lower_expr_node(ll, arg_holder.c0)
                        ll = arg_r.l
                        marg_temps = marg_temps.append(arg_r.temp)
                        marg_types = marg_types.append(_lget_type(ll, arg_r.temp))
                        mai = mai + 1
                    }
                    // Count register args (strings take 2)
                    mut mreg_count := 0
                    mai = 1
                    while mai < marg_temps.len() {
                        if marg_types[mai] == 12 { mreg_count = mreg_count + 2 } else { mreg_count = mreg_count + 1 }
                        mai = mai + 1
                    }
                    // Marshal args into consecutive temps
                    mut mfa := 0
                    if marg_temps.len() > 1 {
                        first_nt := _lnew_temp(ll)
                        ll = first_nt.l
                        mut mri := 1
                        while mri < mreg_count {
                            extra := _lnew_temp(ll)
                            ll = extra.l
                            mri = mri + 1
                        }
                        mut mslot := 0
                        mai = 1
                        while mai < marg_temps.len() {
                            if marg_types[mai] == 12 {
                                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot, marg_temps[mai], 0, "", 0))
                                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot + 1, marg_temps[mai] + 1, 0, "", 0))
                                mslot = mslot + 2
                            } else {
                                ll = _lemit(ll, new_inst(OpStore, first_nt.temp + mslot, marg_temps[mai], 0, "", 0))
                                mslot = mslot + 1
                            }
                            mai = mai + 1
                        }
                        mfa = first_nt.temp
                    }
                    // Emit call
                    mrt := msig.return_type
                    mut mnt_temp := 0
                    if mrt == 12 {
                        mnt := _lnew_str_temp(ll)
                        ll = mnt.l
                        mnt_temp = mnt.temp
                    } else {
                        mnt := _lnew_temp(ll)
                        ll = mnt.l
                        mnt_temp = mnt.temp
                    }
                    ll = _lemit(ll, new_inst(OpCall, mnt_temp, mfa, mreg_count, mcall_name, mrt))
                    if mrt > 0 {
                        ll = _lset_type(ll, mnt_temp, mrt)
                    } else {
                        // If return type unknown, try to infer from receiver type name
                        recv_tid := _struct_type_id(ll.registry, recv_name)
                        if recv_tid > 0 { ll = _lset_type(ll, mnt_temp, recv_tid) }
                    }
                    return LT{l: ll, temp: mnt_temp}
                }
            }
        }
        // Lower receiver from AST
        recv := _lower_expr_node(ll, node.c0)
        ll = recv.l
        // .to[Type](), .trunc[Type](), .parse[Type]() — conversion with type arg in s2
        if node.s2.len() > 0 && (method == "to" || method == "trunc" || method == "parse") {
            conv_method := method
            if method == "parse" { conv_method = "to" }
            return _lower_conversion(ll, recv.temp, conv_method, node.s2)
        }
        // AST path: lower arguments from pool, then dispatch to method codegen
        if node.list_count > 0 {
            arg1_r := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = arg1_r.l
            mut arg2 := 0
            if node.list_count > 1 {
                arg2_r := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + 1).c0)
                ll = arg2_r.l
                arg2 = arg2_r.temp
            }
            return _lower_method_with_args(ll, recv.temp, method, arg1_r.temp, arg2, node.list_count)
        }
        // Zero-arg methods: emit the call directly from the AST so we don't
        // drift into the callee's body when the token cursor isn't already
        // positioned at the call site's `(`.
        {
            obj_type := _lget_type(ll, recv.temp)
            obj_sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
            mut qualified := method
            if obj_sname != "" { qualified = obj_sname + "_" + method }
            mut msig := reg_find_fn(ll.registry, qualified)
            if msig.name == "" {
                msig = reg_find_fn(ll.registry, method)
                qualified = method
            }
            if msig.name != "" {
                mut nt_temp := 0
                if msig.return_type == 12 {
                    nt := _lnew_str_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                } else {
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                }
                ll = _lemit(ll, new_inst(OpCall, nt_temp, recv.temp, 1, qualified, 0))
                if msig.return_type > 0 { ll = _lset_type(ll, nt_temp, msig.return_type) }
                return LT{l: ll, temp: nt_temp}
            }
            // Fall back to token walker for builtin methods (len, sqrt, etc.)
            mut tp := _find_tok_pos(ll, node.span.offset)
            while tp < ll.tokens.len() && ll.tokens[tp].name != "(" { tp = tp + 1 }
            ll = _lset_pos(ll, tp)
            return _lower_method_call(ll, recv.temp, method)
        }
    }

    // --- FieldAccess ---

    if nk == "FieldAccess" {
        field := node.s1
        // Check if this is a no-data variant access: Type.Variant
        fa_vtag := _variant_tag(ll.registry, field)
        if fa_vtag > 0 {
            fa_vparent := _variant_parent(ll.registry, field)
            fa_vdc := variant_data_count(fa_vparent, fa_vtag)
            if fa_vdc == 0 {
                fa_alloc := sum_alloc_size(fa_vparent)
                if fa_alloc > 1 {
                    // Parent has data variants — allocate heap object for uniform representation
                    fa_nt := _lnew_temp(ll)
                    ll = fa_nt.l
                    ll = _lemit(ll, new_inst(OpAlloc, fa_nt.temp, fa_alloc, 0, fa_vparent.name, 0))
                    fa_st_id := _struct_type_id(ll.registry, fa_vparent.name)
                    if fa_st_id > 0 { ll = _lset_type(ll, fa_nt.temp, fa_st_id) }
                    fa_tag_nt := _lnew_temp(ll)
                    ll = fa_tag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, fa_tag_nt.temp, fa_vtag, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, fa_nt.temp, fa_tag_nt.temp, 0, "_tag", 0))
                    return LT{l: ll, temp: fa_nt.temp}
                }
                // Pure no-data sum type: just return the tag value
                fa_nt := _lnew_temp(ll)
                ll = fa_nt.l
                ll = _lemit(ll, new_inst(OpConst, fa_nt.temp, fa_vtag, 0, "", 0))
                return LT{l: ll, temp: fa_nt.temp}
            }
        }
        recv := _lower_expr_node(ll, node.c0)
        ll = recv.l
        left_type := _lget_type(ll, recv.temp)
        sname := _struct_name_for_type(ll.store, ll.registry, left_type)
        mut fidx := 0
        mut ft := 0
        // Tuple field access: field name is a digit string ("0", "1", "2")
        // Use the digit as the field index directly.
        mut is_tuple_field := false
        if field.len() > 0 {
            ch := field.charAt(0)
            if ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
               ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" {
                is_tuple_field = true
            }
        }
        if is_tuple_field {
            fidx = _parse_int_literal(field)
            ft = 1  // tuple fields default to i64; type system can refine later
        } else if sname != "" {
            fidx = _field_index(ll.registry, sname, field)
            ft = _field_type_id(ll, sname, field)
        } else {
            fidx = _field_index_any(ll.registry, field)
            ft = _field_type_id_any(ll.registry, field)
        }
        // If field not found, try bound method ref: obj.method → closure
        // ft==0 means _field_type_id returned unknown — field doesn't exist
        has_field := reg_find_field(ll.registry, sname, field)
        if has_field.name == "" && sname != "" {
            qualified := sname + "_" + field
            msig := reg_find_fn(ll.registry, qualified)
            if msig.name == "" {
                _warn_unresolved(ll, "field", sname + "." + field)
            }
            if msig.name != "" {
                // Register for bound-trampoline generation
                ll = _lset_reg(ll, reg_add_bound_fn_value_ref(ll.registry, qualified))
                // Allocate env with 1 slot for captured receiver
                env_nt := _lnew_temp(ll)
                ll = env_nt.l
                ll = _lemit(ll, new_inst(OpAlloc, env_nt.temp, 1, 0, "_bound_env", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, env_nt.temp, recv.temp, 0, "_self", 0))
                // Build fat-pointer closure: {_bound_tramp_qualified, env}
                clos := _lnew_temp(ll)
                ll = clos.l
                ll = _lemit(ll, new_inst(OpAlloc, clos.temp, 2, 0, "_Closure", 0))
                fn_ref := _lnew_temp(ll)
                ll = fn_ref.l
                ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, "_bound_tramp_" + qualified, 0))
                ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, fn_ref.temp, 0, "_fn", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, env_nt.temp, 1, "_env", 0))
                return LT{l: ll, temp: clos.temp}
            }
        }
        mut nt_temp := 0
        if ft == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
            fidx_len := fidx + 1
            nt_len := nt_temp + 1
            ll = _lemit(ll, new_inst(OpFieldGet, nt_temp, recv.temp, fidx, field, 0))
            ll = _lemit(ll, new_inst(OpFieldGet, nt_len, recv.temp, fidx_len, field, 0))
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
            ll = _lemit(ll, new_inst(OpFieldGet, nt_temp, recv.temp, fidx, field, 0))
        }
        if ft > 0 { ll = _lset_type(ll, nt_temp, ft) }
        return LT{l: ll, temp: nt_temp}
    }

    // --- Index ---

    if nk == "Index" {
        container := _lower_expr_node(ll, node.c0)
        ll = container.l
        subscript := _lower_expr_node(ll, node.c1)
        ll = subscript.l
        left_type := _lget_type(ll, container.temp)
        // Map index-get: `m[k]`. Maps are type 300.
        if left_type == 300 {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpMapGet, nt.temp, container.temp, subscript.temp, "", 0))
            return LT{l: ll, temp: nt.temp}
        }
        elem_type := _array_elem_type(ll.store, left_type)
        if elem_type == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, nt.temp, container.temp, subscript.temp, "", 12))
            ll = _lset_type(ll, nt.temp, 12)
            return LT{l: ll, temp: nt.temp}
        }
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpArrayGet, nt.temp, container.temp, subscript.temp, "", 0))
        if elem_type > 0 { ll = _lset_type(ll, nt.temp, elem_type) }
        return LT{l: ll, temp: nt.temp}
    }

    // --- Array ---

    if nk == "Array" {
        arr_nt := _lnew_temp(ll)
        ll = arr_nt.l
        ll = _lemit(ll, new_inst(OpArrayNew, arr_nt.temp, node.list_count, 0, "", 0))
        mut ai := 0
        mut arr_elem_type := 0
        while ai < node.list_count {
            idx_node := pool_get(ll.pool, node.list_start + ai)
            elem := _lower_expr_node(ll, idx_node.c0)
            ll = elem.l
            elem_tid := _lget_type(ll, elem.temp)
            if elem_tid > 0 { arr_elem_type = elem_tid }
            ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, elem.temp, "", elem_tid))
            ai = ai + 1
        }
        // Track array type so for-loops and interpolation see the element type.
        // 13 is a sentinel for [str]; for other element types build/reuse a
        // store-based TyArray entry.
        if arr_elem_type == 12 {
            ll = _lset_type(ll, arr_nt.temp, 13)
        } else if arr_elem_type > 0 {
            arr_info := TypeInfo{kind: TyArray, name: "", type_id: arr_elem_type, type_id2: 0, param_start: 0, param_count: 0}
            sar := store_add_canonical(ll.store, arr_info)
            ll = _lset_store(ll, sar.store)
            ll = _lset_type(ll, arr_nt.temp, sar.id)
        }
        return LT{l: ll, temp: arr_nt.temp}
    }

    // --- Map literal { k: v, ... } ---

    if nk == "MapLit" {
        // Create map with initial capacity
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        mut cap := node.list_count
        if cap < 8 { cap = 8 }
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, cap, 0, "", 0))
        map_nt := _lnew_temp(ll)
        ll = map_nt.l
        ll = _lemit(ll, new_inst(OpMapNew, map_nt.temp, cap_nt.temp, 0, "", 0))
        ll = _lset_type(ll, map_nt.temp, 300)
        // Insert key-value pairs (list stores alternating key/value indices)
        mut mi := 0
        while mi < node.list_count * 2 {
            key_idx_node := pool_get(ll.pool, node.list_start + mi)
            val_idx_node := pool_get(ll.pool, node.list_start + mi + 1)
            key := _lower_expr_node(ll, key_idx_node.c0)
            ll = key.l
            val := _lower_expr_node(ll, val_idx_node.c0)
            ll = val.l
            ll = _lemit(ll, new_inst(OpMapSet, 0, map_nt.temp, key.temp, "", val.temp))
            mi = mi + 2
        }
        return LT{l: ll, temp: map_nt.temp}
    }

    // --- Set literal { a, b, ... } ---

    if nk == "SetLit" {
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        mut cap := node.list_count
        if cap < 8 { cap = 8 }
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, cap, 0, "", 0))
        set_nt := _lnew_temp(ll)
        ll = set_nt.l
        ll = _lemit(ll, new_inst(OpSetNew, set_nt.temp, cap_nt.temp, 0, "", 0))
        ll = _lset_type(ll, set_nt.temp, 301)
        // Insert elements
        mut si := 0
        while si < node.list_count {
            idx_node := pool_get(ll.pool, node.list_start + si)
            elem := _lower_expr_node(ll, idx_node.c0)
            ll = elem.l
            ll = _lemit(ll, new_inst(OpSetAdd, 0, set_nt.temp, elem.temp, "", 0))
            si = si + 1
        }
        return LT{l: ll, temp: set_nt.temp}
    }

    // --- Struct ---

    if nk == "Struct" {
        sname := node.s1

        // Record update: lower base via AST, then walk tokens for .{field: val, ...}
        if sname == "_update" {
            base := _lower_expr_node(ll, node.c0)
            ll = base.l
            base_tid := _lget_type(ll, base.temp)
            // Advance past base tokens and .{ token to position at first field
            dlb := ".\{"
            mut scan_limit := 0
            while _lk(ll) != dlb && _lk(ll) != "EOF" && scan_limit < 100 {
                ll = _ladv(ll)
                scan_limit = scan_limit + 1
            }
            if _lk(ll) == dlb { ll = _ladv(ll) }
            ll = _lskip_nl(ll)
            // Resolve struct name from type
            ru_sname := _struct_name_for_type(ll.store, ll.registry, base_tid)
            ru_sdef := reg_find_struct(ll.registry, ru_sname)
            alloc_sz := _struct_field_count(ll.registry, ru_sname)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, ru_sname, 0))
            if base_tid > 0 { ll = _lset_type(ll, nt.temp, base_tid) }
            // Copy all fields from base
            mut ci := 1
            while ci < ru_sdef.fields.len() {
                cname := ru_sdef.fields[ci].name
                c_slot := _field_index(ll.registry, ru_sname, cname)
                cft := ru_sdef.fields[ci].type_id
                if cft == 12 {
                    cs := _lnew_str_temp(ll)
                    ll = cs.l
                    ll = _lemit(ll, new_inst(OpFieldGet, cs.temp, base.temp, c_slot, cname, 0))
                    cs_len := c_slot + 1
                    ll = _lemit(ll, new_inst(OpFieldGet, cs.temp + 1, base.temp, cs_len, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, cs.temp, c_slot, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, cs.temp + 1, cs_len, cname, 0))
                } else {
                    ct := _lnew_temp(ll)
                    ll = ct.l
                    ll = _lemit(ll, new_inst(OpFieldGet, ct.temp, base.temp, c_slot, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, ct.temp, c_slot, cname, 0))
                }
                ci = ci + 1
            }
            // Walk tokens for updated fields: field: val, ...}
            rb := "\}"
            while _lk(ll) != rb && _lk(ll) != "EOF" {
                if _lk(ll) == "IDENT" {
                    ufname := _lcur(ll).text
                    ll = _ladv(ll)
                    if _lk(ll) == ":" {
                        ll = _ladv(ll)
                        fval := _lower_expr(ll)
                        ll = fval.l
                        uf_slot := _field_index(ll.registry, ru_sname, ufname)
                        ufi := reg_find_field(ll.registry, ru_sname, ufname)
                        if ufi.type_id == 12 {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, uf_slot, ufname, 0))
                            uf_slot_len := uf_slot + 1
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp + 1, uf_slot_len, ufname, 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, uf_slot, ufname, 0))
                        }
                    }
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == rb { ll = _ladv(ll) }
            return LT{l: ll, temp: nt.temp}
        }

        // --- Check if this is a struct-like variant: Move { x: 10, y: 20 } ---
        sv_vtag := _variant_tag(ll.registry, sname)
        if sv_vtag > 0 {
            sv_parent := _variant_parent(ll.registry, sname)
            alloc_sz := sum_alloc_size(sv_parent)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, sv_parent.name, 0))
            st_id := _struct_type_id(ll.registry, sv_parent.name)
            if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
            // Set tag
            vtag_nt := _lnew_temp(ll)
            ll = vtag_nt.l
            ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, sv_vtag, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, vtag_nt.temp, 0, "_tag", 0))
            // Fill variant fields by name from the AST list (uses token-walk for names)
            mut sv_tok := _find_tok_pos(ll, node.span.offset)
            // Advance to { in token stream
            lb2 := "\{"
            while sv_tok < ll.tokens.len() && ll.tokens[sv_tok].name != lb2 { sv_tok = sv_tok + 1 }
            if sv_tok < ll.tokens.len() { sv_tok = sv_tok + 1 }
            // Walk field: value pairs
            mut svi := 0
            mut sv_slot := 1
            rb2 := "\}"
            while svi < node.list_count {
                // Find the field name token
                while sv_tok < ll.tokens.len() && (ll.tokens[sv_tok].name == "NEWLINE" || ll.tokens[sv_tok].name == ",") { sv_tok = sv_tok + 1 }
                if sv_tok < ll.tokens.len() && ll.tokens[sv_tok].name == rb2 { svi = node.list_count }
                if svi < node.list_count {
                    sv_fname := ll.tokens[sv_tok].text
                    sv_tok = sv_tok + 1
                    // Skip : and value tokens (value already lowered via AST)
                    if sv_tok < ll.tokens.len() && ll.tokens[sv_tok].name == ":" { sv_tok = sv_tok + 1 }
                    // Lower value from AST
                    idx_node := pool_get(ll.pool, node.list_start + svi)
                    fval := _lower_expr_node(ll, idx_node.c0)
                    ll = fval.l
                    // Find the slot for this field name in the variant
                    vfc := variant_data_count(sv_parent, sv_vtag)
                    sv_foff := sv_parent.variant_field_offsets[sv_vtag]
                    mut svi2 := 0
                    mut found_slot := sv_slot
                    while svi2 < vfc {
                        idx2 := sv_foff + svi2
                        if idx2 < sv_parent.variant_field_names.len() && sv_parent.variant_field_names[idx2] == sv_fname {
                            found_slot = svi2 + 1
                        }
                        svi2 = svi2 + 1
                    }
                    sv_ftype := variant_field_type(sv_parent, sv_vtag, svi)
                    if sv_ftype == 12 {
                        ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, found_slot, sv_fname, 0))
                        ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp + 1, found_slot + 1, sv_fname, 0))
                        sv_slot = sv_slot + 2
                    } else {
                        ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, found_slot, sv_fname, 0))
                        sv_slot = sv_slot + 1
                    }
                    svi = svi + 1
                }
            }
            return LT{l: ll, temp: nt.temp}
        }

        // --- Normal struct literal ---
        sdef := reg_find_struct(ll.registry, sname)
        if sdef.name == "" { _warn_unresolved(ll, "struct", sname) }
        alloc_sz := _struct_field_count(ll.registry, sname)
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, sname, 0))
        st_id := _struct_type_id(ll.registry, sname)
        if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
        mut fi := 0
        while fi < node.list_count {
            idx_node := pool_get(ll.pool, node.list_start + fi)
            fval := _lower_expr_node(ll, idx_node.c0)
            ll = fval.l
            mut fname := ""
            mut f_slot := fi
            fi_idx := fi + 1
            mut ft := 0
            if sdef.name != "" && fi_idx < sdef.fields.len() {
                fname = sdef.fields[fi_idx].name
                ft = sdef.fields[fi_idx].type_id
                f_slot = _field_index(ll.registry, sname, fname)
            } else {
                ft = _lget_type(ll, fval.temp)
            }
            if ft == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, f_slot, fname, 0))
                f_slot_len := f_slot + 1
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp + 1, f_slot_len, fname, 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, f_slot, fname, 0))
            }
            fi = fi + 1
        }
        return LT{l: ll, temp: nt.temp}
    }

    // --- Tuple ---

    if nk == "Tuple" {
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpAlloc, nt.temp, node.list_count, 0, "_Tuple", 0))
        mut ti := 0
        while ti < node.list_count {
            idx_node := pool_get(ll.pool, node.list_start + ti)
            elem := _lower_expr_node(ll, idx_node.c0)
            ll = elem.l
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, elem.temp, ti, "", 0))
            ti = ti + 1
        }
        return LT{l: ll, temp: nt.temp}
    }

    // --- Pipeline ---

    if nk == "Pipeline" {
        left := _lower_expr_node(ll, node.c0)
        ll = left.l
        right_node := pool_get(ll.pool, node.c1)
        left_type := _lget_type(ll, left.temp)
        right_kind := expr_kind_name(right_node.kind)
        if right_kind == "Ident" {
            fname := right_node.s1
            fsig := reg_find_fn(ll.registry, fname)
            if fsig.name != "" {
                // If generic, resolve the specialization name from left_type and
                // prefer its FnSig so codegen emits e.g. @identity_i64.
                mut call_name := fname
                mut call_sig := fsig
                if fn_is_generic(fsig) {
                    suffix := _type_name_suffix_l(ll.store, ll.registry, left_type)
                    if suffix != "unknown" {
                        cand := fname + "_" + suffix
                        sp_sig := reg_find_fn(ll.registry, cand)
                        if sp_sig.name != "" && fn_is_generic(sp_sig) == false {
                            call_name = cand
                            call_sig = sp_sig
                        }
                    }
                }
                mut reg_count := 1
                if left_type == 12 { reg_count = 2 }
                mut nt_temp := 0
                if call_sig.return_type == 12 {
                    nt := _lnew_str_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                } else {
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                }
                ll = _lemit(ll, new_inst(OpCall, nt_temp, left.temp, reg_count, call_name, call_sig.return_type))
                if call_sig.return_type > 0 { ll = _lset_type(ll, nt_temp, call_sig.return_type) }
                return LT{l: ll, temp: nt_temp}
            }
        }
        // Call node on pipe right: arr |> filter(pred) → delegate to method call
        // Position to the function name token and use token-based method dispatch
        if right_kind == "Call" {
            fname := right_node.s1
            tp := _find_tok_pos(ll, right_node.span.offset)
            ll = _lset_pos(ll, tp)
            // Skip to ( after function name
            if _lk(ll) == "IDENT" { ll = _ladv(ll) }
            if _lk(ll) == "(" {
                mr := _lower_method_call(ll, left.temp, fname)
                ll = mr.l
                return LT{l: ll, temp: mr.temp}
            }
        }
        return LT{l: ll, temp: left.temp}
    }

    // --- Range ---

    if nk == "Range" {
        // Range nodes are lowered by For; standalone range is uncommon
        start := _lower_expr_node(ll, node.c0)
        ll = start.l
        return LT{l: ll, temp: start.temp}
    }

    // --- ListComp ---

    if nk == "ListComp" {
        // s1=var_name, c0=mapping_expr, c1=iterator, c2=where_expr (if b1)
        // Desugar to: result = []; for x in iter { if cond { result.append(expr) } }
        arr_nt := _lnew_temp(ll)
        ll = arr_nt.l
        ll = _lemit(ll, new_inst(OpArrayNew, arr_nt.temp, 0, 0, "", 0))
        // Lower iterator
        iter := _lower_expr_node(ll, node.c1)
        ll = iter.l
        iter_type := _lget_type(ll, iter.temp)
        // Get array length
        len_nt := _lnew_temp(ll)
        ll = len_nt.l
        ll = _lemit(ll, new_inst(OpArrayLen, len_nt.temp, iter.temp, 0, "", 0))
        idx_nt := _lnew_temp(ll)
        ll = idx_nt.l
        ll = _lemit(ll, new_inst(OpConst, idx_nt.temp, 0, 0, "", 0))
        loop_lbl := _lnew_label(ll)
        ll = loop_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
        cond_nt := _lnew_temp(ll)
        ll = cond_nt.l
        ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, len_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))
        // Load element and bind loop variable
        if iter_type == 13 || _is_str_array_type(ll.store, iter_type) {
            elem_nt := _lnew_str_temp(ll)
            ll = elem_nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 12))
            ll = _lset_type(ll, elem_nt.temp, 12)
            ll = _lenv_add(ll, node.s1, elem_nt.temp)
        } else {
            elem_nt := _lnew_temp(ll)
            ll = elem_nt.l
            ll = _lemit(ll, new_inst(OpArrayGet, elem_nt.temp, iter.temp, idx_nt.temp, "", 0))
            elem_type := _array_elem_type(ll.store, iter_type)
            if elem_type > 0 { ll = _lset_type(ll, elem_nt.temp, elem_type) }
            ll = _lenv_add(ll, node.s1, elem_nt.temp)
        }
        // Optional where/if filter
        if node.b1 {
            skip_lbl := _lnew_label(ll)
            ll = skip_lbl.l
            wcond := _lower_expr_node(ll, node.c2)
            ll = wcond.l
            ll = _lemit(ll, new_inst(OpBranchFalse, 0, wcond.temp, skip_lbl.temp, "", 0))
            // Lower mapping expression and append
            mval := _lower_expr_node(ll, node.c0)
            ll = mval.l
            ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, mval.temp, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, skip_lbl.temp, 0, "", 0))
        } else {
            // No filter — always append
            mval := _lower_expr_node(ll, node.c0)
            ll = mval.l
            ll = _lemit(ll, new_inst(OpArrayAppend, arr_nt.temp, arr_nt.temp, mval.temp, "", 0))
        }
        // Increment and loop
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        inc_nt := _lnew_temp(ll)
        ll = inc_nt.l
        ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: arr_nt.temp}
    }

    // --- Yield ---

    if nk == "Yield" {
        // yield expr — used in catch blocks to provide the catch value
        // Falls back to token-walking for proper catch context integration
        if node.b1 {
            tp := _find_tok_pos(ll, node.span.offset)
            ll = _lset_pos(ll, tp)
            // yield is treated like a return-from-catch: lower the expression
            ll = _ladv(ll)  // skip "yield"
            result := _lower_expr(ll)
            ll = result.l
            return LT{l: ll, temp: result.temp}
        }
        return LT{l: ll, temp: -1}
    }

    // --- Propagate (?) ---

    if nk == "Propagate" {
        operand := _lower_expr_node(ll, node.c0)
        ll = operand.l
        // If the operand isn't a Result, pass it through (no propagation needed)
        prop_type := _lget_type(ll, operand.temp)
        if prop_type != 200 && prop_type != 0 {
            return LT{l: ll, temp: operand.temp}
        }
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, operand.temp, 0, "_tag", 0))
        const_one := _lnew_temp(ll)
        ll = const_one.l
        ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
        is_err := _lnew_temp(ll)
        ll = is_err.l
        ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
        err_lbl := _lnew_label(ll)
        ll = err_lbl.l
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, err_lbl.temp, "", 0))
        ok_val := _lnew_temp(ll)
        ll = ok_val.l
        ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, operand.temp, 1, "_val", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, err_lbl.temp, 0, "", 0))
        ll = _emit_defers(ll)
        ll = _lemit(ll, new_inst(OpRet, 0, operand.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: ok_val.temp}
    }

    // --- AssertOk (!) ---

    if nk == "AssertOk" {
        operand := _lower_expr_node(ll, node.c0)
        ll = operand.l
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, operand.temp, 0, "_tag", 0))
        const_one := _lnew_temp(ll)
        ll = const_one.l
        ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
        is_err := _lnew_temp(ll)
        ll = is_err.l
        ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
        panic_lbl := _lnew_label(ll)
        ll = panic_lbl.l
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, panic_lbl.temp, "", 0))
        ok_val := _lnew_temp(ll)
        ll = ok_val.l
        ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, operand.temp, 1, "_val", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, panic_lbl.temp, 0, "", 0))
        mut panic_str_idx := mod_find_string(ll.module, "unwrap failed on Err value")
        if panic_str_idx == 0 {
            new_mod := mod_add_string(ll.module, "unwrap failed on Err value")
            panic_str_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        panic_ptr := _lnew_str_temp(ll)
        ll = panic_ptr.l
        ll = _lemit(ll, new_inst(OpConstStr, panic_ptr.temp, panic_str_idx, 25, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, panic_ptr.temp, 2, "_aria_panic", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: ok_val.temp}
    }

    // --- Catch ---

    if nk == "Catch" {
        // c0=expr, s1=error binding name
        // b1=true: multi-arm catch (list has arm pairs)
        // b1=false: single-body catch (c1=handler)
        expr := _lower_expr_node(ll, node.c0)
        ll = expr.l
        // If the expression is a known non-Result type, catch is a no-op — return value as-is
        expr_type := _lget_type(ll, expr.temp)
        if expr_type == 12 || expr_type == 9 || expr_type == 8 {
            return LT{l: ll, temp: expr.temp}
        }
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, expr.temp, 0, "_tag", 0))
        const_one := _lnew_temp(ll)
        ll = const_one.l
        ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
        is_err := _lnew_temp(ll)
        ll = is_err.l
        ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
        result_nt := _lnew_str_temp(ll)
        ll = result_nt.l
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        end_lbl := _lnew_label(ll)
        ll = end_lbl.l
        ll = _lemit(ll, new_inst(OpBranchFalse, 0, is_err.temp, ok_lbl.temp, "", 0))
        // Error path
        err_val := _lnew_temp(ll)
        ll = err_val.l
        ll = _lemit(ll, new_inst(OpFieldGet, err_val.temp, expr.temp, 1, "_val", 0))
        if node.b1 {
            // Multi-arm catch: dispatch on error variant tags
            // Only extract tag if the first arm isn't a wildcard (avoids null deref on generic errors)
            err_tag_nt := _lnew_temp(ll)
            ll = err_tag_nt.l
            mut needs_tag := true
            if node.list_count == 1 {
                first_arm := pool_get(ll.pool, node.list_start)
                first_pat := pool_get(ll.pool, first_arm.c0)
                if expr_kind_name(first_pat.kind) == "Ident" && first_pat.s1 == "_" {
                    needs_tag = false
                }
            }
            if needs_tag {
                ll = _lemit(ll, new_inst(OpFieldGet, err_tag_nt.temp, err_val.temp, 0, "_tag", 0))
            }
            catch_end := _lnew_label(ll)
            ll = catch_end.l
            mut cai := 0
            while cai < node.list_count {
                arm_node := pool_get(ll.pool, node.list_start + cai)
                pat := pool_get(ll.pool, arm_node.c0)
                body_idx := arm_node.c1
                pat_kind := expr_kind_name(pat.kind)
                // Determine variant name and whether there are destructured args
                mut vname := ""
                mut has_destr := false
                mut destr_list_start := 0
                mut destr_list_count := 0
                if pat_kind == "Ident" {
                    vname = pat.s1
                } else if pat_kind == "FieldAccess" {
                    // Qualified: ParseError.EmptyInput — s1 is the variant name
                    vname = pat.s1
                } else if pat_kind == "MethodCall" {
                    // Qualified with args: ParseError.InvalidFormat(s) — s1 is variant, list has args
                    vname = pat.s1
                    has_destr = true
                    destr_list_start = pat.list_start
                    destr_list_count = pat.list_count
                } else if pat_kind == "Call" {
                    // Unqualified with args: InvalidFormat(s)
                    vname = pat.s1
                    has_destr = true
                    destr_list_start = pat.list_start
                    destr_list_count = pat.list_count
                }
                is_last := cai == node.list_count - 1
                vtag := _variant_tag(ll.registry, vname)
                if vname == "_" || (vtag == 0 && pat_kind == "Ident") {
                    // Wildcard or binding — always matches
                    if vname != "_" {
                        ll = _lenv_add(ll, vname, err_val.temp)
                    }
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    if body.temp >= 0 {
                        btype := _lget_type(ll, body.temp)
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        if btype == 12 {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                        } else {
                            // Clear second slot to prevent stale str len data
                            czero := _lnew_temp(ll)
                            ll = czero.l
                            ll = _lemit(ll, new_inst(OpConst, czero.temp, 0, 0, "", 0))
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, czero.temp, 0, "", 0))
                        }
                    }
                    ll = _lemit(ll, new_inst(OpJump, 0, catch_end.temp, 0, "", 0))
                } else if vtag > 0 {
                    // Variant match: compare tag
                    next_arm := _lnew_label(ll)
                    ll = next_arm.l
                    vtag_nt := _lnew_temp(ll)
                    ll = vtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                    vcmp := _lnew_temp(ll)
                    ll = vcmp.l
                    ll = _lemit(ll, new_inst(OpEq, vcmp.temp, err_tag_nt.temp, vtag_nt.temp, "", 0))
                    ll = _lemit(ll, new_inst(OpBranchFalse, 0, vcmp.temp, next_arm.temp, "", 0))
                    // Destructure variant fields if present
                    if has_destr {
                        vparent := _variant_parent(ll.registry, vname)
                        mut dfi := 0
                        mut dslot := 1
                        while dfi < destr_list_count {
                            arg_holder := pool_get(ll.pool, destr_list_start + dfi)
                            arg_node := pool_get(ll.pool, arg_holder.c0)
                            fname := arg_node.s1
                            ftype := variant_field_type(vparent, vtag, dfi)
                            if fname != "_" {
                                if ftype == 12 {
                                    fld_nt := _lnew_str_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, err_val.temp, dslot, fname, 0))
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp + 1, err_val.temp, dslot + 1, fname, 0))
                                    ll = _lset_type(ll, fld_nt.temp, 12)
                                    ll = _lenv_add(ll, fname, fld_nt.temp)
                                } else {
                                    fld_nt := _lnew_temp(ll)
                                    ll = fld_nt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, fld_nt.temp, err_val.temp, dslot, fname, 0))
                                    if ftype > 0 { ll = _lset_type(ll, fld_nt.temp, ftype) }
                                    ll = _lenv_add(ll, fname, fld_nt.temp)
                                }
                            }
                            if ftype == 12 { dslot = dslot + 2 } else { dslot = dslot + 1 }
                            dfi = dfi + 1
                        }
                    }
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    if body.temp >= 0 {
                        btype := _lget_type(ll, body.temp)
                        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, body.temp, 0, "", 0))
                        if btype == 12 {
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, body.temp + 1, 0, "", 0))
                        } else {
                            czero := _lnew_temp(ll)
                            ll = czero.l
                            ll = _lemit(ll, new_inst(OpConst, czero.temp, 0, 0, "", 0))
                            ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, czero.temp, 0, "", 0))
                        }
                    }
                    ll = _lemit(ll, new_inst(OpJump, 0, catch_end.temp, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpLabel, 0, next_arm.temp, 0, "", 0))
                } else {
                    // Unknown pattern — skip
                    body := _lower_expr_node(ll, body_idx)
                    ll = body.l
                    ll = _lemit(ll, new_inst(OpJump, 0, catch_end.temp, 0, "", 0))
                }
                cai = cai + 1
            }
            ll = _lemit(ll, new_inst(OpLabel, 0, catch_end.temp, 0, "", 0))
        } else {
            // Single-body catch: bind s1 as error and lower c1
            if node.s1.len() > 0 {
                ll = _lenv_add(ll, node.s1, err_val.temp)
            }
            handler := _lower_expr_node(ll, node.c1)
            ll = handler.l
            if handler.temp >= 0 {
                htype := _lget_type(ll, handler.temp)
                ll = _lemit(ll, new_inst(OpStore, result_nt.temp, handler.temp, 0, "", 0))
                if htype == 12 {
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, handler.temp + 1, 0, "", 0))
                } else {
                    czero := _lnew_temp(ll)
                    ll = czero.l
                    ll = _lemit(ll, new_inst(OpConst, czero.temp, 0, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, czero.temp, 0, "", 0))
                }
            }
        }
        ll = _lemit(ll, new_inst(OpJump, 0, end_lbl.temp, 0, "", 0))
        // Ok path: extract value from slot 1
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        ok_val := _lnew_temp(ll)
        ll = ok_val.l
        ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, expr.temp, 1, "_val", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp, ok_val.temp, 0, "", 0))
        // For string values, also extract length from slot 2
        ok_len := _lnew_temp(ll)
        ll = ok_len.l
        ll = _lemit(ll, new_inst(OpFieldGet, ok_len.temp, expr.temp, 2, "_val_len", 0))
        ll = _lemit(ll, new_inst(OpStore, result_nt.temp + 1, ok_len.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: result_nt.temp}
    }

    // --- Defer / With / Closure / Match — token fallback ---

    if nk == "Defer" {
        // Fall back to token-walking for defer
        tp := _find_tok_pos(ll, node.span.offset)
        ll = _lset_pos(ll, tp)
        ll = _lower_stmt(ll)
        return LT{l: ll, temp: -1}
    }

    if nk == "With" {
        // with name := resource_expr { body }
        // 1. Lower resource expression
        resource := _lower_expr_node(ll, node.c0)
        ll = resource.l
        // 2. Bind resource to name
        if node.s1.len() > 0 {
            ll = _lenv_add(ll, node.s1, resource.temp)
        }
        // 3. Determine drop function for cleanup
        res_slot := resource.temp
        obj_type := _lget_type(ll, res_slot)
        sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
        mut has_drop := false
        mut drop_fn := ""
        if sname != "" {
            drop_fn = sname + "_drop"
            drop_sig := reg_find_fn(ll.registry, drop_fn)
            if drop_sig.name != "" { has_drop = true }
        }
        // 4. Lower body block, capturing result
        body := _lower_expr_node(ll, node.c1)
        ll = body.l
        // 5. Emit drop call for resource cleanup
        if has_drop {
            dnt := _lnew_temp(ll)
            ll = dnt.l
            ll = _lemit(ll, new_inst(OpCall, dnt.temp, res_slot, 1, drop_fn, 0))
        }
        // 6. Return body's value
        return LT{l: ll, temp: body.temp}
    }

    if nk == "Closure" {
        return _lower_closure_node(ll, node)
    }

    if nk == "Match" {
        return _lower_match_node(ll, node)
    }

    // Fallback for unknown kinds
    nt := _lnew_temp(ll)
    return LT{l: nt.l, temp: nt.temp}
}

// --- AST For-Range helper ---

fn _lower_for_range_node(l: Lowerer, var_name: str, range_node: Expr, body_idx: i64) -> LT {
    return _lower_for_range_parts(l, var_name, range_node.c0, range_node.c1, range_node.b1, body_idx)
}

fn _lower_for_range_parts(l: Lowerer, var_name: str, start_idx: i64, end_idx: i64, inclusive: bool, body_idx: i64) -> LT {
    mut ll := l
    // Lower start and end of range
    start := _lower_expr_node(ll, start_idx)
    ll = start.l
    end_val := _lower_expr_node(ll, end_idx)
    ll = end_val.l
    // If inclusive, add 1 to end
    mut limit_temp := end_val.temp
    if inclusive {
        one_nt := _lnew_temp(ll)
        ll = one_nt.l
        ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
        inc_nt := _lnew_temp(ll)
        ll = inc_nt.l
        ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, end_val.temp, one_nt.temp, "", 0))
        limit_temp = inc_nt.temp
    }
    idx_nt := _lnew_temp(ll)
    ll = idx_nt.l
    ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, start.temp, 0, "", 0))
    loop_lbl := _lnew_label(ll)
    ll = loop_lbl.l
    end_lbl := _lnew_label(ll)
    ll = end_lbl.l
    inc_lbl := _lnew_label(ll)
    ll = inc_lbl.l
    ll = _lemit(ll, new_inst(OpLabel, 0, loop_lbl.temp, 0, "", 0))
    cond_nt := _lnew_temp(ll)
    ll = cond_nt.l
    ll = _lemit(ll, new_inst(OpLt, cond_nt.temp, idx_nt.temp, limit_temp, "", 0))
    ll = _lemit(ll, new_inst(OpBranchFalse, 0, cond_nt.temp, end_lbl.temp, "", 0))
    if var_name != "" {
        ll = _lenv_add(ll, var_name, idx_nt.temp)
    }
    prev_start := ll.loop_start
    prev_end := ll.loop_end
    ll = _lset_loop(ll, inc_lbl.temp, end_lbl.temp)
    body := _lower_expr_node(ll, body_idx)
    ll = body.l
    ll = _lset_loop(ll, prev_start, prev_end)
    ll = _lemit(ll, new_inst(OpLabel, 0, inc_lbl.temp, 0, "", 0))
    one_nt := _lnew_temp(ll)
    ll = one_nt.l
    ll = _lemit(ll, new_inst(OpConst, one_nt.temp, 1, 0, "", 0))
    inc_nt := _lnew_temp(ll)
    ll = inc_nt.l
    ll = _lemit(ll, new_inst(OpAdd, inc_nt.temp, idx_nt.temp, one_nt.temp, "", 0))
    ll = _lemit(ll, new_inst(OpStore, idx_nt.temp, inc_nt.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpJump, 0, loop_lbl.temp, 0, "", 0))
    ll = _lemit(ll, new_inst(OpLabel, 0, end_lbl.temp, 0, "", 0))
    LT{l: ll, temp: -1}
}

// --- AST Assign helper ---

fn _lower_assign_node(l: Lowerer, node: Expr) -> LT {
    mut ll := l
    lhs := pool_get(ll.pool, node.c0)
    lhs_nk := expr_kind_name(lhs.kind)
    result := _lower_expr_node(ll, node.c1)
    ll = result.l
    if lhs_nk == "Ident" {
        slot := _lenv_lookup(ll, lhs.s1)
        if slot >= 0 {
            ll = _lemit(ll, new_inst(OpStore, slot, result.temp, 0, "", 0))
            if _lget_type(ll, result.temp) == 12 {
                ll = _lemit(ll, new_inst(OpStore, slot + 1, result.temp + 1, 0, "", 0))
            }
            // Propagate type from RHS to the variable slot
            rhs_type := _lget_type(ll, result.temp)
            if rhs_type > 0 { ll = _lset_type(ll, slot, rhs_type) }
        }
    } else if lhs_nk == "FieldAccess" {
        recv := _lower_expr_node(ll, lhs.c0)
        ll = recv.l
        left_type := _lget_type(ll, recv.temp)
        sname := _struct_name_for_type(ll.store, ll.registry, left_type)
        mut fidx := 0
        if sname != "" {
            fidx = _field_index(ll.registry, sname, lhs.s1)
        } else {
            fidx = _field_index_any(ll.registry, lhs.s1)
        }
        ll = _lemit(ll, new_inst(OpFieldSet, recv.temp, result.temp, fidx, lhs.s1, 0))
        if _lget_type(ll, result.temp) == 12 {
            fidx_len := fidx + 1
            ll = _lemit(ll, new_inst(OpFieldSet, recv.temp, result.temp + 1, fidx_len, lhs.s1, 0))
        }
    } else if lhs_nk == "Index" {
        container := _lower_expr_node(ll, lhs.c0)
        ll = container.l
        subscript := _lower_expr_node(ll, lhs.c1)
        ll = subscript.l
        // Map index-assign: `m[k] = v`. Maps are type 300.
        ctype := _lget_type(ll, container.temp)
        if ctype == 300 {
            ll = _lemit(ll, new_inst(OpMapSet, 0, container.temp, subscript.temp, "", result.temp))
        } else {
            ll = _lemit(ll, new_inst(OpArraySet, container.temp, subscript.temp, result.temp, "", 0))
        }
    }
    LT{l: ll, temp: result.temp}
}

// --- AST Call handler ---

fn _lower_call_node(l: Lowerer, node: Expr) -> LT {
    mut ll := l
    name := node.s1

    // --- Special constructors ---

    if name == "Ok" || name == "Err" || name == "err" {
        if node.list_count > 0 {
            val := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = val.l
            val_type := _lget_type(ll, val.temp)
            mut result_slots := 2
            if val_type == 12 { result_slots = 3 }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, result_slots, 0, "_Result", 0))
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            mut tag_val := 0
            if name == "Err" || name == "err" { tag_val = 1 }
            ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, tag_val, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
            if val_type == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                val_len := val.temp + 1
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val_len, 2, "_val_len", 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
            }
            ll = _lset_type(ll, nt.temp, 200)
            return LT{l: ll, temp: nt.temp}
        }
    }

    if name == "Some" {
        if node.list_count > 0 {
            val := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = val.l
            val_type := _lget_type(ll, val.temp)
            mut opt_slots := 2
            if val_type == 12 { opt_slots = 3 }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, opt_slots, 0, "_Optional", 0))
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 1, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
            if val_type == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                val_len := val.temp + 1
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val_len, 2, "_val_len", 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
            }
            ll = _lset_type(ll, nt.temp, 201)
            return LT{l: ll, temp: nt.temp}
        }
    }

    if name == "Map" {
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 16, 0, "", 0))
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpMapNew, nt.temp, cap_nt.temp, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 300)
        return LT{l: ll, temp: nt.temp}
    }

    if name == "Set" {
        cap_nt := _lnew_temp(ll)
        ll = cap_nt.l
        ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 16, 0, "", 0))
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpSetNew, nt.temp, cap_nt.temp, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 301)
        return LT{l: ll, temp: nt.temp}
    }

    // Variant construction with data: Variant(arg1, arg2, ...)
    vtag := _variant_tag(ll.registry, name)
    if vtag > 0 {
        vparent := _variant_parent(ll.registry, name)
        vdc := variant_data_count(vparent, vtag)
        if vdc > 0 && node.list_count > 0 {
            alloc_sz := sum_alloc_size(vparent)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, vparent.name, 0))
            st_id := _struct_type_id(ll.registry, vparent.name)
            if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
            vtag_nt := _lnew_temp(ll)
            ll = vtag_nt.l
            ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, vtag_nt.temp, 0, "_tag", 0))
            mut vfi := 0
            while vfi < node.list_count {
                val := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + vfi).c0)
                ll = val.l
                mut vdata_slot := 1
                mut vsi := 0
                while vsi < vfi {
                    vft := variant_field_type(vparent, vtag, vsi)
                    if vft == 12 { vdata_slot = vdata_slot + 2 } else { vdata_slot = vdata_slot + 1 }
                    vsi = vsi + 1
                }
                vft := variant_field_type(vparent, vtag, vfi)
                if vft == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, vdata_slot, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp + 1, vdata_slot + 1, "", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, vdata_slot, "", 0))
                }
                vfi = vfi + 1
            }
            return LT{l: ll, temp: nt.temp}
        }
    }

    // Newtype construction: TypeName(value)
    nt_def := reg_find_struct(ll.registry, name)
    if nt_def.name != "" && nt_def.is_sum == false && _is_newtype(nt_def) && node.list_count > 0 {
        val := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = val.l
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpAlloc, nt.temp, 1, 0, name, 0))
        st_id := _struct_type_id(ll.registry, name)
        if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
        ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 0, "value", 0))
        return LT{l: ll, temp: nt.temp}
    }

    // --- Built-in functions ---

    // assertEqual(a, b) — compare and print both values on failure
    if name == "assertEqual" && node.list_count == 2 {
        arg_a := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = arg_a.l
        arg_b := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + 1).c0)
        ll = arg_b.l
        at := _lget_type(ll, arg_a.temp)
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        if at == 12 {
            eq_nt := _lnew_temp(ll)
            ll = eq_nt.l
            ll = _lemit(ll, new_inst(OpStrEq, eq_nt.temp, arg_a.temp, arg_b.temp, "", 0))
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, eq_nt.temp, ok_lbl.temp, "", 0))
        } else {
            eq_nt := _lnew_temp(ll)
            ll = eq_nt.l
            ll = _lemit(ll, new_inst(OpEq, eq_nt.temp, arg_a.temp, arg_b.temp, "", 0))
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, eq_nt.temp, ok_lbl.temp, "", 0))
        }
        // Print "assertEqual failed: a != b"
        msg := _lower_string_const(ll, "assertEqual failed")
        ll = msg.l
        pnt := _lnew_temp(ll)
        ll = pnt.l
        ll = _lemit(ll, new_inst(OpCall, pnt.temp, msg.temp, 2, "_aria_println_str", 0))
        exit_nt := _lnew_temp(ll)
        ll = exit_nt.l
        ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: 0}
    }

    // assertOk(result) — assert result is Ok (tag == 0)
    if name == "assertOk" && node.list_count == 1 {
        arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = arg.l
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, arg.temp, 0, "_tag", 0))
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        zero_nt := _lnew_temp(ll)
        ll = zero_nt.l
        ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
        cmp_nt := _lnew_temp(ll)
        ll = cmp_nt.l
        ll = _lemit(ll, new_inst(OpEq, cmp_nt.temp, tag_nt.temp, zero_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, cmp_nt.temp, ok_lbl.temp, "", 0))
        msg := _lower_string_const(ll, "assertOk failed: got Err")
        ll = msg.l
        pnt := _lnew_temp(ll)
        ll = pnt.l
        ll = _lemit(ll, new_inst(OpCall, pnt.temp, msg.temp, 2, "_aria_println_str", 0))
        exit_nt := _lnew_temp(ll)
        ll = exit_nt.l
        ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: 0}
    }

    // assertErr(result) — assert result is Err (tag != 0)
    if name == "assertErr" && node.list_count == 1 {
        arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = arg.l
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, arg.temp, 0, "_tag", 0))
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        zero_nt := _lnew_temp(ll)
        ll = zero_nt.l
        ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
        cmp_nt := _lnew_temp(ll)
        ll = cmp_nt.l
        ll = _lemit(ll, new_inst(OpNeq, cmp_nt.temp, tag_nt.temp, zero_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, cmp_nt.temp, ok_lbl.temp, "", 0))
        msg := _lower_string_const(ll, "assertErr failed: got Ok")
        ll = msg.l
        pnt := _lnew_temp(ll)
        ll = pnt.l
        ll = _lemit(ll, new_inst(OpCall, pnt.temp, msg.temp, 2, "_aria_println_str", 0))
        exit_nt := _lnew_temp(ll)
        ll = exit_nt.l
        ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: 0}
    }

    // assertNear(a, b, epsilon) — float approximate equality
    if name == "assertNear" && node.list_count == 3 {
        arg_a := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = arg_a.l
        arg_b := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + 1).c0)
        ll = arg_b.l
        arg_eps := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + 2).c0)
        ll = arg_eps.l
        // |a - b| <= epsilon
        diff := _lnew_temp(ll)
        ll = diff.l
        ll = _lemit(ll, new_inst(OpSub, diff.temp, arg_a.temp, arg_b.temp, "", 0))
        // abs: if diff < 0, negate
        neg_lbl := _lnew_label(ll)
        ll = neg_lbl.l
        done_lbl := _lnew_label(ll)
        ll = done_lbl.l
        abs_nt := _lnew_temp(ll)
        ll = abs_nt.l
        zero_nt := _lnew_temp(ll)
        ll = zero_nt.l
        ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
        lt_nt := _lnew_temp(ll)
        ll = lt_nt.l
        ll = _lemit(ll, new_inst(OpLt, lt_nt.temp, diff.temp, zero_nt.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, lt_nt.temp, neg_lbl.temp, "", 0))
        ll = _lemit(ll, new_inst(OpStore, abs_nt.temp, diff.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpJump, 0, done_lbl.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, neg_lbl.temp, 0, "", 0))
        neg_diff := _lnew_temp(ll)
        ll = neg_diff.l
        ll = _lemit(ll, new_inst(OpNeg, neg_diff.temp, diff.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpStore, abs_nt.temp, neg_diff.temp, 0, "", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, done_lbl.temp, 0, "", 0))
        // Check abs <= epsilon
        ok_lbl := _lnew_label(ll)
        ll = ok_lbl.l
        le_nt := _lnew_temp(ll)
        ll = le_nt.l
        ll = _lemit(ll, new_inst(OpLte, le_nt.temp, abs_nt.temp, arg_eps.temp, "", 0))
        ll = _lemit(ll, new_inst(OpBranchTrue, 0, le_nt.temp, ok_lbl.temp, "", 0))
        msg := _lower_string_const(ll, "assertNear failed: values not within epsilon")
        ll = msg.l
        pnt := _lnew_temp(ll)
        ll = pnt.l
        ll = _lemit(ll, new_inst(OpCall, pnt.temp, msg.temp, 2, "_aria_println_str", 0))
        exit_nt := _lnew_temp(ll)
        ll = exit_nt.l
        ll = _lemit(ll, new_inst(OpConst, exit_nt.temp, 1, 0, "", 0))
        ll = _lemit(ll, new_inst(OpCall, 0, exit_nt.temp, 1, "_aria_exit", 0))
        ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
        return LT{l: ll, temp: 0}
    }

    // dbg(expr) — print [file:line] value, return value
    if name == "dbg" && node.list_count == 1 {
        arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
        ll = arg.l
        at := _lget_type(ll, arg.temp)
        // Build prefix "[file:line] "
        prefix := "[" + ll.file + "] "
        prefix_res := _lower_string_const(ll, prefix)
        ll = prefix_res.l
        // Convert value to string
        if at == 12 {
            // String: print prefix + value directly
            cat := _lnew_str_temp(ll)
            ll = cat.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, prefix_res.temp, arg.temp, "", 0))
            pnt := _lnew_temp(ll)
            ll = pnt.l
            ll = _lemit(ll, new_inst(OpCall, pnt.temp, cat.temp, 2, "_aria_println_str", 0))
        } else {
            // Numeric: convert to string first
            vstr := _lnew_str_temp(ll)
            ll = vstr.l
            mut ph_hint := ""
            if _is_float_type(_lget_type(ll, arg.temp)) { ph_hint = "f64" }
            ll = _lemit(ll, new_inst(OpIntToStr, vstr.temp, arg.temp, 0, ph_hint, 0))
            cat := _lnew_str_temp(ll)
            ll = cat.l
            ll = _lemit(ll, new_inst(OpStrConcat, cat.temp, prefix_res.temp, vstr.temp, "", 0))
            pnt := _lnew_temp(ll)
            ll = pnt.l
            ll = _lemit(ll, new_inst(OpCall, pnt.temp, cat.temp, 2, "_aria_println_str", 0))
        }
        return LT{l: ll, temp: arg.temp}
    }

    if name == "println" || name == "print" || name == "eprintln" {
        if node.list_count > 0 {
            arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = arg.l
            mut print_temp := arg.temp
            arg_type := _lget_type(ll, arg.temp)
            if arg_type != 12 {
                conv_nt := _lnew_str_temp(ll)
                ll = conv_nt.l
                mut pn_hint := ""
                if _is_float_type(arg_type) { pn_hint = "f64" }
                ll = _lemit(ll, new_inst(OpIntToStr, conv_nt.temp, arg.temp, 0, pn_hint, 0))
                ll = _lset_type(ll, conv_nt.temp, 12)
                print_temp = conv_nt.temp
            }
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpCall, nt.temp, print_temp, 2, "_aria_println_str", 0))
            return LT{l: ll, temp: nt.temp}
        }
    }

    if name == "panic" {
        if node.list_count > 0 {
            arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = arg.l
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpCall, nt.temp, arg.temp, 1, "_aria_exit", 0))
            return LT{l: ll, temp: nt.temp}
        }
    }

    if name == "assert" {
        // Lower assert as: if !cond { panic }
        if node.list_count > 0 {
            cond := _lower_expr_node(ll, pool_get(ll.pool, node.list_start).c0)
            ll = cond.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, cond.temp, ok_lbl.temp, "", 0))
            // Panic on assertion failure
            mut panic_str_idx := mod_find_string(ll.module, "assertion failed")
            if panic_str_idx == 0 {
                new_mod := mod_add_string(ll.module, "assertion failed")
                panic_str_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            panic_ptr := _lnew_str_temp(ll)
            ll = panic_ptr.l
            ll = _lemit(ll, new_inst(OpConstStr, panic_ptr.temp, panic_str_idx, 16, "", 0))
            ll = _lemit(ll, new_inst(OpCall, 0, panic_ptr.temp, 2, "_aria_panic", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            nt := _lnew_temp(ll)
            ll = nt.l
            return LT{l: ll, temp: nt.temp}
        }
    }

    // --- Lower all args generically, then dispatch ---

    mut arg_temps := [0]
    mut arg_types := [0]
    mut ai := 0
    while ai < node.list_count {
        arg := _lower_expr_node(ll, pool_get(ll.pool, node.list_start + ai).c0)
        ll = arg.l
        arg_temps = arg_temps.append(arg.temp)
        arg_types = arg_types.append(_lget_type(ll, arg.temp))
        ai = ai + 1
    }

    // Registry function lookup
    sig := reg_find_fn(ll.registry, name)
    mut call_name := name
    mut call_sig := sig

    // Generic function specialization
    if sig.name != "" && fn_is_generic(sig) {
        call_name = _resolve_generic_call_name(ll.store, ll.registry, name, sig, arg_types)
        sp_sig := reg_find_fn(ll.registry, call_name)
        if sp_sig.name != "" && call_name != name {
            call_sig = sp_sig
        } else if call_name != name && arg_types.len() > 1 {
            // Specialized name resolved but no FnSig registered yet.
            // Create MonoSpec + specialized FnSig so the mono pass can lower it.
            first_concrete := arg_types[1]
            // Build specialized param types by substituting TypeVars with concrete types
            sp_ptypes := [0]
            mut spi := 1
            while spi < sig.param_types.len() {
                mut pt := sig.param_types[spi]
                if pt > 0 && pt < ll.store.types.len() {
                    pti := store_get(ll.store, pt)
                    if type_kind_name(pti.kind) == "TypeVar" { pt = first_concrete }
                }
                sp_ptypes = sp_ptypes.append(pt)
                spi = spi + 1
            }
            mut sp_ret := sig.return_type
            if sp_ret > 0 && sp_ret < ll.store.types.len() {
                rti := store_get(ll.store, sp_ret)
                if type_kind_name(rti.kind) == "TypeVar" { sp_ret = first_concrete }
            }
            new_sig := new_fn_sig(call_name, sig.param_names, sp_ptypes, sp_ret, sig.error_type)
            ll = _lset_reg(ll, reg_add_fn(ll.registry, new_sig))
            spec := MonoSpec{generic_name: name, specialized_name: call_name,
                             type_arg_0: first_concrete, type_arg_1: 0, type_arg_2: 0}
            ll = _lset_reg(ll, reg_add_mono(ll.registry, spec))
            call_sig = new_sig
        } else if arg_types.len() > 1 {
            // Fallback: HKT or derived-from-bound generics.
            first_concrete := arg_types[1]
            sp := reg_find_mono_by_generic(ll.registry, name, first_concrete)
            if sp.specialized_name == "" {
                mut msi := 1
                while msi < ll.registry.mono_specs.len() {
                    if ll.registry.mono_specs[msi].generic_name == name {
                        sp = ll.registry.mono_specs[msi]
                        msi = ll.registry.mono_specs.len()
                    }
                    msi = msi + 1
                }
            }
            if sp.specialized_name != "" {
                call_name = sp.specialized_name
                sp_sig2 := reg_find_fn(ll.registry, call_name)
                if sp_sig2.name != "" { call_sig = sp_sig2 }
            }
        }
    }

    if call_sig.name != "" || name.startsWith("_aria") {
        // Count registers needed
        mut reg_count := 0
        ai = 1
        while ai < arg_temps.len() {
            if arg_types[ai] == 12 { reg_count = reg_count + 2 } else { reg_count = reg_count + 1 }
            ai = ai + 1
        }
        // Check if args are consecutive
        mut already_consecutive := true
        if arg_temps.len() > 1 {
            mut expected := arg_temps[1]
            mut ci := 1
            while ci < arg_temps.len() {
                if arg_temps[ci] != expected { already_consecutive = false }
                if arg_types[ci] == 12 { expected = expected + 2 } else { expected = expected + 1 }
                ci = ci + 1
            }
        }
        mut fa := 0
        if already_consecutive && arg_temps.len() > 1 {
            fa = arg_temps[1]
        } else if arg_temps.len() > 1 {
            first_nt := _lnew_temp(ll)
            ll = first_nt.l
            mut ri := 1
            while ri < reg_count {
                extra := _lnew_temp(ll)
                ll = extra.l
                ri = ri + 1
            }
            mut slot := 0
            ai = 1
            while ai < arg_temps.len() {
                if arg_types[ai] == 12 {
                    ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot, arg_temps[ai], 0, "", 0))
                    slot_plus := slot + 1
                    ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot_plus, arg_temps[ai] + 1, 0, "", 0))
                    slot = slot + 2
                } else {
                    ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot, arg_temps[ai], 0, "", 0))
                    slot = slot + 1
                }
                ai = ai + 1
            }
            fa = first_nt.temp
        }
        // Determine return type and runtime name for _aria* builtins
        mut rt := 0
        mut runtime_name := call_name
        if call_sig.name != "" {
            rt = call_sig.return_type
        } else {
            // Map _aria* names to runtime names and return types
            runtime_name = _builtin_runtime_name(name)
            rt = _builtin_return_type(name)
        }
        // Allocate return temp
        mut nt_temp := 0
        if rt == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            nt_temp = nt.temp
        }
        ll = _lemit(ll, new_inst(OpCall, nt_temp, fa, reg_count, runtime_name, rt))
        if rt == 12 { ll = _lset_type(ll, nt_temp, 12) }
        if rt > 0 {
            if rt != 12 { ll = _lset_type(ll, nt_temp, rt) }
        }
        if call_sig.name != "" {
            if call_sig.return_type > 0 { ll = _lset_type(ll, nt_temp, call_sig.return_type) }
        }
        return LT{l: ll, temp: nt_temp}
    }

    // AST-based indirect call: name might be a local closure variable.
    // Only trigger if the env slot is closure-typed: either the 600 sentinel
    // (set by _lower_closure*) or a Function kind from the type store.
    fn_slot := _lenv_lookup(ll, name)
    mut is_closure_var := false
    if fn_slot >= 0 {
        slot_type := _lget_type(ll, fn_slot)
        if slot_type == 600 {
            is_closure_var = true
        } else if slot_type > 16 {
            ti_chk := store_get(ll.store, slot_type)
            if type_kind_name(ti_chk.kind) == "Function" {
                is_closure_var = true
            }
        }
    }
    if is_closure_var {
        closure_nt := _lnew_temp(ll)
        ll = closure_nt.l
        ll = _lemit(ll, new_inst(OpLoad, closure_nt.temp, fn_slot, 0, "", 0))
        fn_ptr_nt := _lnew_temp(ll)
        ll = fn_ptr_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr_nt.temp, closure_nt.temp, 0, "_fn", 0))
        env_ptr_nt := _lnew_temp(ll)
        ll = env_ptr_nt.l
        ll = _lemit(ll, new_inst(OpFieldGet, env_ptr_nt.temp, closure_nt.temp, 1, "_env", 0))
        pack_start := _lnew_temp(ll)
        ll = pack_start.l
        ll = _lemit(ll, new_inst(OpStore, pack_start.temp, env_ptr_nt.temp, 0, "", 0))
        mut pack_idx := 1
        mut iai := 1
        mut total_reg_count := 1
        while iai < arg_temps.len() {
            if arg_types[iai] == 12 {
                pack_t := _lnew_temp(ll)
                ll = pack_t.l
                ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg_temps[iai], 0, "", 0))
                pack_idx = pack_idx + 1
                pack_t2 := _lnew_temp(ll)
                ll = pack_t2.l
                ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg_temps[iai] + 1, 0, "", 0))
                pack_idx = pack_idx + 1
                total_reg_count = total_reg_count + 2
            } else {
                pack_t := _lnew_temp(ll)
                ll = pack_t.l
                ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, arg_temps[iai], 0, "", 0))
                pack_idx = pack_idx + 1
                total_reg_count = total_reg_count + 1
            }
            iai = iai + 1
        }
        mut ret_hint := ""
        mut ic_ret_type := 0
        fn_tid_ic := _lget_type(ll, fn_slot)
        if fn_tid_ic > 16 {
            ti_ic := store_get(ll.store, fn_tid_ic)
            if type_kind_name(ti_ic.kind) == "Function" {
                ic_ret_type = type_info_type_id(ti_ic)
                if ic_ret_type == 12 { ret_hint = "str" }
            }
        }
        if ic_ret_type == 12 {
            ic_nt_s := _lnew_str_temp(ll)
            ll = ic_nt_s.l
            ll = _lemit(ll, new_inst(OpCallIndirect, ic_nt_s.temp, fn_ptr_nt.temp, total_reg_count, ret_hint, pack_start.temp))
            ll = _lset_type(ll, ic_nt_s.temp, 12)
            return LT{l: ll, temp: ic_nt_s.temp}
        }
        ic_nt_r := _lnew_temp(ll)
        ll = ic_nt_r.l
        ll = _lemit(ll, new_inst(OpCallIndirect, ic_nt_r.temp, fn_ptr_nt.temp, total_reg_count, "", pack_start.temp))
        if ic_ret_type > 0 { ll = _lset_type(ll, ic_nt_r.temp, ic_ret_type) }
        return LT{l: ll, temp: ic_nt_r.temp}
    }

    // Fallback: indirect call (closure variable) or unknown function
    tp := _find_tok_pos(ll, _expr_start_offset(ll.pool, node.c0))
    ll = _lset_pos(ll, tp)
    return _lower_primary(ll)
}

// --- Builtin function name/type mapping ---

fn _builtin_runtime_name(name: str) -> str {
    if name == "_ariaReadFile" { return "_aria_read_file" }
    if name == "_ariaWriteFile" { return "_aria_write_file" }
    if name == "_ariaAppendFile" { return "_aria_append_file" }
    if name == "_ariaWriteBinaryFile" { return "_aria_write_binary_file" }
    if name == "_ariaExec" { return "_aria_exec" }
    if name == "_ariaArgs" { return "_aria_args" }
    if name == "_ariaListDir" { return "_aria_list_dir" }
    if name == "_ariaIsDir" { return "_aria_is_dir" }
    if name == "_ariaGetenv" { return "_aria_getenv" }
    if name == "_ariaTcpSocket" { return "_aria_tcp_socket" }
    if name == "_ariaTcpBind" { return "_aria_tcp_bind" }
    if name == "_ariaTcpListen" { return "_aria_tcp_listen" }
    if name == "_ariaTcpAccept" { return "_aria_tcp_accept" }
    if name == "_ariaTcpRead" { return "_aria_tcp_read" }
    if name == "_ariaTcpWrite" { return "_aria_tcp_write" }
    if name == "_ariaTcpClose" { return "_aria_tcp_close" }
    if name == "_ariaTcpPeerAddr" { return "_aria_tcp_peer_addr" }
    if name == "_ariaTcpSetTimeout" { return "_aria_tcp_set_timeout" }
    if name == "_ariaPgConnect" { return "_aria_pg_connect" }
    if name == "_ariaPgClose" { return "_aria_pg_close" }
    if name == "_ariaPgStatus" { return "_aria_pg_status" }
    if name == "_ariaPgError" { return "_aria_pg_error" }
    if name == "_ariaPgExec" { return "_aria_pg_exec" }
    if name == "_ariaPgExecParams" { return "_aria_pg_exec_params" }
    if name == "_ariaPgResultStatus" { return "_aria_pg_result_status" }
    if name == "_ariaPgResultError" { return "_aria_pg_result_error" }
    if name == "_ariaPgNrows" { return "_aria_pg_nrows" }
    if name == "_ariaPgNcols" { return "_aria_pg_ncols" }
    if name == "_ariaPgFieldName" { return "_aria_pg_field_name" }
    if name == "_ariaPgGetValue" { return "_aria_pg_get_value" }
    if name == "_ariaPgIsNull" { return "_aria_pg_is_null" }
    if name == "_ariaPgClear" { return "_aria_pg_clear" }
    if name == "_ariaSpawn" { return "_aria_spawn" }
    if name == "_ariaTaskAwait" { return "_aria_task_await" }
    if name == "_ariaChanNew" { return "_aria_chan_new" }
    if name == "_ariaChanSend" { return "_aria_chan_send" }
    if name == "_ariaChanRecv" { return "_aria_chan_recv" }
    if name == "_ariaChanClose" { return "_aria_chan_close" }
    if name == "_ariaMutexNew" { return "_aria_mutex_new" }
    if name == "_ariaMutexLock" { return "_aria_mutex_lock" }
    if name == "_ariaMutexUnlock" { return "_aria_mutex_unlock" }
    if name == "i2s" { return "i2s" }
    return name
}

fn _builtin_return_type(name: str) -> i64 {
    if name == "_ariaReadFile" || name == "_ariaGetenv" || name == "_ariaTcpRead" ||
       name == "_ariaTcpPeerAddr" || name == "_ariaPgError" || name == "_ariaPgResultError" ||
       name == "_ariaPgFieldName" || name == "_ariaPgGetValue" || name == "i2s" {
        return 12
    }
    if name == "_ariaArgs" || name == "_ariaListDir" {
        return 13  // returns [str] array
    }
    if name == "_ariaWriteFile" || name == "_ariaAppendFile" || name == "_ariaWriteBinaryFile" ||
       name == "_ariaTcpClose" || name == "_ariaPgClose" ||
       name == "_ariaPgClear" || name == "_ariaChanClose" || name == "_ariaMutexLock" ||
       name == "_ariaMutexUnlock" {
        return 0
    }
    return 1
}

// LEGACY: fn _lower_fn kept below for non-DeclIndex path
fn _lower_fn(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip fn
    if _lk(ll) != "IDENT" { return ll }
    name := _lcur(ll).text
    ll = _ladv(ll)

    sig := reg_find_fn(ll.registry, name)
    if sig.name == "" { return _skip_to_next_l(ll) }

    // Skip generic function bodies — they are lowered via monomorphization
    if fn_is_generic(sig) { return _skip_to_next_l(ll) }

    // Count actual register args (strings take 2 regs each)
    mut actual_param_count := 0
    mut pi := 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            actual_param_count = actual_param_count + 2
        } else {
            actual_param_count = actual_param_count + 1
        }
        pi = pi + 1
    }

    // Start a new IR function with actual register arg count
    ll = _lset_func(ll, new_ir_func(name, actual_param_count, sig.return_type))

    // Track error type for Ok wrapping and ? operator
    if sig.error_type > 0 {
        ll = _lset_error_type(ll, sig.error_type)
    }

    // Allocate temps for parameters
    pi = 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            // Track types for field access and string array detection
            if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                pt := sig.param_types[pi]
                // Check if this is a [str] array type
                if _is_str_array_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 13)
                } else if _is_trait_object_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 500)
                } else {
                    ll = _lset_type(ll, nt.temp, pt)
                }
            }
        }
        pi = pi + 1
    }

    // Skip to body
    lb := "\{"
    while _lk(ll) != "=" && _lk(ll) != lb && _lk(ll) != "EOF" {
        ll = _ladv(ll)
    }

    if _lk(ll) == "=" {
        ll = _ladv(ll)
        ll = _lskip_nl(ll)
        result := _lower_expr(ll)
        ll = result.l
        // Emit defers before return
        ll = _emit_defers(ll)
        // Implicit Ok wrapping for fallible functions (skip if already Ok/Err)
        if ll.fn_error_type > 0 && _lget_type(ll, result.temp) != 200 {
            ret_type := _lget_type(ll, result.temp)
            mut ok_slots := 2
            if ret_type == 12 { ok_slots = 3 }
            ok_nt := _lnew_temp(ll)
            ll = ok_nt.l
            ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
            if ret_type == 12 {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
                val_len := result.temp + 1
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
            } else {
                ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
            }
            ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
        } else {
            // Pass return type in type_id so emitter loads X1 for string returns
            ret_type := _lget_type(ll, result.temp)
            ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
        }
    } else if _lk(ll) == lb {
        ll = _lower_fn_body(ll, sig.return_type)
    } else {
        ll = _lskip_nl(ll)
        if _lk(ll) == lb {
            ll = _lower_fn_body(ll, sig.return_type)
        }
    }

    ll = _lfinish_func(ll)
    return ll
}

// --- Lower entry block ---

fn _lower_entry_ast(l: Lowerer, decl: DeclInfo) -> Lowerer {
    mut ll := l
    ll = _lset_pos(ll, decl.body_start)
    ll = _lset_func(ll, new_ir_func("_main", 0, 0))

    // Use AST path if available, with token fallback for robustness
    mut lowered := false
    if decl.node_idx > 0 {
        entry_node := pool_get(ll.pool, decl.node_idx)
        if entry_node.c0 > 0 {
            body := pool_get(ll.pool, entry_node.c0)
            if expr_kind_name(body.kind) == "Block" && body.list_count > 0 {
                result := _lower_block_node_result(ll, body)
                ll = result.l
                lowered = true
            }
        }
    }
    if lowered == false {
        // Fallback: token-based (handles cases where AST body is empty or missing)
        ll = _lset_pos(ll, decl.token_start)
        ll = _ladv(ll)  // skip entry
        lb := "\{"
        if _lk(ll) == lb {
            ll = _lower_block(ll)
        }
    }

    // Add exit call at end
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, nt.temp, 1, "_aria_exit", 0))

    ll = _lfinish_func(ll)
    mut new_mod := ll.module
    new_mod = mod_set_entry(new_mod, "_main")
    _lset_mod(ll, new_mod)
}

fn _lower_entry(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip entry
    ll = _lset_func(ll, new_ir_func("_main", 0, 0))

    lb := "\{"
    if _lk(ll) == lb {
        ll = _lower_block(ll)
    }

    // Add exit call at end
    nt := _lnew_temp(ll)
    ll = nt.l
    ll = _lemit(ll, new_inst(OpConst, nt.temp, 0, 0, "", 0))
    ll = _lemit(ll, new_inst(OpCall, 0, nt.temp, 1, "_aria_exit", 0))

    ll = _lfinish_func(ll)
    mut new_mod := ll.module
    new_mod = mod_set_entry(new_mod, "_main")
    _lset_mod(ll, new_mod)
}

// --- Lower test block ---

fn _lower_test(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip test

    // Get test name from string literal or identifier
    mut test_name := "_test_" + i2s(ll.module.test_count)
    mut test_label := "test " + i2s(ll.module.test_count)
    if _lk(ll) == "STRING" {
        test_label = _lcur(ll).text
        ll = _ladv(ll)
    } else if _lk(ll) == "IDENT" {
        test_label = _lcur(ll).text
        ll = _ladv(ll)
    }

    // Create IR function for this test
    ll = _lset_func(ll, new_ir_func(test_name, 0, 0))

    lb := "\{"
    if _lk(ll) == lb {
        ll = _lower_block(ll)
    }

    // Return void at end
    ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
    ll = _lfinish_func(ll)

    // Register test in module
    mut new_mod := mod_add_test(ll.module, test_label)
    // Also add the string constant for the test name for printing
    new_mod = mod_add_string(new_mod, test_label)
    _lset_mod(ll, new_mod)
}

// --- Lower extern declaration ---
// extern fn name(params) -> ret
// extern "lib" { fn name(...) -> ret; ... }

fn _lower_extern(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip extern
    lb := "\{"
    rb := "\}"

    // Check for library name: extern "libname" { ... }
    mut lib_name := ""
    if _lk(ll) == "STRING" {
        lib_name = _lcur(ll).text
        ll = _ladv(ll)
    }

    // Block form: extern "lib" { fn ...; fn ...; }
    if _lk(ll) == lb {
        ll = _ladv(ll)  // skip {
        ll = _lskip_nl(ll)
        while _lk(ll) != rb && _lk(ll) != "EOF" {
            ll = _lskip_nl(ll)
            if _lk(ll) == "fn" {
                ll = _lower_extern_fn(ll, lib_name)
            } else {
                ll = _ladv(ll)
            }
            ll = _lskip_nl(ll)
        }
        if _lk(ll) == rb { ll = _ladv(ll) }
        return ll
    }

    // Single form: extern fn name(params) -> ret
    if _lk(ll) == "fn" {
        ll = _lower_extern_fn(ll, lib_name)
    }
    ll
}

fn _lower_extern_fn(l: Lowerer, lib: str) -> Lowerer {
    mut ll := _ladv(l)  // skip fn
    if _lk(ll) != "IDENT" { return ll }
    name := _lcur(ll).text
    ll = _ladv(ll)

    // Parse parameters to count them and determine types
    mut param_count := 0
    mut is_variadic := false
    if _lk(ll) == "(" {
        ll = _ladv(ll)
        while _lk(ll) != ")" && _lk(ll) != "EOF" {
            if _lk(ll) == "." {
                // Check for ... (variadic)
                ll = _ladv(ll)
                if _lk(ll) == "." {
                    ll = _ladv(ll)
                    if _lk(ll) == "." { ll = _ladv(ll) }
                    is_variadic = true
                }
            } else if _lk(ll) == "IDENT" {
                ll = _ladv(ll)  // param name
                if _lk(ll) == ":" {
                    ll = _ladv(ll)
                    // Skip type annotation
                    ll = _skip_type_l(ll)
                }
                param_count = param_count + 1
            } else {
                ll = _ladv(ll)
            }
            if _lk(ll) == "," { ll = _ladv(ll) }
        }
        if _lk(ll) == ")" { ll = _ladv(ll) }
    }

    // Parse return type
    mut ret_type := "void"
    if _lk(ll) == "->" {
        ll = _ladv(ll)
        // Determine return type from type annotation
        if _lk(ll) == "IDENT" {
            rt := _lcur(ll).text
            if rt == "i64" || rt == "i32" || rt == "i16" || rt == "i8" { ret_type = "i64" }
            if rt == "u64" || rt == "u32" || rt == "u16" || rt == "u8" { ret_type = "i64" }
            if rt == "f64" || rt == "f32" { ret_type = "f64" }
            if rt == "bool" { ret_type = "i64" }
            if rt == "str" { ret_type = "str" }
        }
        ll = _skip_type_l(ll)
    }

    // Register extern function in module
    new_mod := mod_add_extern(ll.module, name, param_count, ret_type, lib)
    _lset_mod(ll, new_mod)
}

// --- Lower bench block ---
// bench "name" { body } — lowered like test but with iteration wrapper

fn _lower_bench(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip bench
    // Benches share the test_count sequence for unique naming but are NOT registered
    // as tests — otherwise the test runner would try to call non-existent _test_N
    // functions where benches were emitted as _bench_N.
    // Use funcs.len() for a collision-free bench index. test_count is skipped for
    // benches (see below), so two benches would otherwise collide on test_count.
    bidx := ll.module.funcs.len()
    mut bench_name := "_bench_" + i2s(bidx)
    mut bench_label := "bench " + i2s(bidx)
    if _lk(ll) == "STRING" {
        bench_label = _lcur(ll).text
        ll = _ladv(ll)
    } else if _lk(ll) == "IDENT" {
        bench_label = _lcur(ll).text
        ll = _ladv(ll)
    }
    ll = _lset_func(ll, new_ir_func(bench_name, 0, 0))
    lb := "\{"
    if _lk(ll) == lb {
        ll = _lower_block(ll)
    }
    ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
    ll = _lfinish_func(ll)
    // Record bench label string (for future bench runner) but do NOT increment test_count.
    mut new_mod := mod_add_string(ll.module, bench_label)
    _lset_mod(ll, new_mod)
}

// --- Lower before/after test fixtures ---

fn _lower_fixture(l: Lowerer, kind: str) -> Lowerer {
    mut ll := _ladv(l)  // skip before/after
    mut fname := "_before"
    if kind == "after" { fname = "_after" }
    ll = _lset_func(ll, new_ir_func(fname, 0, 0))
    lb := "\{"
    if _lk(ll) == lb {
        ll = _lower_block(ll)
    }
    ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
    ll = _lfinish_func(ll)
    ll
}

// --- Lower impl block ---

// DeclInfo-aware impl lowering — walks AST method children
fn _lower_impl_d(l: Lowerer, decl: DeclInfo) -> Lowerer {
    mut ll := _ladv(l)  // skip impl
    // Skip generic params [T: Bound] for blanket impls, capturing the bound trait name
    mut is_blanket := false
    mut bound_trait := ""
    if _lk(ll) == "[" {
        is_blanket = true
        ll = _ladv(ll)  // skip [
        // Parse: T : Bound
        if _lk(ll) == "IDENT" { ll = _ladv(ll) }  // skip T
        if _lk(ll) == ":" {
            ll = _ladv(ll)  // skip :
            if _lk(ll) == "IDENT" {
                bound_trait = _lcur(ll).text
                ll = _ladv(ll)
            }
        }
        // Skip any remaining tokens in brackets (e.g., "+ OtherBound")
        mut depth := 1
        while depth > 0 && _lk(ll) != "EOF" {
            if _lk(ll) == "[" { depth = depth + 1 }
            if _lk(ll) == "]" { depth = depth - 1 }
            if depth > 0 { ll = _ladv(ll) }
        }
        if _lk(ll) == "]" { ll = _ladv(ll) }
    }
    mut impl_type := ""
    if _lk(ll) == "IDENT" {
        impl_type = _lcur(ll).text
        ll = _ladv(ll)
    }
    if _lk(ll) == "for" {
        ll = _ladv(ll)
        if _lk(ll) == "IDENT" {
            impl_type = _lcur(ll).text
            ll = _ladv(ll)
        }
    }
    // For blanket impls, use empty prefix — BUT only if impl_type is a type parameter
    // (single letter or not a known struct), not a concrete type like Pair or Stack
    if is_blanket && impl_type.len() > 0 {
        sdef := reg_find_struct(ll.registry, impl_type)
        if sdef.name != "" {
            // It's a known concrete type — NOT a blanket impl
            is_blanket = false
        }
    }
    if is_blanket { impl_type = "" }

    // AST path: walk method children from EkImplDecl
    if decl.node_idx > 0 {
        impl_node := pool_get(ll.pool, decl.node_idx)
        // Position inside the impl block for token scanning
        ll = _lset_pos(ll, decl.body_start)
        lb2 := "\{"
        if _lk(ll) == lb2 { ll = _ladv(ll) }
        ll = _lskip_nl(ll)

        mut mi := 0
        while mi < impl_node.list_count {
            midx_node := pool_get(ll.pool, impl_node.list_start + mi)
            method_node := pool_get(ll.pool, midx_node.c0)
            raw_name := method_node.s1
            name := impl_type + "_" + raw_name

            sig := reg_find_fn(ll.registry, name)
            if sig.name != "" && fn_is_generic(sig) && is_blanket && bound_trait != "" && method_node.b1 {
                // Generic blanket method: register per-concrete-type generic sigs
                // so the mono pass can create _method_ConcreteType_U specializations.
                // Find correct token_start by scanning the impl body for fn <raw_name>
                mut method_tstart := sig.token_start
                mut scan_pos := decl.body_start
                while scan_pos < ll.tokens.len() - 1 {
                    if ll.tokens[scan_pos].name == "fn" {
                        if ll.tokens[scan_pos + 1].text == raw_name {
                            method_tstart = scan_pos
                            scan_pos = ll.tokens.len()
                        }
                    }
                    scan_pos = scan_pos + 1
                }
                concrete_types := treg_types_implementing(ll.treg, bound_trait)
                mut ci := 1
                while ci < concrete_types.len() {
                    ctype_name := concrete_types[ci]
                    spec_base := "_" + raw_name + "_" + ctype_name
                    existing_sig := reg_find_fn(ll.registry, spec_base)
                    if existing_sig.name == "" {
                        ctype_id := _struct_type_id(ll.registry, ctype_name)
                        mut sp_ptypes := [0]
                        mut spi := 1
                        while spi < sig.param_types.len() {
                            mut pt := sig.param_types[spi]
                            if spi == 1 && sig.param_names[spi] == "self" { pt = ctype_id }
                            sp_ptypes = sp_ptypes.append(pt)
                            spi = spi + 1
                        }
                        sp_sig := new_generic_fn_sig(spec_base, sig.param_names, sp_ptypes, sig.return_type, sig.error_type,
                            sig.generic_count, sig.generic_name_0, sig.generic_name_1, sig.generic_name_2,
                            sig.generic_bound_0, sig.generic_bound_1, sig.generic_bound_2, method_tstart)
                        ll = _lset_reg(ll, reg_add_fn(ll.registry, sp_sig))
                    }
                    ci = ci + 1
                }
            }
            if sig.name != "" && fn_is_generic(sig) == false && method_node.b1 {
                ll = _lower_impl_method_by_name(ll, impl_type, raw_name, sig)
                // For blanket impls, also emit specializations per concrete type.
                // Reset position to body start before each specialization so the
                // token-scan finds the method body.
                if is_blanket && bound_trait != "" {
                    concrete_types := treg_types_implementing(ll.treg, bound_trait)
                    mut ci := 1
                    while ci < concrete_types.len() {
                        ctype_name := concrete_types[ci]
                        ctype_id := _struct_type_id(ll.registry, ctype_name)
                        if ctype_id > 0 {
                            ll = _lset_pos(ll, decl.body_start)
                            ll = _lower_blanket_method_specialized(ll, raw_name, sig, ctype_name, ctype_id)
                        }
                        ci = ci + 1
                    }
                }
            }
            mi = mi + 1
        }
        ll = _lset_pos(ll, decl.body_end)
        return ll
    }

    // Legacy fallback
    ll = _lower_impl_legacy(ll, impl_type)
    return ll
}

// Lower a specific impl method — scans forward from current pos to find it
// Lower a blanket impl method specialized to a concrete type. Like
// _lower_impl_method_by_name, but the function name is "_<raw_name>_<concrete_type>"
// and the self parameter gets the concrete type's struct ID so self.X() dispatches
// to the concrete type's methods during body lowering.
fn _lower_blanket_method_specialized(l: Lowerer, raw_name: str, sig: FnSig, concrete_type: str, concrete_tid: i64) -> Lowerer {
    mut ll := l
    tlen := ll.tokens.len()
    mut search_pos := ll.pos
    lb := "\{"
    while search_pos < tlen {
        tk := ll.tokens[search_pos].name
        if tk == "fn" {
            next := search_pos + 1
            if next < tlen {
                if ll.tokens[next].text == raw_name {
                    ll = _lset_pos(ll, search_pos + 2)
                    // Count register args
                    mut actual_param_count := 0
                    mut pi := 1
                    while pi < sig.param_names.len() {
                        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
                            actual_param_count = actual_param_count + 2
                        } else {
                            actual_param_count = actual_param_count + 1
                        }
                        pi = pi + 1
                    }
                    // Specialized function name: "_raw_name_ConcreteType"
                    spec_fname := "_" + raw_name + "_" + concrete_type
                    ll = _lset_func(ll, new_ir_func(spec_fname, actual_param_count, sig.return_type))
                    // Allocate temps for parameters; self gets concrete_tid
                    pi = 1
                    while pi < sig.param_names.len() {
                        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
                            nt := _lnew_str_temp(ll)
                            ll = nt.l
                            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
                            ll = _lset_type(ll, nt.temp, 12)
                        } else {
                            nt := _lnew_temp(ll)
                            ll = nt.l
                            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
                            // Self (first param) gets concrete type; other params use sig
                            if pi == 1 && sig.param_names[pi] == "self" {
                                ll = _lset_type(ll, nt.temp, concrete_tid)
                            } else if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                                pt := sig.param_types[pi]
                                if _is_str_array_type(ll.store, pt) {
                                    ll = _lset_type(ll, nt.temp, 13)
                                } else {
                                    ll = _lset_type(ll, nt.temp, pt)
                                }
                            }
                        }
                        pi = pi + 1
                    }
                    // Skip to body
                    while _lk(ll) != "=" && _lk(ll) != lb && _lk(ll) != "EOF" {
                        ll = _ladv(ll)
                    }
                    if _lk(ll) == "=" {
                        ll = _ladv(ll)
                        ll = _lskip_nl(ll)
                        result := _lower_expr(ll)
                        ll = result.l
                        ret_type := _lget_type(ll, result.temp)
                        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
                    } else if _lk(ll) == lb {
                        ll = _lower_fn_body(ll, sig.return_type)
                    }
                    ll = _lfinish_func(ll)
                    return ll
                }
            }
        }
        search_pos = search_pos + 1
    }
    ll
}

fn _lower_impl_method_by_name(l: Lowerer, impl_type: str, raw_name: str, sig: FnSig) -> Lowerer {
    mut ll := l
    // Scan forward from current position to find fn <raw_name>
    tlen := ll.tokens.len()
    mut search_pos := ll.pos
    lb := "\{"
    while search_pos < tlen {
        tk := ll.tokens[search_pos].name
        if tk == "fn" {
            next := search_pos + 1
            if next < tlen {
                if ll.tokens[next].text == raw_name {
                    // Found it — position past fn + name
                    ll = _lset_pos(ll, search_pos + 2)

                    // Count actual register args
                    mut actual_param_count := 0
                    mut pi := 1
                    while pi < sig.param_names.len() {
                        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
                            actual_param_count = actual_param_count + 2
                        } else {
                            actual_param_count = actual_param_count + 1
                        }
                        pi = pi + 1
                    }

                    ll = _lset_func(ll, new_ir_func(impl_type + "_" + raw_name, actual_param_count, sig.return_type))

                    // Allocate temps for parameters
                    pi = 1
                    while pi < sig.param_names.len() {
                        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
                            nt := _lnew_str_temp(ll)
                            ll = nt.l
                            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
                            ll = _lset_type(ll, nt.temp, 12)
                        } else {
                            nt := _lnew_temp(ll)
                            ll = nt.l
                            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
                            if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                                pt := sig.param_types[pi]
                                if _is_str_array_type(ll.store, pt) {
                                    ll = _lset_type(ll, nt.temp, 13)
                                } else {
                                    ll = _lset_type(ll, nt.temp, pt)
                                }
                            }
                        }
                        pi = pi + 1
                    }

                    // Skip to body
                    while _lk(ll) != "=" && _lk(ll) != lb && _lk(ll) != "EOF" {
                        ll = _ladv(ll)
                    }

                    if _lk(ll) == "=" {
                        ll = _ladv(ll)
                        ll = _lskip_nl(ll)
                        result := _lower_expr(ll)
                        ll = result.l
                        ret_type := _lget_type(ll, result.temp)
                        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
                    } else if _lk(ll) == lb {
                        ll = _lower_fn_body(ll, sig.return_type)
                    }
                    ll = _lfinish_func(ll)
                    return ll
                }
            }
        }
        search_pos = search_pos + 1
    }
    ll
}

// Legacy impl lowering — token-walks the impl block
fn _lower_impl_legacy(l: Lowerer, impl_type: str) -> Lowerer {
    mut ll := l
    lb := "\{"
    rb := "\}"
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }
    if _lk(ll) != lb { return ll }
    ll = _ladv(ll)
    ll = _lskip_nl(ll)
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        ll = _lskip_pub(ll)
        if _lk(ll) == "fn" {
            ll = _lower_impl_fn(ll, impl_type)
        } else if _lk(ll) == rb || _lk(ll) == "EOF" {
            return ll
        } else {
            ll = _ladv(ll)
        }
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    return ll
}

fn _lower_impl(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip impl
    // Capture impl type name for qualified method names
    mut impl_type := ""
    if _lk(ll) == "IDENT" {
        impl_type = _lcur(ll).text
        ll = _ladv(ll)
    }
    if _lk(ll) == "for" {
        ll = _ladv(ll)
        if _lk(ll) == "IDENT" {
            impl_type = _lcur(ll).text
            ll = _ladv(ll)
        }
    }
    lb := "\{"
    rb := "\}"
    while _lk(ll) != lb && _lk(ll) != "EOF" { ll = _ladv(ll) }
    if _lk(ll) != lb { return ll }
    ll = _ladv(ll)
    ll = _lskip_nl(ll)
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lskip_nl(ll)
        ll = _lskip_pub(ll)
        if _lk(ll) == "fn" {
            ll = _lower_impl_fn(ll, impl_type)
        } else if _lk(ll) == rb || _lk(ll) == "EOF" {
            return ll
        } else {
            ll = _ladv(ll)
        }
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }
    return ll
}

// Lower a function inside an impl block — uses qualified name Type_method
fn _lower_impl_fn(l: Lowerer, impl_type: str) -> Lowerer {
    mut ll := _ladv(l)  // skip fn
    if _lk(ll) != "IDENT" { return ll }
    raw_name := _lcur(ll).text
    name := impl_type + "_" + raw_name
    ll = _ladv(ll)

    sig := reg_find_fn(ll.registry, name)
    if sig.name == "" { return _skip_to_next_l(ll) }

    // Skip generic method bodies — they are lowered via monomorphization
    if fn_is_generic(sig) { return _skip_to_next_l(ll) }

    // Count actual register args (strings take 2 regs each)
    mut actual_param_count := 0
    mut pi := 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            actual_param_count = actual_param_count + 2
        } else {
            actual_param_count = actual_param_count + 1
        }
        pi = pi + 1
    }

    ll = _lset_func(ll, new_ir_func(name, actual_param_count, sig.return_type))

    // Allocate temps for parameters
    pi = 1
    while pi < sig.param_names.len() {
        if pi <= sig.param_types.len() - 1 && sig.param_types[pi] == 12 {
            nt := _lnew_str_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            ll = _lset_type(ll, nt.temp, 12)
        } else {
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lenv_add(ll, sig.param_names[pi], nt.temp)
            if pi <= sig.param_types.len() - 1 && sig.param_types[pi] > 0 {
                pt := sig.param_types[pi]
                if _is_str_array_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 13)
                } else if _is_trait_object_type(ll.store, pt) {
                    ll = _lset_type(ll, nt.temp, 500)
                } else {
                    ll = _lset_type(ll, nt.temp, pt)
                }
            }
        }
        pi = pi + 1
    }

    // Skip to body
    lb := "\{"
    while _lk(ll) != "=" && _lk(ll) != lb && _lk(ll) != "EOF" {
        ll = _ladv(ll)
    }

    if _lk(ll) == "=" {
        ll = _ladv(ll)
        ll = _lskip_nl(ll)
        result := _lower_expr(ll)
        ll = result.l
        ret_type := _lget_type(ll, result.temp)
        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
    } else if _lk(ll) == lb {
        ll = _lower_fn_body(ll, sig.return_type)
    }
    ll = _lfinish_func(ll)
    ll
}

// --- Lower function body block { ... } with implicit return ---
// Like _lower_block but emits OpRet for the last expression if
// the function has a non-void return type.

fn _lower_fn_body(l: Lowerer, return_type: i64) -> Lowerer {
    lb := "\{"
    rb := "\}"
    if _lk(l) != lb { return l }
    mut ll := _ladv(l)  // skip {
    ll = _lskip_nl(ll)

    mut last_temp := -1
    while _lk(ll) != rb && _lk(ll) != "EOF" {
        // Check if this is the last statement before }
        // Lower it as an expression to capture its temp
        k := _lk(ll)
        if k == "return" {
            // Explicit return — lower normally, it emits OpRet
            ll = _lower_stmt(ll)
            last_temp = -1  // return already handled
        } else if k == "mut" || k == "break" || k == "continue" || k == "for" || k == "while" || k == "loop" || k == "assert" || k == "defer" || k == "with" {
            ll = _lower_stmt(ll)
        } else if k == "if" {
            result := _lower_if(ll)
            ll = result.l
            last_temp = result.temp
        } else if k == "match" {
            result := _lower_match(ll)
            ll = result.l
            last_temp = result.temp
        } else {
            // Expression or binding — capture the temp
            result := _lower_expr_result(ll)
            ll = result.l
            last_temp = result.temp
        }
        ll = _lskip_nl(ll)
    }
    if _lk(ll) == rb { ll = _ladv(ll) }

    // If function has a return type and we have a last expression temp,
    // and the last instruction isn't already a Ret/RetVoid, emit OpRet
    if return_type > 0 && last_temp >= 0 {
        // Check if last instruction is already a return
        inst_count := ll.current_func.insts.len()
        mut already_returned := false
        if inst_count > 1 {
            last_op := ir_op_name(ll.current_func.insts[inst_count - 1].op)
            if last_op == "Ret" || last_op == "RetVoid" {
                already_returned = true
            }
        }
        if already_returned == false {
            ll = _emit_defers(ll)
            ret_type := _lget_type(ll, last_temp)
            ll = _lemit(ll, new_inst(OpRet, 0, last_temp, 0, "", ret_type))
        }
    }
    return ll
}

// --- Lower expression statement, returning LT with result temp ---

fn _lower_expr_result(l: Lowerer) -> LT {
    if _lk(l) == "IDENT" {
        name := _lcur(l).text
        next_pos := l.pos + 1
        if next_pos < l.tokens.len() {
            next_k := l.tokens[next_pos].name
            if next_k == ":=" {
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip :=
                result := _lower_expr(ll)
                ll = result.l
                ll = _lenv_add(ll, name, result.temp)
                return LT{l: ll, temp: result.temp}
            }
            if next_k == "=" {
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip =
                result := _lower_expr(ll)
                ll = result.l
                slot := _lenv_lookup(ll, name)
                if slot >= 0 {
                    ll = _lemit(ll, new_inst(OpStore, slot, result.temp, 0, "", 0))
                    result_type := _lget_type(ll, result.temp)
                    if result_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, slot + 1, result.temp + 1, 0, "", 0))
                    }
                }
                return LT{l: ll, temp: result.temp}
            }
            if next_k == "+=" || next_k == "-=" || next_k == "*=" || next_k == "/=" || next_k == "%=" {
                op_k := next_k.substring(0, 1)
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip op
                slot := _lenv_lookup(ll, name)
                if slot >= 0 {
                    cur_nt := _lnew_temp(ll)
                    ll = cur_nt.l
                    ll = _lemit(ll, new_inst(OpLoad, cur_nt.temp, slot, 0, "", 0))
                    rhs := _lower_expr(ll)
                    ll = rhs.l
                    res_nt := _lnew_temp(ll)
                    ll = res_nt.l
                    cur_type := _lget_type(ll, slot)
                    if _is_float_type(cur_type) || _is_float_type(_lget_type(ll, rhs.temp)) {
                        ll = _lemit(ll, new_inst(_arith_op(op_k), res_nt.temp, cur_nt.temp, rhs.temp, "f64", 0))
                        ll = _lset_type(ll, res_nt.temp, 9)
                    } else {
                        ll = _lemit(ll, new_inst(_arith_op(op_k), res_nt.temp, cur_nt.temp, rhs.temp, "", 0))
                    }
                    ll = _lemit(ll, new_inst(OpStore, slot, res_nt.temp, 0, "", 0))
                    return LT{l: ll, temp: res_nt.temp}
                }
                return LT{l: ll, temp: -1}
            }
        }
    }
    // Plain expression
    return _lower_expr(l)
}

// --- Lower block { ... } ---

fn _lower_block(l: Lowerer) -> Lowerer {
    lb := "\{"
    rb := "\}"
    if _lk(l) != lb { return l }
    mut ll := _ladv(l)  // skip {
    ll = _lskip_nl(ll)
    scope_start := ll.env_names.len()

    while _lk(ll) != rb && _lk(ll) != "EOF" {
        ll = _lower_stmt(ll)
        ll = _lskip_nl(ll)
    }
    // Emit drops for bindings created in this block scope
    ll = _emit_drops_scoped(ll, scope_start)
    if _lk(ll) == rb { ll = _ladv(ll) }
    ll
}

// --- Lower statement ---

fn _lower_stmt(l: Lowerer) -> Lowerer {
    k := _lk(l)

    if k == "mut" { return _lower_mut_binding(l) }
    if k == "return" { return _lower_return(l) }
    if k == "break" {
        mut ll := _ladv(l)
        // Check for labeled break: break outer
        if _lk(ll) == "IDENT" {
            bname := _lcur(ll).text
            ll = _ladv(ll)
            label_end := _lenv_lookup(ll, "_label_" + bname)
            if label_end >= 0 {
                ll = _lemit(ll, new_inst(OpJump, 0, label_end, 0, "", 0))
            }
        } else if l.loop_end >= 0 {
            ll = _lemit(ll, new_inst(OpJump, 0, l.loop_end, 0, "", 0))
        }
        return ll
    }
    if k == "continue" {
        mut ll := _ladv(l)
        if l.loop_start >= 0 {
            ll = _lemit(ll, new_inst(OpJump, 0, l.loop_start, 0, "", 0))
        }
        return ll
    }
    if k == "yield" {
        // yield expr — in catch blocks, the yielded value becomes the catch result
        mut ll := _ladv(l)
        result := _lower_expr(ll)
        return result.l
    }
    if k == "for" { return _lower_for(l) }
    if k == "while" { return _lower_while(l) }
    if k == "loop" { return _lower_loop(l) }
    // Labeled loop: IDENT : for/while/loop — skip label and colon
    if k == "IDENT" && l.pos + 1 < l.tokens.len() && l.tokens[l.pos + 1].name == ":" {
        lp2 := l.pos + 2
        if lp2 < l.tokens.len() {
            lk := l.tokens[lp2].name
            if lk == "for" || lk == "while" || lk == "loop" {
                // Skip label and colon, dispatch to loop handler
                // The loop handler reads loop_label from the token stream
                // For now, just skip and dispatch — label is registered by AST path
                mut ll := _ladv(_ladv(_ladv(l)))  // skip IDENT : keyword
                if lk == "for" { return _lower_for(_lset_pos(l, lp2)) }
                if lk == "while" { return _lower_while(_lset_pos(l, lp2)) }
                return _lower_loop(_lset_pos(l, lp2))
            }
        }
    }
    if k == "if" {
        result := _lower_if(l)
        return result.l
    }
    if k == "assert" { return _lower_assert(l) }
    if k == "mock" {
        // mock fn_name with <closure_expr>
        // Lowers the closure and stores it in env under fn_name,
        // so subsequent calls to fn_name dispatch via CallIndirect.
        mut ll := _ladv(l)  // skip mock
        if _lk(ll) == "IDENT" {
            mock_name := _lcur(ll).text
            ll = _ladv(ll)
            if _lk(ll) == "with" {
                ll = _ladv(ll)
                mock_expr := _lower_expr(ll)
                ll = mock_expr.l
                ll = _lenv_add(ll, "_mock_" + mock_name, mock_expr.temp)
            }
        }
        return ll
    }
    if k == "with" {
        // with expr { body } — resource block with guaranteed cleanup
        // Check if this is effect clause (with [...]) or resource block
        mut ll := _ladv(l)  // skip with
        if _lk(ll) != "[" {
            // Check for named binding: with name := expr { body }
            mut res_name := ""
            if _lk(ll) == "IDENT" {
                next := ll.pos + 1
                if next < ll.tokens.len() && ll.tokens[next].name == ":=" {
                    res_name = _lcur(ll).text
                    ll = _ladv(ll)  // skip name
                    ll = _ladv(ll)  // skip :=
                }
            }
            // Resource block: lower resource expr
            resource := _lower_expr(ll)
            ll = resource.l
            if res_name.len() > 0 {
                ll = _lenv_add(ll, res_name, resource.temp)
            }
            // Store resource in a named slot for drop access
            res_slot := resource.temp
            // Determine the drop function name
            obj_type := _lget_type(ll, res_slot)
            sname := _struct_name_for_type(ll.store, ll.registry, obj_type)
            mut has_drop := false
            mut drop_fn := ""
            if sname != "" {
                drop_fn = sname + "_drop"
                drop_sig := reg_find_fn(ll.registry, drop_fn)
                if drop_sig.name != "" { has_drop = true }
            }
            // Save defer state, add synthetic defer for drop
            saved_defer_count := ll.defer_starts.len() - 1
            // We can't easily add a token-based defer for a synthesized call,
            // so we manually manage: lower body, then emit drop, and also
            // ensure _emit_defers in returns covers this.
            // Approach: lower the block, emit drops at the end, and rely on
            // _emit_drops_scoped for early return cleanup (resource is in env)
            scope_start := ll.env_names.len()
            ll = _lower_block(ll)
            // Emit resource drop after body
            if has_drop {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpCall, nt.temp, res_slot, 1, drop_fn, 0))
            }
            return ll
        }
        // Otherwise it's effect clause — skip (handled by checker, not lowerer)
        while _lk(ll) != "NEWLINE" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        return ll
    }
    if k == "spawn" {
        result := _lower_spawn(l)
        return result.l
    }
    if k == "scope" {
        result := _lower_scope(l)
        return result.l
    }
    if k == "select" {
        result := _lower_select(l)
        return result.l
    }
    if k == "defer" {
        mut ll := _ladv(l)  // skip defer
        // Save the token position of the deferred expression
        defer_start := ll.pos
        // Skip the expression tokens to find the end
        // Advance until newline or block end
        lb2 := "\{"
        if _lk(ll) == lb2 {
            ll = _skip_braces_l(ll)
        } else {
            while _lk(ll) != "NEWLINE" && _lk(ll) != "EOF" { ll = _ladv(ll) }
        }
        defer_end := ll.pos
        // Append defer position to dynamic arrays
        ll = _lappend_defer(ll, defer_start, defer_end)
        return ll
    }

    return _lower_expr_or_binding(l)
}

// --- Lower mut binding ---

fn _lower_mut_binding(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip mut
    if _lk(ll) != "IDENT" { return ll }
    name := _lcur(ll).text
    ll = _ladv(ll)

    // Check for type annotation to infer str type
    mut is_str_type := false
    if _lk(ll) == ":" {
        ll = _ladv(ll)
        if _lk(ll) == "IDENT" && _lcur(ll).text == "str" {
            is_str_type = true
        }
        ll = _skip_type_l(ll)
        if _lk(ll) == "=" { ll = _ladv(ll) }
    } else if _lk(ll) == ":=" {
        ll = _ladv(ll)
    }

    result := _lower_expr(ll)
    ll = result.l
    // Propagate type to binding
    if is_str_type {
        ll = _lset_type(ll, result.temp, 12)
    }
    ll = _lenv_add(ll, name, result.temp)
    return ll
}

// --- Lower return ---

fn _lower_return(l: Lowerer) -> Lowerer {
    mut ll := _ladv(l)  // skip return
    rb := "\}"
    if _lk(ll) == "NEWLINE" || _lk(ll) == "EOF" || _lk(ll) == rb {
        ll = _emit_defers(ll)
        ll = _lemit(ll, new_inst(OpRetVoid, 0, 0, 0, "", 0))
        return ll
    }
    result := _lower_expr(ll)
    ll = result.l
    ll = _emit_defers(ll)
    // Implicit Ok wrapping for fallible functions (skip if already Ok/Err)
    if ll.fn_error_type > 0 && _lget_type(ll, result.temp) != 200 {
        ret_type := _lget_type(ll, result.temp)
        mut ok_slots := 2
        if ret_type == 12 { ok_slots = 3 }
        ok_nt := _lnew_temp(ll)
        ll = ok_nt.l
        ll = _lemit(ll, new_inst(OpAlloc, ok_nt.temp, ok_slots, 0, "_Result", 0))
        tag_nt := _lnew_temp(ll)
        ll = tag_nt.l
        ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 0, 0, "", 0))
        ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, tag_nt.temp, 0, "_tag", 0))
        if ret_type == 12 {
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
            val_len := result.temp + 1
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, val_len, 2, "_val_len", 0))
        } else {
            ll = _lemit(ll, new_inst(OpFieldSet, ok_nt.temp, result.temp, 1, "_val", 0))
        }
        ll = _lemit(ll, new_inst(OpRet, 0, ok_nt.temp, 0, "", 0))
    } else {
        ret_type := _lget_type(ll, result.temp)
        ll = _lemit(ll, new_inst(OpRet, 0, result.temp, 0, "", ret_type))
    }
    return ll
}

// --- Lower expression or binding ---

fn _lower_expr_or_binding(l: Lowerer) -> Lowerer {
    // Tuple destructuring: (name1, name2) := expr
    if _lk(l) == "(" {
        mut scan := l.pos + 1
        mut is_tuple_destr := false
        while scan < l.tokens.len() {
            sk := l.tokens[scan].name
            if sk == ")" {
                next2 := scan + 1
                if next2 < l.tokens.len() && l.tokens[next2].name == ":=" {
                    is_tuple_destr = true
                }
                scan = l.tokens.len()
            } else if sk == "IDENT" || sk == "," || sk == "_" {
                scan = scan + 1
            } else {
                scan = l.tokens.len()
            }
        }
        if is_tuple_destr {
            mut ll := _ladv(l)  // skip (
            mut names := [""]
            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                if _lk(ll) == "IDENT" {
                    names = names.append(_lcur(ll).text)
                }
                ll = _ladv(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
            }
            if _lk(ll) == ")" { ll = _ladv(ll) }
            if _lk(ll) == ":=" { ll = _ladv(ll) }
            result := _lower_expr(ll)
            ll = result.l
            // Extract each element
            mut ni := 1
            while ni < names.len() {
                elt_nt := _lnew_temp(ll)
                ll = elt_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, elt_nt.temp, result.temp, ni - 1, names[ni], 0))
                ll = _lenv_add(ll, names[ni], elt_nt.temp)
                ni = ni + 1
            }
            return ll
        }
    }
    // Check for binding — handles both IDENT and keyword-as-identifier
    // Keywords (before, after, where, scope, etc.) followed by := are treated as bindings
    mut _is_binding_name := _lk(l) == "IDENT"
    if _is_binding_name == false && l.pos + 1 < l.tokens.len() {
        _nk := l.tokens[l.pos + 1].name
        if _nk == ":=" || _nk == ":" {
            _ck := _lk(l)
            if _ck != "fn" && _ck != "type" && _ck != "struct" && _ck != "enum" && _ck != "trait" && _ck != "impl" && _ck != "const" && _ck != "entry" && _ck != "test" && _ck != "if" && _ck != "match" && _ck != "for" && _ck != "while" && _ck != "loop" && _ck != "return" && _ck != "mut" && _ck != "break" && _ck != "continue" && _ck != "defer" && _ck != "assert" && _ck != "pub" && _ck != "use" && _ck != "mod" {
                _is_binding_name = true
            }
        }
    }
    if _is_binding_name {
        name := _lcur(l).text
        next_pos := l.pos + 1
        if next_pos < l.tokens.len() {
            next_k := l.tokens[next_pos].name
            if next_k == ":=" {
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip :=
                result := _lower_expr(ll)
                ll = result.l
                ll = _lenv_add(ll, name, result.temp)
                return ll
            }
            // Compound assignment: += -= *= /= %=
            if next_k == "+=" || next_k == "-=" || next_k == "*=" || next_k == "/=" || next_k == "%=" {
                // Single compound assign token (lexer emits +=/-=/etc. as one token)
                op_k := next_k.substring(0, 1)  // "+" from "+="
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip op (+= etc.)
                // Desugar: x += expr → x = x + expr
                slot := _lenv_lookup(ll, name)
                if slot >= 0 {
                    cur_nt := _lnew_temp(ll)
                    ll = cur_nt.l
                    ll = _lemit(ll, new_inst(OpLoad, cur_nt.temp, slot, 0, "", 0))
                    rhs := _lower_expr(ll)
                    ll = rhs.l
                    res_nt := _lnew_temp(ll)
                    ll = res_nt.l
                    cur_type := _lget_type(ll, slot)
                    if _is_float_type(cur_type) || _is_float_type(_lget_type(ll, rhs.temp)) {
                        ll = _lemit(ll, new_inst(_arith_op(op_k), res_nt.temp, cur_nt.temp, rhs.temp, "f64", 0))
                        ll = _lset_type(ll, res_nt.temp, 9)
                    } else {
                        ll = _lemit(ll, new_inst(_arith_op(op_k), res_nt.temp, cur_nt.temp, rhs.temp, "", 0))
                    }
                    ll = _lemit(ll, new_inst(OpStore, slot, res_nt.temp, 0, "", 0))
                }
                return ll
            }
            if next_k == "=" {
                // Assignment: name = expr
                mut ll := _ladv(l)   // skip name
                ll = _ladv(ll)       // skip =
                result := _lower_expr(ll)
                ll = result.l
                slot := _lenv_lookup(ll, name)
                if slot >= 0 {
                    ll = _lemit(ll, new_inst(OpStore, slot, result.temp, 0, "", 0))
                    // For strings, also copy the len slot
                    result_type := _lget_type(ll, result.temp)
                    if result_type == 12 {
                        ll = _lemit(ll, new_inst(OpStore, slot + 1, result.temp + 1, 0, "", 0))
                    }
                    // Propagate type to variable slot (critical for arrays that change type)
                    if result_type > 0 {
                        ll = _lset_type(ll, slot, result_type)
                    }
                }
                return ll
            }
        }
    }
    // Refutable binding: Variant(x) := expr else { ... }
    if _lk(l) == "IDENT" {
        rname := _lcur(l).text
        rvtag := _variant_tag(l.registry, rname)
        if rvtag > 0 {
            // Peek ahead for ( or { then ... := pattern
            mut rp := l.pos + 1
            lb := "\{"
            rb := "\}"
            // Skip over (...) or {...} to find :=
            if rp < l.tokens.len() {
                rpk := l.tokens[rp].name
                if rpk == "(" || rpk == lb {
                    mut close := ")"
                    if rpk == lb { close = rb }
                    mut depth := 1
                    rp = rp + 1
                    while rp < l.tokens.len() && depth > 0 {
                        rpk2 := l.tokens[rp].name
                        if rpk2 == rpk { depth = depth + 1 }
                        if rpk2 == close { depth = depth - 1 }
                        rp = rp + 1
                    }
                    // Now rp should be at :=
                    if rp < l.tokens.len() && l.tokens[rp].name == ":=" {
                        // Confirmed refutable binding pattern
                        mut ll := _ladv(l)  // skip variant name
                        // Parse destructuring bindings
                        mut rb_names := [""]  // sentinel
                        if _lk(ll) == "(" {
                            ll = _ladv(ll)  // skip (
                            ll = _lskip_nl(ll)
                            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                                if _lk(ll) == "IDENT" {
                                    rb_names = rb_names.append(_lcur(ll).text)
                                    ll = _ladv(ll)
                                } else {
                                    ll = _ladv(ll)
                                }
                                ll = _lskip_nl(ll)
                                if _lk(ll) == "," { ll = _ladv(ll) }
                                ll = _lskip_nl(ll)
                            }
                            if _lk(ll) == ")" { ll = _ladv(ll) }
                        } else if _lk(ll) == lb {
                            ll = _ladv(ll)  // skip {
                            ll = _lskip_nl(ll)
                            while _lk(ll) != rb && _lk(ll) != "EOF" {
                                if _lk(ll) == "IDENT" {
                                    fname := _lcur(ll).text
                                    ll = _ladv(ll)
                                    if _lk(ll) == ":" {
                                        ll = _ladv(ll)
                                        ll = _lskip_nl(ll)
                                        if _lk(ll) == "IDENT" {
                                            rb_names = rb_names.append(_lcur(ll).text)
                                            ll = _ladv(ll)
                                        }
                                    } else {
                                        rb_names = rb_names.append(fname)
                                    }
                                } else {
                                    ll = _ladv(ll)
                                }
                                ll = _lskip_nl(ll)
                                if _lk(ll) == "," { ll = _ladv(ll) }
                                ll = _lskip_nl(ll)
                            }
                            if _lk(ll) == rb { ll = _ladv(ll) }
                        }
                        // Skip :=
                        if _lk(ll) == ":=" { ll = _ladv(ll) }
                        // Lower RHS expression
                        rhs := _lower_expr(ll)
                        ll = rhs.l
                        // Extract tag and compare
                        rhs_tag := _lnew_temp(ll)
                        ll = rhs_tag.l
                        // Check if data sum or tag-only
                        rparent := _variant_parent(ll.registry, rname)
                        if rparent.name != "" && sum_has_data(rparent) {
                            ll = _lemit(ll, new_inst(OpFieldGet, rhs_tag.temp, rhs.temp, 0, "_tag", 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpStore, rhs_tag.temp, rhs.temp, 0, "", 0))
                        }
                        rtag_nt := _lnew_temp(ll)
                        ll = rtag_nt.l
                        ll = _lemit(ll, new_inst(OpConst, rtag_nt.temp, rvtag, 0, "", 0))
                        rcmp := _lnew_temp(ll)
                        ll = rcmp.l
                        ll = _lemit(ll, new_inst(OpEq, rcmp.temp, rhs_tag.temp, rtag_nt.temp, "", 0))
                        // Branch to else if no match
                        relse_lbl := _lnew_label(ll)
                        ll = relse_lbl.l
                        rcont_lbl := _lnew_label(ll)
                        ll = rcont_lbl.l
                        ll = _lemit(ll, new_inst(OpBranchFalse, 0, rcmp.temp, relse_lbl.temp, "", 0))
                        // Match: extract bindings
                        if rb_names.len() > 1 {
                            mut rbi := 1
                            while rbi < rb_names.len() {
                                mut rd_slot := 1
                                mut rsi := 1
                                while rsi < rbi {
                                    rft := variant_field_type(rparent, rvtag, rsi - 1)
                                    if rft == 12 { rd_slot = rd_slot + 2 } else { rd_slot = rd_slot + 1 }
                                    rsi = rsi + 1
                                }
                                rft := variant_field_type(rparent, rvtag, rbi - 1)
                                if rft == 12 {
                                    rbnt := _lnew_str_temp(ll)
                                    ll = rbnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, rbnt.temp, rhs.temp, rd_slot, "", 0))
                                    ll = _lemit(ll, new_inst(OpFieldGet, rbnt.temp + 1, rhs.temp, rd_slot + 1, "", 0))
                                    ll = _lset_type(ll, rbnt.temp, 12)
                                    ll = _lenv_add(ll, rb_names[rbi], rbnt.temp)
                                } else {
                                    rbnt := _lnew_temp(ll)
                                    ll = rbnt.l
                                    ll = _lemit(ll, new_inst(OpFieldGet, rbnt.temp, rhs.temp, rd_slot, "", 0))
                                    if rft != 0 { ll = _lset_type(ll, rbnt.temp, rft) }
                                    ll = _lenv_add(ll, rb_names[rbi], rbnt.temp)
                                }
                                rbi = rbi + 1
                            }
                        }
                        ll = _lemit(ll, new_inst(OpJump, 0, rcont_lbl.temp, 0, "", 0))
                        // Else block
                        ll = _lemit(ll, new_inst(OpLabel, 0, relse_lbl.temp, 0, "", 0))
                        // Skip `else` keyword
                        if _lk(ll) == "else" { ll = _ladv(ll) }
                        ll = _lskip_nl(ll)
                        // Optional |err| binding in else
                        if _lk(ll) == "|" {
                            ll = _ladv(ll)  // skip |
                            if _lk(ll) == "IDENT" {
                                ename := _lcur(ll).text
                                ll = _ladv(ll)
                                ll = _lenv_add(ll, ename, rhs.temp)
                            }
                            if _lk(ll) == "|" { ll = _ladv(ll) }
                        }
                        if _lk(ll) == lb {
                            ll = _lower_block(ll)
                        }
                        ll = _lemit(ll, new_inst(OpLabel, 0, rcont_lbl.temp, 0, "", 0))
                        return ll
                    }
                }
            }
        }
    }

    // Expression statement
    result := _lower_expr(l)
    return result.l
}

// --- Lower multiplicative (atom [*|/|% atom]*) ---
// Handles *, /, % which bind tighter than +, -

fn _lower_multiplicative(l: Lowerer) -> LT {
    result := _lower_atom(l)
    mut ll := result.l
    mut left := result.temp
    mut running := true
    while running {
        k := _lk(ll)
        if k == "*" || k == "/" || k == "%" {
            ll = _ladv(ll)
            right := _lower_atom(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if _is_float_type(left_type) || _is_float_type(right_type) {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
            } else {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 1)
            }
            left = nt.temp
        } else {
            running = false
        }
    }
    LT{l: ll, temp: left}
}

// --- Lower additive (multiplicative [+|- multiplicative]*) ---
// Handles +, - which bind tighter than comparison

fn _lower_additive(l: Lowerer) -> LT {
    result := _lower_multiplicative(l)
    mut ll := result.l
    mut left := result.temp
    mut running := true
    while running {
        k := _lk(ll)
        if k == "+" || k == "-" {
            ll = _ladv(ll)
            right := _lower_multiplicative(ll)
            ll = right.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if k == "+" && left_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpStrConcat, nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                left = nt.temp
            } else if _is_float_type(left_type) || _is_float_type(right_type) {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
                left = nt.temp
            } else {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 1)
                left = nt.temp
            }
        } else {
            running = false
        }
    }
    LT{l: ll, temp: left}
}

// --- Lower comparison (additive [cmp additive]) ---
// Used as right-hand side of && and || to get correct precedence

fn _lower_comparison(l: Lowerer) -> LT {
    result := _lower_additive(l)
    mut ll := result.l
    mut left := result.temp
    k := _lk(ll)
    if k == "==" || k == "!=" || k == "<" || k == ">" || k == "<=" || k == ">=" {
        ll = _ladv(ll)
        right := _lower_additive(ll)
        ll = right.l
        nt := _lnew_temp(ll)
        ll = nt.l
        left_type := _lget_type(ll, left)
        if (k == "==" || k == "!=") && left_type == 12 {
            ll = _lemit(ll, new_inst(OpStrEq, nt.temp, left, right.temp, "", 0))
            if k == "!=" {
                not_nt := _lnew_temp(ll)
                ll = not_nt.l
                ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                left = not_nt.temp
                ll = _lset_type(ll, not_nt.temp, 1)
            } else {
                left = nt.temp
            }
        } else if (k == "==" || k == "!=") && _is_struct_type(ll.store, ll.registry, left_type) {
            // Struct equality: compare field by field
            sname := _struct_name_for_type(ll.store, ll.registry, left_type)
            if sname != "" {
                eq_result := _lower_struct_eq(ll, left, right.temp, sname, nt.temp)
                ll = eq_result
                if k == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    left = not_nt.temp
                    ll = _lset_type(ll, not_nt.temp, 1)
                } else {
                    left = nt.temp
                }
            } else {
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "", 0))
                left = nt.temp
            }
        } else if _is_float_type(left_type) || _is_float_type(_lget_type(ll, right.temp)) {
            ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "f64", 0))
            left = nt.temp
        } else if left_type == 12 {
            cmp_nt := _lnew_temp(ll)
            ll = cmp_nt.l
            ll = _lemit(ll, new_inst(OpStrCmp, cmp_nt.temp, left, right.temp, "", 0))
            ll = _lset_type(ll, cmp_nt.temp, 1)
            zero_nt := _lnew_temp(ll)
            ll = zero_nt.l
            ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
            ll = _lset_type(ll, zero_nt.temp, 1)
            ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, cmp_nt.temp, zero_nt.temp, "", 0))
            left = nt.temp
        } else {
            ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "", 0))
            left = nt.temp
        }
        ll = _lset_type(ll, nt.temp, 1)
    }
    LT{l: ll, temp: left}
}

// --- Lower expression ---

fn _lower_expr(l: Lowerer) -> LT {
    result := _lower_primary(l)
    mut ll := result.l
    mut left := result.temp

    // Handle binary operators and postfix
    mut running := true
    while running {
        k := _lk(ll)

        if k == "+" || k == "-" {
            ll = _ladv(ll)
            right := _lower_multiplicative(ll)
            ll = right.l
            // Check if left operand is a string for +
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if k == "+" && left_type == 12 {
                nt := _lnew_str_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpStrConcat, nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 12)
                left = nt.temp
            } else if _is_float_type(left_type) || _is_float_type(right_type) {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
                left = nt.temp
            } else {
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 1)
                left = nt.temp
            }
        } else if k == "*" || k == "/" || k == "%" {
            ll = _ladv(ll)
            right := _lower_atom(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            left_type := _lget_type(ll, left)
            right_type := _lget_type(ll, right.temp)
            if _is_float_type(left_type) || _is_float_type(right_type) {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "f64", 0))
                ll = _lset_type(ll, nt.temp, 9)
            } else {
                ll = _lemit(ll, new_inst(_arith_op(k), nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, nt.temp, 1)
            }
            left = nt.temp
        } else if k == "==" || k == "!=" || k == "<" || k == ">" || k == "<=" || k == ">=" {
            ll = _ladv(ll)
            right := _lower_additive(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            left_type := _lget_type(ll, left)
            if (k == "==" || k == "!=") && left_type == 12 {
                ll = _lemit(ll, new_inst(OpStrEq, nt.temp, left, right.temp, "", 0))
                if k == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    left = not_nt.temp
                    ll = _lset_type(ll, not_nt.temp, 1)
                } else {
                    left = nt.temp
                }
            } else if (k == "==" || k == "!=") && _is_struct_type(ll.store, ll.registry, left_type) {
                sname := _struct_name_for_type(ll.store, ll.registry, left_type)
                if sname != "" {
                    eq_result := _lower_struct_eq(ll, left, right.temp, sname, nt.temp)
                    ll = eq_result
                    if k == "!=" {
                        not_nt := _lnew_temp(ll)
                        ll = not_nt.l
                        ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                        left = not_nt.temp
                        ll = _lset_type(ll, not_nt.temp, 1)
                    } else {
                        left = nt.temp
                    }
                } else {
                    ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "", 0))
                    left = nt.temp
                }
            } else if (k == "==" || k == "!=") && _is_option_or_result_type(ll.store, left_type) {
                // Option / Result equality — tag + payload compare.
                a_tag := _lnew_temp(ll)
                ll = a_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_tag.temp, left, 0, "_tag", 0))
                b_tag := _lnew_temp(ll)
                ll = b_tag.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_tag.temp, right.temp, 0, "_tag", 0))
                tag_eq := _lnew_temp(ll)
                ll = tag_eq.l
                ll = _lemit(ll, new_inst(OpEq, tag_eq.temp, a_tag.temp, b_tag.temp, "", 0))
                ll = _lset_type(ll, tag_eq.temp, 1)
                a_pay := _lnew_temp(ll)
                ll = a_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, a_pay.temp, left, 1, "_val", 0))
                b_pay := _lnew_temp(ll)
                ll = b_pay.l
                ll = _lemit(ll, new_inst(OpFieldGet, b_pay.temp, right.temp, 1, "_val", 0))
                pay_eq := _lnew_temp(ll)
                ll = pay_eq.l
                ll = _lemit(ll, new_inst(OpEq, pay_eq.temp, a_pay.temp, b_pay.temp, "", 0))
                ll = _lset_type(ll, pay_eq.temp, 1)
                mut combined := pay_eq.temp
                if _is_option_type(ll.store, left_type) {
                    zero_c := _lnew_temp(ll)
                    ll = zero_c.l
                    ll = _lemit(ll, new_inst(OpConst, zero_c.temp, 0, 0, "", 0))
                    is_none := _lnew_temp(ll)
                    ll = is_none.l
                    ll = _lemit(ll, new_inst(OpEq, is_none.temp, a_tag.temp, zero_c.temp, "", 0))
                    ll = _lset_type(ll, is_none.temp, 1)
                    or_nt := _lnew_temp(ll)
                    ll = or_nt.l
                    ll = _lemit(ll, new_inst(OpOr, or_nt.temp, is_none.temp, pay_eq.temp, "", 0))
                    ll = _lset_type(ll, or_nt.temp, 1)
                    combined = or_nt.temp
                }
                ll = _lemit(ll, new_inst(OpAnd, nt.temp, tag_eq.temp, combined, "", 0))
                if k == "!=" {
                    not_nt := _lnew_temp(ll)
                    ll = not_nt.l
                    ll = _lemit(ll, new_inst(OpNot, not_nt.temp, nt.temp, 0, "", 0))
                    left = not_nt.temp
                    ll = _lset_type(ll, not_nt.temp, 1)
                } else {
                    ll = _lset_type(ll, nt.temp, 1)
                    left = nt.temp
                }
            } else if _is_float_type(left_type) || _is_float_type(_lget_type(ll, right.temp)) {
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "f64", 0))
                left = nt.temp
            } else if left_type == 12 {
                cmp_nt := _lnew_temp(ll)
                ll = cmp_nt.l
                ll = _lemit(ll, new_inst(OpStrCmp, cmp_nt.temp, left, right.temp, "", 0))
                ll = _lset_type(ll, cmp_nt.temp, 1)
                zero_nt := _lnew_temp(ll)
                ll = zero_nt.l
                ll = _lemit(ll, new_inst(OpConst, zero_nt.temp, 0, 0, "", 0))
                ll = _lset_type(ll, zero_nt.temp, 1)
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, cmp_nt.temp, zero_nt.temp, "", 0))
                left = nt.temp
            } else {
                ll = _lemit(ll, new_inst(_cmp_op(k), nt.temp, left, right.temp, "", 0))
                left = nt.temp
            }
            ll = _lset_type(ll, nt.temp, 1)
        } else if k == "&&" {
            ll = _ladv(ll)
            right := _lower_comparison(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAnd, nt.temp, left, right.temp, "", 0))
            left = nt.temp
        } else if k == "||" {
            ll = _ladv(ll)
            right := _lower_comparison(ll)
            ll = right.l
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpOr, nt.temp, left, right.temp, "", 0))
            left = nt.temp
        } else if k == "|>" {
            ll = _ladv(ll)
            // Pipe: a |> f → f(a) or a |> f(args) → a.f(args) (method delegation)
            if _lk(ll) == "IDENT" {
                fname := _lcur(ll).text
                ll = _ladv(ll)
                // If pipe target is followed by (, delegate to method call
                // This handles: arr |> filter(pred), arr |> map(fn), etc.
                if _lk(ll) == "(" {
                    mr := _lower_method_call(ll, left, fname)
                    ll = mr.l
                    left = mr.temp
                } else {
                    // Simple pipe: a |> f → f(a)
                    pipe_sig := reg_find_fn(ll.registry, fname)
                    mut pipe_call_name := fname
                    mut pipe_call_sig := pipe_sig
                    if pipe_sig.name != "" && fn_is_generic(pipe_sig) {
                        left_type := _lget_type(ll, left)
                        suffix := _type_name_suffix(ll.store, left_type)
                        if suffix != "unknown" {
                            pipe_call_name = fname + "_" + suffix
                            sp_sig := reg_find_fn(ll.registry, pipe_call_name)
                            if sp_sig.name != "" { pipe_call_sig = sp_sig }
                        }
                    }
                    mut nt_temp := 0
                    if pipe_call_sig.name != "" && pipe_call_sig.return_type == 12 {
                        nt := _lnew_str_temp(ll)
                        ll = nt.l
                        nt_temp = nt.temp
                    } else {
                        nt := _lnew_temp(ll)
                        ll = nt.l
                        nt_temp = nt.temp
                    }
                    ll = _lemit(ll, new_inst(OpCall, nt_temp, left, 1, pipe_call_name, 0))
                    if pipe_call_sig.name != "" && pipe_call_sig.return_type == 12 {
                        ll = _lset_type(ll, nt_temp, 12)
                    } else if pipe_call_sig.name != "" && pipe_call_sig.return_type > 0 {
                        ll = _lset_type(ll, nt_temp, pipe_call_sig.return_type)
                    }
                    left = nt_temp
                }
            }
        } else if k == ".\{" {
            // Record update: base.{field: val, ...}
            ll = _ladv(ll)  // skip .{ token
            ll = _lskip_nl(ll)
            left_type := _lget_type(ll, left)
            ru_sname := _struct_name_for_type(ll.store, ll.registry, left_type)
            ru_sdef := reg_find_struct(ll.registry, ru_sname)
            alloc_sz := _struct_field_count(ll.registry, ru_sname)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, ru_sname, 0))
            if left_type > 0 { ll = _lset_type(ll, nt.temp, left_type) }
            // Copy all fields from base
            mut ci := 1
            while ci < ru_sdef.fields.len() {
                cname := ru_sdef.fields[ci].name
                c_slot := _field_index(ll.registry, ru_sname, cname)
                cft := ru_sdef.fields[ci].type_id
                if cft == 12 {
                    cs := _lnew_str_temp(ll)
                    ll = cs.l
                    ll = _lemit(ll, new_inst(OpFieldGet, cs.temp, left, c_slot, cname, 0))
                    cs_len := c_slot + 1
                    ll = _lemit(ll, new_inst(OpFieldGet, cs.temp + 1, left, cs_len, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, cs.temp, c_slot, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, cs.temp + 1, cs_len, cname, 0))
                } else {
                    ct := _lnew_temp(ll)
                    ll = ct.l
                    ll = _lemit(ll, new_inst(OpFieldGet, ct.temp, left, c_slot, cname, 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, ct.temp, c_slot, cname, 0))
                }
                ci = ci + 1
            }
            // Overwrite updated fields
            rb := "\}"
            while _lk(ll) != rb && _lk(ll) != "EOF" {
                if _lk(ll) == "IDENT" {
                    ufname := _lcur(ll).text
                    ll = _ladv(ll)  // skip field name
                    if _lk(ll) == ":" {
                        ll = _ladv(ll)  // skip :
                        fval := _lower_expr(ll)
                        ll = fval.l
                        uf_slot := _field_index(ll.registry, ru_sname, ufname)
                        ufi := reg_find_field(ll.registry, ru_sname, ufname)
                        if ufi.type_id == 12 {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, uf_slot, ufname, 0))
                            uf_slot_len := uf_slot + 1
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp + 1, uf_slot_len, ufname, 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, fval.temp, uf_slot, ufname, 0))
                        }
                    }
                } else {
                    ll = _ladv(ll)
                }
                ll = _lskip_nl(ll)
                if _lk(ll) == "," { ll = _ladv(ll) }
                ll = _lskip_nl(ll)
            }
            if _lk(ll) == rb { ll = _ladv(ll) }
            left = nt.temp
        } else if k == "." {
            ll = _ladv(ll)
            if _lk(ll) == "IDENT" {
                field := _lcur(ll).text
                ll = _ladv(ll)
                if _lk(ll) == "(" {
                    // Check if this is a module-qualified function call (e.g., log.info())
                    // If the function exists as a top-level name, call it directly
                    left_type := _lget_type(ll, left)
                    // Check if this is a variant construction: Type.Variant(args)
                    vtag := _variant_tag(ll.registry, field)
                    if vtag > 0 {
                        // Variant construction: Shape.Circle(5.0) → construct Circle variant
                        vparent := _variant_parent(ll.registry, field)
                        vdc := variant_data_count(vparent, vtag)
                        if vdc > 0 {
                            ll = _ladv(ll)  // skip (
                            ll = _lskip_nl(ll)
                            alloc_sz := sum_alloc_size(vparent)
                            vnt := _lnew_temp(ll)
                            ll = vnt.l
                            ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, alloc_sz, 0, vparent.name, 0))
                            st_id := _struct_type_id(ll.registry, vparent.name)
                            if st_id > 0 { ll = _lset_type(ll, vnt.temp, st_id) }
                            vtag_nt := _lnew_temp(ll)
                            ll = vtag_nt.l
                            ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                            ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, vtag_nt.temp, 0, "_tag", 0))
                            mut vfi := 0
                            mut vslot := 1
                            while _lk(ll) != ")" && _lk(ll) != "EOF" {
                                ll = _lskip_nl(ll)
                                val := _lower_expr(ll)
                                ll = val.l
                                vft := variant_field_type(vparent, vtag, vfi)
                                if vft == 12 {
                                    ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp, vslot, "", 0))
                                    ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp + 1, vslot + 1, "", 0))
                                    vslot = vslot + 2
                                } else {
                                    ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, val.temp, vslot, "", 0))
                                    vslot = vslot + 1
                                }
                                vfi = vfi + 1
                                ll = _lskip_nl(ll)
                                if _lk(ll) == "," { ll = _ladv(ll) }
                            }
                            if _lk(ll) == ")" { ll = _ladv(ll) }
                            left = vnt.temp
                        } else {
                            // Tag-only variant: Shape.Point
                            if _lk(ll) == "(" {
                                ll = _ladv(ll)
                                if _lk(ll) == ")" { ll = _ladv(ll) }
                            }
                            vnt := _lnew_temp(ll)
                            ll = vnt.l
                            if sum_has_data(vparent) {
                                alloc_sz := sum_alloc_size(vparent)
                                ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, alloc_sz, 0, vparent.name, 0))
                                st_id := _struct_type_id(ll.registry, vparent.name)
                                if st_id > 0 { ll = _lset_type(ll, vnt.temp, st_id) }
                                vtag_nt := _lnew_temp(ll)
                                ll = vtag_nt.l
                                ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                                ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, vtag_nt.temp, 0, "_tag", 0))
                            } else {
                                ll = _lemit(ll, new_inst(OpConst, vnt.temp, vtag, 0, "", 0))
                            }
                            left = vnt.temp
                        }
                    } else {
                    // Try module-qualified call: log.info() → info()
                    // Also try type-qualified call: Pair.new() → Pair_new()
                    mod_fn_sig := reg_find_fn(ll.registry, field)
                    if mod_fn_sig.name == "" {
                        // Try TypeName_method qualified name
                        left_name := _struct_name_for_type(ll.store, ll.registry, left_type)
                        if left_name == "" {
                            // left might be an unresolved ident — scan back to find Type in Type.method(
                            // pos is at (, pos-1 is method name, pos-2 is ., pos-3 is Type
                            if ll.pos > 3 && ll.tokens[ll.pos - 2].name == "." {
                                left_name = ll.tokens[ll.pos - 3].text
                            } else if ll.pos > 2 {
                                left_name = ll.tokens[ll.pos - 2].text
                            }
                        }
                        if left_name.len() > 0 {
                            qualified_name := left_name + "_" + field
                            mod_fn_sig = reg_find_fn(ll.registry, qualified_name)
                            if mod_fn_sig.name != "" { field = qualified_name }
                        }
                    }
                    if (left_type == 0 || mod_fn_sig.name != "") && mod_fn_sig.name != "" {
                        // Module-qualified or type-qualified call
                        ll = _ladv(ll)  // skip (
                        ll = _lskip_nl(ll)
                        // Determine if this is a method call (has self param) vs module function
                        // If sig has "self" as first param, prepend receiver as self arg
                        mut is_method := false
                        if mod_fn_sig.param_names.len() > 1 && mod_fn_sig.param_names[1] == "self" {
                            is_method = true
                        }
                        // Marshal self + explicit args
                        mut self_nt := _lnew_temp(ll)
                        ll = self_nt.l
                        if is_method {
                            ll = _lemit(ll, new_inst(OpStore, self_nt.temp, left, 0, "", 0))
                        }
                        mut arg_count := 0
                        mut reg_count := 0
                        if is_method {
                            left_tid := _lget_type(ll, left)
                            if left_tid == 12 { reg_count = reg_count + 2 } else { reg_count = reg_count + 1 }
                            arg_count = arg_count + 1
                        }
                        while _lk(ll) != ")" && _lk(ll) != "EOF" {
                            ll = _lskip_nl(ll)
                            arg := _lower_expr(ll)
                            ll = arg.l
                            extra := _lnew_temp(ll)
                            ll = extra.l
                            ll = _lemit(ll, new_inst(OpStore, self_nt.temp + reg_count, arg.temp, 0, "", 0))
                            atid := _lget_type(ll, arg.temp)
                            if atid == 12 { reg_count = reg_count + 2 } else { reg_count = reg_count + 1 }
                            arg_count = arg_count + 1
                            ll = _lskip_nl(ll)
                            if _lk(ll) == "," { ll = _ladv(ll) }
                        }
                        if _lk(ll) == ")" { ll = _ladv(ll) }
                        mut nt_temp := 0
                        if mod_fn_sig.return_type == 12 {
                            nt := _lnew_str_temp(ll)
                            ll = nt.l
                            nt_temp = nt.temp
                        } else {
                            nt := _lnew_temp(ll)
                            ll = nt.l
                            nt_temp = nt.temp
                        }
                        if arg_count > 0 {
                            ll = _lemit(ll, new_inst(OpCall, nt_temp, self_nt.temp, reg_count, field, 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpCall, nt_temp, 0, 0, field, 0))
                        }
                        if mod_fn_sig.return_type > 0 { ll = _lset_type(ll, nt_temp, mod_fn_sig.return_type) }
                        left = nt_temp
                    } else {
                        // Regular method call
                        mr := _lower_method_call(ll, left, field)
                        ll = mr.l
                        left = mr.temp
                    }
                    } // close variant else block
                } else if _lk(ll) == "[" && (field == "to" || field == "trunc") {
                    // Conversion with type arg: .to[Type]() or .trunc[Type]()
                    ll = _ladv(ll)  // skip [
                    mut target_type_name := ""
                    if _lk(ll) == "IDENT" {
                        target_type_name = _lcur(ll).text
                        ll = _ladv(ll)
                    }
                    if _lk(ll) == "]" { ll = _ladv(ll) }
                    if _lk(ll) == "(" { ll = _ladv(ll) }
                    if _lk(ll) == ")" { ll = _ladv(ll) }
                    mr := _lower_conversion(ll, left, field, target_type_name)
                    ll = mr.l
                    left = mr.temp
                } else {
                    // Check for no-data variant access: Type.Variant (no parens)
                    tok_vtag := _variant_tag(ll.registry, field)
                    if tok_vtag > 0 {
                        tok_vparent := _variant_parent(ll.registry, field)
                        tok_vdc := variant_data_count(tok_vparent, tok_vtag)
                        if tok_vdc == 0 {
                            tok_alloc := sum_alloc_size(tok_vparent)
                            if tok_alloc > 1 {
                                // Mixed sum type: heap-allocate with tag
                                vnt := _lnew_temp(ll)
                                ll = vnt.l
                                ll = _lemit(ll, new_inst(OpAlloc, vnt.temp, tok_alloc, 0, tok_vparent.name, 0))
                                st_id := _struct_type_id(ll.registry, tok_vparent.name)
                                if st_id > 0 { ll = _lset_type(ll, vnt.temp, st_id) }
                                vtag_nt := _lnew_temp(ll)
                                ll = vtag_nt.l
                                ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, tok_vtag, 0, "", 0))
                                ll = _lemit(ll, new_inst(OpFieldSet, vnt.temp, vtag_nt.temp, 0, "_tag", 0))
                                left = vnt.temp
                            } else {
                                // Pure no-data sum: just the tag
                                vnt := _lnew_temp(ll)
                                ll = vnt.l
                                ll = _lemit(ll, new_inst(OpConst, vnt.temp, tok_vtag, 0, "", 0))
                                left = vnt.temp
                            }
                        }
                    } else {
                    // Field access — use type-aware lookup
                    left_type := _lget_type(ll, left)
                    sname := _struct_name_for_type(ll.store, ll.registry, left_type)
                    mut fidx := 0
                    mut ft := 0
                    if sname != "" {
                        fidx = _field_index(ll.registry, sname, field)
                        ft = _field_type_id(ll, sname, field)
                    } else {
                        fidx = _field_index_any(ll.registry, field)
                        ft = _field_type_id_any(ll.registry, field)
                    }
                    // Bound method ref fallback: obj.method → closure capturing obj
                    has_fld := reg_find_field(ll.registry, sname, field)
                    if has_fld.name == "" && sname != "" {
                        qualified := sname + "_" + field
                        msig := reg_find_fn(ll.registry, qualified)
                        if msig.name != "" {
                            ll = _lset_reg(ll, reg_add_bound_fn_value_ref(ll.registry, qualified))
                            env_nt := _lnew_temp(ll)
                            ll = env_nt.l
