            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, err_lbl.temp, "", 0))
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, err_lbl.temp, 0, "", 0))
            // Check for error transform: ? |e| expr
            if _lk(ll) == "|" {
                ll = _ladv(ll)  // skip |
                mut transform_name := "_"
                if _lk(ll) == "IDENT" {
                    transform_name = _lcur(ll).text
                    ll = _ladv(ll)
                } else {
                    ll = _ladv(ll)
                }
                if _lk(ll) == "|" { ll = _ladv(ll) }
                // Bind error value
                err_val := _lnew_temp(ll)
                ll = err_val.l
                ll = _lemit(ll, new_inst(OpFieldGet, err_val.temp, left, 1, "_val", 0))
                if transform_name != "_" {
                    ll = _lenv_add(ll, transform_name, err_val.temp)
                }
                // Lower transform expression
                transform := _lower_expr(ll)
                ll = transform.l
                // Build new Err with transformed value and return
                new_err := _lnew_temp(ll)
                ll = new_err.l
                ll = _lemit(ll, new_inst(OpAlloc, new_err.temp, 2, 0, "_Result", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, new_err.temp, const_one.temp, 0, "_tag", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, new_err.temp, transform.temp, 1, "_val", 0))
                ll = _emit_defers(ll)
                ll = _lemit(ll, new_inst(OpRet, 0, new_err.temp, 0, "", 0))
            } else {
                ll = _emit_defers(ll)
                ll = _lemit(ll, new_inst(OpRet, 0, left, 0, "", 0))
            }
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            left = ok_val.temp
        } else if k == "!" {
            // Assert-unwrap in expression context
            ll = _ladv(ll)
            tag_nt := _lnew_temp(ll)
            ll = tag_nt.l
            ll = _lemit(ll, new_inst(OpFieldGet, tag_nt.temp, left, 0, "_tag", 0))
            const_one := _lnew_temp(ll)
            ll = const_one.l
            ll = _lemit(ll, new_inst(OpConst, const_one.temp, 1, 0, "", 0))
            is_err := _lnew_temp(ll)
            ll = is_err.l
            ll = _lemit(ll, new_inst(OpEq, is_err.temp, tag_nt.temp, const_one.temp, "", 0))
            panic_lbl := _lnew_label(ll)
            ll = panic_lbl.l
            ok_lbl := _lnew_label(ll)
            ll = ok_lbl.l
            ll = _lemit(ll, new_inst(OpBranchTrue, 0, is_err.temp, panic_lbl.temp, "", 0))
            ok_val := _lnew_temp(ll)
            ll = ok_val.l
            ll = _lemit(ll, new_inst(OpFieldGet, ok_val.temp, left, 1, "_val", 0))
            ll = _lemit(ll, new_inst(OpJump, 0, ok_lbl.temp, 0, "", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, panic_lbl.temp, 0, "", 0))
            mut panic_str_idx := mod_find_string(ll.module, "unwrap failed on Err value")
            if panic_str_idx == 0 {
                new_mod := mod_add_string(ll.module, "unwrap failed on Err value")
                panic_str_idx = new_mod.string_constants.len() - 1
                ll = _lset_mod(ll, new_mod)
            }
            panic_ptr := _lnew_str_temp(ll)
            ll = panic_ptr.l
            ll = _lemit(ll, new_inst(OpConstStr, panic_ptr.temp, panic_str_idx, 25, "", 0))
            ll = _lemit(ll, new_inst(OpCall, 0, panic_ptr.temp, 2, "_aria_panic", 0))
            ll = _lemit(ll, new_inst(OpLabel, 0, ok_lbl.temp, 0, "", 0))
            left = ok_val.temp
        } else {
            running = false
        }
    }

    LT{l: ll, temp: left}
}

// --- Lower primary expression ---

fn _lower_primary(l: Lowerer) -> LT {
    k := _lk(l)
    // Memory annotations: @stack, @arena(handle), @inline
    // For now, parse and skip — allocation still uses _aria_alloc
    // @stack is a hint for future optimization (LLVM alloca)
    // @arena(handle) would use _aria_arena_alloc instead of _aria_alloc
    // @inline is a compile-time layout hint (no-op for now)
    if k == "@" {
        mut ll := _ladv(l)  // skip @
        if _lk(ll) == "IDENT" {
            ann := _lcur(ll).text
            ll = _ladv(ll)  // skip annotation name
            // Skip optional (args)
            if _lk(ll) == "(" {
                ll = _ladv(ll)
                while _lk(ll) != ")" && _lk(ll) != "EOF" { ll = _ladv(ll) }
                if _lk(ll) == ")" { ll = _ladv(ll) }
            }
            // Continue lowering the annotated expression
            // The annotation is stored for future use but doesn't change codegen yet
            return _lower_primary(ll)
        }
        return _lower_primary(ll)
    }
    if k == "-" || k == "!" || k == "~" {
        ll := _ladv(l)
        operand := _lower_atom(ll)
        nt := _lnew_temp(operand.l)
        op_type := _lget_type(nt.l, operand.temp)
        if k == "-" && _is_float_type(op_type) {
            lll := _lemit(nt.l, new_inst(OpNeg, nt.temp, operand.temp, 0, "f64", 0))
            llll := _lset_type(lll, nt.temp, 9)
            return LT{l: llll, temp: nt.temp}
        }
        lll := _lemit(nt.l, new_inst(_unary_op(k), nt.temp, operand.temp, 0, "", 0))
        return LT{l: lll, temp: nt.temp}
    }

    if k == "INT" {
        val := _lcur(l).text
        num := _parse_int_literal(val)
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, num, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "DURATION" {
        // Duration literal: "30s", "5m", "100ms" etc. → nanoseconds as i64
        val := _lcur(l).text
        num := _parse_duration(val)
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, num, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "SIZE" {
        // Size literal: "64kb", "1mb" etc. → bytes as i64
        val := _lcur(l).text
        num := _parse_size(val)
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, num, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "FLOAT" {
        val := _lcur(l).text
        mut ll := _ladv(l)
        // Store float literal text as a string constant, then use its index
        mut str_idx := mod_find_string(ll.module, val)
        if str_idx == 0 {
            new_mod := mod_add_string(ll.module, val)
            str_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        // Use OpConstStr with arg2 = -9 as float marker
        // arg1 = string constant index, arg2 = -9 signals float
        nt := _lnew_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConstStr, nt.temp, str_idx, 0 - 9, "", 0))
        ll = _lset_type(ll, nt.temp, 9)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "STRING" {
        val := _lcur(l).text
        mut ll := _ladv(l)
        mut str_idx := mod_find_string(ll.module, val)
        if str_idx == 0 {
            new_mod := mod_add_string(ll.module, val)
            str_idx = new_mod.string_constants.len() - 1
            ll = _lset_mod(ll, new_mod)
        }
        nt := _lnew_str_temp(ll)
        ll = nt.l
        ll = _lemit(ll, new_inst(OpConstStr, nt.temp, str_idx, val.len(), "", 0))
        ll = _lset_type(ll, nt.temp, 12)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "CHAR" {
        val := _lcur(l).text
        // Store char as its first byte value (codepoint for ASCII)
        mut code := 0
        if val.len() > 0 {
            ch := val.charAt(0)
            // Map ASCII characters to their codepoint values
            code = _char_to_code(ch)
        }
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, code, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 13)  // TY_CHAR
        return LT{l: ll, temp: nt.temp}
    }

    // Raw strings and triple-quoted strings: treat as plain string constants
    if k == "RAW_STRING" || k == "TRIPLE_STRING" {
        val := _lcur(l).text
        return _lower_string_const(_ladv(l), val)
    }

    // Duration literals: convert to nanoseconds (i64)
    if k == "DURATION" {
        val := _lcur(l).text
        dur_ns := _parse_duration(val)
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, dur_ns, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    // Size literals: convert to bytes (i64)
    if k == "SIZE" {
        val := _lcur(l).text
        size_bytes := _parse_size(val)
        nt := _lnew_temp(l)
        mut ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, size_bytes, 0, "", 0))
        ll = _lset_type(ll, nt.temp, 1)
        return LT{l: ll, temp: nt.temp}
    }

    if k == "STRING_START" {
        return _lower_interpolated_string(l)
    }

    if k == "true" {
        nt := _lnew_temp(l)
        ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, 1, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }
    if k == "false" {
        nt := _lnew_temp(l)
        ll := _lemit(_ladv(nt.l), new_inst(OpConst, nt.temp, 0, 0, "", 0))
        return LT{l: ll, temp: nt.temp}
    }

    if k == "if" { return _lower_if(l) }
    if k == "match" { return _lower_match(l) }
    if k == "fn" { return _lower_closure(l) }
    if k == "spawn" { return _lower_spawn(l) }
    if k == "scope" { return _lower_scope(l) }
    if k == "select" { return _lower_select(l) }

    // self keyword — treat as variable reference
    if k == "self" {
        mut ll := _ladv(l)
        slot := _lenv_lookup(ll, "self")
        if slot >= 0 {
            src_type := _lget_type(ll, slot)
            nt := _lnew_temp(ll)
            ll = nt.l
            ll = _lemit(ll, new_inst(OpLoad, nt.temp, slot, 0, "", 0))
            if src_type != 0 { ll = _lset_type(ll, nt.temp, src_type) }
            return LT{l: ll, temp: nt.temp}
        }
    }

    // dyn TraitName(expr) — explicit trait object construction
    if k == "IDENT" && _lcur(l).text == "dyn" {
        mut ll := _ladv(l)  // skip dyn
        if _lk(ll) == "IDENT" {
            trait_name := _lcur(ll).text
            ll = _ladv(ll)  // skip trait name
            if _lk(ll) == "(" {
                ll = _ladv(ll)  // skip (
                // Lower the concrete value expression
                val := _lower_expr(ll)
                ll = val.l
                if _lk(ll) == ")" { ll = _ladv(ll) }
                // Determine concrete type from the value's type tracking
                obj_type := _lget_type(ll, val.temp)
                concrete_name := _struct_name_for_type(ll.store, ll.registry, obj_type)
                if concrete_name != "" {
                    result := _lower_make_trait_object(ll, val.temp, concrete_name, trait_name)
                    return result
                }
                // If we can't determine concrete type, just pass through
                return LT{l: ll, temp: val.temp}
            }
        }
    }

    // Keywords used as function names: treat as IDENT when followed by (
    mut is_kw_fn_call := false
    if k == "test" || k == "check" || k == "bench" || k == "where" {
        next_ll := _ladv(l)
        if _lk(next_ll) == "(" { is_kw_fn_call = true }
    }

    if k == "IDENT" || is_kw_fn_call {
        name := _lcur(l).text
        mut ll := _ladv(l)

        // Method reference: Type::method — rewrite as Type_method fn-value ref
        if _lk(ll) == ":" {
            next_pos := ll.pos + 1
            if next_pos < ll.tokens.len() && ll.tokens[next_pos].name == ":" {
                third_pos := ll.pos + 2
                if third_pos < ll.tokens.len() && ll.tokens[third_pos].name == "IDENT" {
                    meth_name := ll.tokens[third_pos].text
                    qualified := name + "_" + meth_name
                    // Advance past :: and method name
                    ll = _ladv(_ladv(_ladv(ll)))
                    // Check if qualified name resolves to a function
                    fsig := reg_find_fn(ll.registry, qualified)
                    if fsig.name != "" {
                        ll = _lset_reg(ll, reg_add_fn_value_ref(ll.registry, qualified))
                        clos := _lnew_temp(ll)
                        ll = clos.l
                        ll = _lemit(ll, new_inst(OpAlloc, clos.temp, 2, 0, "_Closure", 0))
                        fn_ref := _lnew_temp(ll)
                        ll = fn_ref.l
                        ll = _lemit(ll, new_inst(OpFnRef, fn_ref.temp, 0, 0, "_tramp_" + qualified, 0))
                        ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, fn_ref.temp, 0, "_fn", 0))
                        null_env := _lnew_temp(ll)
                        ll = null_env.l
                        ll = _lemit(ll, new_inst(OpConst, null_env.temp, 0, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpFieldSet, clos.temp, null_env.temp, 1, "_env", 0))
                        return LT{l: ll, temp: clos.temp}
                    }
                }
            }
        }

        // Function call or variant construction with data
        if _lk(ll) == "(" {
            // Ok(value) and Err(value) — Result construction
            if name == "Ok" || name == "Err" || name == "err" {
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                val := _lower_atom(ll)  // use _lower_atom to handle Type.Variant (field access)
                ll = val.l
                ll = _lskip_nl(ll)
                if _lk(ll) == ")" { ll = _ladv(ll) }
                val_type := _lget_type(ll, val.temp)
                // Determine alloc size: 2 slots (tag + val) or 3 (tag + str_ptr + str_len)
                mut result_slots := 2
                if val_type == 12 { result_slots = 3 }
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, result_slots, 0, "_Result", 0))
                // Set tag: 0 for Ok, 1 for Err
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                mut tag_val := 0
                if name == "Err" || name == "err" { tag_val = 1 }
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, tag_val, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                // Set value at slot 1 (and slot 2 for string len)
                if val_type == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                    val_len := val.temp + 1
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val_len, 2, "_val_len", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                }
                // Mark as Result so implicit Ok wrapping is skipped
                ll = _lset_type(ll, nt.temp, 200)
                return LT{l: ll, temp: nt.temp}
            }

            // Some(value) — Optional construction
            if name == "Some" {
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                val := _lower_expr(ll)
                ll = val.l
                ll = _lskip_nl(ll)
                if _lk(ll) == ")" { ll = _ladv(ll) }
                val_type := _lget_type(ll, val.temp)
                mut opt_slots := 2
                if val_type == 12 { opt_slots = 3 }
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, opt_slots, 0, "_Optional", 0))
                tag_nt := _lnew_temp(ll)
                ll = tag_nt.l
                ll = _lemit(ll, new_inst(OpConst, tag_nt.temp, 1, 0, "", 0))
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, tag_nt.temp, 0, "_tag", 0))
                if val_type == 12 {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                    val_len := val.temp + 1
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val_len, 2, "_val_len", 0))
                } else {
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 1, "_val", 0))
                }
                ll = _lset_type(ll, nt.temp, 201)  // type 201 = Optional
                return LT{l: ll, temp: nt.temp}
            }

            // Map() constructor
            if name == "Map" {
                ll = _ladv(ll)  // skip (
                if _lk(ll) == ")" { ll = _ladv(ll) }
                cap_nt := _lnew_temp(ll)
                ll = cap_nt.l
                ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 16, 0, "", 0))
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpMapNew, nt.temp, cap_nt.temp, 0, "", 0))
                ll = _lset_type(ll, nt.temp, 300)  // type 300 = Map
                return LT{l: ll, temp: nt.temp}
            }
            if name == "Set" {
                ll = _ladv(ll)  // skip (
                if _lk(ll) == ")" { ll = _ladv(ll) }
                cap_nt := _lnew_temp(ll)
                ll = cap_nt.l
                ll = _lemit(ll, new_inst(OpConst, cap_nt.temp, 16, 0, "", 0))
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpSetNew, nt.temp, cap_nt.temp, 0, "", 0))
                ll = _lset_type(ll, nt.temp, 301)  // type 301 = Set
                return LT{l: ll, temp: nt.temp}
            }

            // Check for variant construction first: Circle(5), Pair(1, 2)
            vtag := _variant_tag(ll.registry, name)
            if vtag > 0 {
                vparent := _variant_parent(ll.registry, name)
                vdc := variant_data_count(vparent, vtag)
                if vdc > 0 {
                    // Variant with tuple data
                    alloc_sz := sum_alloc_size(vparent)
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    ll = _lemit(ll, new_inst(OpAlloc, nt.temp, alloc_sz, 0, vparent.name, 0))
                    st_id := _struct_type_id(ll.registry, vparent.name)
                    if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
                    // Set tag at slot 0
                    vtag_nt := _lnew_temp(ll)
                    ll = vtag_nt.l
                    ll = _lemit(ll, new_inst(OpConst, vtag_nt.temp, vtag, 0, "", 0))
                    ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, vtag_nt.temp, 0, "_tag", 0))
                    // Parse and set data fields
                    ll = _ladv(ll)  // skip (
                    ll = _lskip_nl(ll)
                    mut vfi := 0
                    while _lk(ll) != ")" && _lk(ll) != "EOF" {
                        val := _lower_expr(ll)
                        ll = val.l
                        mut vdata_slot := 1
                        mut vsi := 0
                        while vsi < vfi {
                            vft := variant_field_type(vparent, vtag, vsi)
                            if vft == 12 {
                                vdata_slot = vdata_slot + 2
                            } else {
                                vdata_slot = vdata_slot + 1
                            }
                            vsi = vsi + 1
                        }
                        vft := variant_field_type(vparent, vtag, vfi)
                        if vft == 12 {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, vdata_slot, "", 0))
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp + 1, vdata_slot + 1, "", 0))
                        } else {
                            ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, vdata_slot, "", 0))
                        }
                        vfi = vfi + 1
                        ll = _lskip_nl(ll)
                        if _lk(ll) == "," { ll = _ladv(ll) }
                        ll = _lskip_nl(ll)
                    }
                    if _lk(ll) == ")" { ll = _ladv(ll) }
                    return LT{l: ll, temp: nt.temp}
                }
            }
            // Newtype construction: UserId(42) — allocate single-field struct
            nt_def := reg_find_struct(ll.registry, name)
            if nt_def.name != "" && nt_def.is_sum == false && _is_newtype(nt_def) {
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                val := _lower_expr(ll)
                ll = val.l
                ll = _lskip_nl(ll)
                if _lk(ll) == ")" { ll = _ladv(ll) }
                // Allocate struct with 1 slot for the value field
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpAlloc, nt.temp, 1, 0, name, 0))
                st_id := _struct_type_id(ll.registry, name)
                if st_id > 0 { ll = _lset_type(ll, nt.temp, st_id) }
                // Set value field at slot 0
                ll = _lemit(ll, new_inst(OpFieldSet, nt.temp, val.temp, 0, "value", 0))
                return LT{l: ll, temp: nt.temp}
            }
            // Check for mock binding — uses _mock_ prefix to avoid colliding with closure params
            mock_slot := _lenv_lookup(ll, "_mock_" + name)
            if mock_slot >= 0 && _lk(ll) == "(" {
                // Mocked function — redirect through closure in env
                closure_nt := _lnew_temp(ll)
                ll = closure_nt.l
                ll = _lemit(ll, new_inst(OpLoad, closure_nt.temp, mock_slot, 0, "", 0))
                fn_ptr_nt := _lnew_temp(ll)
                ll = fn_ptr_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, fn_ptr_nt.temp, closure_nt.temp, 0, "_fn", 0))
                env_ptr_nt := _lnew_temp(ll)
                ll = env_ptr_nt.l
                ll = _lemit(ll, new_inst(OpFieldGet, env_ptr_nt.temp, closure_nt.temp, 1, "_env", 0))
                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                mut ic_arg_count := 0
                mut ic_reg_count := 0
                mut first_arg := -1
                while _lk(ll) != ")" && _lk(ll) != "EOF" {
                    ll = _lskip_nl(ll)
                    arg := _lower_expr(ll)
                    ll = arg.l
                    if ic_arg_count == 0 { first_arg = arg.temp }
                    atid := _lget_type(ll, arg.temp)
                    if atid == 12 { ic_reg_count = ic_reg_count + 2 } else { ic_reg_count = ic_reg_count + 1 }
                    ic_arg_count = ic_arg_count + 1
                    ll = _lskip_nl(ll)
                    if _lk(ll) == "," { ll = _ladv(ll) }
                }
                if _lk(ll) == ")" { ll = _ladv(ll) }
                total_args := ic_reg_count + 1
                pack_start := _lnew_temp(ll)
                ll = pack_start.l
                ll = _lemit(ll, new_inst(OpStore, pack_start.temp, env_ptr_nt.temp, 0, "", 0))
                mut pack_idx := 1
                if ic_arg_count > 0 && first_arg >= 0 {
                    mut ai := 0
                    while ai < ic_arg_count {
                        pack_t := _lnew_temp(ll)
                        ll = pack_t.l
                        ll = _lemit(ll, new_inst(OpLoad, pack_t.temp, first_arg + ai, 0, "", 0))
                        ll = _lemit(ll, new_inst(OpStore, pack_start.temp + pack_idx, pack_t.temp, 0, "", 0))
                        pack_idx = pack_idx + 1
                        ai = ai + 1
                    }
                }
                nt := _lnew_temp(ll)
                ll = nt.l
                ll = _lemit(ll, new_inst(OpCallIndirect, nt.temp, fn_ptr_nt.temp, total_args, "", pack_start.temp))
                return LT{l: ll, temp: nt.temp}
            }
            sig := reg_find_fn(ll.registry, name)
            if sig.name != "" {
                // If generic, resolve to specialized name before lowering
                mut call_name := name
                mut call_sig := sig
                if fn_is_generic(sig) {
                    // We need to peek at arg types to build the specialized name.
                    // Save position, lower args, then use types to find specialization.
                    call_sig = sig  // placeholder, will be resolved after args
                }

                ll = _ladv(ll)  // skip (
                ll = _lskip_nl(ll)
                // Collect arg temps and types
                mut arg_temps := [0]
                mut arg_types := [0]
                mut param_idx := 1
                while _lk(ll) != ")" && _lk(ll) != "EOF" {
                    ll = _lskip_nl(ll)
                    arg := _lower_expr(ll)
                    ll = arg.l
                    arg_type := _lget_type(ll, arg.temp)
                    arg_temps = arg_temps.append(arg.temp)
                    arg_types = arg_types.append(arg_type)
                    param_idx = param_idx + 1
                    ll = _lskip_nl(ll)
                    if _lk(ll) == "," { ll = _ladv(ll) }
                }
                if _lk(ll) == ")" { ll = _ladv(ll) }

                // For generic functions, infer specialization from argument types
                if fn_is_generic(sig) {
                    call_name = _resolve_generic_call_name(ll.store, ll.registry, name, sig, arg_types)
                    // Look up the specialized sig (must be different from the generic)
                    sp_sig := reg_find_fn(ll.registry, call_name)
                    if sp_sig.name != "" && fn_is_generic(sp_sig) == false {
                        call_sig = sp_sig
                    } else if call_name != name && arg_types.len() > 1 {
                        // Specialization named but not yet registered — create
                        // MonoSpec + specialized FnSig so the mono pass emits it.
                        // Mirrors the AST-call path in _lower_call_node.
                        first_concrete := arg_types[1]
                        sp_ptypes := [0]
                        mut spi := 1
                        while spi < sig.param_types.len() {
                            mut pt := sig.param_types[spi]
                            if pt > 0 && pt < ll.store.types.len() {
                                pti := store_get(ll.store, pt)
                                if type_kind_name(pti.kind) == "TypeVar" { pt = first_concrete }
                            }
                            sp_ptypes = sp_ptypes.append(pt)
                            spi = spi + 1
                        }
                        mut sp_ret := sig.return_type
                        if sp_ret > 0 && sp_ret < ll.store.types.len() {
                            rti := store_get(ll.store, sp_ret)
                            if type_kind_name(rti.kind) == "TypeVar" { sp_ret = first_concrete }
                        }
                        new_sig := new_fn_sig(call_name, sig.param_names, sp_ptypes, sp_ret, sig.error_type)
                        ll = _lset_reg(ll, reg_add_fn(ll.registry, new_sig))
                        spec := MonoSpec{generic_name: name, specialized_name: call_name,
                                         type_arg_0: first_concrete, type_arg_1: 0, type_arg_2: 0}
                        ll = _lset_reg(ll, reg_add_mono(ll.registry, spec))
                        call_sig = new_sig
                    } else if arg_types.len() > 1 {
                        // Fallback: HKT or derived-from-bound generics.
                        sp := reg_find_mono_by_generic(ll.registry, name, arg_types[1])
                        if sp.specialized_name == "" {
                            mut msi := 1
                            while msi < ll.registry.mono_specs.len() {
                                if ll.registry.mono_specs[msi].generic_name == name {
                                    msi = ll.registry.mono_specs.len()
                                }
                                msi = msi + 1
                            }
                        }
                        if sp.specialized_name != "" {
                            call_name = sp.specialized_name
                            sp_sig2 := reg_find_fn(ll.registry, call_name)
                            if sp_sig2.name != "" { call_sig = sp_sig2 }
                        }
                    }
                }

                // Count registers needed
                mut reg_count := 0
                mut ai := 1
                while ai < arg_temps.len() {
                    if arg_types[ai] == 12 {
                        reg_count = reg_count + 2
                    } else {
                        reg_count = reg_count + 1
                    }
                    ai = ai + 1
                }
                // Check if args are already consecutive
                mut already_consecutive := true
                if arg_temps.len() > 1 {
                    mut expected := arg_temps[1]
                    mut ci := 1
                    while ci < arg_temps.len() {
                        if arg_temps[ci] != expected {
                            already_consecutive = false
                        }
                        if arg_types[ci] == 12 {
                            expected = expected + 2
                        } else {
                            expected = expected + 1
                        }
                        ci = ci + 1
                    }
                }
                mut fa := 0
                if already_consecutive && arg_temps.len() > 1 {
                    fa = arg_temps[1]
                } else if arg_temps.len() > 1 {
                    // Allocate consecutive temps and copy
                    first_nt := _lnew_temp(ll)
                    ll = first_nt.l
                    mut ri := 1
                    while ri < reg_count {
                        extra := _lnew_temp(ll)
                        ll = extra.l
                        ri = ri + 1
                    }
                    mut slot := 0
                    ai = 1
                    while ai < arg_temps.len() {
                        if arg_types[ai] == 12 {
                            ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot, arg_temps[ai], 0, "", 0))
                            slot_plus := slot + 1
                            ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot_plus, arg_temps[ai] + 1, 0, "", 0))
                            slot = slot + 2
                        } else {
                            ll = _lemit(ll, new_inst(OpStore, first_nt.temp + slot, arg_temps[ai], 0, "", 0))
                            slot = slot + 1
                        }
                        ai = ai + 1
                    }
                    fa = first_nt.temp
                }
                // Allocate return temp
                mut nt_temp := 0
                if call_sig.return_type == 12 {
                    nt := _lnew_str_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                } else {
                    nt := _lnew_temp(ll)
                    ll = nt.l
                    nt_temp = nt.temp
                }
                ll = _lemit(ll, new_inst(OpCall, nt_temp, fa, reg_count, call_name, call_sig.return_type))
                if call_sig.return_type == 12 {
                    ll = _lset_type(ll, nt_temp, 12)
                } else if call_sig.return_type > 0 {
                    ll = _lset_type(ll, nt_temp, call_sig.return_type)
                }
                return LT{l: ll, temp: nt_temp}
            }
            // Built-in function calls
            if name == "dbg" {
                ll = _ladv(ll)  // skip (
                arg := _lower_expr(ll)
                ll = arg.l
                if _lk(ll) == ")" { ll = _ladv(ll) }
