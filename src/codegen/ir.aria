mod codegen

// ============================================================
// Intermediate Representation
// Linear IR with flat structs and tag enums.
// Each instruction produces a value in a numbered temporary.
// ============================================================

// --- IR Operation ---

type IrOp =
    | OpConst
    | OpConstStr
    | OpAdd
    | OpSub
    | OpMul
    | OpDiv
    | OpMod
    | OpNeg
    | OpEq
    | OpNeq
    | OpLt
    | OpGt
    | OpLte
    | OpGte
    | OpAnd
    | OpOr
    | OpNot
    | OpBitAnd
    | OpBitOr
    | OpBitXor
    | OpShl
    | OpShr
    | OpCall
    | OpCallIndirect
    | OpFnRef
    | OpRet
    | OpRetVoid
    | OpArg
    | OpLocal
    | OpStore
    | OpLoad
    | OpFieldGet
    | OpFieldSet
    | OpAlloc
    | OpArrayNew
    | OpArrayGet
    | OpArraySet
    | OpArrayLen
    | OpArrayAppend
    | OpStrLen
    | OpStrConcat
    | OpStrEq
    | OpStrCmp
    | OpStrCharAt
    | OpStrSubstring
    | OpStrContains
    | OpStrStartsWith
    | OpStrEndsWith
    | OpStrIndexOf
    | OpStrTrim
    | OpStrReplace
    | OpStrToLower
    | OpStrToUpper
    | OpStrSplit
    | OpIntToStr
    | OpStrToInt
    | OpMapNew
    | OpMapSet
    | OpMapGet
    | OpMapContains
    | OpMapLen
    | OpMapKeys
    | OpSetNew
    | OpSetAdd
    | OpSetContains
    | OpSetLen
    | OpSetValues
    | OpSetRemove
    | OpJump
    | OpBranchTrue
    | OpBranchFalse
    | OpLabel
    | OpTraitObject
    | OpVtableCall
    | OpArraySlice
    | OpNop

fn ir_op_name(op: IrOp) -> str = match op {
    OpConst => "Const"
    OpConstStr => "ConstStr"
    OpAdd => "Add"
    OpSub => "Sub"
    OpMul => "Mul"
    OpDiv => "Div"
    OpMod => "Mod"
    OpNeg => "Neg"
    OpEq => "Eq"
    OpNeq => "Neq"
    OpLt => "Lt"
    OpGt => "Gt"
    OpLte => "Lte"
    OpGte => "Gte"
    OpAnd => "And"
    OpOr => "Or"
    OpNot => "Not"
    OpBitAnd => "BitAnd"
    OpBitOr => "BitOr"
    OpBitXor => "BitXor"
    OpShl => "Shl"
    OpShr => "Shr"
    OpCall => "Call"
    OpCallIndirect => "CallIndirect"
    OpFnRef => "FnRef"
    OpRet => "Ret"
    OpRetVoid => "RetVoid"
    OpArg => "Arg"
    OpLocal => "Local"
    OpStore => "Store"
    OpLoad => "Load"
    OpFieldGet => "FieldGet"
    OpFieldSet => "FieldSet"
    OpAlloc => "Alloc"
    OpArrayNew => "ArrayNew"
    OpArrayGet => "ArrayGet"
    OpArraySet => "ArraySet"
    OpArrayLen => "ArrayLen"
    OpArrayAppend => "ArrayAppend"
    OpStrLen => "StrLen"
    OpStrConcat => "StrConcat"
    OpStrEq => "StrEq"
    OpStrCmp => "StrCmp"
    OpStrCharAt => "StrCharAt"
    OpStrSubstring => "StrSubstring"
    OpStrContains => "StrContains"
    OpStrStartsWith => "StrStartsWith"
    OpStrEndsWith => "StrEndsWith"
    OpStrIndexOf => "StrIndexOf"
    OpStrTrim => "StrTrim"
    OpStrReplace => "StrReplace"
    OpStrToLower => "StrToLower"
    OpStrToUpper => "StrToUpper"
    OpStrSplit => "StrSplit"
    OpIntToStr => "IntToStr"
    OpStrToInt => "StrToInt"
    OpMapNew => "MapNew"
    OpMapSet => "MapSet"
    OpMapGet => "MapGet"
    OpMapContains => "MapContains"
    OpMapLen => "MapLen"
    OpMapKeys => "MapKeys"
    OpSetNew => "SetNew"
    OpSetAdd => "SetAdd"
    OpSetContains => "SetContains"
    OpSetLen => "SetLen"
    OpSetValues => "SetValues"
    OpSetRemove => "SetRemove"
    OpJump => "Jump"
    OpBranchTrue => "BranchTrue"
    OpBranchFalse => "BranchFalse"
    OpLabel => "Label"
    OpTraitObject => "TraitObject"
    OpVtableCall => "VtableCall"
    OpArraySlice => "ArraySlice"
    OpNop => "Nop"
}

// --- IR Instruction ---

struct IrInst {
    op: IrOp
    dest: i64
    arg1: i64
    arg2: i64
    s1: str
    type_id: i64
}

fn _sentinel_inst() -> IrInst =
    IrInst{op: OpNop, dest: 0, arg1: 0, arg2: 0, s1: "", type_id: 0}

fn new_inst(op: IrOp, dest: i64, arg1: i64, arg2: i64, s1: str, tid: i64) -> IrInst =
    IrInst{op: op, dest: dest, arg1: arg1, arg2: arg2, s1: s1, type_id: tid}

// --- IR Function ---

struct IrFunc {
    name: str
    param_count: i64
    insts: [IrInst]
    return_type: i64
    local_count: i64
    temp_types: [i64]
}

fn _sentinel_func() -> IrFunc =
    IrFunc{name: "", param_count: 0, insts: [_sentinel_inst()], return_type: 0, local_count: 0, temp_types: [0]}

fn new_ir_func(name: str, param_count: i64, ret_type: i64) -> IrFunc =
    IrFunc{name: name, param_count: param_count, insts: [_sentinel_inst()], return_type: ret_type, local_count: 0, temp_types: [0]}

fn func_add_inst(f: IrFunc, inst: IrInst) -> IrFunc =
    IrFunc{name: f.name, param_count: f.param_count,
           insts: f.insts.append(inst), return_type: f.return_type,
           local_count: f.local_count, temp_types: f.temp_types}

fn func_set_locals(f: IrFunc, count: i64) -> IrFunc =
    IrFunc{name: f.name, param_count: f.param_count,
           insts: f.insts, return_type: f.return_type,
           local_count: count, temp_types: f.temp_types}

fn func_set_temp_types(f: IrFunc, types: [i64]) -> IrFunc =
    IrFunc{name: f.name, param_count: f.param_count,
           insts: f.insts, return_type: f.return_type,
           local_count: f.local_count, temp_types: types}

fn func_inst_count(f: IrFunc) -> i64 = f.insts.len() - 1  // minus sentinel

// --- IR Module ---

struct IrModule {
    funcs: [IrFunc]
    string_constants: [str]
    entry_func: str
    test_count: i64
    test_names: [str]
    // FFI: extern function declarations
    extern_names: [str]
    extern_param_counts: [i64]
    extern_ret_types: [str]
    extern_libs: [str]
}

fn new_ir_module() -> IrModule =
    IrModule{funcs: [_sentinel_func()], string_constants: [""], entry_func: "", test_count: 0, test_names: [""],
             extern_names: [""], extern_param_counts: [0], extern_ret_types: [""], extern_libs: [""]}

fn mod_add_func(m: IrModule, f: IrFunc) -> IrModule =
    IrModule{funcs: m.funcs.append(f), string_constants: m.string_constants, entry_func: m.entry_func, test_count: m.test_count, test_names: m.test_names,
             extern_names: m.extern_names, extern_param_counts: m.extern_param_counts, extern_ret_types: m.extern_ret_types, extern_libs: m.extern_libs}

fn mod_add_string(m: IrModule, s: str) -> IrModule =
    IrModule{funcs: m.funcs, string_constants: m.string_constants.append(s), entry_func: m.entry_func, test_count: m.test_count, test_names: m.test_names,
             extern_names: m.extern_names, extern_param_counts: m.extern_param_counts, extern_ret_types: m.extern_ret_types, extern_libs: m.extern_libs}

fn mod_add_extern(m: IrModule, name: str, param_count: i64, ret_type: str, lib: str) -> IrModule =
    IrModule{funcs: m.funcs, string_constants: m.string_constants, entry_func: m.entry_func, test_count: m.test_count, test_names: m.test_names,
             extern_names: m.extern_names.append(name), extern_param_counts: m.extern_param_counts.append(param_count),
             extern_ret_types: m.extern_ret_types.append(ret_type), extern_libs: m.extern_libs.append(lib)}

fn mod_set_entry(m: IrModule, name: str) -> IrModule =
    IrModule{funcs: m.funcs, string_constants: m.string_constants, entry_func: name, test_count: m.test_count, test_names: m.test_names,
             extern_names: m.extern_names, extern_param_counts: m.extern_param_counts, extern_ret_types: m.extern_ret_types, extern_libs: m.extern_libs}

fn mod_add_test(m: IrModule, name: str) -> IrModule =
    IrModule{funcs: m.funcs, string_constants: m.string_constants, entry_func: m.entry_func, test_count: m.test_count + 1, test_names: m.test_names.append(name),
             extern_names: m.extern_names, extern_param_counts: m.extern_param_counts, extern_ret_types: m.extern_ret_types, extern_libs: m.extern_libs}

fn mod_find_string(m: IrModule, s: str) -> i64 {
    mut i := 1
    while i < m.string_constants.len() {
        if m.string_constants[i] == s { return i }
        i = i + 1
    }
    return 0  // not found
}

fn mod_func_count(m: IrModule) -> i64 = m.funcs.len() - 1

fn mod_find_func(m: IrModule, name: str) -> IrFunc {
    mut i := 1
    while i < m.funcs.len() {
        if m.funcs[i].name == name { return m.funcs[i] }
        i = i + 1
    }
    return _sentinel_func()
}

// ============================================================
// IR Validation — checks for common lowering errors
// ============================================================

fn _is_jump_op(op: IrOp) -> bool =
    ir_op_name(op) == "Jump" || ir_op_name(op) == "BranchTrue" || ir_op_name(op) == "BranchFalse"

fn _is_def_op(op: IrOp) -> bool {
    name := ir_op_name(op)
    // Ops that produce a value in dest
    if name == "Const" { return true }
    if name == "ConstStr" { return true }
    if name == "Add" { return true }
    if name == "Sub" { return true }
    if name == "Mul" { return true }
    if name == "Div" { return true }
    if name == "Mod" { return true }
    if name == "Neg" { return true }
    if name == "Eq" { return true }
    if name == "Neq" { return true }
    if name == "Lt" { return true }
    if name == "Gt" { return true }
    if name == "Lte" { return true }
    if name == "Gte" { return true }
    if name == "And" { return true }
    if name == "Or" { return true }
    if name == "Not" { return true }
    if name == "Call" { return true }
    if name == "CallIndirect" { return true }
    if name == "FnRef" { return true }
    if name == "Load" { return true }
    if name == "FieldGet" { return true }
    if name == "Alloc" { return true }
    if name == "ArrayNew" { return true }
    if name == "ArrayGet" { return true }
    if name == "ArrayLen" { return true }
    if name == "ArrayAppend" { return true }
    if name == "MapNew" { return true }
    if name == "SetNew" { return true }
    if name == "IntToStr" { return true }
    if name == "StrToInt" { return true }
    false
}

// Validate a single IR function: check label targets and return path
fn _validate_func(f: IrFunc) -> [str] {
    mut errors := [""]
    // Collect all defined labels
    mut labels := [0]
    mut ii := 1
    while ii < f.insts.len() {
        inst := f.insts[ii]
        if ir_op_name(inst.op) == "Label" {
            labels = labels.append(inst.dest)
        }
        ii = ii + 1
    }
    // Check jump targets reference existing labels
    mut ji := 1
    while ji < f.insts.len() {
        inst := f.insts[ji]
        if _is_jump_op(inst.op) {
            target := inst.arg1
            mut found := false
            mut li := 1
            while li < labels.len() {
                if labels[li] == target { found = true }
                li = li + 1
            }
            if found == false {
                errors = errors.append("E9002: jump to undefined label L" + _ir_i2s(target) + " in function '" + f.name + "'")
            }
        }
        ji = ji + 1
    }
    // Check return path: last non-nop instruction should be Ret or RetVoid
    if f.insts.len() > 1 {
        last := f.insts[f.insts.len() - 1]
        last_name := ir_op_name(last.op)
        if last_name != "Ret" && last_name != "RetVoid" && last_name != "Jump" {
            // Only warn if function has instructions (not empty)
            if f.insts.len() > 2 {
                errors = errors.append("W9003: function '" + f.name + "' may not return on all paths")
            }
        }
    }
    errors
}

// Simple i64 to string for IR validation messages
fn _ir_i2s(n: i64) -> str {
    if n == 0 { return "0" }
    mut result := ""
    mut v := n
    if v < 0 { v = 0 - v }
    while v > 0 {
        d := v - (v / 10) * 10
        mut ch := "0"
        if d == 1 { ch = "1" }
        if d == 2 { ch = "2" }
        if d == 3 { ch = "3" }
        if d == 4 { ch = "4" }
        if d == 5 { ch = "5" }
        if d == 6 { ch = "6" }
        if d == 7 { ch = "7" }
        if d == 8 { ch = "8" }
        if d == 9 { ch = "9" }
        result = ch + result
        v = v / 10
    }
    if n < 0 { result = "-" + result }
    result
}

// Validate entire IR module
fn validate_ir_module(m: IrModule) -> [str] {
    mut all_errors := [""]
    // Check entry function exists
    if m.entry_func.len() > 0 {
        ef := mod_find_func(m, m.entry_func)
        if ef.name == "" {
            all_errors = all_errors.append("E9004: entry function '" + m.entry_func + "' not found in module")
        }
    }
    // Validate each function
    mut fi := 1
    while fi < m.funcs.len() {
        func_errors := _validate_func(m.funcs[fi])
        mut ei := 1
        while ei < func_errors.len() {
            all_errors = all_errors.append(func_errors[ei])
            ei = ei + 1
        }
        fi = fi + 1
    }
    all_errors
}
