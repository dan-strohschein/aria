mod main

// ============================================================
// Aria Self-Hosting Compiler — CLI Entry Point
// ============================================================

use diagnostic
use lexer
use parser
use resolver
use checker
use codegen

// --- CLI Command ---

type Command =
    | CmdCheck
    | CmdBuild
    | CmdRun
    | CmdTest
    | CmdFix
    | CmdExplain
    | CmdBench
    | CmdHelp
    | CmdVersion
    | CmdUnknown

// --- CLI Options ---

struct Options {
    command: Command
    files: [str]
    format: str
    target: str
    runtime_path: str
    parallel: bool
    output_path: str
    help_requested: bool
    has_error: bool
}

fn default_options() -> Options =
    Options{
        command: CmdHelp,
        files: [""],
        format: "text",
        target: "native",
        runtime_path: "runtime/runtime.c",
        parallel: false,
        output_path: "",
        help_requested: false,
        has_error: false
    }

// DRY: Options setter helpers (avoid duplicating 9-field struct literal)
fn _opts_set_cmd(o: Options, c: Command) -> Options =
    Options{command: c, files: o.files, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_format(o: Options, v: str) -> Options =
    Options{command: o.command, files: o.files, format: v, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_target(o: Options, v: str) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: v, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_runtime(o: Options, v: str) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: o.target, runtime_path: v, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_parallel(o: Options) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: true, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_output(o: Options, v: str) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: v, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_files(o: Options, f: [str]) -> Options =
    Options{command: o.command, files: f, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: o.has_error}
fn _opts_set_help(o: Options) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: true, has_error: o.has_error}
fn _opts_set_error(o: Options) -> Options =
    Options{command: o.command, files: o.files, format: o.format, target: o.target, runtime_path: o.runtime_path, parallel: o.parallel, output_path: o.output_path, help_requested: o.help_requested, has_error: true}

// --- Argument parsing ---

fn parse_command(arg: str) -> Command {
    if arg == "check" { return CmdCheck }
    if arg == "build" { return CmdBuild }
    if arg == "run" { return CmdRun }
    if arg == "test" { return CmdTest }
    if arg == "fix" { return CmdFix }
    if arg == "explain" { return CmdExplain }
    if arg == "bench" { return CmdBench }
    if arg == "help" { return CmdHelp }
    if arg == "--help" { return CmdHelp }
    if arg == "-h" { return CmdHelp }
    if arg == "version" { return CmdVersion }
    if arg == "--version" { return CmdVersion }
    if arg == "-v" { return CmdVersion }
    return CmdUnknown
}

fn command_to_str(cmd: Command) -> str = match cmd {
    CmdCheck => "check"
    CmdBuild => "build"
    CmdRun => "run"
    CmdTest => "test"
    CmdFix => "fix"
    CmdExplain => "explain"
    CmdBench => "bench"
    CmdHelp => "help"
    CmdVersion => "version"
    CmdUnknown => "unknown"
}

fn _is_flag(arg: str) -> bool =
    arg.len() > 0 && arg.charAt(0) == "-"

fn _parse_flag_value(arg: str) -> str {
    // Parse --flag=value, return value
    mut i := 0
    while i < arg.len() {
        if arg.charAt(i) == "=" {
            return arg.substring(i + 1, arg.len())
        }
        i = i + 1
    }
    ""
}

fn _validate_format(v: str) -> bool =
    v == "text" || v == "json"

fn parse_args(args: [str]) -> Options with [Io] {
    mut opts := default_options()
    mut cmd_set := false
    mut files := [""]

    // args[0] = sentinel, args[1] = program name, start from 2
    mut i := 2
    while i < args.len() {
        arg := args[i]
        if _is_flag(arg) {
            if arg == "--help" || arg == "-h" {
                opts = _opts_set_help(opts)
            } else if arg.startsWith("--format=") {
                fv := _parse_flag_value(arg)
                if _validate_format(fv) {
                    opts = _opts_set_format(opts, fv)
                } else {
                    println("error: invalid format '" + fv + "' (expected 'text' or 'json')")
                    opts = _opts_set_error(opts)
                }
            } else if arg.startsWith("--target=") {
                opts = _opts_set_target(opts, _parse_flag_value(arg))
            } else if arg.startsWith("--runtime=") {
                opts = _opts_set_runtime(opts, _parse_flag_value(arg))
            } else if arg.startsWith("--output=") {
                opts = _opts_set_output(opts, _parse_flag_value(arg))
            } else if arg == "-o" {
                // -o PATH: value is next argument
                if i + 1 < args.len() {
                    i = i + 1
                    opts = _opts_set_output(opts, args[i])
                } else {
                    println("error: -o requires a path argument")
                }
            } else if arg == "--parallel" {
                opts = _opts_set_parallel(opts)
            } else if arg == "--version" || arg == "-v" {
                opts = _opts_set_cmd(opts, CmdVersion)
            } else {
                println("error: unknown flag '" + arg + "'")
                opts = _opts_set_error(opts)
            }
        } else if cmd_set == false {
            opts = _opts_set_cmd(opts, parse_command(arg))
            cmd_set = true
        } else {
            files = files.append(arg)
        }
        i = i + 1
    }

    _opts_set_files(opts, files)
}

// --- Version ---

