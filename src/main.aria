// --- Directory expansion ---
// If a file argument is a directory, recursively find all .aria files in it

fn _ends_with_aria(s: str) -> bool {
    if s.len() < 6 { return false }
    s.substring(s.len() - 5, s.len()) == ".aria"
}

// --- Path helpers ---

fn _basename(path: str) -> str {
    mut last_slash := 0 - 1
    mut i := 0
    while i < path.len() {
        if path.charAt(i) == "/" { last_slash = i }
        i = i + 1
    }
    if last_slash < 0 { return path }
    path.substring(last_slash + 1, path.len())
}

fn _dir_of(path: str) -> str {
    mut last_slash := 0 - 1
    mut i := 0
    while i < path.len() {
        if path.charAt(i) == "/" { last_slash = i }
        i = i + 1
    }
    if last_slash < 0 { return "" }
    path.substring(0, last_slash + 1)
}

// Normalize a path by collapsing "foo/../" segments.
// e.g. "testdata/programs/../lib/json.aria" → "testdata/lib/json.aria"
fn _normalize_path(path: str) -> str {
    mut result := path
    // Repeatedly collapse "segment/../" until none remain
    mut changed := true
    while changed {
        changed = false
        // Find "/../" in result
        mut i := 0
        while i + 3 < result.len() {
            if result.charAt(i) == "/" && result.charAt(i + 1) == "." && result.charAt(i + 2) == "." && result.charAt(i + 3) == "/" {
                // Found /../ at position i — find the preceding segment start
                mut j := i - 1
                while j >= 0 && result.charAt(j) != "/" {
                    j = j - 1
                }
                if j >= 0 {
                    // Remove from j to i+3 (inclusive)
                    result = result.substring(0, j) + result.substring(i + 3, result.len())
                    changed = true
                    i = 0
                } else if i > 0 {
                    // No preceding slash — remove from start to i+4
                    result = result.substring(i + 4, result.len())
                    changed = true
                    i = 0
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
    }
    result
}

// --- test-files directive ---
// Parse `// test-files: file1.aria file2.aria` from the first 10 lines of a source file.
// Returns resolved paths relative to the source file's directory.

fn _parse_test_files_directive(file_path: str) -> [str] with [Fs] {
    source := _ariaReadFile(file_path)
    dir := _dir_of(file_path)
    mut line_count := 0
    mut i := 0
    while i < source.len() && line_count < 10 {
        if i == 0 || source.charAt(i - 1) == "\n" {
            line_count = line_count + 1
            prefix := "// test-files: "
            if i + prefix.len() <= source.len() && source.substring(i, i + prefix.len()) == prefix {
                mut end := i + prefix.len()
                while end < source.len() && source.charAt(end) != "\n" {
                    end = end + 1
                }
                line_val := source.substring(i + prefix.len(), end)
                parts := line_val.split(" ")
                mut result := [""]
                mut pi := 1
                while pi < parts.len() {
                    if parts[pi].len() > 0 {
                        result = result.append(_normalize_path(dir + parts[pi]))
                    }
                    pi = pi + 1
                }
                return result
            }
        }
        i = i + 1
    }
    [""]
}

// --- Standard library auto-resolution ---
// Detect `use <module>` in source files and auto-include lib/*.aria

// Known standard library modules and their file names
fn _is_stdlib_module(name: str) -> bool =
    name == "json" || name == "http" || name == "db" ||
    name == "fs" || name == "time" || name == "log" || name == "test" ||
    name == "property" || name == "crypto" || name == "net" || name == "os" || name == "flag"

fn _find_aria_home() -> str with [Fs] {
    // Check ARIA_HOME env var first
    home := _ariaGetenv("ARIA_HOME")
    if home.len() > 0 { return home }
    // Default install location
    "/usr/local/lib/aria"
}

fn _stdlib_path(aria_home: str, module_name: str) -> str =
    aria_home + "/lib/" + module_name + ".aria"

fn _scan_file_for_stdlib_imports(file_path: str) -> [str] with [Fs] {
    // Read file and look for `use <module>` lines where module is a stdlib module
    // Handles: use json, use std.fs, use std.{fs, time, log}
    mut modules := [""]
    source := _ariaReadFile(file_path)
    mut i := 0
    while i < source.len() {
        if i == 0 || (i > 0 && source.charAt(i - 1) == "\n") {
            mut j := i
            while j < source.len() && (source.charAt(j) == " " || source.charAt(j) == "\t") { j = j + 1 }
            if j + 4 <= source.len() && source.substring(j, j + 4) == "use " {
                mut k := j + 4
                while k < source.len() && (source.charAt(k) == " " || source.charAt(k) == "\t") { k = k + 1 }
                // Read first identifier (may be module name or prefix like "std")
                mut name_start := k
                while k < source.len() && source.charAt(k) != " " && source.charAt(k) != "\n" && source.charAt(k) != "\t" && source.charAt(k) != "." {
                    k = k + 1
                }
                if k > name_start {
                    name := source.substring(name_start, k)
                    if source.charAt(k) == "." {
                        // Dotted import: use std.fs or use std.{fs, time}
                        k = k + 1
                        lb := "\{"
                        if k < source.len() && source.charAt(k) == lb {
                            // Grouped import: use std.{fs, time, log}
                            k = k + 1
                            rb := "\}"
                            while k < source.len() && source.charAt(k) != rb && source.charAt(k) != "\n" {
                                // Skip whitespace/commas
                                while k < source.len() && (source.charAt(k) == " " || source.charAt(k) == "," || source.charAt(k) == "\t") { k = k + 1 }
                                // Read module name
                                mut ms := k
                                while k < source.len() && source.charAt(k) != "," && source.charAt(k) != rb && source.charAt(k) != " " && source.charAt(k) != "\n" {
                                    k = k + 1
                                }
                                if k > ms {
                                    mname := source.substring(ms, k)
                                    if _is_stdlib_module(mname) { modules = modules.append(mname) }
                                }
                            }
                        } else {
                            // Single dotted import: use std.fs
                            mut ms := k
                            while k < source.len() && source.charAt(k) != " " && source.charAt(k) != "\n" && source.charAt(k) != "\t" {
                                k = k + 1
                            }
                            if k > ms {
                                mname := source.substring(ms, k)
                                if _is_stdlib_module(mname) { modules = modules.append(mname) }
                            }
                        }
                    } else {
                        // Simple import: use json
                        if _is_stdlib_module(name) { modules = modules.append(name) }
                    }
                }
            }
        }
        i = i + 1
    }
    modules
}

fn _resolve_stdlib_files(files: [str]) -> [str] with [Fs] {
    // Scan all user files for stdlib imports, return additional files to include
    aria_home := _find_aria_home()
    mut extra := [""]
    mut seen := [""]  // Track already-added modules to avoid duplicates
    mut fi := 1
    while fi < files.len() {
        modules := _scan_file_for_stdlib_imports(files[fi])
        mut mi := 1
        while mi < modules.len() {
            mod_name := modules[mi]
            // Check if already added
            mut already := false
            mut si := 1
            while si < seen.len() {
                if seen[si] == mod_name { already = true }
                si = si + 1
            }
            if already == false {
                // Try local lib/<module>.aria first (works in dev without ARIA_HOME)
                local_path := "lib/" + mod_name + ".aria"
                local_content := _ariaReadFile(local_path)
                if local_content.len() > 0 {
                    extra = extra.append(local_path)
                    seen = seen.append(mod_name)
                } else if aria_home != "/usr/local/lib/aria" {
                    // Only try ARIA_HOME if it was explicitly set
                    lib_path := _stdlib_path(aria_home, mod_name)
                    content := _ariaReadFile(lib_path)
                    if content.len() > 0 {
                        extra = extra.append(lib_path)
                        seen = seen.append(mod_name)
                    }
                }
            }
            mi = mi + 1
        }
        fi = fi + 1
    }
    extra
}

fn _merge_file_lists(a: [str], b: [str]) -> [str] {
    mut result := a
    mut i := 1
    while i < b.len() {
        // Deduplicate: skip if file already in result (compare by basename)
        mut dup := false
        bname := _basename(b[i])
        mut j := 1
        while j < result.len() {
            if _basename(result[j]) == bname { dup = true }
            j = j + 1
        }
        if dup == false {
            result = result.append(b[i])
        }
        i = i + 1
    }
    result
}

fn _resolve_runtime_path(explicit: str) -> str with [Fs] {
    // If the explicit path exists (relative to CWD), use it
    // Otherwise, look in ARIA_HOME
    content := _ariaReadFile(explicit)
    if content.len() > 0 { return explicit }
    aria_home := _find_aria_home()
    aria_home + "/runtime/runtime.c"
}

// Validate runtime path exists and return it, or print error and return ""
fn _resolve_and_validate_runtime(runtime_path: str) -> str with [Io, Fs] {
    rt := _resolve_runtime_path(runtime_path)
    content := _ariaReadFile(rt)
    if content.len() > 0 { return rt }
    println("error: runtime not found at '" + rt + "'")
    println("hint: set ARIA_HOME or use --runtime=PATH")
    ""
}

// Determine output path: explicit > derived from file > derived from directory > a.out
fn _determine_output_path(raw_files: [str], file: str, explicit: str) -> str with [Fs] {
    if explicit.len() > 0 { return explicit }
    mut output := "a.out"
    if file.len() > 5 && file.substring(file.len() - 5, file.len()) == ".aria" {
        output = file.substring(0, file.len() - 5)
    }
    if raw_files.len() > 1 {
        raw_input := raw_files[1]
        if _ariaIsDir(raw_input) == 1 {
            mut out := raw_input
            if out.len() > 1 && out.charAt(out.len() - 1) == "/" {
                out = out.substring(0, out.len() - 1)
            }
            mut last_slash := 0 - 1
            mut si := 0
            while si < out.len() {
                if out.charAt(si) == "/" { last_slash = si }
                si = si + 1
            }
            if last_slash >= 0 {
                output = out + "/" + out.substring(last_slash + 1, out.len())
            } else {
                output = out + "/" + out
            }
        }
    }
    output
}

fn _expand_dir(path: str) -> [str] with [Fs] {
    mut result := [""]
    entries := _ariaListDir(path)
    mut i := 1
    while i < entries.len() {
        ename := entries[i]
        mut full := path
        // Ensure path ends with /
        if path.len() > 0 && path.charAt(path.len() - 1) != "/" {
            full = path + "/"
        }
        full = full + ename
        if _ariaIsDir(full) == 1 {
            // Recurse into subdirectory
            sub := _expand_dir(full)
            mut si := 1
            while si < sub.len() {
                result = result.append(sub[si])
                si = si + 1
            }
        } else if _ends_with_aria(ename) {
            result = result.append(full)
        }
        i = i + 1
    }
    result
}

// Module priority for dependency ordering: lower number = processed first.
// Ensures type definitions are available before they're referenced.
// Within each module, type-definition files (token, ast, types, scope, ir)
// are prioritized before implementation files (lexer, parser, checker, etc.)
fn _module_priority(path: str) -> i64 {
    mut base := 30
    if path.contains("/lexer/") { base = 10 }
    if path.contains("/parser/") { base = 20 }
    if path.contains("/diagnostic/") { base = 30 }
    if path.contains("/resolver/") { base = 40 }
    if path.contains("/checker/") { base = 50 }
    if path.contains("/codegen/") { base = 60 }
    if path.contains("/main.aria") { base = 70 }
    // Within a module, type/data files before implementation files
    if path.contains("/token.aria") { return base }
    if path.contains("/ast.aria") { return base }
    if path.contains("/types.aria") { return base }
    if path.contains("/scope.aria") { return base }
    if path.contains("/ir.aria") { return base }
    if path.contains("/precedence.aria") { return base }
    if path.contains("/diagnostic.aria") { return base }
    // Tests come last within a module
    if path.contains("/tests.aria") { return base + 5 }
    if path.contains("_tests.aria") { return base + 5 }
    // Implementation files
    base + 2
}

// Sort files by module dependency order using insertion sort
fn _sort_by_module_priority(files: [str]) -> [str] {
    mut sorted := [""]
    mut i := 1
    while i < files.len() {
        sorted = sorted.append(files[i])
        i = i + 1
    }
    // Insertion sort by priority
    mut si := 2
    while si < sorted.len() {
        key := sorted[si]
        key_pri := _module_priority(key)
        mut j := si - 1
        while j >= 1 && _module_priority(sorted[j]) > key_pri {
            // Shift — rebuild array (Aria arrays are immutable, so swap via temp)
            sorted = _arr_set(sorted, j + 1, sorted[j])
            j = j - 1
        }
        sorted = _arr_set(sorted, j + 1, key)
        si = si + 1
    }
    sorted
}

// Set element at index in a string array (returns new array)
fn _arr_set(arr: [str], idx: i64, val: str) -> [str] {
    mut result := [""]
    mut i := 1
    while i < arr.len() {
        if i == idx {
            result = result.append(val)
        } else {
            result = result.append(arr[i])
        }
        i = i + 1
    }
    result
}

fn expand_files(files: [str]) -> [str] with [Fs] {
    mut result := [""]
    mut i := 1
    while i < files.len() {
        file := files[i]
        if _ariaIsDir(file) == 1 {
            expanded := _expand_dir(file)
            mut ei := 1
            while ei < expanded.len() {
                result = result.append(expanded[ei])
                ei = ei + 1
            }
        } else {
            result = result.append(file)
        }
        i = i + 1
    }
    // Check for // test-files: directive in any input file
    mut fi := 1
    while fi < result.len() {
        directed := _parse_test_files_directive(result[fi])
        if directed.len() > 1 {
            return _sort_by_module_priority(directed)
        }
        fi = fi + 1
    }
    // Sort by module dependency order so types are defined before referenced
    _sort_by_module_priority(result)
}

// --- Pipeline skeleton ---

fn check_source(source: str, file: str) -> DiagnosticBag {
    lex := tokenize(source, file)
    toks := get_tokens(lex)
    lex_diags := get_diagnostics(lex)
    if bag_has_errors(lex_diags) { return lex_diags }

    pr := build_decl_index(toks)
    if bag_has_errors(pr.diagnostics) { return pr.diagnostics }

    rr := resolve(toks, pr.index, pr.pool, file)
    if bag_has_errors(rr.diagnostics) { return rr.diagnostics }

    cr := check(toks, pr.index, pr.pool, rr.table, file)
    return cr.diagnostics
}

fn run_check(raw_files: [str], format: str) -> i64 with [Io, Fs] {
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    diags := check_sources(files)
    if bag_has_errors(diags) {
        _print_diagnostics(diags, format)
        return 1
    }
    if bag_warning_count(diags) > 0 {
        _print_diagnostics(diags, format)
    }
    wcount := bag_warning_count(diags)
    println("check: ok (" + wcount.toStr() + " warnings)")
    0
}

fn _print_diagnostics(diags: DiagnosticBag, format: str) with [Io] {
    if format == "json" {
        println(render_json_bag(diags))
    } else {
        // Text format (default)
        mut di := 1
        while di < diags.diagnostics.len() {
            d := diags.diagnostics[di]
            println(format_span(d.span) + ": " + severity_to_str(d.severity) + "[" + d.code + "]: " + d.message)
            // Render notes
            mut ni := 1
            while ni < d.notes.len() {
                note := d.notes[ni]
                if note.len() > 0 {
                    println("  = note: " + note)
                }
                ni = ni + 1
            }
            di = di + 1
        }
        println(format_summary(diags))
    }
    // Explicit void return (prevents bootstrap Go codegen from wrapping last println in return)
    mut _unused := 0
}

fn run_build(raw_files: [str], format: str, target: str, runtime_path: str, output_path: str) -> i64 with [Io, Fs] {
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    rt := _resolve_and_validate_runtime(runtime_path)
    if rt == "" { return 1 }
    file := files[1]
    output := _determine_output_path(raw_files, file, output_path)

    // Run full pipeline: lex → resolve → check → lower → LLVM IR → clang
    diags := generate_from_sources(files, output, rt)
    if bag_has_errors(diags) {
        _print_diagnostics(diags, format)
        return 1
    }
    // Print warnings even on success
    if bag_warning_count(diags) > 0 {
        _print_diagnostics(diags, format)
    }
    println("built: " + output)
    0
}

fn run_run(raw_files: [str], format: str, target: str, runtime_path: str, output_path: str) -> i64 with [Io, Fs] {
    // Build to temp path, then execute
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    rt := _resolve_and_validate_runtime(runtime_path)
    if rt == "" { return 1 }
    file := files[1]
    output := _determine_output_path(raw_files, file, output_path)

    // Build
    diags := generate_from_sources(files, output, rt)
    if bag_has_errors(diags) {
        _print_diagnostics(diags, format)
        return 1
    }
    if bag_warning_count(diags) > 0 {
        _print_diagnostics(diags, format)
    }

    // Execute
    exit_code := _ariaExec(output)
    return exit_code
}

fn run_test(raw_files: [str], format: str, runtime_path: str, parallel: bool) -> i64 with [Io, Fs] {
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    rt := _resolve_and_validate_runtime(runtime_path)
    if rt == "" { return 1 }
    file := files[1]

    // Build test binary to temp path
    mut output := file
    if file.len() > 5 && file.substring(file.len() - 5, file.len()) == ".aria" {
        output = file.substring(0, file.len() - 5)
    }
    output = output + "_test_runner"

    // Compile with test runner
    diags := generate_tests_from_sources(files, output, rt, parallel)
    if bag_has_errors(diags) {
        _print_diagnostics(diags, format)
        return 1
    }

    // Run the test binary
    return _ariaExec(output)
}

// --- Explain command ---

fn run_explain(files: [str]) -> i64 with [Io] {
    // aria explain E0042 — print detailed error explanation
    if files.len() <= 1 {
        println("Usage: aria explain <error-code>")
        println("")
        println("Example: aria explain E0100")
        return 1
    }
    code := files[1]
    desc := describe_code(code)
    if desc == "unknown error code" {
        println("Unknown error code: " + code)
        return 1
    }
    println(code + ": " + desc)
    println("")
    // Print extended explanation based on error category
    first_char := code.charAt(0)
    if first_char == "E" {
        num := code.substring(1, code.len())
        println("Category: " + _error_category(code))
        println("")
        println(_error_explanation(code))
    }
    if first_char == "W" {
        println("Category: Warning")
        println("")
        println("This is a warning -- your code will still compile, but the")
        println("indicated issue may cause problems or indicate a mistake.")
    }
    0
}

fn _error_category(code: str) -> str {
    if code.startsWith("E000") { return "Syntax Error" }
    if code.startsWith("E001") { return "Type Error" }
    if code.startsWith("E002") { return "Trait Error" }
    if code.startsWith("E003") { return "Effect Error" }
    if code.startsWith("E004") { return "Pattern Error" }
    if code.startsWith("E005") { return "Mutability Error" }
    if code.startsWith("E007") { return "Module/Import Error" }
    "Compiler Error"
}

fn _error_explanation(code: str) -> str {
    if code == "E0100" { return "The types on the left and right side of an expression\ndon't match. Check that the types are compatible." }
    if code == "E0106" { return "The function's return type doesn't match what the body\nactually returns. Check the return type annotation." }
    if code == "E0200" { return "A type used in a generic context doesn't implement the\nrequired trait. Add a derives clause or impl block." }
    if code == "E0400" { return "A match expression doesn't cover all possible cases.\nAdd the missing variant or a wildcard (_) arm." }
    if code == "E0500" { return "Attempted to reassign a variable that wasn't declared\nwith 'mut'. Add 'mut' to the binding if reassignment is needed." }
    if code == "E0701" { return "A name was used that isn't defined in the current scope.\nCheck spelling, imports, and visibility." }
    if code == "E0704" { return "Attempted to access a symbol that is not marked 'pub'\nfrom a different file. Add 'pub' to the declaration or\nmove the access to the same file." }
    "See the Aria language specification for details on this error."
}

// --- Fix command ---

fn run_fix(raw_files: [str], format: str) -> i64 with [Io, Fs] {
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    // Run check and collect diagnostics with suggestions
    diags := check_sources(files)
    mut fix_count := 0
    mut di := 1
    while di < diags.diagnostics.len() {
        d := diags.diagnostics[di]
        if d.suggestions.len() > 1 {
            // Has fix suggestions — print them
            mut si := 1
            while si < d.suggestions.len() {
                s := d.suggestions[si]
                println("fix: " + d.code + " at " + format_span(d.span) + ": " + s.message)
                fix_count = fix_count + 1
                si = si + 1
            }
        }
        di = di + 1
    }
    if fix_count == 0 {
        println("No auto-fixable issues found.")
    } else {
        println(fix_count.toStr() + " fix(es) suggested. Use --apply to apply them.")
    }
    0
}

// --- Bench command ---

fn run_bench(raw_files: [str], format: str, runtime_path: str) -> i64 with [Io, Fs] {
    user_files := expand_files(raw_files)
    if user_files.len() <= 1 {
        println("error: no input files")
        return 1
    }
    stdlib_files := _resolve_stdlib_files(user_files)
    files := _merge_file_lists(user_files, stdlib_files)
    rt := _resolve_and_validate_runtime(runtime_path)
    if rt == "" { return 1 }
    file := files[1]
    mut output := file
    if file.len() > 5 && file.substring(file.len() - 5, file.len()) == ".aria" {
        output = file.substring(0, file.len() - 5)
    }
    output = output + "_bench_runner"
    // Compile with bench runner
    diags := generate_bench_from_sources(files, output, rt)
    if bag_has_errors(diags) {
        _print_diagnostics(diags, format)
        return 1
    }
    // Run the bench binary
    return _ariaExec(output)
}

// --- Entry point ---

entry {
    args := _ariaArgs()
    if args.len() < 3 {
        print_help()
    } else {
        opts := parse_args(args)
        if opts.has_error {
            println("Run 'aria --help' for usage information.")
        }
        cmd := command_to_str(opts.command)
        // Per-command help: aria <command> --help
        if opts.has_error {
            // Stop — errors already printed
            mut _skip := 0
        } else if opts.help_requested {
            if cmd == "build" {
                _print_build_help()
            } else if cmd == "run" {
                _print_run_help()
            } else if cmd == "check" {
                _print_check_help()
            } else if cmd == "test" {
                _print_test_help()
            } else if cmd == "bench" {
                _print_bench_help()
            } else {
                print_help()
            }
        } else if cmd == "build" {
            run_build(opts.files, opts.format, opts.target, opts.runtime_path, opts.output_path)
        } else if cmd == "run" {
            run_run(opts.files, opts.format, opts.target, opts.runtime_path, opts.output_path)
        } else if cmd == "check" {
            run_check(opts.files, opts.format)
        } else if cmd == "test" {
            run_test(opts.files, opts.format, opts.runtime_path, opts.parallel)
        } else if cmd == "bench" {
            run_bench(opts.files, opts.format, opts.runtime_path)
        } else if cmd == "fix" {
            run_fix(opts.files, opts.format)
        } else if cmd == "explain" {
            run_explain(opts.files)
        } else if cmd == "version" {
            print_version()
        } else {
            print_help()
        }
    }
}
