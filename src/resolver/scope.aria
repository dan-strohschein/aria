mod resolver

// ============================================================
// Scope & Symbol Infrastructure
// Data types for scope hierarchy and symbol table.
// ============================================================

use diagnostic
use lexer

// --- SymbolKind ---

type SymbolKind =
    | SkFunction
    | SkType
    | SkEnum
    | SkTrait
    | SkConst
    | SkVariable
    | SkParameter
    | SkVariant
    | SkModule
    | SkBuiltin
    | SkNone

fn symbol_kind_name(k: SymbolKind) -> str = match k {
    SkFunction => "Function"
    SkType => "Type"
    SkEnum => "Enum"
    SkTrait => "Trait"
    SkConst => "Const"
    SkVariable => "Variable"
    SkParameter => "Parameter"
    SkVariant => "Variant"
    SkModule => "Module"
    SkBuiltin => "Builtin"
    SkNone => "None"
}

fn sk_eq(a: SymbolKind, b: SymbolKind) -> bool {
    na := symbol_kind_name(a)
    nb := symbol_kind_name(b)
    na == nb
}

// --- Symbol ---

struct Symbol {
    name: str
    kind: SymbolKind
    span: Span
    scope_id: i64
    is_mutable: bool
    is_public: bool
}

fn _sentinel_symbol() -> Symbol =
    Symbol{
        name: "",
        kind: SkNone,
        span: new_span("", 0, 0, 0, 0),
        scope_id: 0,
        is_mutable: false,
        is_public: false
    }

fn new_symbol(name: str, kind: SymbolKind, span: Span, scope_id: i64, is_mutable: bool, is_public: bool) -> Symbol =
    Symbol{name: name, kind: kind, span: span, scope_id: scope_id, is_mutable: is_mutable, is_public: is_public}

// --- ScopeKind ---

type ScopeKind =
    | ScUniverse
    | ScModule
    | ScFunction
    | ScBlock
    | ScNone

fn scope_kind_name(k: ScopeKind) -> str = match k {
    ScUniverse => "Universe"
    ScModule => "Module"
    ScFunction => "Function"
    ScBlock => "Block"
    ScNone => "None"
}

// --- Scope ---

struct Scope {
    kind: ScopeKind
    parent: i64
    name: str
    depth: i64
}

fn _sentinel_scope() -> Scope =
    Scope{kind: ScNone, parent: 0, name: "", depth: 0}

fn new_scope(kind: ScopeKind, parent: i64, name: str, depth: i64) -> Scope =
    Scope{kind: kind, parent: parent, name: name, depth: depth}

// --- SymbolTable ---

struct SymbolTable {
    scopes: [Scope]
    symbols: [Symbol]
}

fn new_table() -> SymbolTable =
    SymbolTable{
        scopes: [_sentinel_scope()],
        symbols: [_sentinel_symbol()]
    }

fn add_scope(table: SymbolTable, kind: ScopeKind, parent: i64, name: str) -> SymbolTable {
    mut depth := 0
    if parent > 0 && parent < table.scopes.len() {
        depth = table.scopes[parent].depth + 1
    }
    s := new_scope(kind, parent, name, depth)
    SymbolTable{
        scopes: table.scopes.append(s),
        symbols: table.symbols
    }
}

fn last_scope_id(table: SymbolTable) -> i64 = table.scopes.len() - 1

fn add_symbol(table: SymbolTable, sym: Symbol) -> SymbolTable =
    SymbolTable{
        scopes: table.scopes,
        symbols: table.symbols.append(sym)
    }

fn scope_count(table: SymbolTable) -> i64 = table.scopes.len()

fn symbol_count(table: SymbolTable) -> i64 = table.symbols.len()

// --- Lookup ---

// Lookup in a specific scope only (no parent walk)
fn lookup_local(table: SymbolTable, scope_id: i64, name: str) -> Symbol {
    mut i := 1  // skip sentinel
    while i < table.symbols.len() {
        sym := table.symbols[i]
        if sym.scope_id == scope_id {
            if sym.name == name {
                return sym
            }
        }
        i = i + 1
    }
    _sentinel_symbol()
}

// Lookup walking the parent chain from scope_id up to universe
fn lookup(table: SymbolTable, scope_id: i64, name: str) -> Symbol {
    mut cur := scope_id
    while cur > 0 {
        found := lookup_local(table, cur, name)
        if found.name != "" {
            return found
        }
        if cur < table.scopes.len() {
            cur = table.scopes[cur].parent
        } else {
            cur = 0
        }
    }
    // Also check scope 0 (shouldn't normally have symbols, but just in case)
    _sentinel_symbol()
}

// ============================================================
// StrMap — Simple hash map for string keys → i64 values
// Uses parallel arrays with open addressing and linear probing.
// ============================================================

struct StrMap {
    keys: [str]
    vals: [i64]
    buckets: [i64]
    capacity: i64
    count: i64
}

fn _strmap_init_buckets(cap: i64) -> [i64] {
    mut b := [0]
    mut i := 0
    while i < cap {
        b = b.append(0 - 1)
        i = i + 1
    }
    b
}

fn strmap_new() -> StrMap {
    cap := 64
    StrMap{keys: [""], vals: [0], buckets: _strmap_init_buckets(cap), capacity: cap, count: 0}
}

// Hash a string using DJB2 algorithm
fn _char_ord(c: str) -> i64 {
    if c == "a" { return 97 }
    if c == "b" { return 98 }
    if c == "c" { return 99 }
    if c == "d" { return 100 }
    if c == "e" { return 101 }
    if c == "f" { return 102 }
    if c == "g" { return 103 }
    if c == "h" { return 104 }
    if c == "i" { return 105 }
    if c == "j" { return 106 }
    if c == "k" { return 107 }
    if c == "l" { return 108 }
    if c == "m" { return 109 }
    if c == "n" { return 110 }
    if c == "o" { return 111 }
    if c == "p" { return 112 }
    if c == "q" { return 113 }
    if c == "r" { return 114 }
    if c == "s" { return 115 }
    if c == "t" { return 116 }
    if c == "u" { return 117 }
    if c == "v" { return 118 }
    if c == "w" { return 119 }
    if c == "x" { return 120 }
    if c == "y" { return 121 }
    if c == "z" { return 122 }
    if c == "A" { return 65 }
    if c == "B" { return 66 }
    if c == "C" { return 67 }
    if c == "D" { return 68 }
    if c == "E" { return 69 }
    if c == "F" { return 70 }
    if c == "G" { return 71 }
    if c == "H" { return 72 }
    if c == "I" { return 73 }
    if c == "J" { return 74 }
    if c == "K" { return 75 }
    if c == "L" { return 76 }
    if c == "M" { return 77 }
    if c == "N" { return 78 }
    if c == "O" { return 79 }
    if c == "P" { return 80 }
    if c == "Q" { return 81 }
    if c == "R" { return 82 }
    if c == "S" { return 83 }
    if c == "T" { return 84 }
    if c == "U" { return 85 }
    if c == "V" { return 86 }
    if c == "W" { return 87 }
    if c == "X" { return 88 }
    if c == "Y" { return 89 }
    if c == "Z" { return 90 }
    if c == "0" { return 48 }
    if c == "1" { return 49 }
    if c == "2" { return 50 }
    if c == "3" { return 51 }
    if c == "4" { return 52 }
    if c == "5" { return 53 }
    if c == "6" { return 54 }
    if c == "7" { return 55 }
    if c == "8" { return 56 }
    if c == "9" { return 57 }
    if c == "_" { return 95 }
    if c == ":" { return 58 }
    if c == "." { return 46 }
    if c == "-" { return 45 }
    if c == "/" { return 47 }
    42
}

fn _str_hash(s: str) -> i64 {
    mut h := 5381
    mut i := 0
    while i < s.len() {
        h = h * 33 + _char_ord(s.charAt(i))
        i = i + 1
    }
    // Ensure positive
    if h < 0 { h = 0 - h }
    h
}

// Set a bucket value at a given index (uses AST-lowered indexed assignment)
fn _bucket_set(mut buckets: [i64], idx: i64, val: i64) {
    buckets[idx] = val
}

// Rehash: rebuild bucket array at double capacity
fn _strmap_rehash(m: StrMap) -> StrMap {
    new_cap := m.capacity * 2
    mut new_buckets := _strmap_init_buckets(new_cap)
    // Re-insert all existing entries
    mut i := 1
    while i < m.keys.len() {
        h := _str_hash(m.keys[i]) % new_cap
        mut probe := h
        mut placed := false
        while placed == false {
            bidx := probe + 1
            if bidx < new_buckets.len() && new_buckets[bidx] == 0 - 1 {
                _bucket_set(new_buckets, bidx, i)
                placed = true
            } else {
                probe = (probe + 1) % new_cap
            }
        }
        i = i + 1
    }
    StrMap{keys: m.keys, vals: m.vals, buckets: new_buckets, capacity: new_cap, count: m.count}
}

// Put a key-value pair with hash-based bucket insertion.
fn strmap_put(m: StrMap, key: str, val: i64) -> StrMap {
    // Rehash at 70% load
    mut mm := m
    threshold := mm.capacity * 7 / 10
    if mm.count >= threshold {
        mm = _strmap_rehash(mm)
    }
    new_idx := mm.keys.len()
    new_keys := mm.keys.append(key)
    new_vals := mm.vals.append(val)
    // Insert into bucket
    h := _str_hash(key) % mm.capacity
    mut probe := h
    mut placed := false
    while placed == false {
        bidx := probe + 1
        if bidx < mm.buckets.len() && mm.buckets[bidx] == 0 - 1 {
            _bucket_set(mm.buckets, bidx, new_idx)
            placed = true
        } else {
            probe = (probe + 1) % mm.capacity
        }
    }
    StrMap{keys: new_keys, vals: new_vals, buckets: mm.buckets, capacity: mm.capacity, count: mm.count + 1}
}

// Get the value for a key using hash-based lookup, or -1 if not found.
fn strmap_get(m: StrMap, key: str) -> i64 {
    h := _str_hash(key) % m.capacity
    mut probe := h
    mut checks := 0
    while checks < m.capacity {
        bidx := probe + 1
        if bidx >= m.buckets.len() { return 0 - 1 }
        entry_idx := m.buckets[bidx]
        if entry_idx == 0 - 1 { return 0 - 1 }
        if entry_idx > 0 && entry_idx < m.keys.len() {
            if m.keys[entry_idx] == key { return m.vals[entry_idx] }
        }
        probe = (probe + 1) % m.capacity
        checks = checks + 1
    }
    return 0 - 1
}

fn strmap_has(m: StrMap, key: str) -> bool = strmap_get(m, key) >= 0
