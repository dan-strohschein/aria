mod parser

// ============================================================
// Recursive Descent Parser
// ============================================================

// Dependencies: diagnostic, lexer, ast, precedence (compiled together)

struct Parser {
    tokens: [Token]
    pos: i64
    pool: NodePool
    diagnostics: DiagnosticBag
}

fn new_parser(tokens: [Token]) -> Parser =
    Parser{tokens: tokens, pos: 0, pool: new_pool(), diagnostics: new_bag()}

fn _pidx(p: Parser) -> i64 = pool_size(p.pool)

fn _padd(p: Parser, e: Expr) -> Parser =
    Parser{tokens: p.tokens, pos: p.pos, pool: pool_add(p.pool, e), diagnostics: p.diagnostics}

fn _cur(p: Parser) -> Token {
    if p.pos >= p.tokens.len() {
        return Token{kind: TkEof, text: "", line: 0, col: 0, offset: 0, name: "EOF", file: ""}
    }
    p.tokens[p.pos]
}

// Read the precomputed name from the token instead of calling token_name on
// every check. The lexer fills Token.name once at creation time, replacing
// ~80M 120-arm match dispatches with ~800K (one per token).
fn _ck(p: Parser) -> str = _cur(p).name

fn _pk(p: Parser) -> str {
    next := p.pos + 1
    if next >= p.tokens.len() { return "EOF" }
    p.tokens[next].name
}

fn _pspan(p: Parser) -> Span {
    tok := _cur(p)
    new_span("", tok.line, tok.col, tok.offset, tok.text.len())
}

fn _adv(p: Parser) -> Parser =
    Parser{tokens: p.tokens, pos: p.pos + 1, pool: p.pool, diagnostics: p.diagnostics}

fn _expect(p: Parser, expected: str) -> Parser {
    if _ck(p) == expected { return _adv(p) }
    tok := _cur(p)
    span := new_span("", tok.line, tok.col, tok.offset, tok.text.len())
    Parser{tokens: p.tokens, pos: p.pos, pool: p.pool,
           diagnostics: bag_add_error(p.diagnostics, E0001, "expected " + expected + ", got " + _ck(p), span)}
}

fn _skip_nl(p: Parser) -> Parser {
    mut pp := p
    while _ck(pp) == "NEWLINE" { pp = _adv(pp) }
    pp
}

fn _perror(p: Parser, code: str, msg: str) -> Parser {
    tok := _cur(p)
    span := new_span("", tok.line, tok.col, tok.offset, tok.text.len())
    Parser{tokens: p.tokens, pos: p.pos, pool: p.pool,
           diagnostics: bag_add_error(p.diagnostics, code, msg, span)}
}

// --- Parse result ---

struct PR {
    p: Parser
    e: Expr
}

// Check if name looks like a PascalCase type name (starts uppercase, has lowercase)
fn _is_upper_start(name: str) -> bool {
    nlen := name.len()
    if nlen == 0 { return false }
    mut ch := name.charAt(0)
    // Private types: _PascalCase — check second char
    if ch == "_" && nlen > 1 { ch = name.charAt(1) }
    mut is_upper := ch == "A" || ch == "B" || ch == "C" || ch == "D" || ch == "E" ||
        ch == "F" || ch == "G" || ch == "H" || ch == "I" || ch == "J" ||
        ch == "K" || ch == "L" || ch == "M" || ch == "N" || ch == "O" ||
        ch == "P" || ch == "Q" || ch == "R" || ch == "S" || ch == "T" ||
        ch == "U" || ch == "V" || ch == "W" || ch == "X" || ch == "Y" || ch == "Z"
    if is_upper == false { return false }
    // Reject SCREAMING_SNAKE_CASE: if all chars are uppercase/underscore/digit, not a type
    // Start after leading _ for private types
    mut i := 1
    if name.charAt(0) == "_" && nlen > 2 { i = 2 }
    while i < nlen {
        c := name.charAt(i)
        mut is_lower := c == "a" || c == "b" || c == "c" || c == "d" || c == "e" ||
            c == "f" || c == "g" || c == "h" || c == "i" || c == "j" ||
            c == "k" || c == "l" || c == "m" || c == "n" || c == "o" ||
            c == "p" || c == "q" || c == "r" || c == "s" || c == "t" ||
            c == "u" || c == "v" || c == "w" || c == "x" || c == "y" || c == "z"
        if is_lower { return true }
        i = i + 1
    }
    // Check for underscores — SCREAMING_SNAKE_CASE has underscores, short PascalCase (PR, CE, LT) does not
    // Skip leading _ (private type prefix)
    mut j := 0
    if name.charAt(0) == "_" { j = 1 }
    while j < nlen {
        if name.charAt(j) == "_" { return false }
        j = j + 1
    }
    // All-caps with no underscore is a short PascalCase type name (PR, CE, LT, IO).
    // Single-letter names (P, T) are also accepted as types — disambiguation
    // from generic params happens at the call site via context (e.g. `{` for
    // struct literal). Callers that want to *exclude* single-letter generic
    // params should check separately.
    true
}

// --- Public API: parse a token stream ---

fn parse(tokens: [Token]) -> PR {
    mut p := new_parser(tokens)
    // Skip sentinel token at index 0
    if _ck(p) == "EOF" && p.pos == 0 && p.tokens.len() > 1 { p = _adv(p) }
    p = _skip_nl(p)

    if _ck(p) == "mod" {
        p = _adv(p)
        p = _adv(p)
        p = _skip_nl(p)
    }

    while _ck(p) == "use" {
        p = _adv(p)
        // Record the module name if present (may be IDENT or a keyword-named
        // stdlib module like `test` / `bench` — accept either).
        first := _ck(p)
        if first != "NEWLINE" && first != "EOF" { p = _adv(p) }
        // Stop at decl-starters because the lexer omits NEWLINE after keyword-
        // named module paths.
        while _ck(p) != "NEWLINE" && _ck(p) != "EOF" {
            nm := _ck(p)
            if nm == "fn" || nm == "type" || nm == "struct" || nm == "enum" || nm == "trait" ||
               nm == "impl" || nm == "const" || nm == "entry" || nm == "test" || nm == "bench" ||
               nm == "pub" || nm == "extern" || nm == "use" || nm == "mod" || nm == "@" {
                break
            }
            p = _adv(p)
        }
        p = _skip_nl(p)
    }

    mut decl_indices := [0]
    mut count := 0
    while _ck(p) != "EOF" {
        p = _skip_nl(p)
        if _ck(p) == "EOF" {
            // Add index nodes for collected declarations
            list_start := _pidx(p)
            mut di := 0
            while di < count {
                p = _padd(p, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                   c0: decl_indices[di + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                di = di + 1
            }
            return PR{p: p, e: Expr{kind: EkBlock, s1: "", s2: "", b1: false, b2: false,
                                     c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: _no_span()}}
        }
        result := _parse_top(p)
        decl_idx := _pidx(result.p)
        p = _padd(result.p, result.e)
        decl_indices = decl_indices.append(decl_idx)
        count = count + 1
        p = _skip_nl(p)
    }

    // Add index nodes for collected declarations
    list_start := _pidx(p)
    mut di := 0
    while di < count {
        p = _padd(p, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                           c0: decl_indices[di + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        di = di + 1
    }

    PR{p: p, e: Expr{kind: EkBlock, s1: "", s2: "", b1: false, b2: false,
                      c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: _no_span()}}
}

// ============================================================
// Declaration Index Builder
// Walks tokens once, records each top-level declaration.
// ============================================================

// Check if a token kind can be used as a function name.
// Keywords like "test", "check", "match" are valid fn names.
fn _is_fn_name_token(tk: str) -> bool {
    if tk == "IDENT" { return true }
    if tk == "test" { return true }
    if tk == "check" { return true }
    if tk == "match" { return true }
    if tk == "type" { return true }
    if tk == "where" { return true }
    if tk == "bench" { return true }
    return false
}

fn build_decl_index(tokens: [Token]) -> ParseResult {
    mut idx := new_decl_index()
    mut pos := 0
    len := tokens.len()

    // Skip sentinel at index 0
    if pos < len && tokens[pos].name == "EOF" {
        pos = pos + 1
    }

    // Skip newlines
    while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }

    // Skip mod declaration
    if pos < len && tokens[pos].name == "mod" {
        pos = pos + 1  // skip "mod"
        // Consume module name: one token (IDENT or keyword like `test`, `bench`),
        // optionally followed by `.path` segments. Must NOT scan to NEWLINE because
        // the lexer sometimes omits NEWLINE between `mod <keyword>` and the next
        // decl — that would swallow the next function declaration.
        if pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
            pos = pos + 1  // consume module name token
            while pos < len && tokens[pos].name == "." {
                pos = pos + 1
                if pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
                    pos = pos + 1
                }
            }
        }
        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
    }

    // Skip use declarations (record them in index). Stop consuming at the
    // first decl-starter because the lexer omits NEWLINE after keyword-named
    // module paths (e.g. `use test` / `use bench`).
    while pos < len && tokens[pos].name == "use" {
        use_start := pos
        name := ""
        pos = pos + 1
        if pos < len && tokens[pos].name == "IDENT" {
            name = tokens[pos].text
        }
        while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
            nm := tokens[pos].name
            if nm == "fn" || nm == "type" || nm == "struct" || nm == "enum" || nm == "trait" ||
               nm == "impl" || nm == "const" || nm == "entry" || nm == "test" || nm == "bench" ||
               nm == "pub" || nm == "extern" || nm == "use" || nm == "mod" || nm == "@" {
                if tokens[pos - 1].name == "use" || tokens[pos - 1].name == "." {
                    pos = pos + 1
                } else {
                    break
                }
            } else {
                pos = pos + 1
            }
        }
        use_end := pos
        idx = decl_index_add(idx, DeclInfo{kind: DkUse, name: name, token_start: use_start, body_start: use_start, body_end: use_end, is_pub: false, node_idx: 0})
        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
    }

    // Scan top-level declarations
    while pos < len && tokens[pos].name != "EOF" {
        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
        if pos >= len || tokens[pos].name == "EOF" { return ParseResult{index: idx, pool: new_pool(), diagnostics: new_bag()} }

        mut is_pub := false
        if tokens[pos].name == "pub" {
            is_pub = true
            pos = pos + 1
            // Skip optional (pkg) scope qualifier — treated as pub for intra-package compilation
            if pos < len && tokens[pos].name == "(" {
                pos = pos + 1
                if pos < len && tokens[pos].name == "IDENT" { pos = pos + 1 }
                if pos < len && tokens[pos].name == ")" { pos = pos + 1 }
            }
        }

        // Skip annotations
        if pos < len && tokens[pos].name == "@" {
            pos = pos + 1
            if pos < len && tokens[pos].name == "IDENT" { pos = pos + 1 }
            if pos < len && tokens[pos].name == "(" {
                pos = pos + 1
                while pos < len && tokens[pos].name != ")" && tokens[pos].name != "EOF" { pos = pos + 1 }
                if pos < len && tokens[pos].name == ")" { pos = pos + 1 }
            }
            while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
        }

        if pos >= len || tokens[pos].name == "EOF" { return ParseResult{index: idx, pool: new_pool(), diagnostics: new_bag()} }

        k := tokens[pos].name
        lb := "\{"
        rb := "\}"

        if k == "fn" {
            decl_start := pos
            pos = pos + 1  // skip "fn"
            mut name := ""
            if pos < len && _is_fn_name_token(tokens[pos].name) {
                name = tokens[pos].text
            }
            // Find body start: scan past params, return type, where clause to = or {
            pos = _bdi_find_fn_body(tokens, pos, len)
            body_start := pos
            // Skip past body
            if pos < len && tokens[pos].name == "=" {
                pos = pos + 1
                pos = _bdi_skip_expr(tokens, pos, len)
            } else if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkFn, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "type" || k == "struct" {
            decl_start := pos
            pos = pos + 1  // skip "type"/"struct"
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
                pos = pos + 1
            }
            // Skip generic params
            if pos < len && tokens[pos].name == "[" {
                pos = _bdi_skip_brackets(tokens, pos, len)
            }
            body_start := pos
            // Skip body: = variants... or { fields... }
            if pos < len && tokens[pos].name == "=" {
                pos = pos + 1
                while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
                if pos < len && tokens[pos].name == "|" {
                    // Sum type variants
                    while pos < len && tokens[pos].name == "|" {
                        pos = pos + 1
                        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
                        if pos < len { pos = pos + 1 }  // variant name
                        if pos < len && tokens[pos].name == "(" {
                            pos = _bdi_skip_parens(tokens, pos, len)
                        } else if pos < len && tokens[pos].name == lb {
                            pos = _bdi_skip_braces(tokens, pos, len)
                        }
                        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
                    }
                } else {
                    // Single-line type alias or newtype
                    while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
                        pos = pos + 1
                    }
                }
            } else if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            // Skip derives
            while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
            if pos < len && tokens[pos].name == "derives" {
                while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkType, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "enum" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
                pos = pos + 1
            }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkEnum, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "trait" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
            }
            // Find the brace
            while pos < len && tokens[pos].name != lb && tokens[pos].name != "EOF" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkTrait, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "impl" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
            }
            while pos < len && tokens[pos].name != lb && tokens[pos].name != "EOF" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkImpl, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "const" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
            }
            // Skip to end of line (const values are single-expression)
            while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            idx = decl_index_add(idx, DeclInfo{kind: DkConst, name: name, token_start: decl_start, body_start: decl_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "mut" {
            // Module-level mut binding: `mut NAME := expr`. Register with a
            // "_mut:" name prefix so the lowerer can distinguish it from
            // `const`. Codegen allocates an LLVM global and emits GlobalLoad
            // / GlobalStore for reads/writes.
            decl_start := pos
            pos = pos + 1  // skip mut
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
                pos = pos + 1
            }
            // Skip optional `: Type`
            if pos < len && tokens[pos].name == ":" {
                while pos < len && tokens[pos].name != ":=" && tokens[pos].name != "=" && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            }
            // Skip to end of line (mut values are single-expression)
            while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            idx = decl_index_add(idx, DeclInfo{kind: DkConst, name: "_mut:" + name, token_start: decl_start, body_start: decl_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "mod" {
            // `mod <name>` — consume mod + name token (optionally dotted path).
            // Do NOT scan to NEWLINE: the lexer omits NEWLINE between `mod <keyword>`
            // (e.g. `mod test`) and the next decl, so scanning to NEWLINE eats the
            // following fn/type/etc. declaration.
            pos = pos + 1  // skip mod
            if pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
                pos = pos + 1  // consume name token
                while pos < len && tokens[pos].name == "." {
                    pos = pos + 1
                    if pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
                        pos = pos + 1
                    }
                }
            }
        } else if k == "use" {
            // Consume a use clause: `use <path>` or `use <prefix>.{ ... }`.
            // We stop at the first recognized top-level decl-starter so that
            // `use <keyword>` (e.g. `use test`, `use bench`) doesn't over-consume
            // when the lexer omits the trailing NEWLINE.
            pos = pos + 1  // skip use
            // Optional brace-form immediately after `use`
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            } else {
                while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
                    nm := tokens[pos].name
                    if nm == "fn" || nm == "type" || nm == "struct" || nm == "enum" || nm == "trait" ||
                       nm == "impl" || nm == "const" || nm == "entry" || nm == "test" || nm == "bench" ||
                       nm == "pub" || nm == "extern" || nm == "use" || nm == "mod" || nm == "@" {
                        // Only stop on a decl-starter if it appears at a position
                        // that couldn't be part of the use path. Heuristic: the
                        // very first token after `use` is the module root and
                        // may legitimately be a keyword like `test`/`bench` — so
                        // let it through. Subsequent keyword-tokens terminate.
                        if tokens[pos - 1].name == "use" || tokens[pos - 1].name == "." {
                            pos = pos + 1  // allow keyword-as-module-name
                        } else {
                            break
                        }
                    } else if nm == lb {
                        pos = _bdi_skip_braces(tokens, pos, len)
                    } else {
                        pos = pos + 1
                    }
                }
            }
        } else if k == "entry" {
            decl_start := pos
            pos = pos + 1
            while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkEntry, name: "", token_start: decl_start, body_start: body_start, body_end: pos, is_pub: false, node_idx: 0})
        } else if k == "test" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && (tokens[pos].name == "STRING" || tokens[pos].name == "IDENT") {
                name = tokens[pos].text
                pos = pos + 1
            }
            while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkTest, name: name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: false, node_idx: 0})
        } else if k == "bench" {
            decl_start := pos
            pos = pos + 1
            mut name := ""
            if pos < len && (tokens[pos].name == "STRING" || tokens[pos].name == "IDENT") {
                name = tokens[pos].text
                pos = pos + 1
            }
            while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkTest, name: "_bench:" + name, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: false, node_idx: 0})
        } else if k == "extern" {
            decl_start := pos
            pos = pos + 1
            // extern "lib" { ... } or extern fn name(...)
            if pos < len && tokens[pos].name == "STRING" { pos = pos + 1 }
            body_start := pos
            if pos < len && tokens[pos].name == lb {
                pos = _bdi_skip_braces(tokens, pos, len)
            } else if pos < len && tokens[pos].name == "fn" {
                while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            }
            idx = decl_index_add(idx, DeclInfo{kind: DkFn, name: "_extern", token_start: decl_start, body_start: body_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if k == "IDENT" && pos < len && tokens[pos].text == "alias" {
            decl_start := pos
            pos = pos + 1  // skip "alias"
            mut name := ""
            if pos < len && tokens[pos].name == "IDENT" {
                name = tokens[pos].text
            }
            while pos < len && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" { pos = pos + 1 }
            idx = decl_index_add(idx, DeclInfo{kind: DkType, name: "_alias:" + name, token_start: decl_start, body_start: decl_start, body_end: pos, is_pub: is_pub, node_idx: 0})
        } else if (k == "before" || k == "after") {
            // Check if followed by { (fixture block)
            decl_start := pos
            fixture_kind := k
            mut probe := pos + 1
            while probe < len && tokens[probe].name == "NEWLINE" { probe = probe + 1 }
            if probe < len && tokens[probe].name == lb {
                pos = pos + 1  // skip before/after
                while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
                body_start := pos
                pos = _bdi_skip_braces(tokens, pos, len)
                idx = decl_index_add(idx, DeclInfo{kind: DkFn, name: "_fixture:" + fixture_kind, token_start: decl_start, body_start: body_start, body_end: pos, is_pub: false, node_idx: 0})
            } else {
                // Not a fixture — skip as unknown
                pos = pos + 1
            }
        } else {
            // Unknown token — advance
            pos = pos + 1
        }

        while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
    }

    // Also run the full parser to build the AST pool
    pr := parse(tokens)
    result := _bridge_ast_to_decl_index(idx, pr.p.pool, pr.e)
    ParseResult{index: result, pool: pr.p.pool, diagnostics: new_bag()}
}

fn _bridge_ast_to_decl_index(idx: DeclIndex, pool: NodePool, root: Expr) -> DeclIndex {
    mut out := idx
    mut ni := 0
    while ni < root.list_count {
        // Root children are index nodes: c0 points to actual declaration
        idx_node := pool_get(pool, root.list_start + ni)
        actual_idx := idx_node.c0
        node := pool_get(pool, actual_idx)
        nk := expr_kind_name(node.kind)
        mut node_name := ""
        mut is_decl := false
        if nk == "FnDecl" || nk == "ConstDecl" || nk == "TypeDecl" || nk == "EnumDecl" || nk == "TraitDecl" || nk == "ImplDecl" {
            node_name = node.s1
            is_decl = true
        } else if nk == "Block" && node.s1 == "_entry" {
            node_name = ""
            is_decl = true
        } else if nk == "Block" && node.s1.startsWith("_test:") {
            slen := node.s1.len()
            node_name = node.s1.substring(6, slen)
            is_decl = true
        }
        if is_decl {
            mut di := 1
            mut found := false
            while di < decl_index_len(out) {
                decl := decl_index_get(out, di)
                mut matched := false
                if nk == "Block" && node.s1 == "_entry" && decl_kind_name(decl.kind) == "entry" && decl.node_idx == 0 {
                    matched = true
                } else if nk == "Block" && node.s1.startsWith("_test:") && decl_kind_name(decl.kind) == "test" && decl.name == node_name && decl.node_idx == 0 {
                    matched = true
                } else if decl.name == node_name && decl.node_idx == 0 && decl_kind_name(decl.kind) != "entry" && decl_kind_name(decl.kind) != "test" {
                    matched = true
                }
                if matched {
                    found = true
                    updated := DeclInfo{kind: decl.kind, name: decl.name, token_start: decl.token_start,
                                        body_start: decl.body_start, body_end: decl.body_end,
                                        is_pub: decl.is_pub, node_idx: actual_idx}
                    out = _decl_index_set(out, di, updated)
                    di = decl_index_len(out)  // break
                } else {
                    di = di + 1
                }
            }
        }
        ni = ni + 1
    }
    out
}

// --- Declaration index helpers ---

fn _bdi_skip_braces(tokens: [Token], start: i64, len: i64) -> i64 {
    lb := "\{"
    rb := "\}"
    if start >= len || tokens[start].name != lb { return start }
    mut pos := start + 1
    mut depth := 1
    while depth > 0 && pos < len {
        if tokens[pos].name == lb { depth = depth + 1 }
        if tokens[pos].name == rb { depth = depth - 1 }
        pos = pos + 1
    }
    pos
}

fn _bdi_skip_brackets(tokens: [Token], start: i64, len: i64) -> i64 {
    if start >= len || tokens[start].name != "[" { return start }
    mut pos := start + 1
    mut depth := 1
    while depth > 0 && pos < len {
        if tokens[pos].name == "[" { depth = depth + 1 }
        if tokens[pos].name == "]" { depth = depth - 1 }
        pos = pos + 1
    }
    pos
}

fn _bdi_skip_parens(tokens: [Token], start: i64, len: i64) -> i64 {
    if start >= len || tokens[start].name != "(" { return start }
    mut pos := start + 1
    mut depth := 1
    while depth > 0 && pos < len {
        if tokens[pos].name == "(" { depth = depth + 1 }
        if tokens[pos].name == ")" { depth = depth - 1 }
        pos = pos + 1
    }
    pos
}

fn _bdi_find_fn_body(tokens: [Token], start: i64, len: i64) -> i64 {
    // From after "fn", scan past name, generic params, params, return type, where clause
    // to find = or { that starts the body
    mut pos := start
    lb := "\{"
    // Skip name (can be IDENT or keyword used as function name)
    if pos < len && _is_fn_name_token(tokens[pos].name) { pos = pos + 1 }
    // Skip generic params [T, U]
    if pos < len && tokens[pos].name == "[" {
        pos = _bdi_skip_brackets(tokens, pos, len)
    }
    // Skip params (...)
    if pos < len && tokens[pos].name == "(" {
        pos = _bdi_skip_parens(tokens, pos, len)
    }
    // Skip return type annotation: -> Type
    if pos < len && tokens[pos].name == "->" {
        pos = pos + 1
        pos = _bdi_skip_type_tokens(tokens, pos, len)
    }
    // Skip error type: ! Type
    if pos < len && tokens[pos].name == "!" {
        pos = pos + 1
        pos = _bdi_skip_type_tokens(tokens, pos, len)
    }
    // Skip with clause
    if pos < len && tokens[pos].name == "with" {
        pos = pos + 1
        while pos < len && tokens[pos].name != "=" && tokens[pos].name != lb && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
            pos = pos + 1
        }
    }
    // Skip where clause
    if pos < len && tokens[pos].name == "where" {
        pos = pos + 1
        while pos < len && tokens[pos].name != "=" && tokens[pos].name != lb && tokens[pos].name != "NEWLINE" && tokens[pos].name != "EOF" {
            pos = pos + 1
        }
    }
    // Skip newlines to find body on next line
    while pos < len && tokens[pos].name == "NEWLINE" { pos = pos + 1 }
    // Now pos should be at = or {
    pos
}

fn _bdi_skip_type_tokens(tokens: [Token], start: i64, len: i64) -> i64 {
    // Skip a type annotation (IDENT, [], fn(...) -> ..., etc.)
    mut pos := start
    if pos >= len { return pos }
    k := tokens[pos].name
    if k == "IDENT" || k == "Self" {
        pos = pos + 1
        // Skip dots (qualified names)
        while pos < len && tokens[pos].name == "." {
            nxt := pos + 1
            if nxt < len && tokens[nxt].name == "." { return pos }  // range ..
            pos = pos + 2  // skip . and name
        }
        // Skip generic args [T, U]
        if pos < len && tokens[pos].name == "[" {
            pos = _bdi_skip_brackets(tokens, pos, len)
        }
        // Skip optional ?
        if pos < len && tokens[pos].name == "?" { pos = pos + 1 }
        // Skip error type !
        if pos < len && tokens[pos].name == "!" {
            pos = pos + 1
            pos = _bdi_skip_type_tokens(tokens, pos, len)
        }
        return pos
    }
    if k == "[" {
        pos = _bdi_skip_brackets(tokens, pos, len)
        return pos
    }
    if k == "(" {
        pos = _bdi_skip_parens(tokens, pos, len)
        if pos < len && tokens[pos].name == "->" {
            pos = pos + 1
            pos = _bdi_skip_type_tokens(tokens, pos, len)
        }
        return pos
    }
    if k == "fn" {
        pos = pos + 1
        // Optional `once`
        if pos < len && tokens[pos].name == "IDENT" && tokens[pos].text == "once" { pos = pos + 1 }
        if pos < len && tokens[pos].name == "(" {
            pos = _bdi_skip_parens(tokens, pos, len)
        }
        if pos < len && tokens[pos].name == "->" {
            pos = pos + 1
            pos = _bdi_skip_type_tokens(tokens, pos, len)
        }
        return pos
    }
    pos
}

fn _bdi_skip_expr(tokens: [Token], start: i64, len: i64) -> i64 {
    // Skip a single expression (to end of line or balanced braces)
    mut pos := start
    lb := "\{"
    rb := "\}"
    while pos < len {
        k := tokens[pos].name
        if k == "NEWLINE" || k == "EOF" { return pos }
        if k == lb {
            pos = _bdi_skip_braces(tokens, pos, len)
        } else {
            pos = pos + 1
        }
    }
    pos
}

fn _parse_top(p: Parser) -> PR {
    k := _ck(p)
    if k == "fn" { return _parse_fn(p) }
    if k == "pub" {
        pp := _adv(p)
        return _parse_top(pp)
    }
    if k == "type" || k == "struct" { return _parse_type_decl(p) }
    if k == "enum" { return _parse_enum_decl(p) }
    if k == "trait" { return _parse_trait_decl(p) }
    if k == "impl" { return _parse_impl_decl(p) }
    if k == "const" { return _parse_const_decl(p) }
    if k == "entry" { return _parse_entry(p) }
    if k == "test" { return _parse_test(p) }
    if k == "bench" { return _parse_bench(p) }
    _parse_stmt(p)
}

// --- Function declaration ---

fn _parse_fn(p: Parser) -> PR {
    span := _pspan(p)
    pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    // Capture generic params: "T:Eq,U" format
    mut generics := ""
    if _ck(pp) == "[" {
        pp = _adv(pp)
        mut gcount := 0
        while _ck(pp) != "]" && _ck(pp) != "EOF" {
            if _ck(pp) == "IDENT" {
                mut gname := _cur(pp).text
                pp = _adv(pp)
                // HKT: detect F[_] syntax
                if _ck(pp) == "[" {
                    next_pos := pp.pos + 1
                    if next_pos < pp.tokens.len() && _cur(_adv(pp)).text == "_" {
                        pp = _adv(pp)  // skip [
                        pp = _adv(pp)  // skip _
                        if _ck(pp) == "]" { pp = _adv(pp) }
                        gname = gname + "[_]"
                    }
                }
                if gcount > 0 { generics = generics + "," }
                generics = generics + gname
                // Capture optional trait bound ": Trait" or ": Trait + Trait2"
                // Also supports associated-type constraints: ": Trait<Item=Type>"
                if _ck(pp) == ":" {
                    pp = _adv(pp)
                    if _ck(pp) == "IDENT" {
                        generics = generics + ":" + _cur(pp).text
                        pp = _adv(pp)
                        if _ck(pp) == "<" {
                            pp = _adv(pp)
                            if _ck(pp) == "IDENT" {
                                assoc_n := _cur(pp).text
                                pp = _adv(pp)
                                if _ck(pp) == "=" {
                                    pp = _adv(pp)
                                    if _ck(pp) == "IDENT" {
                                        assoc_v := _cur(pp).text
                                        generics = generics + "<" + assoc_n + "=" + assoc_v + ">"
                                        pp = _adv(pp)
                                    }
                                }
                            }
                            if _ck(pp) == ">" { pp = _adv(pp) }
                        }
                        while _ck(pp) == "+" {
                            pp = _adv(pp)
                            if _ck(pp) == "IDENT" {
                                generics = generics + "+" + _cur(pp).text
                                pp = _adv(pp)
                            }
                        }
                    }
                }
                gcount = gcount + 1
            } else {
                pp = _adv(pp)
            }
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        if _ck(pp) == "]" { pp = _adv(pp) }
    }
    pp = _expect(pp, "(")
    // Collect parameters as EkParam nodes
    mut param_indices := [0]
    mut param_count := 0
    while _ck(pp) != ")" && _ck(pp) != "EOF" {
        // Accept IDENT, "self", or keywords followed by ":"
        mut is_param := _ck(pp) == "IDENT" || _ck(pp) == "self"
        if is_param == false {
            npos := pp.pos + 1
            if npos < pp.tokens.len() {
                nk := pp.tokens[npos].name
                if nk == ":" { is_param = true }
            }
        }
        if is_param {
            pname := _cur(pp).text
            pspan := _pspan(pp)
            pp = _adv(pp)
            if pname == "self" {
                // self param — no type annotation
                pidx := _pidx(pp)
                pp = _padd(pp, mk_param("self", 0, true, pspan))
                param_indices = param_indices.append(pidx)
                param_count = param_count + 1
            } else if _ck(pp) == ":" {
                pp = _adv(pp)  // skip ':'
                // Parse type and store AST node in pool (replaces _skip_type)
                tr := _parse_type(pp)
                pp = tr.p
                type_node_idx := _pidx(pp)
                pp = _padd(pp, tr.e)
                pidx := _pidx(pp)
                pp = _padd(pp, mk_param(pname, type_node_idx, false, pspan))
                param_indices = param_indices.append(pidx)
                param_count = param_count + 1
            }
        } else {
            pp = _adv(pp)
        }
        if _ck(pp) == "," { pp = _adv(pp) }
    }
    pp = _adv(pp)  // skip ')'
    // Return type
    mut has_ret := false
    mut ret_tok_pos := 0
    if _ck(pp) == "->" {
        pp = _adv(pp)
        has_ret = true
        ret_tok_pos = pp.pos
        pp = _skip_type(pp)
    }
    // Error type
    mut err_tok_pos := 0
    if _ck(pp) == "!" {
        pp = _adv(pp)
        err_tok_pos = pp.pos
        pp = _skip_type(pp)
    }
    // Skip where clause
    if _ck(pp) == "with" {
        pp = _adv(pp)
        lb := "\{"
        while _ck(pp) != "NEWLINE" && _ck(pp) != "EOF" && _ck(pp) != "=" && _ck(pp) != lb {
            pp = _adv(pp)
        }
    }
    // Skip where clause (keyword "where")
    if _ck(pp) == "where" {
        lb := "\{"
        while _ck(pp) != "NEWLINE" && _ck(pp) != "EOF" && _ck(pp) != "=" && _ck(pp) != lb {
            pp = _adv(pp)
        }
    }
    mut body := _no_expr()
    lb := "\{"
    if _ck(pp) == "=" {
        pp = _adv(pp)
        result := _parse_expr(pp, 0)
        pp = result.p
        body = result.e
    } else if _ck(pp) == lb {
        result := _parse_block(pp)
        pp = result.p
        body = result.e
    } else {
        pp = _skip_nl(pp)
        if _ck(pp) == lb {
            result := _parse_block(pp)
            pp = result.p
            body = result.e
        }
    }
    mut has_body := false
    mut body_idx := 0
    if expr_kind_name(body.kind) != "None" {
        has_body = true
        body_idx = _pidx(pp)
        pp = _padd(pp, body)
    }
    // Add index nodes for params
    list_start := _pidx(pp)
    mut pi := 0
    while pi < param_count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: param_indices[pi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        pi = pi + 1
    }
    PR{p: pp, e: Expr{kind: EkFnDecl, s1: name, s2: generics, b1: has_body, b2: has_ret,
                       c0: body_idx, c1: ret_tok_pos, c2: err_tok_pos, list_start: list_start, list_count: param_count, span: span}}
}

// Parse a type expression, building AST nodes into the pool.
// Returns PR with the type node. Also serves as _skip_type (advances past all type tokens).
fn _parse_type(p: Parser) -> PR {
    mut pp := p
    k := _ck(pp)
    span := _pspan(pp)
    // Named type: Ident, Ident.Path, Ident[T], Ident?, Ident ! Err
    if k == "IDENT" || k == "Self" {
        mut name := _cur(pp).text
        pp = _adv(pp)
        // Qualified path: Mod.Type
        while _ck(pp) == "." && _pk(pp) != "." {
            pp = _adv(pp)
            name = name + "." + _cur(pp).text
            pp = _adv(pp)
        }
        // Generic args: Type[A, B]
        mut type_arg_idx := 0
        if _ck(pp) == "[" {
            pp = _adv(pp)
            mut d := 1
            while d > 0 && _ck(pp) != "EOF" {
                if _ck(pp) == "[" { d = d + 1 }
                if _ck(pp) == "]" { d = d - 1 }
                if d > 0 { pp = _adv(pp) }
            }
            pp = _adv(pp)
        }
        // Optional: Type?
        if _ck(pp) == "?" {
            pp = _adv(pp)
            base := Expr{kind: EkTypeRef, s1: name, s2: "", b1: false, b2: false,
                         c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}
            base_idx := _pidx(pp)
            pp = _padd(pp, base)
            return PR{p: pp, e: Expr{kind: EkTypeOptional, s1: "", s2: "", b1: false, b2: false,
                                      c0: base_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
        }
        // Result: Type ! ErrType
        if _ck(pp) == "!" {
            pp = _adv(pp)
            err := _parse_type(pp)
            err_idx := _pidx(err.p)
            pp = _padd(err.p, err.e)
            base := Expr{kind: EkTypeRef, s1: name, s2: "", b1: false, b2: false,
                         c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}
            base_idx := _pidx(pp)
            pp = _padd(pp, base)
            return PR{p: pp, e: Expr{kind: EkTypeResult, s1: "", s2: "", b1: false, b2: false,
                                      c0: base_idx, c1: err_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
        }
        return PR{p: pp, e: Expr{kind: EkTypeRef, s1: name, s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    // Array type: [T]
    if k == "[" {
        pp = _adv(pp)
        elem := _parse_type(pp)
        elem_idx := _pidx(elem.p)
        pp = _padd(elem.p, elem.e)
        pp = _expect(pp, "]")
        return PR{p: pp, e: Expr{kind: EkTypeArray, s1: "", s2: "", b1: false, b2: false,
                                  c0: elem_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    // Tuple type: (A, B, C) or fn type starting with (
    if k == "(" {
        pp = _adv(pp)
        list_start := _pidx(pp)
        mut count := 0
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            sub := _parse_type(pp)
            pp = _padd(sub.p, sub.e)
            count = count + 1
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _adv(pp)
        // Check for -> (function type without fn keyword)
        if _ck(pp) == "->" {
            pp = _adv(pp)
            ret := _parse_type(pp)
            ret_idx := _pidx(ret.p)
            pp = _padd(ret.p, ret.e)
            return PR{p: pp, e: Expr{kind: EkTypeFn, s1: "", s2: "", b1: false, b2: false,
                                      c0: ret_idx, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
        }
        return PR{p: pp, e: Expr{kind: EkTypeTuple, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    // Function type: fn(A, B) -> C [! E]
    if k == "fn" {
        pp = _adv(pp)
        if _ck(pp) == "IDENT" && _cur(pp).text == "once" { pp = _adv(pp) }
        pp = _expect(pp, "(")
        list_start := _pidx(pp)
        mut count := 0
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            sub := _parse_type(pp)
            pp = _padd(sub.p, sub.e)
            count = count + 1
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _adv(pp)
        mut ret_idx := 0
        if _ck(pp) == "->" {
            pp = _adv(pp)
            ret := _parse_type(pp)
            ret_idx = _pidx(ret.p)
            pp = _padd(ret.p, ret.e)
        }
        // Optional error type after `!`. Stored in c1 so the checker can
        // construct a fallible fn type (TypeInfo.type_id2 != 0).
        mut err_idx := 0
        if _ck(pp) == "!" {
            pp = _adv(pp)
            et := _parse_type(pp)
            err_idx = _pidx(et.p)
            pp = _padd(et.p, et.e)
        }
        return PR{p: pp, e: Expr{kind: EkTypeFn, s1: "", s2: "", b1: false, b2: false,
                                  c0: ret_idx, c1: err_idx, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    // Unknown — return empty and don't advance
    PR{p: pp, e: Expr{kind: EkTypeRef, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

// Backward-compatible: _skip_type advances past type tokens (used by callers that don't need AST)
fn _skip_type(p: Parser) -> Parser {
    result := _parse_type(p)
    result.p
}

fn _skip_braces(p: Parser) -> Parser {
    lb := "\{"
    rb := "\}"
    if _ck(p) != lb { return p }
    mut pp := _adv(p)
    mut d := 1
    while d > 0 && _ck(pp) != "EOF" {
        if _ck(pp) == lb { d = d + 1 }
        if _ck(pp) == rb { d = d - 1 }
        if d > 0 { pp = _adv(pp) }
    }
    _adv(pp)
}

fn _parse_type_decl(p: Parser) -> PR {
    span := _pspan(p)
    pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    // Capture generic params
    mut generics := ""
    if _ck(pp) == "[" {
        pp = _adv(pp)
        mut gcount := 0
        while _ck(pp) != "]" && _ck(pp) != "EOF" {
            if _ck(pp) == "IDENT" {
                gname := _cur(pp).text
                if gcount > 0 { generics = generics + "," }
                generics = generics + gname
                pp = _adv(pp)
                if _ck(pp) == ":" {
                    pp = _adv(pp)
                    if _ck(pp) == "IDENT" {
                        generics = generics + ":" + _cur(pp).text
                        pp = _adv(pp)
                        // Optional associated-type constraint: <Name=Type>
                        if _ck(pp) == "<" {
                            pp = _adv(pp)
                            if _ck(pp) == "IDENT" {
                                assoc_n := _cur(pp).text
                                pp = _adv(pp)
                                if _ck(pp) == "=" {
                                    pp = _adv(pp)
                                    if _ck(pp) == "IDENT" {
                                        assoc_v := _cur(pp).text
                                        generics = generics + "<" + assoc_n + "=" + assoc_v + ">"
                                        pp = _adv(pp)
                                    }
                                }
                            }
                            if _ck(pp) == ">" { pp = _adv(pp) }
                        }
                        while _ck(pp) == "+" {
                            pp = _adv(pp)
                            if _ck(pp) == "IDENT" {
                                generics = generics + "+" + _cur(pp).text
                                pp = _adv(pp)
                            }
                        }
                    }
                }
                gcount = gcount + 1
            } else {
                pp = _adv(pp)
            }
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        if _ck(pp) == "]" { pp = _adv(pp) }
    }
    lb := "\{"
    mut has_variants := false
    mut newtype_tok_pos := 0
    mut child_indices := [0]
    mut child_count := 0
    if _ck(pp) == "=" {
        pp = _adv(pp)
        pp = _skip_nl(pp)
    }
    // Detect inline sum type: IDENT | ... (first variant without leading |)
    mut inline_sum := false
    if _ck(pp) == "IDENT" {
        // Look ahead: if next non-newline token after ident (and optional payload) is |, it's a sum type
        mut la := _adv(pp)
        // Skip optional payload: (Type, ...) or {name: Type, ...}
        if _ck(la) == "(" {
            mut depth := 1
            la = _adv(la)
            while depth > 0 && _ck(la) != "EOF" {
                if _ck(la) == "(" { depth = depth + 1 }
                if _ck(la) == ")" { depth = depth - 1 }
                la = _adv(la)
            }
        }
        if _ck(la) == "|" { inline_sum = true }
    }
    if inline_sum {
        has_variants = true
        // Parse the first variant (no leading |)
        vname := _cur(pp).text
        vspan := _pspan(pp)
        pp = _adv(pp)
        mut vf_indices := [0]
        mut vf_count := 0
        mut is_tuple := false
        if _ck(pp) == "(" {
            is_tuple = true
            pp = _adv(pp)
            mut fi := 0
            while _ck(pp) != ")" && _ck(pp) != "EOF" {
                fspan := _pspan(pp)
                tr := _parse_type(pp)
                pp = tr.p
                type_node_idx := _pidx(pp)
                pp = _padd(pp, tr.e)
                fidx := _pidx(pp)
                pp = _padd(pp, mk_field("_" + i2s(fi), type_node_idx, fspan))
                vf_indices = vf_indices.append(fidx)
                vf_count = vf_count + 1
                fi = fi + 1
                if _ck(pp) == "," { pp = _adv(pp) }
            }
            if _ck(pp) == ")" { pp = _adv(pp) }
        }
        vf_list_start := _pidx(pp)
        mut vfi := 0
        while vfi < vf_count {
            pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                 c0: vf_indices[vfi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
            vfi = vfi + 1
        }
        vidx := _pidx(pp)
        pp = _padd(pp, Expr{kind: EkVariant, s1: vname, s2: "", b1: is_tuple, b2: false,
                             c0: 0, c1: 0, c2: 0, list_start: vf_list_start, list_count: vf_count, span: vspan})
        child_indices = child_indices.append(vidx)
        child_count = child_count + 1
        pp = _skip_nl(pp)
    }
    if _ck(pp) == "|" {
        // Sum type: parse variants (with leading | prefix)
        has_variants = true
        while _ck(pp) == "|" {
            pp = _adv(pp)  // skip |
            pp = _skip_nl(pp)
            vname := _cur(pp).text
            vspan := _pspan(pp)
            pp = _adv(pp)  // skip variant name
            // Parse variant payload fields
            mut vf_indices := [0]
            mut vf_count := 0
            mut is_tuple := false
            if _ck(pp) == "(" {
                is_tuple = true
                pp = _adv(pp)  // skip (
                mut fi := 0
                while _ck(pp) != ")" && _ck(pp) != "EOF" {
                    fspan := _pspan(pp)
                    tr := _parse_type(pp)
                    pp = tr.p
                    type_node_idx := _pidx(pp)
                    pp = _padd(pp, tr.e)
                    fidx := _pidx(pp)
                    pp = _padd(pp, mk_field("_" + i2s(fi), type_node_idx, fspan))
                    vf_indices = vf_indices.append(fidx)
                    vf_count = vf_count + 1
                    fi = fi + 1
                    if _ck(pp) == "," { pp = _adv(pp) }
                }
                if _ck(pp) == ")" { pp = _adv(pp) }
            } else if _ck(pp) == lb {
                pp = _adv(pp)  // skip {
                pp = _skip_nl(pp)
                rb := "\}"
                while _ck(pp) != rb && _ck(pp) != "EOF" {
                    if _ck(pp) == "IDENT" {
                        fname := _cur(pp).text
                        fspan := _pspan(pp)
                        pp = _adv(pp)
                        if _ck(pp) == ":" {
                            pp = _adv(pp)
                            tr := _parse_type(pp)
                            pp = tr.p
                            type_node_idx := _pidx(pp)
                            pp = _padd(pp, tr.e)
                            fidx := _pidx(pp)
                            pp = _padd(pp, mk_field(fname, type_node_idx, fspan))
                            vf_indices = vf_indices.append(fidx)
                            vf_count = vf_count + 1
                        }
                    } else {
                        pp = _adv(pp)
                    }
                    pp = _skip_nl(pp)
                    if _ck(pp) == "," { pp = _adv(pp) }
                    pp = _skip_nl(pp)
                }
                if _ck(pp) == rb { pp = _adv(pp) }
            }
            // Add field index nodes for this variant
            vf_list_start := _pidx(pp)
            mut vfi := 0
            while vfi < vf_count {
                pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                     c0: vf_indices[vfi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                vfi = vfi + 1
            }
            // Create variant node
            vidx := _pidx(pp)
            pp = _padd(pp, Expr{kind: EkVariant, s1: vname, s2: "", b1: is_tuple, b2: false,
                                 c0: 0, c1: 0, c2: 0, list_start: vf_list_start, list_count: vf_count, span: vspan})
            child_indices = child_indices.append(vidx)
            child_count = child_count + 1
            pp = _skip_nl(pp)
        }
    } else if _ck(pp) == lb {
        // Struct type: parse fields
        pp = _adv(pp)  // skip {
        pp = _skip_nl(pp)
        rb := "\}"
        while _ck(pp) != rb && _ck(pp) != "EOF" {
            if _ck(pp) == "IDENT" {
                fname := _cur(pp).text
                fspan := _pspan(pp)
                pp = _adv(pp)
                if _ck(pp) == ":" {
                    pp = _adv(pp)
                    tr := _parse_type(pp)
                    pp = tr.p
                    type_node_idx := _pidx(pp)
                    pp = _padd(pp, tr.e)
                    // Optional default: `name: Type = <expr>`. Record the
                    // starting token position of the default expression so
                    // struct-literal lowering can replay it for omitted fields.
                    mut default_tok := 0
                    if _ck(pp) == "=" {
                        pp = _adv(pp)
                        default_tok = pp.pos
                        def_r := _parse_expr(pp, 0)
                        pp = _padd(def_r.p, def_r.e)
                    }
                    fidx := _pidx(pp)
                    field_expr := Expr{kind: EkField, s1: fname, s2: "", b1: false, b2: false,
                                       c0: type_node_idx, c1: default_tok, c2: 0,
                                       list_start: 0, list_count: 0, span: fspan}
                    pp = _padd(pp, field_expr)
                    child_indices = child_indices.append(fidx)
                    child_count = child_count + 1
                }
            } else {
                pp = _adv(pp)
            }
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
            pp = _skip_nl(pp)
        }
        if _ck(pp) == rb { pp = _adv(pp) }
    } else {
        // Newtype: type Name = Type (not | and not {)
        // Check if we have a type to parse
        if _ck(pp) != "NEWLINE" && _ck(pp) != "EOF" && _ck(pp) != "derives" {
            newtype_tok_pos = pp.pos
            pp = _skip_type(pp)
        }
    }
    // Skip derives
    if _ck(pp) == "derives" {
        pp = _adv(pp)
        if _ck(pp) == "[" {
            pp = _adv(pp)
            while _ck(pp) != "]" && _ck(pp) != "EOF" { pp = _adv(pp) }
            pp = _adv(pp)
        }
    }
    // Add index nodes for children (fields or variants)
    list_start := _pidx(pp)
    mut ci := 0
    while ci < child_count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: child_indices[ci + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        ci = ci + 1
    }
    mut is_sum := false
    if has_variants { is_sum = true }
    glen := generics.len()
    mut has_generics := false
    if glen > 0 { has_generics = true }
    PR{p: pp, e: Expr{kind: EkTypeDecl, s1: name, s2: generics, b1: is_sum, b2: has_generics,
                       c0: newtype_tok_pos, c1: 0, c2: 0, list_start: list_start, list_count: child_count, span: span}}
}

fn _parse_enum_decl(p: Parser) -> PR {
    span := _pspan(p)
    pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    lb := "\{"
    rb := "\}"
    // Parse variant names
    mut variant_names := ""
    mut variant_count := 0
    if _ck(pp) == lb {
        pp = _adv(pp)  // skip {
        pp = _skip_nl(pp)
        while _ck(pp) != rb && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            if _ck(pp) == "IDENT" {
                if variant_count > 0 { variant_names = variant_names + "," }
                variant_names = variant_names + _cur(pp).text
                variant_count = variant_count + 1
                pp = _adv(pp)
            } else if _ck(pp) == rb || _ck(pp) == "EOF" {
                mut _skip := 0
            } else {
                pp = _adv(pp)
            }
            pp = _skip_nl(pp)
        }
        if _ck(pp) == rb { pp = _adv(pp) }
    }
    // s2 = comma-joined variant names
    PR{p: pp, e: Expr{kind: EkEnumDecl, s1: name, s2: variant_names, b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: 0, list_count: variant_count, span: span}}
}

fn _parse_trait_decl(p: Parser) -> PR {
    span := _pspan(p)
    pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    // Capture supertrait clause: trait B: A, C {
    mut supers := ""
    if _ck(pp) == ":" {
        pp = _adv(pp)  // skip :
        mut scount := 0
        mut parsing := true
        while parsing {
            if _ck(pp) == "IDENT" {
                if scount > 0 { supers = supers + "," }
                supers = supers + _cur(pp).text
                scount = scount + 1
                pp = _adv(pp)
                if _ck(pp) == "," { pp = _adv(pp) } else { parsing = false }
            } else {
                parsing = false
            }
        }
    }
    lb := "\{"
    while _ck(pp) != lb && _ck(pp) != "EOF" { pp = _adv(pp) }
    if _ck(pp) != lb {
        return PR{p: pp, e: Expr{kind: EkTraitDecl, s1: name, s2: supers, b1: false, b2: false,
                                   c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    pp = _adv(pp)  // skip {
    pp = _skip_nl(pp)
    rb := "\}"
    // Parse methods as FnDecl nodes (same as impl)
    mut method_indices := [0]
    mut method_count := 0
    // Also collect associated type names
    mut assoc_types := ""
    mut assoc_count := 0
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        pp = _skip_nl(pp)
        if _ck(pp) == "pub" { pp = _adv(pp) }
        if _ck(pp) == "fn" {
            result := _parse_fn(pp)
            method_idx := _pidx(result.p)
            pp = _padd(result.p, result.e)
            method_indices = method_indices.append(method_idx)
            method_count = method_count + 1
        } else if _ck(pp) == "type" {
            pp = _adv(pp)  // skip type
            if _ck(pp) == "IDENT" {
                if assoc_count > 0 { assoc_types = assoc_types + "," }
                assoc_types = assoc_types + _cur(pp).text
                assoc_count = assoc_count + 1
            }
            while _ck(pp) != "NEWLINE" && _ck(pp) != rb && _ck(pp) != "EOF" { pp = _adv(pp) }
        } else if _ck(pp) == rb || _ck(pp) == "EOF" {
            mut _skip := 0
        } else {
            pp = _adv(pp)
        }
        pp = _skip_nl(pp)
    }
    if _ck(pp) == rb { pp = _adv(pp) }
    // Add index nodes for methods
    list_start := _pidx(pp)
    mut mi := 0
    while mi < method_count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: method_indices[mi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        mi = mi + 1
    }
    // s2 = supertrait names (comma-separated)
    // b1 = has associated types
    // c0 = assoc_count (repurposed)
    // Encode assoc_types into the node by appending to s2 after a ";" separator
    mut full_s2 := supers
    alen := assoc_types.len()
    if alen > 0 {
        full_s2 = full_s2 + ";" + assoc_types
    }
    PR{p: pp, e: Expr{kind: EkTraitDecl, s1: name, s2: full_s2, b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: method_count, span: span}}
}

fn _parse_impl_decl(p: Parser) -> PR {
    span := _pspan(p)
    pp := _adv(p)
    // Capture impl target type name
    mut impl_type := ""
    if _ck(pp) == "IDENT" {
        impl_type = _cur(pp).text
    }
    // Capture trait name if present: impl Type : Trait { ... }
    mut trait_name := ""
    lb := "\{"
    // Scan for trait name — look for : before {
    mut scan := pp
    while _ck(scan) != lb && _ck(scan) != "EOF" {
        if _ck(scan) == ":" {
            scan = _adv(scan)
            if _ck(scan) == "IDENT" {
                trait_name = _cur(scan).text
            }
        }
        scan = _adv(scan)
    }
    // Advance to opening brace
    while _ck(pp) != lb && _ck(pp) != "EOF" { pp = _adv(pp) }
    if _ck(pp) != lb {
        return PR{p: pp, e: mk_impl_decl(impl_type, trait_name, 0, span)}
    }
    pp = _adv(pp)  // skip {
    pp = _skip_nl(pp)
    // Parse methods
    rb := "\}"
    mut method_indices := [0]
    mut method_count := 0
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        pp = _skip_nl(pp)
        if _ck(pp) == "pub" { pp = _adv(pp) }
        if _ck(pp) == "fn" {
            result := _parse_fn(pp)
            method_idx := _pidx(result.p)
            pp = _padd(result.p, result.e)
            method_indices = method_indices.append(method_idx)
            method_count = method_count + 1
        } else if _ck(pp) == rb || _ck(pp) == "EOF" {
            // done
            mut _skip := 0
        } else {
            pp = _adv(pp)
        }
        pp = _skip_nl(pp)
    }
    if _ck(pp) == rb { pp = _adv(pp) }
    // Add index nodes for methods
    list_start := _pidx(pp)
    mut mi := 0
    while mi < method_count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: method_indices[mi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        mi = mi + 1
    }
    PR{p: pp, e: Expr{kind: EkImplDecl, s1: impl_type, s2: trait_name, b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: method_count, span: span}}
}

fn _parse_const_decl(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    mut type_tok_pos := 0
    if _ck(pp) == ":" {
        pp = _adv(pp)
        type_tok_pos = pp.pos
        pp = _skip_type(pp)
    }
    pp = _expect(pp, "=")
    result := _parse_expr(pp, 0)
    val_idx := _pidx(result.p)
    pp = _padd(result.p, result.e)
    // c0=val_idx, c1=type_tok_pos
    PR{p: pp, e: Expr{kind: EkConstDecl, s1: name, s2: "", b1: false, b2: false,
                       c0: val_idx, c1: type_tok_pos, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_entry(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    result := _parse_block(pp)
    body_idx := _pidx(result.p)
    pp = _padd(result.p, result.e)
    PR{p: pp, e: Expr{kind: EkBlock, s1: "_entry", s2: "", b1: false, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: result.e.list_start, list_count: result.e.list_count, span: span}}
}

fn _parse_test(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    mut test_name := ""
    if _ck(pp) == "STRING" || _ck(pp) == "IDENT" {
        test_name = _cur(pp).text
        pp = _adv(pp)
    }
    result := _parse_block(pp)
    body_idx := _pidx(result.p)
    pp = _padd(result.p, result.e)
    PR{p: pp, e: Expr{kind: EkBlock, s1: "_test:" + test_name, s2: "", b1: false, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: result.e.list_start, list_count: result.e.list_count, span: span}}
}

fn _parse_bench(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    mut bench_name := ""
    if _ck(pp) == "STRING" || _ck(pp) == "IDENT" {
        bench_name = _cur(pp).text
        pp = _adv(pp)
    }
    result := _parse_block(pp)
    body_idx := _pidx(result.p)
    pp = _padd(result.p, result.e)
    PR{p: pp, e: Expr{kind: EkBlock, s1: "_test:_bench:" + bench_name, s2: "", b1: false, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: result.e.list_start, list_count: result.e.list_count, span: span}}
}

// --- Statement ---

fn _parse_stmt(p: Parser) -> PR {
    k := _ck(p)
    if k == "mut" { return _parse_mut(p) }
    if k == "return" { return _parse_return(p) }
    if k == "break" {
        span := _pspan(p)
        mut pp := _adv(p)
        mut label := ""
        if _ck(pp) == "IDENT" { label = _cur(pp).text; pp = _adv(pp) }
        return PR{p: pp, e: Expr{kind: EkBreak, s1: label, s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "continue" {
        span := _pspan(p)
        mut pp := _adv(p)
        mut label := ""
        if _ck(pp) == "IDENT" { label = _cur(pp).text; pp = _adv(pp) }
        return PR{p: pp, e: Expr{kind: EkContinue, s1: label, s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "yield" {
        span := _pspan(p)
        mut pp := _adv(p)
        val := _parse_expr(pp, 0)
        val_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        return PR{p: pp, e: Expr{kind: EkYield, s1: "", s2: "", b1: true, b2: false,
                                  c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "for" { return _parse_for(p) }
    if k == "while" { return _parse_while(p) }
    if k == "loop" { return _parse_loop(p) }
    // Labeled loop: label: for/while/loop — skip label and colon, parse loop
    if k == "IDENT" {
        lp1 := p.pos + 1
        if lp1 < p.tokens.len() && p.tokens[lp1].name == ":" {
            lp2 := lp1 + 1
            if lp2 < p.tokens.len() {
                lk := p.tokens[lp2].name
                if lk == "for" || lk == "while" || lk == "loop" {
                    label := _cur(p).text
                    mut pp := _adv(_adv(_adv(p)))  // skip label, :, keyword
                    if lk == "for" {
                        fr := _parse_for_body(pp, label)
                        return fr
                    }
                    if lk == "while" {
                        wr := _parse_while_body(pp, label)
                        return wr
                    }
                    lr := _parse_loop_body(pp, label)
                    return lr
                }
            }
        }
    }
    if k == "defer" {
        span := _pspan(p)
        mut pp := _adv(p)
        r := _parse_expr(pp, 0)
        defer_idx := _pidx(r.p)
        pp = _padd(r.p, r.e)
        return PR{p: pp, e: Expr{kind: EkDefer, s1: "", s2: "", b1: false, b2: false,
                                  c0: defer_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "assert" { return _parse_assert(p) }
    if k == "with" { return _parse_with(p) }
    if k == "type" || k == "struct" { return _parse_type_decl(p) }

    result := _parse_expr(p, 0)
    mut pp := result.p

    if _ck(pp) == ":=" {
        pp = _adv(pp)
        val := _parse_expr(pp, 0)
        val_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        pp = _skip_nl(pp)
        // Tuple-destructuring binding: (a, b, ...) := rhs
        // Encoded as EkBinding with s1="$tuple", s2 = comma-separated names,
        // list_count = element count. Lowerer expands into FieldGet per elem.
        if expr_kind_name(result.e.kind) == "Tuple" {
            mut tup_names := ""
            mut ti := 0
            while ti < result.e.list_count {
                holder := pool_get(pp.pool, result.e.list_start + ti)
                elem := pool_get(pp.pool, holder.c0)
                if ti > 0 { tup_names = tup_names + "," }
                tup_names = tup_names + elem.s1
                ti = ti + 1
            }
            return PR{p: pp, e: Expr{kind: EkBinding, s1: "$tuple", s2: tup_names, b1: false, b2: false,
                                      c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: result.e.list_count, span: result.e.span}}
        }
        return PR{p: pp, e: Expr{kind: EkBinding, s1: result.e.s1, s2: "", b1: false, b2: false,
                                  c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: result.e.span}}
    }
    if _ck(pp) == ":" {
        pp = _adv(pp)
        pp = _skip_type(pp)
        pp = _expect(pp, "=")
        val := _parse_expr(pp, 0)
        val_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        pp = _skip_nl(pp)
        return PR{p: pp, e: Expr{kind: EkBinding, s1: result.e.s1, s2: "", b1: false, b2: false,
                                  c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: result.e.span}}
    }
    if _ck(pp) == "=" {
        lhs_idx := _pidx(pp)
        pp = _padd(pp, result.e)
        pp = _adv(pp)
        val := _parse_expr(pp, 0)
        rhs_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        pp = _skip_nl(pp)
        return PR{p: pp, e: Expr{kind: EkAssign, s1: "", s2: "", b1: false, b2: false,
                                  c0: lhs_idx, c1: rhs_idx, c2: 0, list_start: 0, list_count: 0, span: result.e.span}}
    }
    // Compound assignment: x += rhs → Assign(x, Binary("+", x, rhs))
    if _ck(pp) == "+=" || _ck(pp) == "-=" || _ck(pp) == "*=" || _ck(pp) == "/=" || _ck(pp) == "%=" {
        op_text := _cur(pp).text
        // Extract arithmetic op (drop trailing '=')
        arith_op := op_text.substring(0, 1)
        // Add LHS to pool — used as both Assign LHS and Binary's left operand
        lhs_idx := _pidx(pp)
        pp = _padd(pp, result.e)
        pp = _adv(pp)
        val := _parse_expr(pp, 0)
        rhs_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        // Build Binary(op, lhs, rhs) — reuses lhs_idx
        binary_idx := _pidx(pp)
        pp = _padd(pp, Expr{kind: EkBinary, s1: arith_op, s2: "", b1: false, b2: false,
                             c0: lhs_idx, c1: rhs_idx, c2: 0, list_start: 0, list_count: 0, span: result.e.span})
        pp = _skip_nl(pp)
        return PR{p: pp, e: Expr{kind: EkAssign, s1: "", s2: "", b1: false, b2: false,
                                  c0: lhs_idx, c1: binary_idx, c2: 0, list_start: 0, list_count: 0, span: result.e.span}}
    }

    pp = _skip_nl(pp)
    PR{p: pp, e: result.e}
}

fn _parse_mut(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    name := _cur(pp).text
    pp = _adv(pp)
    if _ck(pp) == ":" {
        pp = _adv(pp)
        pp = _skip_type(pp)
        pp = _expect(pp, "=")
    } else { pp = _expect(pp, ":=") }
    val := _parse_expr(pp, 0)
    val_idx := _pidx(val.p)
    pp = _padd(val.p, val.e)
    PR{p: pp, e: Expr{kind: EkBinding, s1: name, s2: "", b1: true, b2: false,
                       c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

// --- Expression parsing (Pratt) ---

fn _parse_expr(p: Parser, min_bp: i64) -> PR {
    mut result := _parse_prefix(p)
    mut pp := result.p
    mut left := result.e

    mut running := true
    while running {
        // Skip NL when the next non-NL token is a pipeline continuation `|>`
        // so multi-line pipelines are parsed as a single expression.
        if _cur(pp).name == "NEWLINE" {
            mut peek := pp.pos + 1
            while peek < pp.tokens.len() && pp.tokens[peek].name == "NEWLINE" { peek = peek + 1 }
            if peek < pp.tokens.len() && pp.tokens[peek].text == "|>" {
                pp = Parser{tokens: pp.tokens, pos: peek, pool: pp.pool, diagnostics: pp.diagnostics}
            }
        }
        cur_name := _cur(pp).name
        post_bp := postfix_binding_power(cur_name)
        // Contextual postfix keywords stored as IDENT: `or`, `must`
        // Treat them as postfix operators with binding power 150 (same as `?`)
        is_or_must := false
        if _ck(pp) == "IDENT" {
            txt := _cur(pp).text
            if txt == "or" || txt == "must" {
                is_or_must = true
            }
        }
        if is_or_must && 150 >= min_bp {
            op_text := _cur(pp).text
            span := _pspan(pp)
            left_idx := _pidx(pp)
            pp = _padd(pp, left)
            pp = _adv(pp)  // skip or/must
            // Parse the operand expression
            rhs := _parse_expr(pp, 151)
            pp = rhs.p
            rhs_idx := _pidx(pp)
            pp = _padd(pp, rhs.e)
            // Store as Binary with op="or" or "must"
            left = Expr{kind: EkBinary, s1: op_text, s2: "", b1: false, b2: false,
                        c0: left_idx, c1: rhs_idx, c2: 0, list_start: 0, list_count: 0, span: span}
        } else if post_bp > 0 && post_bp >= min_bp {
            post := _parse_postfix(pp, left)
            pp = post.p
            left = post.e
        } else {
            bp := infix_binding_power(cur_name)
            if bp.left > 0 && bp.left >= min_bp {
                op := _cur(pp).text
                span := _pspan(pp)
                left_idx := _pidx(pp)
                pp = _padd(pp, left)
                pp = _adv(pp)
                right := _parse_expr(pp, bp.right)
                pp = right.p
                right_idx := _pidx(pp)
                pp = _padd(pp, right.e)
                left = Expr{kind: EkBinary, s1: op, s2: "", b1: false, b2: false,
                            c0: left_idx, c1: right_idx, c2: 0, list_start: 0, list_count: 0, span: span}
            } else {
                running = false
            }
        }
    }

    PR{p: pp, e: left}
}

fn _parse_prefix(p: Parser) -> PR {
    k := _ck(p)

    // Skip annotations (@name or @name(...)) in expression position
    if k == "@" {
        mut pp := _adv(p)
        if _ck(pp) == "IDENT" { pp = _adv(pp) }
        if _ck(pp) == "(" {
            pp = _adv(pp)
            while _ck(pp) != ")" && _ck(pp) != "EOF" { pp = _adv(pp) }
            if _ck(pp) == ")" { pp = _adv(pp) }
        }
        pp = _skip_nl(pp)
        return _parse_prefix(pp)
    }

    if k == "-" || k == "!" || k == "~" {
        op := _cur(p).text
        span := _pspan(p)
        pp := _adv(p)
        bp := prefix_binding_power(_cur(p).name)
        r := _parse_expr(pp, bp)
        operand_idx := _pidx(r.p)
        pp = _padd(r.p, r.e)
        return PR{p: pp, e: Expr{kind: EkUnary, s1: op, s2: "", b1: false, b2: false,
                                  c0: operand_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "INT" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_int_lit(tok.text, _pspan(p))}
    }
    if k == "FLOAT" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_float_lit(tok.text, _pspan(p))}
    }
    if k == "DURATION" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_duration_lit(tok.text, _pspan(p))}
    }
    if k == "SIZE" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_size_lit(tok.text, _pspan(p))}
    }
    if k == "STRING" || k == "RAW_STRING" || k == "TRIPLE_STRING" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_string_lit(tok.text, _pspan(p))}
    }
    if k == "STRING_START" {
        // String interpolation: "text{expr}more{expr}end"
        // Store token position in c0 for lowerer to find STRING_START directly
        span := _pspan(p)
        tok_pos := p.pos
        mut pp := _adv(p)
        while _ck(pp) != "STRING_END" && _ck(pp) != "EOF" {
            if _ck(pp) == "STRING_MIDDLE" {
                pp = _adv(pp)
            } else {
                r := _parse_expr(pp, 0)
                pp = r.p
            }
        }
        if _ck(pp) == "STRING_END" { pp = _adv(pp) }
        return PR{p: pp, e: Expr{kind: EkStringLit, s1: "", s2: "", b1: false, b2: false,
                                  c0: tok_pos, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "true" { return PR{p: _adv(p), e: mk_bool_lit(true, _pspan(p))} }
    if k == "false" { return PR{p: _adv(p), e: mk_bool_lit(false, _pspan(p))} }
    if k == "if" { return _parse_if(p) }
    if k == "match" { return _parse_match(p) }
    if k == "select" { return _parse_select(p) }
    if k == "spawn" { return _parse_spawn(p) }
    if k == "scope" { return _parse_scope(p) }
    if k == "fn" { return _parse_closure_expr(p) }
    if k == "(" { return _parse_grouped(p) }
    if k == "[" { return _parse_array(p) }
    lb := "\{"
    if k == lb { return _parse_brace_expr(p) }
    // Prefix catch: catch <expr> { arms }
    if k == "catch" {
        span := _pspan(p)
        mut pp := _adv(p)
        // Parse the expression being caught
        inner := _parse_expr(pp, 0)
        inner_idx := _pidx(inner.p)
        pp = _padd(inner.p, inner.e)
        pp = _skip_nl(pp)
        lb2 := "\{"
        rb2 := "\}"
        // Check if followed by { => (multi-arm catch)
        mut has_arms := false
        if _ck(pp) == lb2 {
            mut sc := pp.pos + 1
            mut sl := 0
            while sc < pp.tokens.len() && pp.tokens[sc].name != rb2 && sl < 80 {
                if pp.tokens[sc].name == "=>" { has_arms = true }
                sc = sc + 1; sl = sl + 1
            }
        }
        if has_arms {
            // Multi-arm prefix catch — parse like postfix multi-arm catch
            pp = _adv(pp)  // skip {
            pp = _skip_nl(pp)
            mut arm_indices := [0]
            mut arm_count := 0
            while _ck(pp) != rb2 && _ck(pp) != "EOF" {
                pp = _skip_nl(pp)
                pat := _parse_expr(pp, 0)
                pat_idx := _pidx(pat.p)
                pp = _padd(pat.p, pat.e)
                while _ck(pp) != "=>" && _ck(pp) != rb2 && _ck(pp) != "EOF" { pp = _adv(pp) }
                if _ck(pp) == "=>" { pp = _adv(pp) }
                pp = _skip_nl(pp)
                mut body_e := _no_expr()
                pbk := _ck(pp)
                if pbk == lb2 {
                    br := _parse_block(pp)
                    pp = br.p; body_e = br.e
                } else if pbk == "return" || pbk == "break" || pbk == "continue" {
                    br := _parse_stmt(pp)
                    pp = br.p; body_e = br.e
                } else {
                    br := _parse_expr(pp, 0)
                    pp = br.p; body_e = br.e
                }
                body_idx := _pidx(pp)
                pp = _padd(pp, body_e)
                arm_indices = arm_indices.append(pat_idx)
                arm_indices = arm_indices.append(body_idx)
                arm_count = arm_count + 1
                pp = _skip_nl(pp)
            }
            if _ck(pp) == rb2 { pp = _adv(pp) }
            list_start := _pidx(pp)
            mut ai := 0
            while ai < arm_count {
                pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                     c0: arm_indices[ai * 2 + 1], c1: arm_indices[ai * 2 + 2], c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                ai = ai + 1
            }
            return PR{p: pp, e: Expr{kind: EkCatch, s1: "", s2: "", b1: true, b2: false,
                                      c0: inner_idx, c1: 0, c2: 0, list_start: list_start, list_count: arm_count, span: span}}
        }
        // Single-body prefix catch
        body := _parse_block(pp)
        body_idx := _pidx(body.p)
        pp = _padd(body.p, body.e)
        return PR{p: pp, e: Expr{kind: EkCatch, s1: "", s2: "", b1: false, b2: false,
                                  c0: inner_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "IDENT" || k == "Self" || k == "self" {
        name := _cur(p).text
        span := _pspan(p)
        mut pp := _adv(p)
        lb := "\{"
        // Only parse struct literal if name starts with uppercase (type names are PascalCase)
        if _ck(pp) == lb && _is_upper_start(name) { return _parse_struct_lit(pp, name, span) }
        // Method ref: Type::method — rewrite as qualified name Type_method
        if _ck(pp) == ":" && _pk(pp) == ":" {
            pp = _adv(pp)  // skip first :
            pp = _adv(pp)  // skip second :
            if _ck(pp) == "IDENT" {
                meth := _cur(pp).text
                pp = _adv(pp)
                return PR{p: pp, e: mk_ident(name + "_" + meth, span)}
            }
        }
        return PR{p: pp, e: mk_ident(name, span)}
    }

    pp := _perror(p, E0005, "expected expression, got " + k)
    PR{p: _adv(pp), e: _no_expr()}
}

// Parse record update body: field: val, ...} — called after .{ has been consumed
fn _parse_record_update(p: Parser, left_idx: i64, span: Span) -> PR {
    rb := "\}"
    mut pp := _skip_nl(p)
    mut ru_names := [""]
    mut ru_vals := [0]
    mut count := 0
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        mut fname := ""
        if _ck(pp) == "IDENT" {
            fname = _cur(pp).text
            pp = _adv(pp)
        }
        if _ck(pp) == ":" {
            pp = _adv(pp)
            r := _parse_expr(pp, 0)
            val_idx := _pidx(r.p)
            pp = _padd(r.p, r.e)
            ru_names = ru_names.append(fname)
            ru_vals = ru_vals.append(val_idx)
        } else {
            ru_names = ru_names.append(fname)
            ru_vals = ru_vals.append(0)
        }
        count = count + 1
        pp = _skip_nl(pp)
        if _ck(pp) == "," {
            pp = _adv(pp)
            pp = _skip_nl(pp)
        }
    }
    if _ck(pp) == rb { pp = _adv(pp) }
    // Emit EkField wrapper nodes: s1=field_name, c0=value_expr_idx
    list_start := _pidx(pp)
    mut rfi := 0
    while rfi < count {
        pp = _padd(pp, mk_field(ru_names[rfi + 1], ru_vals[rfi + 1], span))
        rfi = rfi + 1
    }
    PR{p: pp, e: Expr{kind: EkStruct, s1: "_update", s2: "", b1: false, b2: false,
                       c0: left_idx, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _parse_postfix(p: Parser, left: Expr) -> PR {
    k := _ck(p)
    dlb := ".\{"
    if k == dlb {
        // Record update via TkDotLBrace token: .{field: val, ...}
        span := _pspan(p)
        left_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)  // consume .{ token
        return _parse_record_update(pp, left_idx, span)
    }
    if k == "." {
        span := _pspan(p)
        left_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)
        lb := "\{"
        if _ck(pp) == lb {
            pp = _adv(pp)  // skip {
            return _parse_record_update(pp, left_idx, span)
        }
        field := _cur(pp).text
        pp = _adv(pp)
        // .to[Type]() and .trunc[Type]() — conversion methods with type arg
        if _ck(pp) == "[" && (field == "to" || field == "trunc" || field == "parse") {
            pp = _adv(pp)  // skip [
            mut type_arg := ""
            if _ck(pp) == "IDENT" {
                type_arg = _cur(pp).text
                pp = _adv(pp)
            }
            if _ck(pp) == "]" { pp = _adv(pp) }
            if _ck(pp) == "(" { pp = _adv(pp) }
            if _ck(pp) == ")" { pp = _adv(pp) }
            return PR{p: pp, e: Expr{kind: EkMethodCall, s1: field, s2: type_arg, b1: false, b2: false,
                                      c0: left_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
        }
        // Struct-like variant construction: Type.Variant { field: val, ... }
        // Only parse as struct if the { } block contains field: value pairs, not match arms (=>)
        if _ck(pp) == lb && _is_upper_start(field) {
            // Look ahead to distinguish struct literal { x: val } from match/block body { arm => }
            mut la_sv := pp.pos + 1
            mut is_struct_lit := false
            if la_sv + 1 < pp.tokens.len() && pp.tokens[la_sv].name == "IDENT" {
                la_sv2 := la_sv + 1
                if la_sv2 < pp.tokens.len() && pp.tokens[la_sv2].name == ":" {
                    is_struct_lit = true
                }
            }
            if is_struct_lit {
                return _parse_struct_lit(pp, field, span)
            }
        }
        if _ck(pp) == "(" {
            pp = _adv(pp)
            mut mc_arg_indices := [0]
            mut count := 0
            while _ck(pp) != ")" && _ck(pp) != "EOF" {
                pp = _skip_nl(pp)
                r := _parse_expr(pp, 0)
                arg_idx := _pidx(r.p)
                pp = _padd(r.p, r.e)
                mc_arg_indices = mc_arg_indices.append(arg_idx)
                count = count + 1
                pp = _skip_nl(pp)
                if _ck(pp) == "," { pp = _adv(pp) }
            }
            pp = _expect(pp, ")")
            list_start := _pidx(pp)
            mut mci := 0
            while mci < count {
                pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                     c0: mc_arg_indices[mci + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                mci = mci + 1
            }
            return PR{p: pp, e: Expr{kind: EkMethodCall, s1: field, s2: "", b1: false, b2: false,
                                      c0: left_idx, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
        }
        return PR{p: pp, e: Expr{kind: EkFieldAccess, s1: field, s2: "", b1: false, b2: false,
                                  c0: left_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "(" {
        span := _pspan(p)
        callee_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)
        mut call_arg_indices := [0]
        mut count := 0
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            r := _parse_expr(pp, 0)
            arg_idx := _pidx(r.p)
            pp = _padd(r.p, r.e)
            call_arg_indices = call_arg_indices.append(arg_idx)
            count = count + 1
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _expect(pp, ")")
        list_start := _pidx(pp)
        mut cai := 0
        while cai < count {
            pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                 c0: call_arg_indices[cai + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
            cai = cai + 1
        }
        return PR{p: pp, e: Expr{kind: EkCall, s1: left.s1, s2: "", b1: false, b2: false,
                                  c0: callee_idx, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    if k == "[" {
        span := _pspan(p)
        obj_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)
        idx_r := _parse_expr(pp, 0)
        idx_idx := _pidx(idx_r.p)
        pp = _padd(idx_r.p, idx_r.e)
        pp = _expect(pp, "]")
        return PR{p: pp, e: Expr{kind: EkIndex, s1: "", s2: "", b1: false, b2: false,
                                  c0: obj_idx, c1: idx_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    if k == "?" {
        inner_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)
        // Check for ? |e| transform pattern
        if _ck(pp) == "|" {
            pp = _adv(pp)  // skip |
            mut err_name := "_"
            if _ck(pp) == "IDENT" {
                err_name = _cur(pp).text
                pp = _adv(pp)
            }
            if _ck(pp) == "|" { pp = _adv(pp) }
            body := _parse_expr(pp, 0)
            body_idx := _pidx(body.p)
            pp = _padd(body.p, body.e)
            // Store as Propagate with s1=error binding name, c1=transform body
            return PR{p: pp, e: Expr{kind: EkPropagate, s1: err_name, s2: "", b1: true, b2: false,
                                      c0: inner_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: _pspan(p)}}
        }
        return PR{p: pp, e: Expr{kind: EkPropagate, s1: "", s2: "", b1: false, b2: false,
                                  c0: inner_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: _pspan(p)}}
    }
    if k == "!" {
        inner_idx := _pidx(p)
        pp := _padd(p, left)
        pp = _adv(pp)
        return PR{p: pp, e: Expr{kind: EkAssertOk, s1: "", s2: "", b1: false, b2: false,
                                  c0: inner_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: _pspan(p)}}
    }
    if k == "catch" {
        span := _pspan(p)
        inner_idx := _pidx(p)
        mut pp := _padd(p, left)
        pp = _adv(pp)
        // catch |err| { body }
        mut err_name := ""
        if _ck(pp) == "|" {
            pp = _adv(pp)
            if _ck(pp) == "IDENT" { err_name = _cur(pp).text; pp = _adv(pp) }
            if _ck(pp) == "|" { pp = _adv(pp) }
        }
        lb := "\{"
        rb := "\}"
        // Check if catch block has match-arm syntax (contains =>)
        mut has_arms := false
        if _ck(pp) == lb {
            mut scan := pp.pos + 1
            mut slimit := 0
            while scan < pp.tokens.len() && pp.tokens[scan].name != rb && slimit < 80 {
                if pp.tokens[scan].name == "=>" { has_arms = true }
                scan = scan + 1
                slimit = slimit + 1
            }
        }
        if has_arms {
            // Multi-arm catch: parse like match body
            // Rewrite as: match <error_expr> { arms }
            // Use list to store (pattern, body) pairs
            pp = _adv(pp)  // skip {
            pp = _skip_nl(pp)
            mut arm_indices := [0]
            mut arm_count := 0
            while _ck(pp) != rb && _ck(pp) != "EOF" {
                pp = _skip_nl(pp)
                // Parse pattern (skip to =>)
                pat := _parse_expr(pp, 0)
                pat_idx := _pidx(pat.p)
                pp = _padd(pat.p, pat.e)
                // Skip to =>
                while _ck(pp) != "=>" && _ck(pp) != rb && _ck(pp) != "EOF" { pp = _adv(pp) }
                if _ck(pp) == "=>" { pp = _adv(pp) }
                pp = _skip_nl(pp)
                // Parse body — handle statement keywords that _parse_expr can't
                mut body_e := _no_expr()
                bk := _ck(pp)
                if bk == lb {
                    br := _parse_block(pp)
                    pp = br.p
                    body_e = br.e
                } else if bk == "return" || bk == "break" || bk == "continue" {
                    br := _parse_stmt(pp)
                    pp = br.p
                    body_e = br.e
                } else {
                    br := _parse_expr(pp, 0)
                    pp = br.p
                    body_e = br.e
                }
                body_idx := _pidx(pp)
                pp = _padd(pp, body_e)
                arm_indices = arm_indices.append(pat_idx)
                arm_indices = arm_indices.append(body_idx)
                arm_count = arm_count + 1
                pp = _skip_nl(pp)
            }
            if _ck(pp) == rb { pp = _adv(pp) }
            // Store arms as list (pairs of pattern, body indices)
            list_start := _pidx(pp)
            mut ai := 0
            while ai < arm_count {
                pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                     c0: arm_indices[ai * 2 + 1], c1: arm_indices[ai * 2 + 2], c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                ai = ai + 1
            }
            return PR{p: pp, e: Expr{kind: EkCatch, s1: err_name, s2: "", b1: true, b2: false,
                                      c0: inner_idx, c1: 0, c2: 0, list_start: list_start, list_count: arm_count, span: span}}
        }
        body := _parse_block(pp)
        body_idx := _pidx(body.p)
        pp = _padd(body.p, body.e)
        return PR{p: pp, e: Expr{kind: EkCatch, s1: err_name, s2: "", b1: false, b2: false,
                                  c0: inner_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    PR{p: p, e: left}
}

fn _parse_block(p: Parser) -> PR {
    span := _pspan(p)
    lb := "\{"
    rb := "\}"
    if _ck(p) != lb {
        pp := _perror(p, E0018, "expected block")
        return PR{p: pp, e: _no_expr()}
    }
    mut pp := _adv(p)
    pp = _skip_nl(pp)
    // Collect statement pool indices
    mut stmt_indices := [0]
    mut count := 0
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        result := _parse_stmt(pp)
        stmt_idx := _pidx(result.p)
        pp = _padd(result.p, result.e)
        stmt_indices = stmt_indices.append(stmt_idx)
        count = count + 1
        pp = _skip_nl(pp)
    }
    pp = _adv(pp)
    // Add index nodes: each is an EkNone with c0 pointing to the actual stmt
    list_start := _pidx(pp)
    mut si := 0
    while si < count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: stmt_indices[si + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        si = si + 1
    }
    PR{p: pp, e: Expr{kind: EkBlock, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _parse_if(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    cond := _parse_expr(pp, 0)
    cond_idx := _pidx(cond.p)
    pp = _padd(cond.p, cond.e)
    then_br := _parse_block(pp)
    then_idx := _pidx(then_br.p)
    pp = _padd(then_br.p, then_br.e)
    mut has_else := false
    mut else_idx := 0
    // Peek past newlines so multiline `if { ... }\nelse if ...` chains are
    // recognized. Only commit to consuming newlines if `else` actually follows.
    mut lookahead := pp
    while _ck(lookahead) == "NEWLINE" { lookahead = _adv(lookahead) }
    if _ck(lookahead) == "else" {
        pp = lookahead
        pp = _adv(pp)
        // Also allow newlines between `else` and its body.
        while _ck(pp) == "NEWLINE" { pp = _adv(pp) }
        has_else = true
        if _ck(pp) == "if" {
            r := _parse_if(pp)
            else_idx = _pidx(r.p)
            pp = _padd(r.p, r.e)
        } else {
            r := _parse_block(pp)
            else_idx = _pidx(r.p)
            pp = _padd(r.p, r.e)
        }
    }
    PR{p: pp, e: Expr{kind: EkIf, s1: "", s2: "", b1: has_else, b2: false,
                       c0: cond_idx, c1: then_idx, c2: else_idx, list_start: 0, list_count: 0, span: span}}
}

fn _parse_match(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    subject := _parse_expr(pp, 0)
    subj_idx := _pidx(subject.p)
    pp = _padd(subject.p, subject.e)
    lb := "\{"
    rb := "\}"
    pp = _skip_nl(pp)
    pp = _expect(pp, lb)
    pp = _skip_nl(pp)
    // Collect arm info: (pattern_idx, guard_idx, alt_start, alt_count, body_idx)
    mut pat_indices := [0]
    mut guard_indices := [0]
    mut alt_starts := [0]
    mut alt_counts := [0]
    mut body_indices := [0]
    mut count := 0
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        pat := _parse_pattern(pp)
        pat_idx := _pidx(pat.p)
        pp = _padd(pat.p, pat.e)
        // Or-patterns: pat1 | pat2 | pat3 — collect alt indices first
        mut alt_idx_0 := 0
        mut alt_idx_1 := 0
        mut alt_idx_2 := 0
        mut alt_idx_3 := 0
        mut alt_idx_4 := 0
        mut alt_idx_5 := 0
        mut alt_idx_6 := 0
        mut alt_idx_7 := 0
        mut alts_count := 0
        while _ck(pp) == "|" {
            pp = _adv(pp)
            pp = _skip_nl(pp)
            alt := _parse_pattern(pp)
            alt_idx := _pidx(alt.p)
            pp = _padd(alt.p, alt.e)
            if alts_count == 0 { alt_idx_0 = alt_idx }
            if alts_count == 1 { alt_idx_1 = alt_idx }
            if alts_count == 2 { alt_idx_2 = alt_idx }
            if alts_count == 3 { alt_idx_3 = alt_idx }
            if alts_count == 4 { alt_idx_4 = alt_idx }
            if alts_count == 5 { alt_idx_5 = alt_idx }
            if alts_count == 6 { alt_idx_6 = alt_idx }
            if alts_count == 7 { alt_idx_7 = alt_idx }
            alts_count = alts_count + 1
        }
        // Add holder nodes consecutively (after all patterns are parsed)
        mut alts_start := 0
        if alts_count > 0 {
            alts_start = _pidx(pp)
            mut hi := 0
            while hi < alts_count {
                mut idx := 0
                if hi == 0 { idx = alt_idx_0 }
                if hi == 1 { idx = alt_idx_1 }
                if hi == 2 { idx = alt_idx_2 }
                if hi == 3 { idx = alt_idx_3 }
                if hi == 4 { idx = alt_idx_4 }
                if hi == 5 { idx = alt_idx_5 }
                if hi == 6 { idx = alt_idx_6 }
                if hi == 7 { idx = alt_idx_7 }
                pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                     c0: idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
                hi = hi + 1
            }
        }
        // Guard expression: if <expr>
        mut guard_idx := 0
        if _ck(pp) == "if" {
            pp = _adv(pp)
            g := _parse_expr(pp, 0)
            guard_idx = _pidx(g.p)
            pp = _padd(g.p, g.e)
        }
        pp = _expect(pp, "=>")
        // Parse body — handle statement keywords that _parse_expr can't
        mut body_e := _no_expr()
        mbk := _ck(pp)
        if mbk == "return" || mbk == "break" || mbk == "continue" {
            mbr := _parse_stmt(pp)
            pp = mbr.p
            body_e = mbr.e
        } else {
            mbr := _parse_expr(pp, 0)
            pp = mbr.p
            body_e = mbr.e
        }
        body_idx := _pidx(pp)
        pp = _padd(pp, body_e)
        pat_indices = pat_indices.append(pat_idx)
        guard_indices = guard_indices.append(guard_idx)
        alt_starts = alt_starts.append(alts_start)
        alt_counts = alt_counts.append(alts_count)
        body_indices = body_indices.append(body_idx)
        count = count + 1
        pp = _skip_nl(pp)
    }
    pp = _adv(pp)
    // Add index nodes: pairs of (pattern, body) index nodes
    // Pattern node uses c0=pat_idx, c1=guard_idx, list_start=alt_holders, list_count=alts_count
    list_start := _pidx(pp)
    mut ai := 0
    while ai < count {
        // Pattern index node — also carries guard and or-pattern alts
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: pat_indices[ai + 1], c1: guard_indices[ai + 1], c2: 0,
                             list_start: alt_starts[ai + 1], list_count: alt_counts[ai + 1], span: _no_span()})
        // Body index node
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: body_indices[ai + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        ai = ai + 1
    }
    PR{p: pp, e: Expr{kind: EkMatch, s1: "", s2: "", b1: false, b2: false,
                       c0: subj_idx, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _skip_parens(p: Parser) -> Parser {
    if _ck(p) != "(" { return p }
    mut pp := _adv(p)
    mut d := 1
    while d > 0 && _ck(pp) != "EOF" {
        if _ck(pp) == "(" { d = d + 1 }
        if _ck(pp) == ")" { d = d - 1 }
        if d > 0 { pp = _adv(pp) }
    }
    _adv(pp)
}

fn _parse_pattern(p: Parser) -> PR {
    k := _ck(p)
    span := _pspan(p)
    lb := "\{"
    // Tuple pattern: (a, b, c)
    if k == "(" {
        mut pp := _adv(p)
        list_start := _pidx(pp)
        mut count := 0
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            sub := _parse_pattern(pp)
            pp = _padd(sub.p, sub.e)
            count = count + 1
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _expect(pp, ")")
        return PR{p: pp, e: Expr{kind: EkTuple, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    // Array pattern: [first, second, ..rest]
    if k == "[" {
        mut pp := _adv(p)
        list_start := _pidx(pp)
        mut count := 0
        while _ck(pp) != "]" && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            if _ck(pp) == ".." {
                // Rest pattern
                pp = _adv(pp)
                if _ck(pp) == "IDENT" {
                    rest_name := _cur(pp).text
                    pp = _padd(_adv(pp), mk_ident(".." + rest_name, span))
                } else {
                    pp = _padd(pp, mk_ident("..", span))
                }
                count = count + 1
            } else {
                sub := _parse_pattern(pp)
                pp = _padd(sub.p, sub.e)
                count = count + 1
            }
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _expect(pp, "]")
        return PR{p: pp, e: Expr{kind: EkArray, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    if k == "INT" {
        tok := _cur(p)
        mut pp := _adv(p)
        // Range pattern: `lo..=hi` / `lo..hi` — encode as a Range node with
        // c0=lo-IntLit, c1=hi-IntLit, b1=inclusive.
        if _ck(pp) == "..=" || _ck(pp) == ".." {
            inclusive := _ck(pp) == "..="
            pp = _adv(pp)
            mut hi_text := ""
            mut neg := false
            if _ck(pp) == "-" { neg = true; pp = _adv(pp) }
            if _ck(pp) == "INT" {
                htok := _cur(pp)
                hi_text = htok.text
                if neg { hi_text = "-" + hi_text }
                pp = _adv(pp)
            }
            lo_idx := _pidx(pp)
            pp = _padd(pp, mk_int_lit(tok.text, span))
            hi_idx := _pidx(pp)
            pp = _padd(pp, mk_int_lit(hi_text, span))
            return PR{p: pp, e: Expr{kind: EkRange, s1: "", s2: "",
                                      b1: inclusive, b2: false,
                                      c0: lo_idx, c1: hi_idx, c2: 0,
                                      list_start: 0, list_count: 0, span: span}}
        }
        return PR{p: pp, e: mk_int_lit(tok.text, span)}
    }
    if k == "FLOAT" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_float_lit(tok.text, span)}
    }
    if k == "STRING" || k == "RAW_STRING" || k == "TRIPLE_STRING" {
        tok := _cur(p)
        return PR{p: _adv(p), e: mk_string_lit(tok.text, span)}
    }
    if k == "true" { return PR{p: _adv(p), e: mk_bool_lit(true, span)} }
    if k == "false" { return PR{p: _adv(p), e: mk_bool_lit(false, span)} }
    if k == "-" {
        // Negative literal pattern
        pp := _adv(p)
        if _ck(pp) == "INT" {
            tok := _cur(pp)
            return PR{p: _adv(pp), e: mk_int_lit("-" + tok.text, span)}
        }
        if _ck(pp) == "FLOAT" {
            tok := _cur(pp)
            return PR{p: _adv(pp), e: mk_float_lit("-" + tok.text, span)}
        }
        return PR{p: pp, e: mk_ident("-", span)}
    }
    if k == "IDENT" || k == "Self" {
        name := _cur(p).text
        mut pp := _adv(p)
        if name == "_" { return PR{p: pp, e: mk_ident("_", span)} }
        // Named pattern: name @ subpattern
        if _ck(pp) == "@" {
            pp = _adv(pp)
            sub := _parse_pattern(pp)
            sub_idx := _pidx(sub.p)
            pp = _padd(sub.p, sub.e)
            return PR{p: pp, e: Expr{kind: EkBinding, s1: name, s2: "@", b1: false, b2: false,
                                      c0: sub_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
        }
        // Check for destructure: Name(x, y) or Name{x: p}
        if _ck(pp) == "(" {
            pp = _adv(pp)
            list_start := _pidx(pp)
            mut count := 0
            while _ck(pp) != ")" && _ck(pp) != "EOF" {
                pp = _skip_nl(pp)
                sub := _parse_pattern(pp)
                pp = _padd(sub.p, sub.e)
                count = count + 1
                pp = _skip_nl(pp)
                if _ck(pp) == "," { pp = _adv(pp) }
            }
            pp = _expect(pp, ")")
            return PR{p: pp, e: Expr{kind: EkCall, s1: name, s2: "", b1: false, b2: false,
                                      c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
        }
        if _ck(pp) == lb {
            // Struct pattern: Move { x, y } or Repeat { count, cmd: inner }
            pp = _adv(pp)  // skip {
            pp = _skip_nl(pp)
            list_start := _pidx(pp)
            mut count := 0
            rb2 := "\}"
            while _ck(pp) != rb2 && _ck(pp) != "EOF" {
                pp = _skip_nl(pp)
                if _ck(pp) == "IDENT" {
                    fname := _cur(pp).text
                    fspan := _pspan(pp)
                    pp = _adv(pp)
                    if _ck(pp) == ":" {
                        // field: binding — store field name in s1, binding name via c1
                        pp = _adv(pp)
                        if _ck(pp) == "IDENT" {
                            bname := _cur(pp).text
                            bspan := _pspan(pp)
                            // Use EkField: s1=binding_name, c0=0, c1 encodes field index
                            // We store field_name as s1 and use EkNone for binding
                            pp = _padd(pp, Expr{kind: EkField, s1: bname, s2: fname, b1: false, b2: false,
                                                 c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: bspan})
                            pp = _adv(pp)
                        }
                    } else {
                        // Shorthand: field name = binding name
                        pp = _padd(pp, Expr{kind: EkField, s1: fname, s2: fname, b1: false, b2: false,
                                             c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: fspan})
                    }
                    count = count + 1
                }
                pp = _skip_nl(pp)
                if _ck(pp) == "," { pp = _adv(pp) }
                pp = _skip_nl(pp)
            }
            if _ck(pp) == rb2 { pp = _adv(pp) }
            // b2=true marks this as a struct pattern (vs tuple pattern)
            return PR{p: pp, e: Expr{kind: EkCall, s1: name, s2: "", b1: false, b2: true,
                                      c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
        }
        // Check for qualified name: Mod.Variant or Mod.Variant(args)
        if _ck(pp) == "." && _pk(pp) == "IDENT" {
            pp = _adv(pp)
            qual := _cur(pp).text
            pp = _adv(pp)
            qname := name + "." + qual
            if _ck(pp) == "(" {
                pp = _adv(pp)
                mut list_start := 0 - 1
                mut count := 0
                while _ck(pp) != ")" && _ck(pp) != "EOF" {
                    pp = _skip_nl(pp)
                    sub := _parse_pattern(pp)
                    pp = _padd(sub.p, sub.e)
                    if list_start < 0 { list_start = _pidx(pp) - 1 }
                    count = count + 1
                    pp = _skip_nl(pp)
                    if _ck(pp) == "," { pp = _adv(pp) }
                }
                pp = _expect(pp, ")")
                if list_start < 0 { list_start = _pidx(pp) }
                return PR{p: pp, e: Expr{kind: EkCall, s1: qname, s2: "", b1: false, b2: false,
                                          c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
            }
            return PR{p: pp, e: mk_ident(qname, span)}
        }
        // Method ref: Type::method — produce qualified name Type_method
        if _ck(pp) == ":" && _pk(pp) == ":" {
            pp = _adv(pp)  // skip first :
            pp = _adv(pp)  // skip second :
            if _ck(pp) == "IDENT" {
                meth := _cur(pp).text
                pp = _adv(pp)
                return PR{p: pp, e: mk_ident(name + "_" + meth, span)}
            }
        }
        return PR{p: pp, e: mk_ident(name, span)}
    }
    // Fallback: advance one token
    PR{p: _adv(p), e: mk_ident(_cur(p).text, span)}
}

fn _parse_closure_expr(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    // Optional `once` keyword — consumed, but semantics not yet enforced
    mut is_once := false
    if _ck(pp) == "IDENT" && _cur(pp).text == "once" {
        is_once = true
        pp = _adv(pp)
    }
    pp = _expect(pp, "(")
    mut params := ""
    while _ck(pp) != ")" && _ck(pp) != "EOF" {
        if params.len() > 0 { params = params + "," }
        params = params + _cur(pp).text
        pp = _adv(pp)
        if _ck(pp) == ":" {
            pp = _adv(pp)
            pp = _skip_type(pp)
        }
        if _ck(pp) == "," { pp = _adv(pp) }
    }
    pp = _adv(pp)
    if _ck(pp) == "->" {
        pp = _adv(pp)
        pp = _skip_type(pp)
    }
    lb := "\{"
    mut body := _no_expr()
    if _ck(pp) == "=>" || _ck(pp) == "=" {
        pp = _adv(pp)
        result := _parse_expr(pp, 0)
        pp = result.p
        body = result.e
    } else if _ck(pp) == lb {
        result := _parse_block(pp)
        pp = result.p
        body = result.e
    } else {
        pp = _expect(pp, "=>")
    }
    body_idx := _pidx(pp)
    pp = _padd(pp, body)
    PR{p: pp, e: Expr{kind: EkClosure, s1: params, s2: "", b1: false, b2: is_once,
                       c0: body_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_grouped(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    pp = _skip_nl(pp)
    result := _parse_expr(pp, 0)
    pp = result.p
    // Check for tuple: if comma follows first expression, it's a tuple
    if _ck(pp) == "," {
        mut tup_indices := [0]
        first_idx := _pidx(pp)
        pp = _padd(pp, result.e)
        tup_indices = tup_indices.append(first_idx)
        mut count := 1
        while _ck(pp) == "," && _ck(pp) != "EOF" {
            pp = _adv(pp)
            pp = _skip_nl(pp)
            if _ck(pp) != ")" {
                r := _parse_expr(pp, 0)
                elem_idx := _pidx(r.p)
                pp = _padd(r.p, r.e)
                tup_indices = tup_indices.append(elem_idx)
                count = count + 1
            }
            pp = _skip_nl(pp)
        }
        if _ck(pp) == ")" { pp = _adv(pp) }
        list_start := _pidx(pp)
        mut tei := 0
        while tei < count {
            pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                 c0: tup_indices[tei + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
            tei = tei + 1
        }
        return PR{p: pp, e: Expr{kind: EkTuple, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    while _ck(pp) != ")" && _ck(pp) != "EOF" { pp = _adv(pp) }
    pp = _adv(pp)
    PR{p: pp, e: result.e}
}

// Disambiguate { in expression position: map literal, set literal, or block
fn _parse_brace_expr(p: Parser) -> PR {
    span := _pspan(p)
    rb := "\}"
    mut pp := _adv(p)
    pp = _skip_nl(pp)
    // Empty braces: empty map literal
    if _ck(pp) == rb {
        pp = _adv(pp)
        return PR{p: pp, e: Expr{kind: EkMapLit, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    // Check if this is a statement block: { IDENT := ... } or { mut ... } or { return ... }
    // If so, delegate to _parse_block which handles multi-statement blocks correctly
    bk := _ck(pp)
    if bk == "mut" || bk == "return" || bk == "break" || bk == "continue" ||
       bk == "for" || bk == "while" || bk == "loop" || bk == "defer" || bk == "assert" {
        // Definitely a statement block — reparse from the { token
        return _parse_block(p)
    }
    // Check for binding: IDENT := ... (peek ahead)
    if bk == "IDENT" {
        peek_pos := pp.pos + 1
        if peek_pos < pp.tokens.len() && pp.tokens[peek_pos].name == ":=" {
            // Statement block with binding — delegate to _parse_block
            return _parse_block(p)
        }
    }
    // Parse first expression to disambiguate map/set/block
    first := _parse_expr(pp, 0)
    first_idx := _pidx(first.p)
    pp = _padd(first.p, first.e)
    pp = _skip_nl(pp)
    // { expr : expr ... } → map literal
    if _ck(pp) == ":" {
        pp = _adv(pp)
        val := _parse_expr(pp, 0)
        val_idx := _pidx(val.p)
        pp = _padd(val.p, val.e)
        // Collect key-value indices (alternating: key, value, key, value, ...)
        mut kv_indices := [0]
        kv_indices = kv_indices.append(first_idx)
        kv_indices = kv_indices.append(val_idx)
        mut count := 1
        pp = _skip_nl(pp)
        if _ck(pp) == "," { pp = _adv(pp) }
        while _ck(pp) != rb && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            kr := _parse_expr(pp, 0)
            ki := _pidx(kr.p)
            pp = _padd(kr.p, kr.e)
            if _ck(pp) == ":" { pp = _adv(pp) }
            vr := _parse_expr(pp, 0)
            vi := _pidx(vr.p)
            pp = _padd(vr.p, vr.e)
            kv_indices = kv_indices.append(ki)
            kv_indices = kv_indices.append(vi)
            count = count + 1
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _adv(pp)
        list_start := _pidx(pp)
        mut mi := 0
        while mi < count * 2 {
            pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                 c0: kv_indices[mi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
            mi = mi + 1
        }
        return PR{p: pp, e: Expr{kind: EkMapLit, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    // { expr , expr ... } → set literal
    if _ck(pp) == "," {
        pp = _adv(pp)
        mut set_indices := [0]
        set_indices = set_indices.append(first_idx)
        mut count := 1
        while _ck(pp) != rb && _ck(pp) != "EOF" {
            pp = _skip_nl(pp)
            r := _parse_expr(pp, 0)
            ei := _pidx(r.p)
            pp = _padd(r.p, r.e)
            set_indices = set_indices.append(ei)
            count = count + 1
            pp = _skip_nl(pp)
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        pp = _adv(pp)
        list_start := _pidx(pp)
        mut si := 0
        while si < count {
            pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                                 c0: set_indices[si + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
            si = si + 1
        }
        return PR{p: pp, e: Expr{kind: EkSetLit, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
    }
    // { expr [NEWLINE stmt]* } → multi-statement block.
    // The first expression has already been parsed; continue parsing further
    // statements until the closing `}`. Previously this path produced a block
    // with exactly one statement, silently dropping the rest.
    pp = _skip_nl(pp)
    mut stmt_indices := [0]
    stmt_indices = stmt_indices.append(first_idx)
    mut count := 1
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        sr := _parse_stmt(pp)
        si_idx := _pidx(sr.p)
        pp = _padd(sr.p, sr.e)
        stmt_indices = stmt_indices.append(si_idx)
        count = count + 1
        pp = _skip_nl(pp)
    }
    if _ck(pp) == rb { pp = _adv(pp) }
    list_start := _pidx(pp)
    mut bsi := 0
    while bsi < count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: stmt_indices[bsi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        bsi = bsi + 1
    }
    PR{p: pp, e: Expr{kind: EkBlock, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _parse_array(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    pp = _skip_nl(pp)
    // Empty array
    if _ck(pp) == "]" {
        pp = _adv(pp)
        return PR{p: pp, e: Expr{kind: EkArray, s1: "", s2: "", b1: false, b2: false,
                                  c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
    }
    // Parse first expression
    first := _parse_expr(pp, 0)
    first_idx := _pidx(first.p)
    pp = _padd(first.p, first.e)
    pp = _skip_nl(pp)
    // List comprehension: [expr for x in iter] or [expr for x in iter where cond]
    if _ck(pp) == "for" {
        pp = _adv(pp)
        mut var_name := ""
        if _ck(pp) == "IDENT" {
            var_name = _cur(pp).text
            pp = _adv(pp)
        }
        if _ck(pp) == "in" { pp = _adv(pp) }
        iter := _parse_expr(pp, 0)
        iter_idx := _pidx(iter.p)
        pp = _padd(iter.p, iter.e)
        pp = _skip_nl(pp)
        mut where_idx := 0
        mut has_where := false
        if _ck(pp) == "where" || _ck(pp) == "if" {
            pp = _adv(pp)
            wexpr := _parse_expr(pp, 0)
            where_idx = _pidx(wexpr.p)
            pp = _padd(wexpr.p, wexpr.e)
            has_where = true
        }
        pp = _skip_nl(pp)
        pp = _expect(pp, "]")
        return PR{p: pp, e: Expr{kind: EkListComp, s1: var_name, s2: "", b1: has_where, b2: false,
                                  c0: first_idx, c1: iter_idx, c2: where_idx,
                                  list_start: 0, list_count: 0, span: span}}
    }
    // Regular array: collect remaining elements
    mut arr_elem_indices := [0]
    arr_elem_indices = arr_elem_indices.append(first_idx)
    mut count := 1
    if _ck(pp) == "," { pp = _adv(pp) }
    while _ck(pp) != "]" && _ck(pp) != "EOF" {
        pp = _skip_nl(pp)
        r := _parse_expr(pp, 0)
        elem_idx := _pidx(r.p)
        pp = _padd(r.p, r.e)
        arr_elem_indices = arr_elem_indices.append(elem_idx)
        count = count + 1
        pp = _skip_nl(pp)
        if _ck(pp) == "," { pp = _adv(pp) }
    }
    pp = _expect(pp, "]")
    list_start := _pidx(pp)
    mut aei := 0
    while aei < count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: arr_elem_indices[aei + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        aei = aei + 1
    }
    PR{p: pp, e: Expr{kind: EkArray, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _parse_struct_lit(p: Parser, name: str, span: Span) -> PR {
    mut pp := _adv(p)
    pp = _skip_nl(pp)
    mut sf_indices := [0]
    mut count := 0
    rb := "\}"
    while _ck(pp) != rb && _ck(pp) != "EOF" {
        // Capture the field name before advancing so shorthand `{ radius }` can
        // materialize an Ident node referencing the same-named local.
        fld_name := _cur(pp).text
        fld_span := _pspan(pp)
        pp = _adv(pp)  // field name
        if _ck(pp) == ":" {
            pp = _adv(pp)
            r := _parse_expr(pp, 0)
            fval_idx := _pidx(r.p)
            pp = _padd(r.p, r.e)
            sf_indices = sf_indices.append(fval_idx)
        } else {
            // Shorthand field: `{ radius }` → `{ radius: radius }`.
            short_idx := _pidx(pp)
            pp = _padd(pp, mk_ident(fld_name, fld_span))
            sf_indices = sf_indices.append(short_idx)
        }
        count = count + 1
        pp = _skip_nl(pp)
        if _ck(pp) == "," {
            pp = _adv(pp)
            pp = _skip_nl(pp)
        }
    }
    pp = _adv(pp)
    list_start := _pidx(pp)
    mut sfi := 0
    while sfi < count {
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: sf_indices[sfi + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        sfi = sfi + 1
    }
    PR{p: pp, e: Expr{kind: EkStruct, s1: name, s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn _parse_for(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    // Check for tuple destructuring: for (a, b, c, ...) in ...
    // s1 = first name, s2 = comma-separated remaining names ("b,c,..."), b1 = is_tuple
    mut pat := ""
    mut pat2 := ""
    mut is_tuple := false
    if _ck(pp) == "(" {
        pp = _adv(pp)  // skip (
        mut first := true
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            if _ck(pp) == "IDENT" {
                nm := _cur(pp).text
                pp = _adv(pp)
                if first { pat = nm; first = false }
                else {
                    if pat2.len() > 0 { pat2 = pat2 + "," }
                    pat2 = pat2 + nm
                    is_tuple = true
                }
            }
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        if _ck(pp) == ")" { pp = _adv(pp) }
    } else {
        pat = _cur(pp).text
        pp = _adv(pp)
    }
    pp = _expect(pp, "in")
    iter := _parse_expr(pp, 0)
    iter_idx := _pidx(iter.p)
    pp = _padd(iter.p, iter.e)
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    PR{p: pp, e: Expr{kind: EkFor, s1: pat, s2: pat2, b1: is_tuple, b2: false,
                       c0: iter_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_while(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    cond := _parse_expr(pp, 0)
    cond_idx := _pidx(cond.p)
    pp = _padd(cond.p, cond.e)
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    PR{p: pp, e: Expr{kind: EkWhile, s1: "", s2: "", b1: false, b2: false,
                       c0: cond_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_loop(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    PR{p: pp, e: Expr{kind: EkLoop, s1: "", s2: "", b1: false, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

// Labeled loop body parsers — called with parser positioned AFTER the loop keyword
fn _parse_for_body(p: Parser, label: str) -> PR {
    span := _pspan(p)
    mut pp := p
    mut pat := ""
    mut pat2 := ""
    mut is_tuple := false
    if _ck(pp) == "(" {
        pp = _adv(pp)
        mut first := true
        while _ck(pp) != ")" && _ck(pp) != "EOF" {
            if _ck(pp) == "IDENT" {
                nm := _cur(pp).text
                pp = _adv(pp)
                if first { pat = nm; first = false }
                else {
                    if pat2.len() > 0 { pat2 = pat2 + "," }
                    pat2 = pat2 + nm
                    is_tuple = true
                }
            }
            if _ck(pp) == "," { pp = _adv(pp) }
        }
        if _ck(pp) == ")" { pp = _adv(pp) }
    } else {
        pat = _cur(pp).text
        pp = _adv(pp)
    }
    pp = _expect(pp, "in")
    iter := _parse_expr(pp, 0)
    iter_idx := _pidx(iter.p)
    pp = _padd(iter.p, iter.e)
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    // b2=true indicates labeled loop; label stored differently depending on is_tuple:
    // non-tuple: s2=label. tuple: s2=second var name, label lost (limitation)
    mut lbl := label
    if is_tuple { lbl = "" }
    PR{p: pp, e: Expr{kind: EkFor, s1: pat, s2: lbl, b1: is_tuple, b2: true,
                       c0: iter_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_while_body(p: Parser, label: str) -> PR {
    span := _pspan(p)
    mut pp := p
    cond := _parse_expr(pp, 0)
    cond_idx := _pidx(cond.p)
    pp = _padd(cond.p, cond.e)
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    PR{p: pp, e: Expr{kind: EkWhile, s1: label, s2: "", b1: false, b2: true,
                       c0: cond_idx, c1: body_idx, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_loop_body(p: Parser, label: str) -> PR {
    span := _pspan(p)
    mut pp := p
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    PR{p: pp, e: Expr{kind: EkLoop, s1: label, s2: "", b1: false, b2: true,
                       c0: body_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_return(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    k := _ck(pp)
    rb := "\}"
    if k == "NEWLINE" || k == "EOF" || k == rb {
        return PR{p: pp, e: mk_return(false, span)}
    }
    val := _parse_expr(pp, 0)
    val_idx := _pidx(val.p)
    pp = _padd(val.p, val.e)
    PR{p: pp, e: Expr{kind: EkReturn, s1: "", s2: "", b1: true, b2: false,
                       c0: val_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_with(p: Parser) -> PR {
    // Parse one or more `name := resource_expr` pairs separated by commas,
    // then a block. Desugars multi-resource syntax into nested With nodes so
    // lowering can keep its single-resource implementation.
    span := _pspan(p)
    mut pp := _adv(p)
    mut names: [str] = [""]
    mut res_indices: [i64] = [0]
    mut count := 0
    mut parsing := true
    while parsing {
        name := _cur(pp).text
        pp = _adv(pp)
        pp = _expect(pp, ":=")
        resource := _parse_expr(pp, 0)
        res_idx := _pidx(resource.p)
        pp = _padd(resource.p, resource.e)
        names = names.append(name)
        res_indices = res_indices.append(res_idx)
        count = count + 1
        // Skip whitespace before `,` or `{`
        pp = _skip_nl(pp)
        if _ck(pp) == "," {
            pp = _adv(pp)
            pp = _skip_nl(pp)
        } else {
            parsing = false
        }
    }
    body := _parse_block(pp)
    body_idx := _pidx(body.p)
    pp = _padd(body.p, body.e)
    // Build nested With expressions from innermost to outermost so the first
    // declared resource is the outermost scope (LIFO drop order).
    mut inner_idx := body_idx
    mut i := count
    while i > 0 {
        w_expr := Expr{kind: EkWith, s1: names[i], s2: "", b1: false, b2: false,
                        c0: res_indices[i], c1: inner_idx, c2: 0, list_start: 0, list_count: 0, span: span}
        if i > 1 {
            pp = _padd(pp, w_expr)
            inner_idx = _pidx(pp) - 1
        } else {
            return PR{p: pp, e: w_expr}
        }
        i = i - 1
    }
    // Unreachable — we always return in the i==1 case above
    PR{p: pp, e: Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

fn _parse_assert(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)
    expr := _parse_expr(pp, 0)
    arg_idx := _pidx(expr.p)
    pp = _padd(expr.p, expr.e)
    list_start := _pidx(pp)
    pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                         c0: arg_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
    PR{p: pp, e: Expr{kind: EkCall, s1: "assert", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: 1, span: span}}
}

// --- Parse spawn expression ---
// spawn <call-or-expr>    -> EkSpawn{c0=body_idx, b1=false}
// spawn { block }         -> EkSpawn{c0=body_idx, b1=true}  (body is EkBlock)
fn _parse_spawn(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)  // skip 'spawn'
    lb := "\{"
    mut is_block := false
    mut body_idx := 0
    if _ck(pp) == lb {
        is_block = true
        br := _parse_block(pp)
        body_idx = _pidx(br.p)
        pp = _padd(br.p, br.e)
    } else {
        br := _parse_expr(pp, 0)
        body_idx = _pidx(br.p)
        pp = _padd(br.p, br.e)
    }
    PR{p: pp, e: Expr{kind: EkSpawn, s1: "", s2: "", b1: is_block, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

// --- Parse scope expression ---
// scope { block }  -> EkScope{c0=block_idx}
fn _parse_scope(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)  // skip 'scope'
    pp = _skip_nl(pp)
    lb := "\{"
    mut body_idx := 0
    if _ck(pp) == lb {
        br := _parse_block(pp)
        body_idx = _pidx(br.p)
        pp = _padd(br.p, br.e)
    } else {
        // Tolerant fallback: treat as an empty block
        body_idx = _pidx(pp)
        pp = _padd(pp, Expr{kind: EkBlock, s1: "", s2: "", b1: false, b2: false,
                             c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span})
    }
    PR{p: pp, e: Expr{kind: EkScope, s1: "", s2: "", b1: false, b2: false,
                       c0: body_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: span}}
}

// --- Parse select expression ---
// select { binding from channel => body, default => body }
// Produces EkSelect node with list of arm pairs:
//   Each arm = 2 index nodes: (arm_info, body)
//   arm_info: s1=binding name ("_" for default), c0=channel expr (0 for default)
//   body: c0=body expression

fn _parse_select(p: Parser) -> PR {
    span := _pspan(p)
    mut pp := _adv(p)  // skip select
    lb := "\{"
    rb := "\}"
    pp = _skip_nl(pp)
    pp = _expect(pp, lb)
    pp = _skip_nl(pp)

    mut arm_info_indices := [0]
    mut body_indices := [0]
    mut count := 0

    while _ck(pp) != rb && _ck(pp) != "EOF" {
        pp = _skip_nl(pp)
        if _ck(pp) == rb { break }

        if _ck(pp) == "_" || (_ck(pp) == "IDENT" && _cur(pp).text == "default") {
            // default => body
            pp = _adv(pp)
            pp = _expect(pp, "=>")
            pp = _skip_nl(pp)
            body := _parse_expr(pp, 0)
            body_idx := _pidx(body.p)
            pp = _padd(body.p, body.e)
            // Store arm info: s1="_default", c0=0 (no channel)
            info_idx := _pidx(pp)
            pp = _padd(pp, Expr{kind: EkNone, s1: "_default", s2: "", b1: false, b2: false,
                                 c0: 0, c1: 0, c2: 0, list_start: 0, list_count: 0, span: _pspan(pp)})
            arm_info_indices = arm_info_indices.append(info_idx)
            body_indices = body_indices.append(body_idx)
            count = count + 1
        } else if _ck(pp) == "IDENT" && _cur(pp).text == "timeout" {
            // timeout(dur_expr) => body  — stored as s1="_timeout", c0=dur_expr
            tspan := _pspan(pp)
            pp = _adv(pp)  // skip 'timeout'
            pp = _expect(pp, "(")
            dur := _parse_expr(pp, 0)
            dur_idx := _pidx(dur.p)
            pp = _padd(dur.p, dur.e)
            if _ck(pp) == ")" { pp = _adv(pp) }
            pp = _expect(pp, "=>")
            pp = _skip_nl(pp)
            body := _parse_expr(pp, 0)
            body_idx := _pidx(body.p)
            pp = _padd(body.p, body.e)
            info_idx := _pidx(pp)
            pp = _padd(pp, Expr{kind: EkNone, s1: "_timeout", s2: "", b1: false, b2: false,
                                 c0: dur_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: tspan})
            arm_info_indices = arm_info_indices.append(info_idx)
            body_indices = body_indices.append(body_idx)
            count = count + 1
        } else if _ck(pp) == "after" {
            // after dur => body  (spec form) — same shape as timeout(dur)
            tspan := _pspan(pp)
            pp = _adv(pp)  // skip 'after'
            dur := _parse_expr(pp, 0)
            dur_idx := _pidx(dur.p)
            pp = _padd(dur.p, dur.e)
            pp = _expect(pp, "=>")
            pp = _skip_nl(pp)
            body := _parse_expr(pp, 0)
            body_idx := _pidx(body.p)
            pp = _padd(body.p, body.e)
            info_idx := _pidx(pp)
            pp = _padd(pp, Expr{kind: EkNone, s1: "_timeout", s2: "", b1: false, b2: false,
                                 c0: dur_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: tspan})
            arm_info_indices = arm_info_indices.append(info_idx)
            body_indices = body_indices.append(body_idx)
            count = count + 1
        } else if _ck(pp) == "IDENT" {
            // Two forms accepted:
            //   binding from channel => body        (spec form)
            //   binding := <- channel => body       (ex09 form)
            bname := _cur(pp).text
            bspan := _pspan(pp)
            pp = _adv(pp)  // skip binding name
            if _ck(pp) == "IDENT" && _cur(pp).text == "from" {
                pp = _adv(pp)  // skip from
            } else if _ck(pp) == ":=" {
                pp = _adv(pp)  // skip :=
                // Expect '<' '-' forming a receive operator (kept contextual
                // so we don't need a new lexer token that would clash with
                // comparison against a negative expression).
                if _ck(pp) == "<" && _pk(pp) == "-" {
                    pp = _adv(pp)  // skip <
                    pp = _adv(pp)  // skip -
                }
            }
            // Parse channel expression
            ch := _parse_expr(pp, 0)
            ch_idx := _pidx(ch.p)
            pp = _padd(ch.p, ch.e)
            pp = _expect(pp, "=>")
            pp = _skip_nl(pp)
            // Parse body expression
            body := _parse_expr(pp, 0)
            body_idx := _pidx(body.p)
            pp = _padd(body.p, body.e)
            // Store arm info: s1=binding name, c0=channel expression
            info_idx := _pidx(pp)
            pp = _padd(pp, Expr{kind: EkNone, s1: bname, s2: "", b1: false, b2: false,
                                 c0: ch_idx, c1: 0, c2: 0, list_start: 0, list_count: 0, span: bspan})
            arm_info_indices = arm_info_indices.append(info_idx)
            body_indices = body_indices.append(body_idx)
            count = count + 1
        } else {
            pp = _adv(pp)
        }
        pp = _skip_nl(pp)
    }
    if _ck(pp) == rb { pp = _adv(pp) }

    // Add arm pairs as index nodes
    list_start := _pidx(pp)
    mut ai := 0
    while ai < count {
        // Arm info index node
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: arm_info_indices[ai + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        // Body index node
        pp = _padd(pp, Expr{kind: EkNone, s1: "", s2: "", b1: false, b2: false,
                             c0: body_indices[ai + 1], c1: 0, c2: 0, list_start: 0, list_count: 0, span: _no_span()})
        ai = ai + 1
    }

    PR{p: pp, e: Expr{kind: EkSelect, s1: "", s2: "", b1: false, b2: false,
                       c0: 0, c1: 0, c2: 0, list_start: list_start, list_count: count, span: span}}
}

fn parser_diagnostics(p: Parser) -> DiagnosticBag = p.diagnostics
