// test-files: pool_scale_test.aria ../../src/diagnostic/diagnostic.aria ../../src/lexer/token.aria ../../src/lexer/lexer.aria ../../src/parser/ast.aria ../../src/parser/precedence.aria ../../src/parser/parser.aria
// test-expect: pool_scale_test passed
mod test

// Test NodePool integrity at scale — does pool_get return correct data for 1100+ functions?
// This test dynamically generates source code, parses it, and verifies the pool.

use lexer
use parser

fn _num_to_str(n: i64) -> str {
    if n == 0 { return "0" }
    mut result := ""
    mut v := n
    while v > 0 {
        d := v - (v / 10) * 10
        mut ch := "0"
        if d == 1 { ch = "1" }
        if d == 2 { ch = "2" }
        if d == 3 { ch = "3" }
        if d == 4 { ch = "4" }
        if d == 5 { ch = "5" }
        if d == 6 { ch = "6" }
        if d == 7 { ch = "7" }
        if d == 8 { ch = "8" }
        if d == 9 { ch = "9" }
        result = ch + result
        v = v / 10
    }
    result
}

entry {
    // Generate source with 1100 functions
    mut source := "mod test\n"
    mut i := 0
    while i < 1100 {
        source = source + "fn _f" + _num_to_str(i) + "() -> i64 = " + _num_to_str(i) + "\n"
        i = i + 1
    }

    // Parse
    lex := tokenize(source, "scale.aria")
    toks := get_tokens(lex)
    pr := build_decl_index(toks)

    dlen := decl_index_len(pr.index)
    println("decl_count=" + _num_to_str(dlen))
    println("pool_size=" + _num_to_str(pool_size(pr.pool)))

    // Verify all FnDecl nodes are correct
    mut ok := 0
    mut bad := 0
    mut di := 1
    while di < dlen {
        decl := decl_index_get(pr.index, di)
        if decl.node_idx > 0 {
            node := pool_get(pr.pool, decl.node_idx)
            kind := expr_kind_name(node.kind)
            if kind == "FnDecl" && node.s1.len() > 0 {
                ok = ok + 1
            } else {
                bad = bad + 1
                if bad <= 3 {
                    println("BAD: di=" + _num_to_str(di) + " node_idx=" + _num_to_str(decl.node_idx) + " kind=" + kind)
                }
            }
        }
        di = di + 1
    }
    println("ok=" + _num_to_str(ok) + " bad=" + _num_to_str(bad))
    if bad == 0 {
        println("pool_scale_test passed")
    } else {
        println("pool_scale_test FAILED")
    }
}
