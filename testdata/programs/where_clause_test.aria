// Test where clause parsing and enforcement
// Where clause bounds are merged into generic params and checked at call sites

trait Showable {
    fn show(self) -> str
}

struct Widget {
    id: i64
}

impl Showable for Widget {
    fn show(self) -> str = "widget"
}

impl Eq for Widget {
    fn eq(self, other: Widget) -> bool = self.id == other.id
}

fn display[T](val: T) -> T where T: Showable {
    val
}

// Multi-bound where clause
fn process[T](val: T) -> T where T: Showable+Eq {
    val
}

entry {
    w := Widget{id: 1}
    // Good: Widget implements Showable
    r := display(w)
    assert r.id == 1

    // Multi-bound: Widget implements both Showable and Eq
    r2 := process(w)
    assert r2.id == 1

    println("where_clause_test passed")
}
