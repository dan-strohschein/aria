// Test: String character access — charCount, chars, graphemes

entry {
    // Test 1: charCount on ASCII
    ascii := "hello"
    assert ascii.charCount() == 5

    // Test 2: charCount on empty string
    empty := ""
    assert empty.charCount() == 0

    // Test 3: chars() returns array of codepoints (0-indexed, no sentinel)
    s := "abc"
    cps := s.chars()
    assert cps.len() == 3

    // Test 4: graphemes() returns array of single-char strings (0-indexed)
    gs := "xyz".graphemes()
    assert gs.len() == 3
    assert gs[0] == "x"
    assert gs[1] == "y"
    assert gs[2] == "z"

    print("chars_graphemes_test passed")
}
