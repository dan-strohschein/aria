mod time

// ============================================================
// Time Library for Aria
// ============================================================

// Duration constants (milliseconds)
const ms: i64 = 1
const s: i64 = 1000
const m: i64 = 60000

struct Instant {
    ns: i64
}

fn now() -> Instant with [Io] {
    Instant{ns: _ariaTimeNow()}
}

fn elapsed(start: Instant, end: Instant) -> i64 {
    end.ns - start.ns
}

// Convert monotonic ns to a "unix-ish" seconds value. The runtime uses
// CLOCK_MONOTONIC, so this isn't a true unix epoch — it's a stable counter
// suitable for unique id generation (e.g. temp file names).
// Exposed both as a free fn `time.unix(inst)` and a method `inst.unix()`
// via the TypeName_method convention.
fn Instant_unix(self: Instant) -> i64 = self.ns / 1000000000

fn unix(i: Instant) -> i64 = Instant_unix(i)

// Millisecond helper mirroring `unix()` for nano→ms conversion. Exposed as
// a method `inst.ms()` so interpolation `{elapsed.ms}` resolves.
fn Instant_ms(self: Instant) -> i64 = self.ns / 1000000

fn sleep(duration_ms: i64) with [Io] {
    _ariaSleep(duration_ms)
}
