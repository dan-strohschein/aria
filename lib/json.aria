mod json

// ============================================================
// JSON Library for Aria
// Standalone parser and emitter.
//
// Design: All JsonValues are stored in a global pool (array).
// References are indices into this pool. This avoids needing
// raw pointer manipulation that the current compiler can't do.
//
// Usage:
//   val := json_parse("{\"name\": \"Aria\"}")
//   name := json_get_str(val, "name")
//   out := json_emit(val)
// ============================================================

// --- JSON Value Kinds ---
const JSON_NULL: i64 = 0
const JSON_BOOL: i64 = 1
const JSON_INT: i64 = 2
const JSON_FLOAT: i64 = 3
const JSON_STRING: i64 = 4
const JSON_ARRAY: i64 = 5
const JSON_OBJECT: i64 = 6

// --- JSON Value Pool ---
// All values are stored as parallel arrays indexed by id.
// id 0 = null sentinel.

struct JsonPool {
    kinds: [i64]
    ints: [i64]
    strs: [str]
    // For arrays: children is [i64] where elements are value ids
    // For objects: children is [i64] with paired key_id, val_id entries
    //             obj_keys is [str] with key names in insertion order
    child_arrays: [i64]   // pool_id → array-of-ids ptr
    obj_key_lists: [i64]  // pool_id → str-array ptr for key order
}

fn _jp_new_pool() -> JsonPool {
    return JsonPool{kinds: [0], ints: [0], strs: [""],
             child_arrays: [0], obj_key_lists: [0]}
}

fn _jp_alloc(pool: JsonPool, kind: i64, int_val: i64, str_val: str) -> i64 {
    // Returns the new id (= length before append, since index 0 is sentinel)
    id := pool.kinds.len()
    // Note: we can't mutate the pool directly, caller must rebuild
    id
}

// Global pool — mutable
// We use a struct wrapper so it can be passed through functions

struct _JPool {
    kinds: [i64]
    ints: [i64]
    strs: [str]
    children: [i64]
    key_lists: [i64]
}

// Global singleton pool — initialized once
fn _jpool_init() -> _JPool {
    return _JPool{kinds: [0], ints: [0], strs: [""], children: [0], key_lists: [0]}
}

fn _jpool_add(p: _JPool, kind: i64, iv: i64, sv: str, ch: i64, kl: i64) -> _JPool {
    return _JPool{
        kinds: p.kinds.append(kind),
        ints: p.ints.append(iv),
        strs: p.strs.append(sv),
        children: p.children.append(ch),
        key_lists: p.key_lists.append(kl)
    }
}

fn _jpool_id(p: _JPool) -> i64 = p.kinds.len() - 1

// --- JsonValue = index into pool ---
// We wrap it in a struct for type safety

struct JsonValue {
    id: i64
    pool: _JPool
}

// --- Constructors (each returns value + updated pool) ---

struct _JV {
    val: JsonValue
    pool: _JPool
}

fn _jv_null(p: _JPool) -> _JV {
    np := _jpool_add(p, JSON_NULL, 0, "", 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_bool(p: _JPool, b: bool) -> _JV {
    mut v := 0
    if b { v = 1 }
    np := _jpool_add(p, JSON_BOOL, v, "", 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_int(p: _JPool, n: i64) -> _JV {
    np := _jpool_add(p, JSON_INT, n, "", 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_float(p: _JPool, s: str) -> _JV {
    np := _jpool_add(p, JSON_FLOAT, 0, s, 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_string(p: _JPool, s: str) -> _JV {
    np := _jpool_add(p, JSON_STRING, 0, s, 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_array(p: _JPool, child_arr: [i64]) -> _JV {
    // child_arr is array of value ids (sentinel at 0)
    // We store the array length in int_val (count of elements, excluding sentinel)
    count := child_arr.len() - 1
    // Store child_arr as a "pointer" — actually just append and remember index
    // We can't store arrays as i64 easily... use the Map trick
    // Actually: store element ids comma-separated in str_val as a hack
    // Better: store count in int_val, element ids in sequential pool entries
    // Simplest: just store as comma-separated ids in str_val
    mut s := ""
    mut i := 1
    while i < child_arr.len() {
        if i > 1 { s = s + "," }
        s = s + child_arr[i].toStr()
        i = i + 1
    }
    np := _jpool_add(p, JSON_ARRAY, count, s, 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

fn _jv_object(p: _JPool, keys: [str], val_ids: [i64]) -> _JV {
    // Store keys as comma-separated in str_val
    // Store val_ids as comma-separated in... we need a second string
    // Use children field for val_ids encoded as string
    mut ks := ""
    mut vs := ""
    mut i := 1
    while i < keys.len() {
        if i > 1 {
            ks = ks + "\x01"  // use \x01 as separator (not in JSON keys)
            vs = vs + ","
        }
        ks = ks + keys[i]
        vs = vs + val_ids[i].toStr()
        i = i + 1
    }
    count := keys.len() - 1
    // Store: str_val = keys (sep by \x01), int_val = count
    // Need second string for val_ids... store in a creative way
    // Use a two-part encoding: "keys\x00val_ids"
    encoded := ks + "\x00" + vs
    np := _jpool_add(p, JSON_OBJECT, count, encoded, 0, 0)
    return _JV{val: JsonValue{id: _jpool_id(np), pool: np}, pool: np}
}

// --- Accessors ---

fn json_kind(v: JsonValue) -> i64 = v.pool.kinds[v.id]
fn json_int_val(v: JsonValue) -> i64 = v.pool.ints[v.id]
fn json_str_val(v: JsonValue) -> str = v.pool.strs[v.id]
fn json_is_null(v: JsonValue) -> bool = json_kind(v) == JSON_NULL

fn json_array_len(v: JsonValue) -> i64 = v.pool.ints[v.id]

fn json_array_get(v: JsonValue, idx: i64) -> JsonValue {
    // Parse element ids from str_val
    s := v.pool.strs[v.id]
    if s.len() == 0 { return JsonValue{id: 0, pool: v.pool} }
    parts := s.split(",")
    if idx + 1 >= parts.len() { return JsonValue{id: 0, pool: v.pool} }
    eid := _jp_parse_int(parts[idx + 1])
    return JsonValue{id: eid, pool: v.pool}
}

fn json_object_get(v: JsonValue, key: str) -> JsonValue {
    encoded := v.pool.strs[v.id]
    // Split on \x00 to get keys_part and vals_part
    sep_idx := encoded.indexOf("\x00")
    if sep_idx < 0 { return JsonValue{id: 0, pool: v.pool} }
    keys_part := encoded.substring(0, sep_idx)
    vals_part := encoded.substring(sep_idx + 1, encoded.len())
    // Split keys by \x01
    keys := keys_part.split("\x01")
    vals := vals_part.split(",")
    mut i := 1
    while i < keys.len() {
        if keys[i] == key {
            eid := _jp_parse_int(vals[i])
            return JsonValue{id: eid, pool: v.pool}
        }
        i = i + 1
    }
    return JsonValue{id: 0, pool: v.pool}
}

fn json_object_has(v: JsonValue, key: str) -> bool {
    result := json_object_get(v, key)
    result.id != 0
}

// Convenience
fn json_get_str(v: JsonValue, key: str) -> str {
    child := json_object_get(v, key)
    json_str_val(child)
}

fn json_get_int(v: JsonValue, key: str) -> i64 {
    child := json_object_get(v, key)
    json_int_val(child)
}

fn json_get_bool(v: JsonValue, key: str) -> bool {
    child := json_object_get(v, key)
    json_int_val(child) != 0
}

// ============================================================
// JSON Parser
// ============================================================

// JsonError is raised by `decode`. `offset` is the byte index of the
// error site; `line`/`col` are 1-based and derived from the source text.
pub struct JsonError {
    message: str
    offset: i64
    line: i64
    col: i64
}

// Parse-state token. err_pos = -1 signals "no error so far"; any
// non-negative value is the byte offset of the first failure and all
// subsequent callers short-circuit on it.
struct _JP {
    pool: _JPool
    pos: i64
    val: JsonValue
    err_msg: str
    err_pos: i64
}

fn _jp_ok(pool: _JPool, pos: i64, val: JsonValue) -> _JP {
    _JP{pool: pool, pos: pos, val: val, err_msg: "", err_pos: 0 - 1}
}

fn _jp_err(pool: _JPool, pos: i64, msg: str) -> _JP {
    // Error path returns a null sentinel so callers that ignore the
    // error channel (json_parse) still get a valid JsonValue back.
    sentinel := JsonValue{id: 0, pool: pool}
    _JP{pool: pool, pos: pos, val: sentinel, err_msg: msg, err_pos: pos}
}

fn _jp_is_err(p: _JP) -> bool = p.err_pos >= 0

fn _jp_pos_to_line_col(src: str, offset: i64) -> [i64] {
    mut line := 1
    mut col := 1
    mut i := 0
    while i < offset && i < src.len() {
        if src.charAt(i) == "\n" {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    [0, line, col]
}

fn json_parse(input: str) -> JsonValue {
    pool := _jpool_init()
    // Add null at index 0
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jp_value(pool, input, 0)
    return r.val
}

// decode: fallible parse. Rejects trailing garbage and reports the
// first error with byte offset + line/col.
pub fn decode(input: str) -> JsonValue!JsonError {
    if input.len() == 0 {
        return err(JsonError{message: "empty input", offset: 0, line: 1, col: 1})
    }
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jp_value(pool, input, 0)
    if _jp_is_err(r) {
        lc := _jp_pos_to_line_col(input, r.err_pos)
        return err(JsonError{message: r.err_msg, offset: r.err_pos, line: lc[1], col: lc[2]})
    }
    // Trailing non-whitespace after the value is an error.
    tail := _jp_skip_ws(input, r.pos)
    if tail < input.len() {
        lc := _jp_pos_to_line_col(input, tail)
        return err(JsonError{message: "trailing content after value", offset: tail, line: lc[1], col: lc[2]})
    }
    r.val
}

pub fn encode(v: JsonValue) -> str = json_emit(v)

fn _jp_value(pool: _JPool, src: str, pos: i64) -> _JP {
    p := _jp_skip_ws(src, pos)
    if p >= src.len() {
        return _jp_err(pool, p, "unexpected end of input")
    }
    ch := src.charAt(p)
    lb := "\{"

    if ch == "\"" { return _jp_string(pool, src, p) }
    if ch == lb { return _jp_object(pool, src, p) }
    if ch == "[" { return _jp_array(pool, src, p) }
    if ch == "t" {
        if p + 4 <= src.len() && src.substring(p, p + 4) == "true" {
            r := _jv_bool(pool, true)
            return _jp_ok(r.pool, p + 4, r.val)
        }
        return _jp_err(pool, p, "invalid literal; expected 'true'")
    }
    if ch == "f" {
        if p + 5 <= src.len() && src.substring(p, p + 5) == "false" {
            r := _jv_bool(pool, false)
            return _jp_ok(r.pool, p + 5, r.val)
        }
        return _jp_err(pool, p, "invalid literal; expected 'false'")
    }
    if ch == "n" {
        if p + 4 <= src.len() && src.substring(p, p + 4) == "null" {
            r := _jv_null(pool)
            return _jp_ok(r.pool, p + 4, r.val)
        }
        return _jp_err(pool, p, "invalid literal; expected 'null'")
    }
    if ch == "-" || _jp_is_digit(ch) { return _jp_number(pool, src, p) }

    return _jp_err(pool, p, "unexpected character")
}

fn _jp_skip_ws(src: str, pos: i64) -> i64 {
    mut p := pos
    while p < src.len() {
        c := src.charAt(p)
        if c != " " && c != "\t" && c != "\n" && c != "\r" { return p }
        p = p + 1
    }
    p
}

fn _jp_string(pool: _JPool, src: str, pos: i64) -> _JP {
    start := pos
    mut p := pos + 1
    mut result := ""
    while p < src.len() {
        ch := src.charAt(p)
        if ch == "\"" {
            r := _jv_string(pool, result)
            return _jp_ok(r.pool, p + 1, r.val)
        }
        if ch == "\\" {
            p = p + 1
            if p < src.len() {
                esc := src.charAt(p)
                if esc == "\"" {
                    result = result + "\""
                } else {
                    if esc == "\\" { result = result + "\\" }
                    if esc == "/" { result = result + "/" }
                    if esc == "n" { result = result + "\n" }
                    if esc == "t" { result = result + "\t" }
                    if esc == "r" { result = result + "\r" }
                    if esc != "\"" && esc != "\\" && esc != "/" && esc != "n" && esc != "t" && esc != "r" { result = result + esc }
                }
            }
        } else {
            result = result + ch
        }
        p = p + 1
    }
    // Reached end of input without closing quote.
    _jp_err(pool, start, "unterminated string")
}

fn _jp_number(pool: _JPool, src: str, pos: i64) -> _JP {
    mut p := pos
    mut is_float := false
    if p < src.len() && src.charAt(p) == "-" { p = p + 1 }
    while p < src.len() && _jp_is_digit(src.charAt(p)) { p = p + 1 }
    if p < src.len() && src.charAt(p) == "." {
        is_float = true
        p = p + 1
        while p < src.len() && _jp_is_digit(src.charAt(p)) { p = p + 1 }
    }
    if p < src.len() {
        ec := src.charAt(p)
        if ec == "e" || ec == "E" {
            is_float = true
            p = p + 1
            if p < src.len() {
                sc := src.charAt(p)
                if sc == "+" || sc == "-" { p = p + 1 }
            }
            while p < src.len() && _jp_is_digit(src.charAt(p)) { p = p + 1 }
        }
    }
    text := src.substring(pos, p)
    if is_float {
        r := _jv_float(pool, text)
        return _jp_ok(r.pool, p, r.val)
    }
    r := _jv_int(pool, _jp_parse_int(text))
    return _jp_ok(r.pool, p, r.val)
}

fn _jp_object(pool: _JPool, src: str, pos: i64) -> _JP {
    start := pos
    mut p := _jp_skip_ws(src, pos + 1)
    mut pl := pool
    rb := "\}"
    mut keys := [""]
    mut val_ids := [0]

    if p < src.len() && src.charAt(p) == rb {
        r := _jv_object(pl, keys, val_ids)
        return _jp_ok(r.pool, p + 1, r.val)
    }
    mut running := true
    mut pending_err := _jp_ok(pl, p, JsonValue{id: 0, pool: pl})
    while running {
        p = _jp_skip_ws(src, p)
        if p >= src.len() {
            pending_err = _jp_err(pl, start, "unterminated object")
            running = false
        } else if src.charAt(p) != "\"" {
            pending_err = _jp_err(pl, p, "expected string key in object")
            running = false
        } else {
            kr := _jp_string(pl, src, p)
            if _jp_is_err(kr) { pending_err = kr; running = false }
            else {
                pl = kr.pool
                key := json_str_val(kr.val)
                p = _jp_skip_ws(src, kr.pos)
                if p >= src.len() || src.charAt(p) != ":" {
                    pending_err = _jp_err(pl, p, "expected ':' after key")
                    running = false
                } else {
                    p = p + 1
                    vr := _jp_value(pl, src, p)
                    if _jp_is_err(vr) { pending_err = vr; running = false }
                    else {
                        pl = vr.pool
                        p = vr.pos
                        keys = keys.append(key)
                        val_ids = val_ids.append(vr.val.id)
                        p = _jp_skip_ws(src, p)
                        if p < src.len() && src.charAt(p) == "," { p = p + 1 }
                        else { running = false }
                    }
                }
            }
        }
    }
    if _jp_is_err(pending_err) { return pending_err }
    p = _jp_skip_ws(src, p)
    if p >= src.len() {
        return _jp_err(pl, start, "unterminated object")
    }
    if src.charAt(p) != rb {
        return _jp_err(pl, p, "expected '}' or ',' in object")
    }
    p = p + 1
    r := _jv_object(pl, keys, val_ids)
    _jp_ok(r.pool, p, r.val)
}

fn _jp_array(pool: _JPool, src: str, pos: i64) -> _JP {
    start := pos
    mut p := _jp_skip_ws(src, pos + 1)
    mut pl := pool
    mut ids := [0]

    if p < src.len() && src.charAt(p) == "]" {
        r := _jv_array(pl, ids)
        return _jp_ok(r.pool, p + 1, r.val)
    }
    mut running := true
    mut pending_err := _jp_ok(pl, p, JsonValue{id: 0, pool: pl})
    while running {
        vr := _jp_value(pl, src, p)
        if _jp_is_err(vr) { pending_err = vr; running = false }
        else {
            pl = vr.pool
            p = vr.pos
            ids = ids.append(vr.val.id)
            p = _jp_skip_ws(src, p)
            if p < src.len() && src.charAt(p) == "," { p = p + 1 }
            else { running = false }
        }
    }
    if _jp_is_err(pending_err) { return pending_err }
    p = _jp_skip_ws(src, p)
    if p >= src.len() || src.charAt(p) != "]" {
        return _jp_err(pl, start, "unterminated array")
    }
    p = p + 1
    r := _jv_array(pl, ids)
    _jp_ok(r.pool, p, r.val)
}

fn _jp_parse_int(s: str) -> i64 {
    mut num := 0
    mut i := 0
    mut neg := false
    if s.len() > 0 && s.charAt(0) == "-" {
        neg = true
        i = 1
    }
    while i < s.len() {
        ch := s.charAt(i)
        mut d := 0
        if ch == "1" { d = 1 }
        if ch == "2" { d = 2 }
        if ch == "3" { d = 3 }
        if ch == "4" { d = 4 }
        if ch == "5" { d = 5 }
        if ch == "6" { d = 6 }
        if ch == "7" { d = 7 }
        if ch == "8" { d = 8 }
        if ch == "9" { d = 9 }
        num = num * 10 + d
        i = i + 1
    }
    if neg { return 0 - num }
    num
}

fn _jp_is_digit(ch: str) -> bool =
    ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
    ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"

// ============================================================
// JSON Emitter
// ============================================================

fn json_emit(v: JsonValue) -> str {
    k := json_kind(v)
    if k == JSON_NULL { return "null" }
    if k == JSON_BOOL {
        if json_int_val(v) != 0 { return "true" }
        return "false"
    }
    if k == JSON_INT { return json_int_val(v).toStr() }
    if k == JSON_FLOAT { return json_str_val(v) }
    if k == JSON_STRING { return _json_escape(json_str_val(v)) }
    if k == JSON_ARRAY { return _json_emit_arr(v) }
    if k == JSON_OBJECT { return _json_emit_obj(v) }
    "null"
}

fn _json_escape(s: str) -> str {
    mut r := "\""
    mut i := 0
    while i < s.len() {
        ch := s.charAt(i)
        if ch == "\"" {
            r = r + "\\\""
        } else {
            if ch == "\\" {
                r = r + "\\\\"
            } else {
                if ch == "\n" {
                    r = r + "\\n"
                } else {
                    if ch == "\t" {
                        r = r + "\\t"
                    } else {
                        if ch == "\r" {
                            r = r + "\\r"
                        } else {
                            r = r + ch
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    r + "\""
}

fn _json_emit_arr(v: JsonValue) -> str {
    n := json_array_len(v)
    if n == 0 { return "[]" }
    mut r := "["
    mut i := 0
    while i < n {
        if i > 0 { r = r + "," }
        item := json_array_get(v, i)
        r = r + json_emit(item)
        i = i + 1
    }
    r + "]"
}

fn _json_emit_obj(v: JsonValue) -> str {
    n := json_int_val(v)  // count stored in int_val
    rb := "\}"
    if n == 0 { return "\{" + rb }
    encoded := json_str_val(v)
    sep_idx := encoded.indexOf("\x00")
    if sep_idx < 0 { return "\{" + rb }
    keys_part := encoded.substring(0, sep_idx)
    vals_part := encoded.substring(sep_idx + 1, encoded.len())
    keys := keys_part.split("\x01")
    vals := vals_part.split(",")
    mut r := "\{"
    mut i := 1
    while i < keys.len() {
        if i > 1 { r = r + "," }
        r = r + _json_escape(keys[i]) + ":" + json_emit(JsonValue{id: _jp_parse_int(vals[i]), pool: v.pool})
        i = i + 1
    }
    r + rb
}

// ============================================================
// Builder API (construct JSON without parsing)
// ============================================================

fn json_new_null() -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)  // sentinel at 0
    r := _jv_null(pool)
    return r.val
}

fn json_new_bool(b: bool) -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jv_bool(pool, b)
    return r.val
}

fn json_new_int(n: i64) -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jv_int(pool, n)
    return r.val
}

fn json_new_string(s: str) -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jv_string(pool, s)
    return r.val
}

// ---- Short-name aliases ----
// These are the canonical public names used by decode/encode tests.
// Keep them as single-line wrappers so there's one implementation.

pub fn json_null() -> JsonValue = json_new_null()
pub fn json_bool(b: bool) -> JsonValue = json_new_bool(b)
pub fn json_int(n: i64) -> JsonValue = json_new_int(n)
pub fn json_str(s: str) -> JsonValue = json_new_string(s)

// ---- Empty containers ----

pub fn json_obj() -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jv_object(pool, [""], [0])
    r.val
}

pub fn json_arr() -> JsonValue {
    pool := _jpool_init()
    pool = _jpool_add(pool, JSON_NULL, 0, "", 0, 0)
    r := _jv_array(pool, [0])
    r.val
}

// ---- Container builders ----
// Each JsonValue owns its own _JPool. Merging a value built in one
// pool into a container in another requires copying the subtree.
//
// _jpool_copy_value walks the source value and re-allocates every
// reachable node into `dst`, returning the new root id. This is the
// single place pool-crossing is implemented; put/push both rely on it.

struct _JVid {
    pool: _JPool
    id: i64
}

fn _jpool_copy_value(dst: _JPool, v: JsonValue) -> _JVid {
    k := v.pool.kinds[v.id]
    if k == JSON_NULL {
        r := _jv_null(dst)
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_BOOL {
        b := v.pool.ints[v.id] != 0
        r := _jv_bool(dst, b)
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_INT {
        r := _jv_int(dst, v.pool.ints[v.id])
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_FLOAT {
        r := _jv_float(dst, v.pool.strs[v.id])
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_STRING {
        r := _jv_string(dst, v.pool.strs[v.id])
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_ARRAY {
        src := v.pool.strs[v.id]
        mut acc := dst
        mut new_ids := [0]
        if src.len() > 0 {
            parts := src.split(",")
            mut i := 1
            while i < parts.len() {
                child := JsonValue{id: _jp_parse_int(parts[i]), pool: v.pool}
                c := _jpool_copy_value(acc, child)
                acc = c.pool
                new_ids = new_ids.append(c.id)
                i = i + 1
            }
        }
        r := _jv_array(acc, new_ids)
        return _JVid{pool: r.pool, id: r.val.id}
    }
    if k == JSON_OBJECT {
        encoded := v.pool.strs[v.id]
        mut acc := dst
        mut keys := [""]
        mut vals := [0]
        sep_idx := encoded.indexOf("\x00")
        if sep_idx >= 0 {
            keys_part := encoded.substring(0, sep_idx)
            vals_part := encoded.substring(sep_idx + 1, encoded.len())
            if keys_part.len() > 0 {
                ks := keys_part.split("\x01")
                vs := vals_part.split(",")
                mut i := 1
                while i < ks.len() {
                    src_child := JsonValue{id: _jp_parse_int(vs[i]), pool: v.pool}
                    c := _jpool_copy_value(acc, src_child)
                    acc = c.pool
                    keys = keys.append(ks[i])
                    vals = vals.append(c.id)
                    i = i + 1
                }
            }
        }
        r := _jv_object(acc, keys, vals)
        return _JVid{pool: r.pool, id: r.val.id}
    }
    // Unknown kind: treat as null
    r := _jv_null(dst)
    _JVid{pool: r.pool, id: r.val.id}
}

// _jp_decode_object_pairs: decode the keys/vals storage of an object
// into parallel arrays. Used by both the public builders and any
// future mutators that need to round-trip pair lists.
struct _JOP {
    keys: [str]
    vals: [i64]
}

fn _jp_decode_object_pairs(v: JsonValue) -> _JOP {
    encoded := v.pool.strs[v.id]
    mut keys := [""]
    mut vals := [0]
    sep_idx := encoded.indexOf("\x00")
    if sep_idx >= 0 {
        keys_part := encoded.substring(0, sep_idx)
        vals_part := encoded.substring(sep_idx + 1, encoded.len())
        if keys_part.len() > 0 {
            ks := keys_part.split("\x01")
            vs := vals_part.split(",")
            mut i := 1
            while i < ks.len() {
                keys = keys.append(ks[i])
                vals = vals.append(_jp_parse_int(vs[i]))
                i = i + 1
            }
        }
    }
    _JOP{keys: keys, vals: vals}
}

pub fn json_obj_put(o: JsonValue, key: str, v: JsonValue) -> JsonValue {
    pairs := _jp_decode_object_pairs(o)
    copy := _jpool_copy_value(o.pool, v)
    new_keys := pairs.keys.append(key)
    new_vals := pairs.vals.append(copy.id)
    r := _jv_object(copy.pool, new_keys, new_vals)
    r.val
}

pub fn json_arr_push(a: JsonValue, v: JsonValue) -> JsonValue {
    // Decode existing child ids from the array's storage.
    encoded := a.pool.strs[a.id]
    mut ids := [0]
    if encoded.len() > 0 {
        parts := encoded.split(",")
        mut i := 1
        while i < parts.len() {
            ids = ids.append(_jp_parse_int(parts[i]))
            i = i + 1
        }
    }
    copy := _jpool_copy_value(a.pool, v)
    new_ids := ids.append(copy.id)
    r := _jv_array(copy.pool, new_ids)
    r.val
}
