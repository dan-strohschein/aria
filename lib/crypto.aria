mod crypto

// ============================================================
// Cryptographic Utilities for Aria
//
// hash / hash_password use real SHA-256 from the runtime.
// hash_password is unsalted — suitable for demos and checksums, not
// for real password storage (use a KDF like bcrypt/argon2 in prod).
// verify uses length-aware comparison on the hex digest.
// ============================================================

fn crypto_hash(data: str) -> str {
    _ariaSha256Hex(data)
}

fn crypto_hash_password(password: str) -> str {
    _ariaSha256Hex(password)
}

fn crypto_verify(password: str, hash_val: str) -> bool {
    _ariaSha256Hex(password) == hash_val
}
