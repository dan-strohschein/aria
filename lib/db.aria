mod db

// ============================================================
// PostgreSQL Database Library for Aria
// Wraps libpq via runtime builtins.
//
// Usage:
//   conn := db_connect("host=localhost dbname=mydb")
//   if db_connected(conn) {
//       result := db_exec(conn, "SELECT 1")
//       if db_ok(result) {
//           println(db_get(result, 0, 0))
//       }
//       db_clear(result)
//   }
//   db_close(conn)
//
// Requires: brew install libpq
// ============================================================

// --- Connection ---

struct DbConn {
    handle: i64
}

struct DbResult {
    handle: i64
}

struct DbRow {
    result: i64
    row: i64
    ncols: i64
}

// Connect to PostgreSQL using a connection string.
fn db_connect(connstr: str) -> DbConn {
    h := _ariaPgConnect(connstr)
    DbConn{handle: h}
}

// Close the connection.
fn db_close(conn: DbConn) {
    _ariaPgClose(conn.handle)
}

// Check if the connection is healthy.
fn db_connected(conn: DbConn) -> bool {
    _ariaPgStatus(conn.handle) == 1
}

// Get the last error message from the connection.
fn db_error(conn: DbConn) -> str {
    _ariaPgError(conn.handle)
}

// --- Queries ---

// Execute a simple SQL query (no parameters).
fn db_exec(conn: DbConn, query: str) -> DbResult {
    h := _ariaPgExec(conn.handle, query)
    DbResult{handle: h}
}

// Execute a parameterized query ($1, $2, ...).
fn db_query(conn: DbConn, query: str, params: [str]) -> DbResult {
    h := _ariaPgExecParams(conn.handle, query, params)
    DbResult{handle: h}
}

// --- Result inspection ---

// Check if the result succeeded (COMMAND_OK or TUPLES_OK).
fn db_ok(result: DbResult) -> bool {
    _ariaPgResultStatus(result.handle) == 0
}

// Get the error message from a failed result.
fn db_result_error(result: DbResult) -> str {
    _ariaPgResultError(result.handle)
}

// Number of rows in the result.
fn db_rows(result: DbResult) -> i64 {
    _ariaPgNrows(result.handle)
}

// Number of columns in the result.
fn db_cols(result: DbResult) -> i64 {
    _ariaPgNcols(result.handle)
}

// Get the name of column `col`.
fn db_field_name(result: DbResult, col: i64) -> str {
    _ariaPgFieldName(result.handle, col)
}

// Get the value at (row, col) as a string.
fn db_get(result: DbResult, row: i64, col: i64) -> str {
    _ariaPgGetValue(result.handle, row, col)
}

// Check if the value at (row, col) is NULL.
fn db_is_null(result: DbResult, row: i64, col: i64) -> bool {
    _ariaPgIsNull(result.handle, row, col) == 1
}

// Free the result memory.
fn db_clear(result: DbResult) {
    _ariaPgClear(result.handle)
}

// --- Row helper ---

// Get a row accessor for convenient column access.
fn db_row(result: DbResult, row: i64) -> DbRow {
    nc := _ariaPgNcols(result.handle)
    DbRow{result: result.handle, row: row, ncols: nc}
}

// Get a column value from a row.
fn db_row_get(r: DbRow, col: i64) -> str {
    _ariaPgGetValue(r.result, r.row, col)
}

// ============================================================
// High-level Connection / Transaction API
//
// Matches the spec-level `with conn := db.connect(url)? { ... }` pattern.
// Current implementation fails fast (ConnectionFailed) because no real
// backend is wired — callers should handle Err in a `catch` block. Once
// libpq/SQLite is linked, connect() can return a live Connection and the
// Transaction methods below can execute real queries.
// ============================================================

// Named DbError to avoid clashing with fs.Error when both are imported.
type DbError =
    | ConnectionFailed
    | QueryFailed
    | TxFailed
    | NotFound
    | Unavailable
    | Constraint(str)

struct Connection {
    handle: i64
}

struct Transaction {
    conn_handle: i64
    active: bool
}

// Returns true iff the runtime was compiled with -DARIA_HAS_LIBPQ. Lets
// callers branch on libpq-present without attempting a real connection.
fn available() -> bool {
    _ariaPgAvailable() == 1
}

// Connect to a database. Returns Connection!DbError — use catch to handle
// the unavailable case. When libpq isn't linked, returns DbError.Unavailable
// immediately so callers get a proper error instead of a dead handle.
fn connect(url: str) -> Connection!DbError with [Io] {
    if _ariaPgAvailable() == 0 { return err(DbError.Unavailable) }
    h := _ariaPgConnect(url)
    if h == 0 { return err(DbError.Unavailable) }
    if _ariaPgStatus(h) != 1 {
        _ariaPgClose(h)
        return err(DbError.ConnectionFailed)
    }
    Connection { handle: h }
}

fn is_connected(c: Connection) -> bool {
    c.handle != 0
}

// All tx methods use the handle-based failure pattern rather than Result
// wrapping (cross-module fallible returns with struct payloads need more
// compiler work). Check tx.active / return values to detect failures.
fn begin(conn: Connection) -> Transaction with [Io] {
    if conn.handle == 0 { return Transaction { conn_handle: 0, active: false } }
    r := _ariaPgExec(conn.handle, "BEGIN")
    ok := _ariaPgResultStatus(r) == 0
    _ariaPgClear(r)
    Transaction { conn_handle: conn.handle, active: ok }
}

fn exec(tx: Transaction, sql: str, params: [str]) -> bool with [Io] {
    if !tx.active { return false }
    r := _ariaPgExecParams(tx.conn_handle, sql, params)
    ok := _ariaPgResultStatus(r) == 0
    _ariaPgClear(r)
    ok
}

fn commit(tx: Transaction) -> bool with [Io] {
    if !tx.active { return false }
    r := _ariaPgExec(tx.conn_handle, "COMMIT")
    ok := _ariaPgResultStatus(r) == 0
    _ariaPgClear(r)
    ok
}

fn rollback(tx: Transaction) -> bool with [Io] {
    if !tx.active { return false }
    r := _ariaPgExec(tx.conn_handle, "ROLLBACK")
    _ariaPgClear(r)
    true
}

fn query_all(tx: Transaction, sql: str) -> [str] with [Io] {
    mut empty: [str] = []
    if !tx.active { return empty }
    r := _ariaPgExec(tx.conn_handle, sql)
    if _ariaPgResultStatus(r) != 0 {
        _ariaPgClear(r)
        return empty
    }
    nrows := _ariaPgNrows(r)
    mut results: [str] = []
    mut i := 0
    while i < nrows {
        results = results.append(_ariaPgGetValue(r, i, 0))
        i = i + 1
    }
    _ariaPgClear(r)
    results
}

fn close(conn: Connection) -> bool {
    _ariaPgClose(conn.handle)
    true
}

// ============================================================
// Pool — connection pool for concurrent request handlers
// ============================================================
//
// Tier 1: fakes pooling with a single shared libpq connection. Real pooling
// (N pre-opened conns, round-robin handoff with a mutex) is a future upgrade
// — the API is stable so callers won't change when it lands.

struct Pool {
    url:      str
    max_conn: i64
    handle:   i64
}

fn Pool_connect(url: str, max_conn: i64) -> Pool!DbError with [Io] {
    if _ariaPgAvailable() == 0 { return err(DbError.Unavailable) }
    h := _ariaPgConnect(url)
    if h == 0 { return err(DbError.Unavailable) }
    if _ariaPgStatus(h) != 1 {
        _ariaPgClose(h)
        return err(DbError.ConnectionFailed)
    }
    Pool { url: url, max_conn: max_conn, handle: h }
}

fn Pool_close(self: Pool) -> bool with [Io] {
    _ariaPgClose(self.handle)
    true
}

// Acquire a connection, run `body`, and release. With the Tier 1 single-
// conn backing this is really "hand the singleton conn to the closure".
// The generic payload T is fixed at Connection for now to sidestep callback
// monomorphization edge cases — handlers return their domain value through
// a second step (e.g. `with_conn(...).and_then(fn c -> User ...)` or
// direct query_one calls on the conn they receive).
fn Pool_with_conn(self: Pool, body: fn(Connection) -> Connection!DbError) -> Connection!DbError with [Io] {
    conn := Connection { handle: self.handle }
    body(conn)
}

// --- Connection row/exec API used by handlers ---

// Execute a non-SELECT statement. Returns affected-row count on success.
// Maps SQLSTATE "23xxx" (integrity constraint violation) to Constraint(msg)
// so callers can return 409 without parsing error text themselves.
fn Connection_exec(c: Connection, sql: str, params: [str]) -> i64!DbError with [Io] {
    if c.handle == 0 { return err(DbError.ConnectionFailed) }
    r := _ariaPgExecParams(c.handle, sql, params)
    status := _ariaPgResultStatus(r)
    if status != 0 {
        sqlstate := _ariaPgResultErrorField(r, 67)  // 'C' = SQLSTATE
        msg      := _ariaPgResultError(r)
        _ariaPgClear(r)
        if sqlstate.len() >= 2 && sqlstate.startsWith("23") {
            return err(DbError.Constraint(msg))
        }
        return err(DbError.QueryFailed)
    }
    nrows := _ariaPgNrows(r)
    _ariaPgClear(r)
    nrows
}

// Query exactly one row and encode it as a JSON object. Callers combine
// this with `json.parse[T](s)` to get a typed `T`:
//   js := db.query_one_json(conn, sql, params)?
//   user := json.parse[User](js)
// Keeps the FFI surface free of generic-method monomorphization — the
// stdlib just produces a string, the derive machinery does the decoding.
// Returns NotFound when the query produced zero rows, QueryFailed on SQL
// errors.
fn query_one_json(c: Connection, sql: str, params: [str]) -> str!DbError with [Io] {
    Connection_query_one_json(c, sql, params)
}

fn Connection_query_one_json(c: Connection, sql: str, params: [str]) -> str!DbError with [Io] {
    if c.handle == 0 { return err(DbError.ConnectionFailed) }
    r := _ariaPgExecParams(c.handle, sql, params)
    status := _ariaPgResultStatus(r)
    if status != 0 {
        _ariaPgClear(r)
        return err(DbError.QueryFailed)
    }
    nrows := _ariaPgNrows(r)
    if nrows == 0 {
        _ariaPgClear(r)
        return err(DbError.NotFound)
    }
    json_str := _row_to_json(r, 0)
    _ariaPgClear(r)
    json_str
}

// --- Internal helpers ---

// Build `{"col": val, "col2": val2}` from a PG result row. Uses PQftype
// to decide bare vs. quoted: bool/int/float emit bare, everything else
// (text, timestamp, uuid, etc.) goes through json.escape.
fn _row_to_json(result: i64, row: i64) -> str with [Io] {
    ncols := _ariaPgNcols(result)
    mut out := "\{"
    mut i := 0
    while i < ncols {
        if i > 0 { out = out + "," }
        fname := _ariaPgFieldName(result, i)
        ftype := _ariaPgFieldType(result, i)
        out = out + "\"" + fname + "\":"
        if _ariaPgIsNull(result, row, i) == 1 {
            out = out + "null"
        } else {
            val := _ariaPgGetValue(result, row, i)
            if _is_bare_pg_type(ftype) {
                // bool comes back as "t"/"f" from libpq text mode
                if ftype == 16 {
                    if val == "t" { out = out + "true" } else { out = out + "false" }
                } else {
                    out = out + val
                }
            } else {
                out = out + _json_quote(val)
            }
        }
        i = i + 1
    }
    out + "\}"
}

fn _is_bare_pg_type(oid: i64) -> bool {
    // bool (16), bytea-no (17 is bytea — NOT bare), int2 (21), int4 (23),
    // int8 (20), float4 (700), float8 (701), numeric (1700 — pg delivers
    // as text, but it's safe to inline when parseable as a JSON number).
    oid == 16 || oid == 20 || oid == 21 || oid == 23 ||
    oid == 700 || oid == 701 || oid == 1700
}

fn _json_quote(s: str) -> str {
    // Escape per JSON spec: \\, \", \n, \r, \t. Control chars below 0x20
    // aren't emitted by libpq for text columns in normal usage; skip them.
    mut out := "\""
    mut i := 0
    while i < s.len() {
        c := s.charAt(i)
        if c == "\\" { out = out + "\\\\" }
        else if c == "\"" { out = out + "\\\"" }
        else if c == "\n" { out = out + "\\n" }
        else if c == "\r" { out = out + "\\r" }
        else if c == "\t" { out = out + "\\t" }
        else { out = out + c }
        i = i + 1
    }
    out + "\""
}
