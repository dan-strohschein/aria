mod log

// ============================================================
// Logging Library for Aria
//
// Simple level-based logging to stdout/stderr.
// ============================================================

fn info(msg: str) with [Io] {
    println("[INFO] " + msg)
}

fn warn(msg: str) with [Io] {
    println("[WARN] " + msg)
}

fn error(msg: str) with [Io] {
    eprintln("[ERROR] " + msg)
}

fn debug(msg: str) with [Io] {
    println("[DEBUG] " + msg)
}

// Stub: level filtering isnt implemented; accepts any i64 and returns it
// unchanged so calls like `log.set_level(0)` compile and run as a no-op.
// We intentionally dont declare log-level constants (log.Info, log.Debug,
// etc.) here: they would collide with user-defined `Info`/`Error`/`Debug`
// types common in error-handling examples.
fn set_level(level: i64) -> i64 {
    level
}
