mod log

// ============================================================
// Logging Library for Aria
//
// Level-based logging to stdout/stderr.
// Levels: 0=Debug, 1=Info, 2=Warn, 3=Error. Default 1 (Info).
// Calls below the current level are suppressed.
// ============================================================

mut _level: i64 = 1

fn info(msg: str) with [Io] {
    if _level <= 1 { println("[INFO] " + msg) }
}

fn warn(msg: str) with [Io] {
    if _level <= 2 { println("[WARN] " + msg) }
}

fn error(msg: str) with [Io] {
    if _level <= 3 { eprintln("[ERROR] " + msg) }
}

fn debug(msg: str) with [Io] {
    if _level <= 0 { println("[DEBUG] " + msg) }
}

// Set the minimum log level (0=Debug, 1=Info, 2=Warn, 3=Error).
// Messages below the current level are suppressed.
fn set_level(level: i64) -> i64 {
    _level = level
    level
}
