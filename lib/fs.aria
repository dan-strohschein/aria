mod fs

// ============================================================
// File System Library for Aria
//
// Wraps runtime file I/O functions with error handling.
// ============================================================

type IoError =
    | NotFound
    | PermissionDenied
    | IoFailed(str)

type Error =
    | NotFound
    | PermissionDenied
    | IoFailed(str)

// read returns an empty string when the file is missing or unreadable.
// Empty-file and missing-file both produce "" — callers that need to
// distinguish should call fs.exists first. The returned string is always
// a valid allocation (never a null pointer), so .len() and string ops
// are safe on the result.
fn read(path: str) -> str with [Fs] {
    _ariaReadFile(path)
}

fn write(path: str, content: str) with [Fs] {
    _ariaWriteFile(path, content)
}

fn append(path: str, content: str) with [Fs] {
    _ariaAppendFile(path, content)
}

fn exists(path: str) -> bool with [Fs] {
    _ariaFileExists(path) == 1
}

fn is_dir(path: str) -> bool with [Fs] {
    _ariaIsDir(path)
}

fn list_dir(path: str) -> [str] with [Fs] {
    _ariaListDir(path)
}

// walk returns the entries of `path` (non-recursive). A real implementation
// would recurse into subdirectories; for now this matches list_dir so the
// common `fs.walk(dir) |> filter(...)` pattern has something to iterate.
fn walk(path: str) -> [str] with [Fs] {
    _ariaListDir(path)
}

// Minimal file metadata. `size_bytes` is the current read size (0 if missing).
struct Metadata {
    path: str
    size_bytes: i64
    exists: bool
}

fn metadata(path: str) -> Metadata with [Fs] {
    content := _ariaReadFile(path)
    Metadata{path: path, size_bytes: content.len(), exists: content.len() > 0}
}

fn remove(path: str) -> bool with [Fs] {
    _ariaRemoveFile(path) == 1
}

// --- File handles (value-typed for now — no real fd resource, just path) ---
// Matches the aspirational spec API: `with f := fs.open(p)? { f.read_all()? }`.
struct File {
    path: str
    mode: str    // "r" | "w" | "a"
}

fn open(path: str) -> File!Error with [Fs] {
    if _ariaFileExists(path) == 0 { return err(Error.NotFound) }
    File { path: path, mode: "r" }
}

fn create(path: str) -> File!Error with [Fs] {
    _ariaWriteFile(path, "")
    File { path: path, mode: "w" }
}

fn file_read_all(f: File) -> str with [Fs] {
    _ariaReadFile(f.path)
}

fn file_lines(f: File) -> [str] with [Fs] {
    content := _ariaReadFile(f.path)
    content.split("\n")
}

fn file_write(f: File, content: str) -> bool!Error with [Fs] {
    if f.mode == "r" { return err(Error.IoFailed("file opened for reading")) }
    if f.mode == "a" {
        _ariaAppendFile(f.path, content)
    } else {
        _ariaAppendFile(f.path, content)
    }
    true
}

fn file_write_line(f: File, content: str) -> bool!Error with [Fs] {
    if f.mode == "r" { return err(Error.IoFailed("file opened for reading")) }
    _ariaAppendFile(f.path, content)
    _ariaAppendFile(f.path, "\n")
    true
}

fn file_close(f: File) -> bool {
    true    // no real fd to close yet; placeholder for the Drop integration
}
