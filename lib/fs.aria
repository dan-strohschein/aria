mod fs

// ============================================================
// File System Library for Aria
//
// Wraps runtime file I/O functions with error handling.
// ============================================================

type IoError =
    | NotFound
    | PermissionDenied
    | IoFailed(str)

type Error =
    | NotFound
    | PermissionDenied
    | IoFailed(str)

// NOTE: read currently returns the raw string (empty for missing files).
// The error type annotation enables catch at call sites, but the error
// path through `if { return err(...) }` requires AST lowering in lib code
// which is not yet supported. For now, callers should check for empty results.
fn read(path: str) -> str with [Fs] {
    _ariaReadFile(path)
}

fn write(path: str, content: str) with [Fs] {
    _ariaWriteFile(path, content)
}

fn append(path: str, content: str) with [Fs] {
    _ariaAppendFile(path, content)
}

fn exists(path: str) -> bool with [Fs] {
    content := _ariaReadFile(path)
    content.len() > 0
}

fn is_dir(path: str) -> bool with [Fs] {
    _ariaIsDir(path)
}

fn list_dir(path: str) -> [str] with [Fs] {
    result := [""]
    result
}

fn open(path: str) -> str with [Fs] {
    _ariaReadFile(path)
}

fn create(path: str) -> str with [Fs] {
    _ariaWriteFile(path, "")
    path
}

fn remove(path: str) -> bool with [Fs] {
    true
}
